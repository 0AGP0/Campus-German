# Sitemap + robots: rate-limit (Retry-After) muafiyeti — GSC için önbellek kapalı (makale: exclude from caching)
<IfModule mod_headers.c>
  <Files "sitemap.xml">
    Header always unset Retry-After
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Content-Type "application/xml; charset=utf-8"
  </Files>
  <FilesMatch "sitemap(-index|\-[0-9]+)?\.xml$">
    Header always unset Retry-After
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Content-Type "application/xml; charset=utf-8"
  </FilesMatch>
  <Files "robots.txt">
    Header always unset Retry-After
    Header always set Cache-Control "public, max-age=86400"
  </Files>
</IfModule>

# Sitemap ve robots.txt asla yönlendirilmesin (GSC 301'de "okunamadı" diyor)
# John Mueller trick: ?sitemap=1 ile sitemap sun (GSC'de "Add sitemap" -> https://campusgerman.com/?sitemap=1)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Eski kök URL'ler (GSC 404) -> gerçek sayfalar
  RewriteRule ^online/?$ /tr/kurslar/online-uebersicht/ [R=301,L]
  RewriteRule ^goethe/?$ /tr/kurslar/pruefungsvorbereitung-uebersicht/ [R=301,L]
  RewriteRule ^kurslar/?$ /tr/kurslar/ [R=301,L]
  RewriteRule ^de-yaz-kampi/?$ /tr/kurslar/yaz-okulu/ [R=301,L]
  RewriteRule ^egitmenler/?$ /tr/lehrkraefte/ [R=301,L]
  RewriteRule ^egitmenlerimiz/?$ /tr/lehrkraefte/ [R=301,L]
  # Eski rezervasyon slug'ları -> buchung
  RewriteRule ^en/booking/?$ /en/buchung/ [R=301,L]
  RewriteRule ^es/reservar/?$ /es/buchung/ [R=301,L]
  # Eski yanlış URL: /en/kurslar/* ve /de/kurslar/* -> doğru dil klasörü (duplicate içerik önleme)
  RewriteRule ^en/kurslar/(.*)$ /en/courses/$1 [R=301,L]
  RewriteRule ^de/kurslar/(.*)$ /de/kurse/$1 [R=301,L]
  # Özel evrak: eski /de|en|es/ozel-evrak-formu -> dile özel slug
  RewriteRule ^de/ozel-evrak-formu/?$ /de/dokumenten-einreichung/ [R=301,L]
  RewriteRule ^en/ozel-evrak-formu/?$ /en/private-documents/ [R=301,L]
  RewriteRule ^es/ozel-evrak-formu/?$ /es/documentos-privados/ [R=301,L]
  # Eski özel evrak proxy yolu (api klasörü sunucuda yok / 404) -> kökteki kanonik PHP
  RewriteRule ^api/private-documents\.php$ /private-documents-proxy.php [R=301,L,QSA]
  # Eski konaklama ilan listesi (explorer) -> geçici konaklama hizmet sayfası
  RewriteRule ^de/unsere-dienstleistungen/konaklama/?$ /de/unsere-dienstleistungen/unterkunft/ [R=301,L]
  RewriteRule ^en/our-services/konaklama/?$ /en/our-services/accommodation/ [R=301,L]
  RewriteRule ^es/nuestros-servicios/konaklama/?$ /es/nuestros-servicios/alojamiento/ [R=301,L]
  # Eski TR "Über uns" path'i -> hakkimizda (Netlify _redirects ile aynı; HTML meta-refresh sayfası yok)
  RewriteRule ^tr/ueber-uns/?$ /tr/hakkimizda/ [R=301,L]
  RewriteRule ^tr/ueber-uns/(.+)$ /tr/hakkimizda/$1 [R=301,L,QSA]
  # Eski kartvizit URL'leri: /k/slug -> /slug (301)
  RewriteRule ^k/([a-z0-9-]+)/?$ /$1 [R=301,L]
  # Tek segment (dosya/klasör değilse) danışman sayfası: /slug -> k.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-z0-9-]+)/?$ k.php?slug=$1 [L,QSA]
  RewriteCond %{QUERY_STRING} ^sitemap=1$
  RewriteRule ^/?$ /sitemap.xml [L]
  RewriteRule ^sitemap(-index|\-[0-9]+)?\.xml$ - [L]
  RewriteRule ^robots\.txt$ - [L]
</IfModule>

# Hostinger / Apache: XML sitemap dosyaları için doğru Content-Type
<IfModule mod_mime.c>
  AddType application/xml .xml
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(xml)$">
    Header set Content-Type "application/xml; charset=utf-8"
  </FilesMatch>
</IfModule>
