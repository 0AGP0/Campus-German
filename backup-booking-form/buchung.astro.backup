                                                    {lang === 'tr' ? 'Konaklama bilgileri yükleniyor...' : lang === 'de' ? 'Unterkunftsinformationen werden geladen...' : lang === 'es' ? 'Cargando información del alojamiento...' : 'Loading accommodation information...'}
                                                </div>
                                            </div>
                                            <div class="summary-section">
                                                <h4>💰 {translations.priceDetails}</h4>
                                                <div class="summary-content" id="price-summary">
                                                    {lang === 'tr' ? 'Fiyat detayları yükleniyor...' : lang === 'de' ? 'Preisdetails werden geladen...' : lang === 'es' ? 'Cargando detalles del precio...' : 'Loading price details...'}
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="terms-section">
                                        <div class="checkbox-group">
                                            <label class="checkbox-label">
                                                <input type="checkbox" name="terms-accepted" value="yes" required>
                                                <span class="checkbox-custom"></span>
                                                <span class="checkbox-text">
                                                    <strong>{lang === 'tr' ? 'Genel Hüküm ve Koşullar' : lang === 'de' ? 'Allgemeine Geschäftsbedingungen' : lang === 'es' ? 'Condiciones Generales' : 'General Terms and Conditions'}</strong> {lang === 'tr' ? "'ı okudum ve kabul ediyorum" : lang === 'de' ? " - Ich habe gelesen und akzeptiere" : lang === 'es' ? " - He leído y acepto" : " - I have read and accept"} *
                                                </span>
                                            </label>
                                            <label class="checkbox-label">
                                                <input type="checkbox" name="privacy-accepted" value="yes" required>
                                                <span class="checkbox-custom"></span>
                                                <span class="checkbox-text">
                                                    <strong>{lang === 'tr' ? 'Kişisel Verilerin Korunması' : lang === 'de' ? 'Datenschutz' : lang === 'es' ? 'Protección de datos' : 'Privacy Policy'}</strong> {lang === 'tr' ? ' hakkındaki bilgilendirmeyi okudum ve kabul ediyorum' : lang === 'de' ? ' - Ich habe die Informationen gelesen und akzeptiere' : lang === 'es' ? ' - He leído y acepto la información' : ' - I have read and accept the information'} *
                                                </span>
