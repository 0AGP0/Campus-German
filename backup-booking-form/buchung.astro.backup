---
import MainLayout from '../../layouts/MainLayout.astro';
import '../../styles/pages/buchung.css';
import { coursePricing } from '../../data/coursePricing.ts';

export async function getStaticPaths() {
    return [
        { params: { lang: 'tr' } },
        { params: { lang: 'de' } },
        { params: { lang: 'en' } },
        { params: { lang: 'es' } },
    ];
}

const { lang } = Astro.params;
const pricingData = coursePricing[lang === 'es' ? 'de' : (lang as 'tr' | 'de' | 'en')];

// Translations
const t = {
    tr: {
        title: "Kurs Rezervasyonu",
        heroTitle: "Kurs Rezervasyonu",
        heroDescription: "CampusGerman ile Almanya'da eğitiminizi planlayın. Adım adım rehberlik ile rezervasyonunuzu tamamlayın.",
