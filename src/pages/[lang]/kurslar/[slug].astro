---
import { getCollection } from 'astro:content';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import QuoteWizardForm from '../../../components/QuoteWizardForm.astro';
import QuoteWizardModal from '../../../components/QuoteWizardModal.astro';
import IntensivePricingSection from '../../../components/IntensivePricingSection.astro';
import PromoPrice from '../../../components/PromoPrice.astro';
import SuccessModal from '../../../components/SuccessModal.astro';
import CookieConsent from '../../../components/CookieConsent.astro';
import MetaPixel from '../../../components/MetaPixel.astro';
import GoogleTagManager from '../../../components/GoogleTagManager.astro';
import '../../../styles/global.css';
import { getCoursePricingData, getWeeklyPricingCategory, extractCourseInfo, formatCourseDate } from '../../../utils/coursePricingHelper';
import { getBookingPath, getContactPath, getSectionPath } from '../../../utils/pathHelpers';
import { buildBookingUrl } from '../../../utils/bookingPrefillHelper';

export async function getStaticPaths() {
  const allKurslar = await getCollection('kurslar');
  
  // Silinmiş / kaldırılan sayfalar (online-almanca, online-sinav-hazirlik ve dil karşılıkları)
  const silinmisSayfalar = [
    'intensiv-studentenvisum',
    'online-almanca', 'online-sinav-hazirlik',
    'online-deutsch', 'online-german', 'aleman-online',
    'online-pruefungsvorbereitung', 'online-exam-preparation', 'preparacion-examenes-online',
  ];
  
  const paths = [];
  
  // Yalnızca TR: DE/EN kurs URL'leri kurse/ ve courses/ altında; burada da üretmek duplicate sayfa ve GSC sorunlarına yol açıyordu
  const supportedLangs = ['tr'];
  
  // Her dil için kursları filtrele ve route oluştur
  for (const langCode of supportedLangs) {
    const langKurslar = allKurslar.filter(kurs => kurs.data.lang === langCode);
    
    for (const kurs of langKurslar) {
      // Use customSlug if available, otherwise use default slug cleaning
      let finalSlug;
      if (kurs.data.customSlug) {
        finalSlug = kurs.data.customSlug;
        // Silinmiş sayfaları kontrol et
        if (silinmisSayfalar.includes(finalSlug)) {
          continue;
        }
      } else {
        // Diğer sayfalarla tutarlı slug temizleme mantığı
        const slug = kurs.slug;
        
        // Dil uzantısını temizle (örn: intensiv-a1.es.md -> intensiv-a1)
        if (slug.endsWith(`.${langCode}`) || slug.endsWith(`-${langCode}`)) {
          finalSlug = slug.replace(new RegExp(`\\.${langCode}$|\\-${langCode}$`), '');
        } else if (slug.endsWith(langCode) && slug.length > langCode.length) {
          finalSlug = slug.slice(0, -langCode.length);
        } else {
          // Dil uzantısı yoksa slug'ı olduğu gibi kullan
          finalSlug = slug;
        }
        
        // Silinmiş sayfaları kontrol et
        if (silinmisSayfalar.includes(finalSlug)) {
          continue;
        }
      }
      
      paths.push({
        params: { 
          lang: langCode,
          slug: finalSlug
        },
        props: { kurs },
      });
    }
  }
  
  return paths;
}

const { kurs } = Astro.props;
const { lang } = Astro.params;
const { slug } = Astro.params;
const { Content } = await kurs.render();

// Legacy slug redirect (örn. /tr/kurslar/intensiv-a1 -> /tr/kurslar/yogun-a1)
const expectedSlug = kurs.data.customSlug ?? kurs.slug;
if (slug && expectedSlug && slug !== expectedSlug) {
  // İspanyolca için cursos, diğerleri için kurslar/kurse/courses
  const sectionPath = lang === 'es' ? 'cursos' : lang === 'de' ? 'kurse' : lang === 'en' ? 'courses' : 'kurslar';
  return Astro.redirect(`/${lang}/${sectionPath}/${expectedSlug}`, 301);
}

// Kurs için fiyat ve tarih bilgilerini al
const pricingData = getCoursePricingData(kurs.data.lang as 'tr' | 'de' | 'en' | 'es', kurs.slug);
const courseInfo = extractCourseInfo(kurs.slug);
const weeklyCategory = getWeeklyPricingCategory(courseInfo.level);

// Mevcut tabs'da "tarihler-fiyatlar" veya "fiyatlar-tarihler" tab'ı var mı kontrol et
const hasPricingTab = kurs.data.tabs?.some(tab => 
  tab.id === 'tarihler-fiyatlar' || 
  tab.id === 'fiyatlar-tarihler' || 
  tab.id === 'pricing-dates' ||
  tab.title.toLowerCase().includes('fiyat') ||
  tab.title.toLowerCase().includes('tarih')
) || false;

// Booking ve contact path'leri dil bazlı (talep formu yoksa CTA booking'e)
const bookingPath = getBookingPath(lang as 'tr' | 'de' | 'en' | 'es');
const courseSlugForBooking = kurs.data.customSlug ?? slug ?? kurs.slug;
const bookingFull = buildBookingUrl(lang as 'tr' | 'de' | 'en' | 'es', courseSlugForBooking);
const homePath = `/${lang}`;
const contactPath = getContactPath(lang as 'tr' | 'de' | 'en' | 'es');
const sectionPath = getSectionPath(lang as 'tr' | 'de' | 'en' | 'es');

// Uzun etiketleri tasarım için kısalt (Unterrichtseinheiten → UE, Unterrichtsstunden → UStd)
function shortenLabels(text: string): string {
  if (!text || typeof text !== 'string') return text;
  return text
    .replace(/\s*Unterrichtseinheiten\s*\(UE\)/gi, ' UE')
    .replace(/Unterrichtseinheiten/gi, ' UE')
    .replace(/\s*Unterrichtsstunden/gi, ' UStd')
    .replace(/\s*45\s*Minuten/gi, ' 45 Min')
    .replace(/\s*45\s*dakika/gi, ' 45 dk')
    .replace(/\s*pro\s*Woche/gi, '/Wo.').replace(/\/Woche\b/gi, '/Wo.')
    .replace(/\s*\(UE\)/g, '')
    .replace(/\s{2,}/g, ' ')
    .trim();
}
// Kişi sayısı (sınıf mevcudu) için dil bazlı "maks" kısaltması: 10-16 maks. / max. / máx.
const groupSizeMaxAbbr = lang === 'tr' ? 'maks.' : lang === 'es' ? 'máx.' : 'max.';
const groupSizeDisplay = `10-16 ${groupSizeMaxAbbr}`;
const displayDescription = shortenLabels(kurs.data.description);
const displayBadgeText = shortenLabels(kurs.data.badge?.text ?? '');
---

<!DOCTYPE html>
<html lang={kurs.data.lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{kurs.data.title} - CampusGerman</title>
    <GoogleTagManager part="head" />
    <link rel="stylesheet" href="/kurs-detay.css">
    <link rel="stylesheet" href="/kurs-detay-override.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Kurs detay: header altında boşluk – inline kesin uygulansın -->
    <style is:inline>
      body.course-detail-page-wrap { padding-top: 0 !important; }
      body.course-detail-page-wrap .header-spacer { display: block !important; height: 155px !important; min-height: 155px !important; width: 100%; }
    </style>
    <MetaPixel />
</head>
<body class="course-detail-page-wrap">
    <GoogleTagManager part="body" />
    <Header lang={lang} />
    <div class="header-spacer" aria-hidden="true"></div>

    <main class="course-detail-page">
        <!-- Hero Section -->
        <section class="hero-section course-hero">
            <div class="container">
                <div class="hero-wrapper">
                    <div class="hero-image">
                        <div class="image-container">
                            <img src={kurs.data.image} alt={kurs.data.title} class="course-image">
                            <div class="image-overlay">
                                <div class="overlay-badge">
                                    <i class={kurs.data.badge.icon}></i>
                                    <span>{displayBadgeText}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="hero-content">
                        <div class="course-badge">
                            <i class={kurs.data.badge.icon}></i>
                            <span>{displayBadgeText}</span>
                        </div>
                        
                        <h1 class="hero-title">{kurs.data.title}</h1>
                        
                        <p class="hero-description">
                            {displayDescription}
                        </p>
                        
                        <div class="course-features">
                            {kurs.data.features.map(feature => (
                                <div class="feature-item">
                                    <div class="feature-icon">
                                        <i class={feature.icon}></i>
                                    </div>
                                    <div class="feature-content">
                                        <h4>{feature.title}</h4>
                                        <p>{feature.icon === 'fas fa-users' ? groupSizeDisplay : feature.description}</p>
                                    </div>
                                </div>
                            ))}
                        </div>
                        
                        <div class="hero-actions">
                            {kurs.data.hasDemandForm ? (
                                <>
                                    <a href={kurs.data.heroButtons.secondary.href} class="hero-secondary-button">
                                        <i class={kurs.data.heroButtons.secondary.icon}></i>
                                        <span>{kurs.data.heroButtons.secondary.text}</span>
                                    </a>
                                    <a href="#bilgi-al-form" class="hero-cta-button">
                                        <span>{kurs.data.heroButtons.primary.text}</span>
                                        <i class={kurs.data.heroButtons.primary.icon}></i>
                                    </a>
                                </>
                            ) : (
                                <>
                                    <a href={`/${lang}/${contactPath}`} class="hero-secondary-button">
                                        <i class="fas fa-envelope"></i>
                                        <span>{lang === 'tr' ? 'Ücretsiz bilgi al' : lang === 'de' ? 'Information anfragen' : lang === 'es' ? 'Solicitar información' : 'Get Information'}</span>
                                    </a>
                                    <a href={bookingFull} class="hero-cta-button">
                                        <span>{lang === 'tr' ? 'Hemen kayıt ol' : lang === 'de' ? 'Jetzt anmelden' : lang === 'es' ? 'Registrarse' : 'Register'}</span>
                                        <i class="fas fa-arrow-right"></i>
                                    </a>
                                </>
                            )}
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Course Details Tabs Section -->
        <section class="course-details-section">
            <div class="container">
                <div class="section-header">
                    <h2>{lang === 'tr' ? 'Kurs Detayları' : 'Kursdetails'}</h2>
                    <p>{lang === 'tr' ? `${kurs.data.title} hakkında tüm detayları keşfedin` : `Entdecken Sie alle Details zu ${kurs.data.title}`}</p>
                </div>
                
                <div class="tabs-navigation">
                    {kurs.data.tabs.map((tab, index) => (
                        <button class={`tab-btn ${index === 0 ? 'active' : ''}`} data-tab={tab.id}>
                            <i class={tab.icon}></i>
                            <span>{tab.title}</span>
                        </button>
                    ))}
                    {pricingData && !hasPricingTab && (
                        <button class="tab-btn" data-tab="fiyatlar-tarihler">
                            <i class="fas fa-euro-sign"></i>
                            <span>{lang === 'tr' ? 'Fiyatlar ve Tarihler' : 'Preise und Termine'}</span>
                        </button>
                    )}
                </div>

                <div class="tab-contents">
                    {kurs.data.tabs.map((tab, index) => {
                        // Eğer bu tab "tarihler-fiyatlar" veya "fiyatlar-tarihler" ise ve pricingData varsa, dinamik içerik göster
                        const isPricingTab = (tab.id === 'tarihler-fiyatlar' || tab.id === 'fiyatlar-tarihler' || tab.id === 'pricing-dates') && pricingData;
                        
                        return (
                            <div class={`tab-content ${index === 0 ? 'active' : ''}`} id={tab.id}>
                                <div class="course-card">
                                    <div class="card-header">
                                        <div class="card-icon">
                                            <i class={tab.icon}></i>
                                        </div>
                                        <h3>{tab.title}</h3>
                                    </div>
                                    <div class="card-content">
                                        {isPricingTab ? (
                                            <div class="dynamic-pricing-content">
                                                <IntensivePricingSection lang={lang} showSectionTitle={false} />
                                                {pricingData.schedule && (
                                                    <div class="pricing-block">
                                                        <h5>{lang === 'tr' ? 'Kurs Zamanları' : 'Kurszeiten'}</h5>
                                                        <p class="lesson-duration-note"><strong>{pricingData.lessonInfo}</strong></p>
                                                        <div class="schedule-info">
                                                            <div class="schedule-item">
                                                                <h6><i class="fas fa-sun"></i> {lang === 'tr' ? 'Sabah Kursları' : 'Vormittagskurse'}</h6>
                                                                <p>{pricingData.schedule.morning.all.time}</p>
                                                                <p class="schedule-break">{pricingData.schedule.morning.all.break}</p>
                                                                <p class="schedule-lessons">{pricingData.schedule.morning.all.lessons}</p>
                                                            </div>
                                                            <div class="schedule-item">
                                                                <h6><i class="fas fa-moon"></i> {lang === 'tr' ? 'Öğleden Sonra Kursları' : 'Nachmittagskurse'}</h6>
                                                                <p>{pricingData.schedule.afternoon.all.time}</p>
                                                                <p class="schedule-break">{pricingData.schedule.afternoon.all.break}</p>
                                                                <p class="schedule-lessons">{pricingData.schedule.afternoon.all.lessons}</p>
                                                            </div>
                                                            <p class="schedule-days"><i class="fas fa-calendar-week"></i> {pricingData.schedule.days}</p>
                                                        </div>
                                                    </div>
                                                )}
                                                {pricingData.dates && (
                                                    <div class="pricing-block">
                                                        <h5>{lang === 'tr' ? 'Kurs Başlangıç Tarihleri 2026' : 'Kursstarttermine 2026'}</h5>
                                                        <div class="dates-list">
                                                            {(pricingData.dates.all ? pricingData.dates.all : Object.values(pricingData.dates).flat()).map(date => (
                                                                <span class="date-badge">{date}</span>
                                                            ))}
                                                        </div>
                                                    </div>
                                                )}
                                                {pricingData.holidays && (
                                                    <div class="pricing-block">
                                                        <h5>{lang === 'tr' ? 'Tatiller 2026' : 'Feiertage 2026'}</h5>
                                                        <div class="holidays-list">
                                                            {pricingData.holidays.map(holiday => (
                                                                <div class="holiday-item">
                                                                    <span class="holiday-name">{holiday.name}</span>
                                                                    <span class="holiday-date">{holiday.date}</span>
                                                                </div>
                                                            ))}
                                                        </div>
                                                    </div>
                                                )}
                                                {pricingData.visaInfo && !pricingData.isWeeklyOnly && (
                                                    <div class="pricing-info-box">
                                                        <p><i class="fas fa-info-circle"></i> {pricingData.visaInfo}</p>
                                                    </div>
                                                )}
                                            </div>
                                        ) : (
                                            <!-- Normal Tab İçeriği -->
                                            <>
                                                <h4>{tab.content.title}</h4>
                                                
                                                {/* Paragraf bazlı içerik - öncelikli */}
                                                {tab.content.paragraphs && tab.content.paragraphs.length > 0 ? (
                                                    <div class="course-content-paragraphs">
                                                        {tab.content.paragraphs.map((para, idx) => (
                                                            <div class="content-paragraph-block">
                                                                {para.heading && (
                                                                    <h5 class="paragraph-heading">{para.heading}</h5>
                                                                )}
                                                                <p class="paragraph-text">{para.text}</p>
                                                            </div>
                                                        ))}
                                                    </div>
                                                ) : (
                                                    <>
                                                        {/* Eski format - items ve additionalInfo (geriye dönük uyumluluk için) */}
                                                        {tab.content.items && (
                                                            <div class="info-list">
                                                                {tab.content.items.map(item => (
                                                                    <div class="info-item">
                                                                        <i class={item.icon}></i>
                                                                        <span set:html={item.text}></span>
                                                                    </div>
                                                                ))}
                                                            </div>
                                                        )}
                                                        
                                                        {tab.content.additionalInfo && (
                                                            <div class="additional-offers">
                                                                <h5>{tab.content.additionalInfo.title}</h5>
                                                                <p>{tab.content.additionalInfo.text}</p>
                                                            </div>
                                                        )}
                                                    </>
                                                )}

                                                {tab.content.pricing && (
                                                    tab.content.pricing.some((p) => typeof p.price === 'string' && p.price.includes('€')) ? (
                                                        <div class="dynamic-pricing-content">
                                                            <PromoPrice lang={lang} variant="block" />
                                                        </div>
                                                    ) : (
                                                    <div class="pricing-table">
                                                        <div class="table-header">
                                                            <div class="header-cell">Program</div>
                                                            <div class="header-cell">Süre</div>
                                                            <div class="header-cell">{kurs.data.lang === 'tr' ? 'Ders' : 'UStd'}</div>
                                                            <div class="header-cell">Fiyat</div>
                                                        </div>
                                                        {tab.content.pricing.map(price => (
                                                            <div class={`table-row ${price.highlighted ? 'highlighted' : ''}`} style={price.highlighted ? 'background-color: #e7f3ff;' : ''}>
                                                                <div class="table-cell">{price.highlighted ? <strong>{price.name}</strong> : price.name}</div>
                                                                <div class="table-cell">{price.highlighted ? <strong>{price.duration}</strong> : price.duration}</div>
                                                                <div class="table-cell">{price.highlighted ? <strong>{shortenLabels(price.schedule)}</strong> : shortenLabels(price.schedule)}</div>
                                                                <div class="table-cell">{price.highlighted ? <strong>{price.price}</strong> : price.price}</div>
                                                            </div>
                                                        ))}
                                                    </div>
                                                    )
                                                )}

                                                {tab.content.lessons && (
                                                    <div class="lesson-info">
                                                        <p class="lesson-duration"><strong>{kurs.data.lang === 'tr' ? '1 Ders = 45 dk' : '1 UStd = 45 Min'}</strong></p>
                                                        <div class="teaching-method">
                                                            {tab.content.lessons.map(lesson => (
                                                                <div style="margin-bottom: 20px;">
                                                                    <h5><strong>{lesson.title}</strong></h5>
                                                                    <p>{lesson.description}</p>
                                                                </div>
                                                            ))}
                                                        </div>
                                                    </div>
                                                )}
                                            </>
                                        )}
                                    </div>
                                </div>
                            </div>
                        );
                    })}
                    {pricingData && !hasPricingTab && (
                        <div class="tab-content" id="fiyatlar-tarihler">
                            <div class="course-card">
                                <div class="card-header">
                                    <div class="card-icon">
                                        <i class="fas fa-euro-sign"></i>
                                    </div>
                                    <h3>{lang === 'tr' ? 'Fiyatlar ve Tarihler' : 'Preise und Termine'}</h3>
                                </div>
                                <div class="card-content">
                                    <div class="dynamic-pricing-content">
                                        <IntensivePricingSection lang={lang} showSectionTitle={false} />
                                        {pricingData.schedule && (
                                            <div class="pricing-block">
                                                <h5>{lang === 'tr' ? 'Kurs Zamanları' : 'Kurszeiten'}</h5>
                                                <p class="lesson-duration-note"><strong>{pricingData.lessonInfo}</strong></p>
                                                <div class="schedule-info">
                                                    <div class="schedule-item">
                                                        <h6><i class="fas fa-sun"></i> {lang === 'tr' ? 'Sabah Kursları' : 'Vormittagskurse'}</h6>
                                                        <p>{pricingData.schedule.morning.all.time}</p>
                                                        <p class="schedule-break">{pricingData.schedule.morning.all.break}</p>
                                                        <p class="schedule-lessons">{pricingData.schedule.morning.all.lessons}</p>
                                                    </div>
                                                    <div class="schedule-item">
                                                        <h6><i class="fas fa-moon"></i> {lang === 'tr' ? 'Öğleden Sonra Kursları' : 'Nachmittagskurse'}</h6>
                                                        <p>{pricingData.schedule.afternoon.all.time}</p>
                                                        <p class="schedule-break">{pricingData.schedule.afternoon.all.break}</p>
                                                        <p class="schedule-lessons">{pricingData.schedule.afternoon.all.lessons}</p>
                                                    </div>
                                                    <p class="schedule-days"><i class="fas fa-calendar-week"></i> {pricingData.schedule.days}</p>
                                                </div>
                                            </div>
                                        )}
                                        {pricingData.dates && (
                                            <div class="pricing-block">
                                                <h5>{lang === 'tr' ? 'Kurs Başlangıç Tarihleri 2026' : 'Kursstarttermine 2026'}</h5>
                                                <div class="dates-list">
                                                    {(pricingData.dates.all ? pricingData.dates.all : Object.values(pricingData.dates).flat()).map(date => (
                                                        <span class="date-badge">{date}</span>
                                                    ))}
                                                </div>
                                            </div>
                                        )}
                                        {pricingData.holidays && (
                                            <div class="pricing-block">
                                                <h5>{lang === 'tr' ? 'Tatiller 2026' : 'Feiertage 2026'}</h5>
                                                <div class="holidays-list">
                                                    {pricingData.holidays.map(holiday => (
                                                        <div class="holiday-item">
                                                            <span class="holiday-name">{holiday.name}</span>
                                                            <span class="holiday-date">{holiday.date}</span>
                                                        </div>
                                                    ))}
                                                </div>
                                            </div>
                                        )}
                                        {pricingData.visaInfo && !pricingData.isWeeklyOnly && (
                                            <div class="pricing-info-box">
                                                <p><i class="fas fa-info-circle"></i> {pricingData.visaInfo}</p>
                                            </div>
                                        )}
                                    </div>
                                </div>
                            </div>
                        </div>
                    )}
                </div>
            </div>
        </section>

        <!-- FAQ and Form Section -->
        <section class="faq-form-section">
            <div class="container">
                <div class="faq-form-layout has-form">
                    {/* FAQ Section */}
                    <section class="faq-section-inline">
                        <div class="faq-section-header">
                            <h2 class="faq-section-title">
                                {lang === 'tr'
                                    ? 'Sık Sorulan Sorular'
                                    : lang === 'de'
                                    ? 'Häufig gestellte Fragen'
                                    : 'Frequently Asked Questions'}
                            </h2>
                            <p class="faq-section-subtitle">
                                {lang === 'tr'
                                    ? `${kurs.data.title} hakkında merak ettiğiniz konular`
                                    : lang === 'de'
                                    ? `Fragen zu ${kurs.data.title}`
                                    : `Questions about ${kurs.data.title}`}
                            </p>
                        </div>
                        
                        <div class="faq-container">
                            {kurs.data.faqs.map(faq => (
                                <div class="faq-item">
                                    <button class="faq-question" onclick="toggleFAQ(this)">
                                        <span>{faq.question}</span>
                                        <i class="fas fa-chevron-down"></i>
                                    </button>
                                    <div class="faq-answer">
                                        <p>{faq.answer}</p>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </section>
                    
                    <section class="demand-form-section-inline" id="bilgi-al-form">
                        <QuoteWizardForm
                            lang={lang}
                            bookingPath={bookingFull}
                            homePath={homePath}
                            embedded
                            instanceSuffix="e"
                        />
                    </section>
                </div>
            </div>
        </section>
    </main>

    <Footer lang={lang} />

    <!-- Success/error modal for form submit -->
    <SuccessModal lang={lang} />

    <CookieConsent lang={lang as 'tr' | 'de' | 'en' | 'es'} />

    <QuoteWizardModal lang={lang} />
    <script is:inline>
      document.addEventListener('click', function (e) {
        var el = e.target.closest('[data-open-quote-modal]');
        if (!el) return;
        e.preventDefault();
        if (typeof window.openCampusQuoteModal === 'function') window.openCampusQuoteModal();
      });
    </script>

    <script is:inline src="/script.js"></script>
