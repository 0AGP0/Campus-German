const { lang } = Astro.params;

// Türkçe'de sinav-hazirlik-genel-bakis slug'ını pruefungsvorbereitung-uebersicht sayfasına yönlendir
return Astro.redirect(`/${lang}/kurslar/pruefungsvorbereitung-uebersicht`, 301);
