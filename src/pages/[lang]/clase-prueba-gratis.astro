---
import MainLayout from '../../layouts/MainLayout.astro';
import LevelPlacementTest from '../../components/LevelPlacementTest.astro';
import { placementUi } from '../../data/levelPlacementTest';

export async function getStaticPaths() {
  return [{ params: { lang: 'es' } }];
}

const { lang } = Astro.params;
const ui = placementUi.es;
---

<MainLayout title={ui.title} lang={lang}>
  <LevelPlacementTest lang={lang || 'es'} />
</MainLayout>
