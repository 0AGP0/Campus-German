    },
    en: {
        title: "Free Trial Lesson - Campus German",
        heroTitle: "Get a Free Trial Lesson",
        heroDescription: "Experience our education quality before you start your German learning journey. Join our free trial lesson.",
        formTitle: "Trial Lesson Request",
        formSubtitle: "Please fill out the form below, we will find the best time for you and schedule your trial lesson.",
        formFields: {
