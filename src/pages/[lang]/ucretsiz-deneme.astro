            kvkk: "I accept the Privacy and Cookies Policy."
        },
        levelOptions: {
            beginner: "Beginner (A1)",
            elementary: "Elementary (A2)",
            intermediate: "Intermediate (B1)",
            upperIntermediate: "Upper Intermediate (B2)",
            advanced: "Advanced (C1)",
            notSure: "Not Sure"
        },
        submitButton: "Request Trial Lesson"
    },
    es: {
        title: "Clase de prueba gratuita - Campus German",
        heroTitle: "Solicite una clase de prueba gratuita",
        heroDescription: "Conozca nuestra calidad formativa antes de empezar su curso de alemán. Participe en nuestra clase de prueba gratuita.",
        formTitle: "Solicitud de clase de prueba",
        formSubtitle: "Rellene el formulario, le propondremos el mejor horario y planificaremos su clase de prueba.",
