---
import { getCollection } from 'astro:content';
import MainLayout from '../../../layouts/MainLayout.astro';
import AkademikAlmancaSarmal from '../../../components/AkademikAlmancaSarmal.astro';
import '../../../styles/pages/kurslar.css';
import { coursePricing } from '../../../data/coursePricing';
import { getSimpleCourseStartDates } from '../../../utils/coursePricingHelper';

export async function getStaticPaths() {
    return [
        { params: { lang: 'en' } },
    ];
}

const { lang } = Astro.params;
const simpleStartDates = getSimpleCourseStartDates(lang as 'tr' | 'de' | 'en');

// Slug'dan dil uzantısını temizle (detail sayfa URL'si ile eşleşsin)
function cleanSlug(slug: string): string {
    let clean = slug;
    if (clean.endsWith('-de')) clean = clean.replace(/-de$/, '');
    else if (clean.endsWith('-tr')) clean = clean.replace(/-tr$/, '');
    else if (clean.endsWith('-en')) clean = clean.replace(/-en$/, '');
    else if (clean.endsWith('-es')) clean = clean.replace(/-es$/, '');
    else if (clean.endsWith('de') && clean.length > 2) clean = clean.replace(/de$/, '');
    else if (clean.endsWith('tr') && clean.length > 2) clean = clean.replace(/tr$/, '');
    else if (clean.endsWith('en') && clean.length > 2 && !clean.endsWith('-en')) clean = clean.replace(/en$/, '');
    else if (clean.endsWith('es') && clean.length > 2 && !clean.endsWith('-es')) clean = clean.replace(/es$/, '');
    return clean;
}

// Sınav hazırlık kursları listesi
const allKurslar = await getCollection('kurslar');
const sinavKurslar = allKurslar.filter(kurs => {
    const cleanedSlug = cleanSlug(kurs.slug);
    return kurs.data.lang === lang && 
        (cleanedSlug.startsWith('goethe-') ||
         cleanedSlug.startsWith('testdaf-') ||
         cleanedSlug.startsWith('pruefungsvorbereitung-') ||
         cleanedSlug.startsWith('online-pruefungsvorbereitung') ||
         cleanedSlug.startsWith('fsp-') ||
         cleanedSlug.startsWith('sinav-')) &&
        cleanedSlug !== 'pruefungsvorbereitung-uebersicht' &&
        cleanedSlug !== 'sinav-hazirlik-genel-bakis' &&
        cleanedSlug !== 'exam-preparation-overview';
});

const t = {
