                <p>{lang === 'tr' ? "Başka sorularınız mı var?" : lang === 'de' ? "Haben Sie weitere Fragen?" : "Do you have other questions?"}</p>
                <a href={`/${lang}/${lang === 'tr' ? 'iletisim' : lang === 'de' ? 'kontakt' : 'contact'}`} class="faq-contact-btn">
                    <i class="fas fa-envelope"></i>
                    <span>{lang === 'tr' ? "Bize Ulaşın" : lang === 'de' ? "Kontaktieren Sie uns" : "Contact Us"}</span>
                </a>
            </div>
        </div>
    </section>
</MainLayout>

