                                            <td>{pricing.duration}</td>
                                            <td><strong>{pricing.fullCourse}</strong></td>
                                        </tr>
                                    );
                                })}
                                <tr style="background-color: #e7f3ff;">
                                    <td><strong>{lang === 'tr' ? 'TestDaF / DSH' : 'TestDaF / DSH'}</strong></td>
                                    <td><strong>-</strong></td>
                                    <td><strong>{coursePricing[lang as 'tr' | 'de' | 'en'].examPrep.testdafDsh.lessons}</strong></td>
                                    <td><strong>{coursePricing[lang as 'tr' | 'de' | 'en'].examPrep.testdafDsh.duration}</strong></td>
                                    <td><strong>{coursePricing[lang as 'tr' | 'de' | 'en'].examPrep.testdafDsh.fullCourse}</strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                
                <!-- Kurs Zamanları -->
                <div class="pricing-block">
                    <h3 class="pricing-block-title">{lang === 'tr' ? 'Kurs Zamanları' : lang === 'de' ? 'Kurszeiten' : 'Course Times'}</h3>
                    <p class="lesson-duration-note"><strong>{coursePricing[lang as 'tr' | 'de' | 'en'].lessonInfo}</strong></p>
                    <div class="schedule-grid">
                        <div class="schedule-card">
                            <h4><i class="fas fa-sun"></i> {lang === 'tr' ? 'Sabah Kursları' : lang === 'de' ? 'Vormittagskurse' : 'Morning Courses'}</h4>
                            <div class="schedule-item">
                                <p>{coursePricing[lang as 'tr' | 'de' | 'en'].schedule.morning.all.time}</p>
                                <p class="schedule-break">{coursePricing[lang as 'tr' | 'de' | 'en'].schedule.morning.all.break}</p>
                                <p class="schedule-lessons">{coursePricing[lang as 'tr' | 'de' | 'en'].schedule.morning.all.lessons}</p>
                            </div>
                        </div>
                        <div class="schedule-card">
                            <h4><i class="fas fa-moon"></i> {lang === 'tr' ? 'Öğleden Sonra Kursları' : lang === 'de' ? 'Nachmittagskurse' : 'Afternoon Courses'}</h4>
                            <div class="schedule-item">
                                <p>{coursePricing[lang as 'tr' | 'de' | 'en'].schedule.afternoon.all.time}</p>
                                <p class="schedule-break">{coursePricing[lang as 'tr' | 'de' | 'en'].schedule.afternoon.all.break}</p>
                                <p class="schedule-lessons">{coursePricing[lang as 'tr' | 'de' | 'en'].schedule.afternoon.all.lessons}</p>
                            </div>
                        </div>
                        <div class="schedule-card">
                            <h4><i class="fas fa-cloud-moon"></i> {lang === 'tr' ? 'Akşam Kursları' : lang === 'de' ? 'Abendkurse' : 'Evening Courses'}</h4>
                            <div class="schedule-item">
                                <p>{coursePricing[lang as 'tr' | 'de' | 'en'].schedule.evening.all.time}</p>
                                <p class="schedule-break">{coursePricing[lang as 'tr' | 'de' | 'en'].schedule.evening.all.break}</p>
                                <p class="schedule-lessons">{coursePricing[lang as 'tr' | 'de' | 'en'].schedule.evening.all.lessons}</p>
                            </div>
                        </div>
                    </div>
                    <p class="schedule-days"><i class="fas fa-calendar-week"></i> {coursePricing[lang as 'tr' | 'de' | 'en'].schedule.days}</p>
                </div>
                
                <!-- Kurs Başlangıç Tarihleri -->
                <div class="pricing-block">
                    <h3 class="pricing-block-title">{lang === 'tr' ? 'Kurs Tarihlerimiz' : lang === 'de' ? 'Unsere Kurstermine' : 'Our Course Dates'}</h3>
                    <p class="pricing-subtitle">{lang === 'tr' ? 'Kurslara kayıt aşağıdaki tarihlerde açılır.' : lang === 'de' ? 'Die Kursanmeldung öffnet an den folgenden Terminen.' : 'Course registration opens on the following dates.'}</p>
                    <div class="course-dates-badges">
                        {simpleStartDates.map((dateStr) => (
                            <span class="course-date-badge">{dateStr} 2026</span>
                        ))}
                    </div>
                </div>
                
                <!-- Tatiller -->
                <div class="pricing-block">
                    <h3 class="pricing-block-title">{lang === 'tr' ? 'Tatiller 2026' : lang === 'de' ? 'Feiertage 2026' : 'Holidays 2026'}</h3>
                    <div class="holidays-list">
                        {coursePricing[lang as 'tr' | 'de' | 'en'].holidays.map(holiday => (
                            <div class="holiday-item">
                                <span class="holiday-name">{holiday.name}</span>
                                <span class="holiday-date">{holiday.date}</span>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Dil Seviyeleri Section -->
    <section class="language-levels-section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">{lang === 'tr' ? "Dil Seviyeleri A1 – C1" : lang === 'de' ? "Sprachniveaus A1 – C1" : "Language Levels A1 – C1"}</h2>
                <p class="section-subtitle">{lang === 'tr' ? "Almanya'da A1 Almanca Kursları ve çok daha fazlası!" : lang === 'de' ? "A1 Deutschkurse in Deutschland und vieles mehr!" : "A1 German Courses in Germany and much more!"}</p>
            </div>
            
            <div class="levels-content">
                <div class="levels-text">
                    <p class="levels-description">
                        {lang === 'tr'
                            ? "İlk kurs gününüzde seviye belirleme sınavı yapacaksınız, ardından size en uygun seviyedeki sınıfa katılacaksınız. Okuma, dinleme, yazma ve konuşma olmak üzere dört dil becerisi, Avrupa Ortak Dil Referans Çerçevesi (CEFR) standartlarına göre ölçülür ve seviyeleri şu şekilde yapılandırılmıştır:"
                            : lang === 'de' ? "Am ersten Kurstag machen Sie einen Einstufungstest und nehmen dann an der Klasse teil, die Ihrem Niveau am besten entspricht. Die vier Sprachfertigkeiten Lesen, Hören, Schreiben und Sprechen werden nach den Standards des Gemeinsamen Europäischen Referenzrahmens (CEFR) gemessen und die Niveaus sind wie folgt strukturiert:"
                            : "On your first course day, you will take a placement test and then join the class that best suits your level. The four language skills of reading, listening, writing and speaking are measured according to the Common European Framework of Reference (CEFR) standards and the levels are structured as follows:"}
                    </p>
                    
                    <div class="levels-info">
                        <div class="level-group">
                            <h3>A1 ve A2</h3>
                            <p>{lang === 'tr' ? "Başlangıç ve temel seviye" : lang === 'de' ? "Anfänger- und Grundstufe" : "Beginner and basic level"}</p>
                        </div>
                        <div class="level-group">
                            <h3>B1 ve B2</h3>
                            <p>{lang === 'tr' ? "Orta öncesi ve orta seviye" : lang === 'de' ? "Mittelstufe und obere Mittelstufe" : "Pre-intermediate and intermediate level"}</p>
                        </div>
                        <div class="level-group">
                            <h3>C1</h3>
                            <p>{lang === 'tr' ? "Üst orta/ileri seviye" : lang === 'de' ? "Obere Mittelstufe/Fortgeschrittene" : "Upper intermediate/advanced level"}</p>
                        </div>
                    </div>
                    
                    <p class="levels-description">
                        {lang === 'tr'
                            ? "Genel kural olarak, her seviye için 8 hafta hesaplıyoruz; B2 ve C1 için genellikle 12 hafta veya daha fazla sürer."
                            : lang === 'de' ? "Als allgemeine Regel rechnen wir 8 Wochen für jedes Niveau; für B2 und C1 dauert es normalerweise 12 Wochen oder länger."
                            : "As a general rule, we calculate 8 weeks for each level; for B2 and C1 it usually takes 12 weeks or more."}
                    </p>
                    
                    <p class="levels-description">
                        {lang === 'tr'
                            ? "Almanca kursunuzu başarıyla tamamladıktan sonra, seviyenize uygun bir sertifika alacaksınız (örneğin A2, B1, vb.)."
                            : lang === 'de' ? "Nach erfolgreichem Abschluss Ihres Deutschkurses erhalten Sie ein Zertifikat, das Ihrem Niveau entspricht (z.B. A2, B1 usw.)."
                            : "After successfully completing your German course, you will receive a certificate appropriate to your level (e.g. A2, B1, etc.)."}
                    </p>
                    
                    <p class="levels-description">
                        {lang === 'tr'
                            ? "Seviyelerin detaylı açıklamasını burada bulabilirsiniz: "
                            : lang === 'de' ? "Eine detaillierte Beschreibung der Niveaus finden Sie hier: "
                            : "You can find a detailed description of the levels here: "}
                        <a href="#" class="cefr-link">CEFR global scale</a>
                    </p>
                </div>
                
                <div class="levels-visual">
                    <div class="levels-pyramid">
                        <div class="level-c2">
                            <div class="level-content">
                                <h4>C2</h4>
                                <p>Mastery</p>
                            </div>
                        </div>
                        <div class="level-c1">
                            <div class="level-content">
                                <h4>C1</h4>
                                <p>{lang === 'tr' ? "Etkili Operasyonel Yeterlilik" : lang === 'de' ? "Effective Operational Proficiency" : "Effective Operational Proficiency"}</p>
                                <span class="level-duration">12+ {lang === 'tr' ? "hafta" : lang === 'de' ? "Wochen" : "weeks"}</span>
                            </div>
                        </div>
                        <div class="level-b2">
                            <div class="level-content">
                                <h4>B2</h4>
                                <p>Vantage</p>
                                <span class="level-duration">12 {lang === 'tr' ? "hafta" : lang === 'de' ? "Wochen" : "weeks"}</span>
                            </div>
                        </div>
                        <div class="level-b1">
                            <div class="level-content">
                                <h4>B1</h4>
                                <p>Threshold</p>
                                <span class="level-duration">8 {lang === 'tr' ? "hafta" : lang === 'de' ? "Wochen" : "weeks"}</span>
                            </div>
                        </div>
                        <div class="level-a2">
                            <div class="level-content">
                                <h4>A2</h4>
                                <p>Waystage</p>
                                <span class="level-duration">8 {lang === 'tr' ? "hafta" : lang === 'de' ? "Wochen" : "weeks"}</span>
                            </div>
                        </div>
                        <div class="level-a1">
                            <div class="level-content">
                                <h4>A1</h4>
                                <p>Breakthrough</p>
                                <span class="level-duration">8 {lang === 'tr' ? "hafta" : lang === 'de' ? "Wochen" : "weeks"}</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="levels-legend">
                        <div class="legend-item">
                            <div class="legend-color beginner"></div>
                            <span>{lang === 'tr' ? "Başlangıç Seviyesi" : lang === 'de' ? "Anfängerniveau" : "Beginner Level"}</span>
                        </div>
                        <div class="legend-item">
                            <div class="legend-color intermediate"></div>
                            <span>{lang === 'tr' ? "Orta Seviye" : lang === 'de' ? "Mittleres Niveau" : "Intermediate Level"}</span>
                        </div>
                        <div class="legend-item">
                            <div class="legend-color advanced"></div>
                            <span>{lang === 'tr' ? "İleri Seviye" : lang === 'de' ? "Fortgeschrittenes Niveau" : "Advanced Level"}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <!-- CampusGerman Hizmetleri Section -->
    <section class="campusgerman-services-section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">{lang === 'tr' ? "CampusGerman Hizmetleri" : lang === 'de' ? "CampusGerman Dienstleistungen" : "CampusGerman Services"}</h2>
                <p class="section-subtitle">{lang === 'tr' ? "Almanca öğrenme yolculuğunuzda yanınızdayız" : lang === 'de' ? "Wir sind an Ihrer Seite auf Ihrer Reise zum Deutschlernen" : "We are by your side on your German learning journey"}</p>
            </div>
            
            <div class="services-grid">
