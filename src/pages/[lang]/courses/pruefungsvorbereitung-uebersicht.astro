                    <div class="pricing-table-wrapper">
                        <table class="pricing-table">
                            <thead>
                                <tr>
                                    <th>{lang === 'tr' ? 'Sınav Tipi' : lang === 'de' ? 'Prüfungstyp' : 'Exam Type'}</th>
                                    <th>{lang === 'tr' ? 'Seviye' : lang === 'de' ? 'Niveau' : 'Level'}</th>
                                    <th>{lang === 'tr' ? 'Ders Sayısı' : lang === 'de' ? 'Unterrichtsstunden' : 'Lessons'}</th>
                                    <th>{lang === 'tr' ? 'Süre' : lang === 'de' ? 'Dauer' : 'Duration'}</th>
                                    <th>{lang === 'tr' ? 'Fiyat' : lang === 'de' ? 'Preis' : 'Price'}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {(['a1', 'a2', 'b1', 'b2', 'c1'] as const).map(level => {
