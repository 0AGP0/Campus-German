        </div>
    </section>
    
    <!-- Fiyatlar ve Tarihler Section -->
    <section class="pricing-dates-section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">{lang === 'tr' ? 'Fiyatlar ve Tarihler' : lang === 'de' ? 'Preise und Termine' : 'Prices and Dates'}</h2>
