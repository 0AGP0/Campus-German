        title: "Almanca Sınav Hazırlık Kursları Genel Bakış - CampusGerman",
        heroTitle: "Almanca Sınav Hazırlık Kursları",
        heroDescription1: "Goethe, TELC, TestDaF ve DSH sınavlarına hazırlık. Sınav odaklı eğitim ve başarı garantisi.",
        heroDescription2: "Sınav formatına özel hazırlık, deneme sınavları ve sınav teknikleri ile başarılı olun.",
        buttonText1: "Kursları İncele",
        buttonText2: "İletişime Geç",
        ctaCardTitle: "Sınav Hazırlık Kurslarımızı Keşfedin",
        ctaCardDescription: "Goethe, TELC, TestDaF ve DSH sınavlarına hazırlık.",
        stat1Number: "7+",
        stat1Label: "Kurs",
        stat2Number: "%95+",
        stat2Label: "Başarı",
        stat3Number: "8-12",
        stat3Label: "Hafta",
        allCoursesButton: "Tüm Kursları Görüntüle",
        sectionTitle: "Sınav Hazırlık Kurslarımız",
        sectionSubtitle: "Sınav odaklı eğitim ve başarı garantisi",
        courseDetail1: "İnteraktif Eğitim Akıllı Tahta ile",
        courseDetail2: "Ek Modüler Yapı Desteği",
    },
    de: {
        title: "Übersicht Prüfungsvorbereitung - CampusGerman",
        heroTitle: "Deutsch Prüfungsvorbereitungskurse",
        heroDescription1: "Vorbereitung auf Goethe, TELC, TestDaF und DSH Prüfungen. Prüfungsorientierte Ausbildung und Erfolgsgarantie.",
        heroDescription2: "Erfolgreich sein mit prüfungsspezifischer Vorbereitung, Probeprüfungen und Prüfungstechniken.",
        buttonText1: "Kurse entdecken",
        buttonText2: "Kontakt aufnehmen",
        ctaCardTitle: "Entdecken Sie unsere Prüfungsvorbereitungskurse",
        ctaCardDescription: "Vorbereitung auf Goethe, TELC, TestDaF und DSH Prüfungen.",
        stat1Number: "7+",
        stat1Label: "Kurs",
        stat2Number: "95%+",
        stat2Label: "Erfolg",
        stat3Number: "8-12",
        stat3Label: "Wochen",
        allCoursesButton: "Alle Kurse anzeigen",
        sectionTitle: "Unsere Prüfungsvorbereitungskurse",
        sectionSubtitle: "Prüfungsorientierte Ausbildung und Erfolgsgarantie",
        courseDetail1: "Interaktive Ausbildung mit Smartboard",
        courseDetail2: "und modulare Strukturunterstützung",
    },
    en: {
        title: "German Exam Preparation Courses Overview - CampusGerman",
        heroTitle: "German Exam Preparation Courses",
        heroDescription1: "Preparation for Goethe, TELC, TestDaF and DSH exams. Exam-focused training and comprehensive preparation.",
        heroDescription2: "Succeed with exam format-specific preparation, practice tests and exam techniques.",
        buttonText1: "Browse Courses",
        buttonText2: "Contact Us",
        ctaCardTitle: "Discover Our Exam Preparation Courses",
        ctaCardDescription: "Preparation for Goethe, TELC, TestDaF and DSH exams.",
        stat1Number: "7+",
        stat1Label: "Courses",
        stat2Number: "95%+",
        stat2Label: "Success",
        stat3Number: "8-12",
        stat3Label: "Weeks",
        allCoursesButton: "View All Courses",
        sectionTitle: "Our Exam Preparation Courses",
        sectionSubtitle: "Exam-focused training and comprehensive preparation",
        courseDetail1: "Interactive Education with Smart Board",
        courseDetail2: "and Additional Modular Structure Support",
    }
};

const translations = t[lang as keyof typeof t];
---

<MainLayout title={translations.title} lang={lang}>
    <!-- Hero Section -->
    <section class="courses-hero-section">
        <div class="container">
            <div class="courses-hero-content">
                <div class="hero-left">
                    <h1 class="hero-title">
                        {translations.heroTitle}
                    </h1>
                    
                    <div class="hero-content">
                        <p class="hero-description">
                            {translations.heroDescription1}
                        </p>
                        
                        <p class="hero-description">
                            {translations.heroDescription2}
                        </p>
                    </div>
                    
                    <div class="hero-actions">
                        <a href="#kurs-kartlari" class="btn-primary">
                            <i class="fas fa-arrow-down"></i>
                            {translations.buttonText1}
                        </a>
                        <button class="btn-secondary" id="contactBtn">
                            <i class="fas fa-envelope"></i>
                            {translations.buttonText2}
                        </button>
                    </div>
                </div>
                
                <div class="hero-right">
                    <div class="hero-cta-card">
                        <div class="cta-icon">
                            <i class="fas fa-certificate"></i>
                        </div>
                        <h3 class="cta-title">{translations.ctaCardTitle}</h3>
                        <p class="cta-description">
                            {translations.ctaCardDescription}
                        </p>
                        <div class="cta-stats">
                            <div class="cta-stat">
                                <div class="stat-number">{translations.stat1Number}</div>
                                <div class="stat-label">{translations.stat1Label}</div>
                            </div>
                            <div class="cta-stat">
                                <div class="stat-number">{translations.stat2Number}</div>
                                <div class="stat-label">{translations.stat2Label}</div>
                            </div>
                            <div class="cta-stat">
                                <div class="stat-number">{translations.stat3Number}</div>
                                <div class="stat-label">{translations.stat3Label}</div>
                            </div>
                        </div>
                        <a href="#kurs-kartlari" class="cta-button">
                            <i class="fas fa-arrow-down"></i>
                            {translations.allCoursesButton}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Campus German Akademik Almanca Sarmalı -->
    <AkademikAlmancaSarmal lang={lang} />
    
    <!-- Kurs Kartları Section -->
    <section class="courses-section" id="kurs-kartlari">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">{translations.sectionTitle}</h2>
                <p class="section-subtitle">{translations.sectionSubtitle}</p>
            </div>
            
            <div class="courses-grid">
                {sinavKurslar.map(kurs => (
                    <div class="course-card">
                        <div class="course-image">
                            <img src={kurs.data.image} alt={kurs.data.title}>
                        </div>
                        <div class="course-content">
                            <h3 class="course-title">{kurs.data.title}</h3>
                            <div class="course-details">
                                <div class="course-detail">
                                    <i class="fas fa-chalkboard-teacher"></i>
                                    <span>{translations.courseDetail1}</span>
                                </div>
                                <div class="course-detail">
                                    <i class="fas fa-layer-group"></i>
                                    <span>{translations.courseDetail2}</span>
                                </div>
                            </div>
                            <p class="course-description">
                                {kurs.data.description}
                            </p>
                            <a href={`/${lang}/${lang === 'tr' ? 'kurslar' : lang === 'de' ? 'kurse' : 'courses'}/${kurs.data.customSlug ?? cleanSlug(kurs.slug)}`} class="course-btn">
