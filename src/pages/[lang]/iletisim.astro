    de: {
        title: "Kontakt - Campus German",
        heroTitleMain: "Kontakt",
        heroTitleHighlight: "Informationen",
        heroDescription: "Nehmen Sie Kontakt mit Campus German auf. Unsere Fachberater sind bereit, Ihnen zu helfen.",
        mapTitle: "Unser Standort",
        mapLinkText: "In Karte öffnen",
        addressTitle: "Adresse",
        addressLine: "Bürgermeister Smidt Straße 80, 28195 Bremen",
        fromGermany: "Aus Deutschland",
        fromOtherCountries: "Aus dem Ausland",
        nameCihan: "Herr Karabag",
        karabagLangs: "Englisch und Deutsch",
