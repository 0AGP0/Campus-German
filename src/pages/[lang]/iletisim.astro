const translations = t[lang as keyof typeof t];
---

<MainLayout title={translations.title} lang={lang}>
    <div class="contact-page">
        <header class="contact-hero">
            <div class="contact-hero__inner">
                <h1 class="contact-hero__title">
                    <span class="contact-hero__title-main">{translations.heroTitleMain}</span>
                    <span class="contact-hero__title-accent">{translations.heroTitleHighlight}</span>
                </h1>
                <p class="contact-hero__desc">{translations.heroDescription}</p>
            </div>
        </header>

        <main class="contact-main">
            <div class="contact-main__inner">
                <div class="contact-main__grid">
                    <aside class="contact-aside">
                        <div class="contact-card">
                            <dl class="contact-list">
                                <div class="contact-list__row">
                                    <dt class="contact-list__term">{translations.addressTitle}</dt>
                                    <dd class="contact-list__value">
                                        <p>{translations.addressLine}</p>
                                        <a href={MAP_LINK_URL} target="_blank" rel="noopener noreferrer" class="contact-list__link">{translations.mapLinkText}</a>
                                    </dd>
                                </div>
                                <div class="contact-list__phones">
                                    <div class="contact-list__row contact-list__row--phone">
                                        <dt class="contact-list__term">{translations.fromGermany}</dt>
                                        <dd class="contact-list__value">
                                            <a href="tel:+4915225227769" class="contact-list__tel">+49 1522 5227769</a>
                                            <span class="contact-list__name">{translations.nameCihan}</span>
                                            <p class="contact-list__role">{translations.karabagRole}</p>
                                            <div class="contact-list__lang-row">
                                                <span class="contact-list__flags" aria-hidden="true">
                                                    <img src="https://flagcdn.com/w40/gb.png" alt="" width="20" height="14" loading="lazy" />
                                                    <img src="https://flagcdn.com/w40/de.png" alt="" width="20" height="14" loading="lazy" />
                                                </span>
                                                <span class="contact-list__meta">{translations.karabagLangs}</span>
                                            </div>
                                            <div class="contact-list__actions">
                                                <a href="tel:+4915225227769" class="contact-btn contact-btn--call" aria-label="Ara"><i class="fas fa-phone-alt"></i></a>
                                                <a href="https://wa.me/4915225227769" target="_blank" rel="noopener noreferrer" class="contact-btn contact-btn--wa"><i class="fab fa-whatsapp"></i><span>{translations.chatWhatsApp}</span></a>
                                            </div>
                                        </dd>
                                    </div>
                                    <div class="contact-list__row contact-list__row--phone">
                                        <dt class="contact-list__term">{translations.fromOtherCountries}</dt>
                                        <dd class="contact-list__value">
                                            <a href="tel:+4915203823792" class="contact-list__tel">+49 1520 382 3792</a>
                                            <span class="contact-list__name">{translations.nameUser}</span>
                                            <p class="contact-list__role">{translations.akmanRole}</p>
                                            <div class="contact-list__lang-row">
                                                <span class="contact-list__flags" aria-hidden="true">
                                                    <img src="https://flagcdn.com/w40/gb.png" alt="" width="20" height="14" loading="lazy" />
                                                    <img src="https://flagcdn.com/w40/es.png" alt="" width="20" height="14" loading="lazy" />
                                                    <img src="https://flagcdn.com/w40/fr.png" alt="" width="20" height="14" loading="lazy" />
                                                    <img src="https://flagcdn.com/w40/kr.png" alt="" width="20" height="14" loading="lazy" />
                                                    <img src="https://flagcdn.com/w40/tr.png" alt="" width="20" height="14" loading="lazy" />
                                                </span>
                                                <span class="contact-list__meta">{translations.akmanLangs}</span>
                                            </div>
                                            <div class="contact-list__actions">
                                                <a href="tel:+4915203823792" class="contact-btn contact-btn--call" aria-label="Ara"><i class="fas fa-phone-alt"></i></a>
                                                <a href="https://wa.me/4915203823792" target="_blank" rel="noopener noreferrer" class="contact-btn contact-btn--wa"><i class="fab fa-whatsapp"></i><span>{translations.chatWhatsApp}</span></a>
                                            </div>
                                        </dd>
                                    </div>
                                </div>
                                <div class="contact-list__row">
                                    <dt class="contact-list__term">{translations.emailTitle}</dt>
                                    <dd class="contact-list__value">
                                        <p><a href="mailto:info@campusgerman.com">info@campusgerman.com</a> <span class="contact-list__muted">({translations.emailForInfo})</span></p>
                                        <p><a href="mailto:partner@campusgerman.com">partner@campusgerman.com</a> <span class="contact-list__muted">({translations.emailForPartner})</span></p>
                                    </dd>
                                </div>
                                <div class="contact-list__row">
                                    <dt class="contact-list__term">{translations.workingHoursTitle}</dt>
                                    <dd class="contact-list__value">
                                        <p>{translations.workingHours.weekdays}</p>
                                        <p>{translations.workingHours.saturday}</p>
                                        <p>{translations.workingHours.sunday}</p>
                                    </dd>
                                </div>
                            </dl>
                        </div>
                        <div class="contact-social">
                            <p class="contact-social__title">{translations.socialTitle}</p>
                            <div class="contact-social__list">
                                <a href="#" class="contact-social__item" aria-label="Facebook"><i class="fab fa-facebook-f"></i><span>Facebook</span></a>
                                <a href="#" class="contact-social__item" aria-label="Instagram"><i class="fab fa-instagram"></i><span>Instagram</span></a>
                                <a href="#" class="contact-social__item" aria-label="YouTube"><i class="fab fa-youtube"></i><span>YouTube</span></a>
                                <a href="#" class="contact-social__item" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i><span>LinkedIn</span></a>
                                <a href="https://wa.me/4915203823792" target="_blank" rel="noopener noreferrer" class="contact-social__item" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i><span>WhatsApp</span></a>
                            </div>
                        </div>
                    </aside>

                    <div class="contact-form-area">
                        <div class="contact-form-box">
                            <h2 class="contact-form-box__title">{translations.formTitle}</h2>
                            <p class="contact-form-box__subtitle">{translations.formSubtitle}</p>
                            <BilgiAlForm lang={lang} formTitle={false} formSubtitle={false} />
                        </div>

                        <section class="contact-map" aria-label={translations.mapTitle}>
                            <h2 class="contact-map__title">{translations.mapTitle}</h2>
                            <div class="contact-map__frame">
                                <iframe
                                    title={translations.mapTitle}
                                    src={MAP_EMBED_URL}
                                    loading="lazy"
                                    referrerpolicy="no-referrer-when-downgrade"
                                />
                            </div>
                            <a href={MAP_LINK_URL} target="_blank" rel="noopener noreferrer" class="contact-map__link">
                                <i class="fas fa-external-link-alt" aria-hidden="true"></i>
                                {translations.mapLinkText}
                            </a>
                        </section>
                    </div>
                </div>
            </div>
        </main>
    </div>
</MainLayout>
