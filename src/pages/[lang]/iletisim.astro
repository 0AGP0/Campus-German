---
import MainLayout from '../../layouts/MainLayout.astro';
import BilgiAlForm from '../../components/BilgiAlForm.astro';
import ContactOfficeCard from '../../components/ContactOfficeCard.astro';
import '../../styles/pages/kontakt.css';

export async function getStaticPaths() {
    return [{ params: { lang: 'tr' } }];
}

const { lang } = Astro.params;

const MAP_EMBED_URL = 'https://www.openstreetmap.org/export/embed.html?bbox=8.800%2C53.073%2C8.814%2C53.081&layer=mapnik&marker=53.077%2C8.806';
const MAP_LINK_URL = 'https://www.google.com/maps/search/?api=1&query=B%C3%BCrgermeister+Smidt+Stra%C3%9Fe+80%2C+28195+Bremen';
const WA_INTL = 'https://wa.me/4915203823792';

const t = {
    title: 'İletişim - Campus German',
    heroTitleMain: 'İletişim',
    heroTitleHighlight: 'Bilgileri',
    heroDescription: 'Campus German ofisiyle iletişime geçin — sorularınız için buradayız.',
    mapTitle: 'Konumumuz',
    mapLinkText: 'Haritada aç',
    socialTitle: 'Sosyal medya',
    formTitle: 'Bilgi Al',
    formSubtitle: 'Formu doldurun, en kısa sürede dönüş yapalım.',
};
---

<MainLayout title={t.title} lang={lang}>
    <div class="contact-page">
        <header class="contact-hero">
            <div class="contact-hero__inner">
                <h1 class="contact-hero__title">
                    <span class="contact-hero__title-main">{t.heroTitleMain}</span>
                    <span class="contact-hero__title-accent">{t.heroTitleHighlight}</span>
                </h1>
                <p class="contact-hero__desc">{t.heroDescription}</p>
            </div>
        </header>

        <main class="contact-main">
            <div class="contact-main__inner">
                <div class="contact-main__grid">
                    <aside class="contact-aside">
                        <ContactOfficeCard lang={lang!} mapLinkUrl={MAP_LINK_URL} />

                        <div class="contact-social">
                            <p class="contact-social__title">{t.socialTitle}</p>
                            <div class="contact-social__list">
                                <a href="https://www.facebook.com/campusgermanbremen/" target="_blank" rel="noopener noreferrer" class="contact-social__item" aria-label="Facebook"><i class="fab fa-facebook-f"></i><span>Facebook</span></a>
                                <a href="https://www.instagram.com/campus.german/" target="_blank" rel="noopener noreferrer" class="contact-social__item" aria-label="Instagram"><i class="fab fa-instagram"></i><span>Instagram</span></a>
                                <a href="https://www.linkedin.com/company/campusgerman" target="_blank" rel="noopener noreferrer" class="contact-social__item" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i><span>LinkedIn</span></a>
                                <a href={WA_INTL} target="_blank" rel="noopener noreferrer" class="contact-social__item" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i><span>WhatsApp</span></a>
                            </div>
                        </div>
                    </aside>

                    <div class="contact-form-area">
                        <div class="contact-form-box">
                            <h2 class="contact-form-box__title">{t.formTitle}</h2>
                            <p class="contact-form-box__subtitle">{t.formSubtitle}</p>
                            <BilgiAlForm lang={lang} formTitle={false} formSubtitle={false} />
                        </div>

                        <section class="contact-map" aria-label={t.mapTitle}>
                            <h2 class="contact-map__title">{t.mapTitle}</h2>
                            <div class="contact-map__frame">
                                <iframe title={t.mapTitle} src={MAP_EMBED_URL} loading="lazy" referrerpolicy="no-referrer-when-downgrade" />
                            </div>
                            <a href={MAP_LINK_URL} target="_blank" rel="noopener noreferrer" class="contact-map__link">
                                <i class="fas fa-external-link-alt" aria-hidden="true"></i>
                                {t.mapLinkText}
                            </a>
                        </section>
                    </div>
                </div>
            </div>
        </main>
    </div>
</MainLayout>
