                                                    <label for="first-name">{translations.firstName} *</label>
                                                    <input type="text" id="first-name" name="first_name" required class="booking-text-input" placeholder={translations.firstNamePlaceholder}>
                                                </div>
                                                <div class="form-group">
                                                    <label for="last-name">{translations.lastName} *</label>
                                                    <input type="text" id="last-name" name="last_name" required class="booking-text-input" placeholder={translations.lastNamePlaceholder}>
                                                </div>
                                                <div class="form-group form-group--phone">
                                                    <label for="phone">{translations.phoneLabel} *</label>
                                                    <div class="phone-input-wrap phone-input-wrap--dial">
                                                        <div class="phone-dial-field">
                                                            <img
                                                                id="phone-dial-flag"
                                                                class="phone-dial-flag"
                                                                src={`https://flagcdn.com/w40/${defaultPhoneCountry.iso}.png`}
                                                                alt=""
                                                                width="20"
                                                                height="14"
                                                                loading="lazy"
                                                            />
                                                            <input
                                                                type="text"
                                                                id="phone-country-code"
                                                                name="phone-country-code"
                                                                class="booking-text-input phone-dial-input"
                                                                value={defaultPhoneCountry.dial}
                                                                placeholder={translations.phoneDialPlaceholder}
                                                                inputmode="tel"
                                                                autocomplete="tel-country-code"
                                                                aria-label={translations.phoneDialLabel}
                                                                required
                                                            />
                                                        </div>
                                                        <input type="tel" id="phone" name="phone" required class="booking-text-input phone-number-input" placeholder={translations.phonePlaceholder} autocomplete="tel-national">
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <label for="email">{translations.emailLabel} *</label>
                                                    <input type="email" id="email" name="email" required class="booking-text-input" placeholder={translations.emailPlaceholder}>
                                                </div>
                                                <div class="form-group">
                                                    <label for="address">{translations.addressLine}</label>
                                                    <input type="text" id="address" name="address" class="booking-text-input" placeholder={translations.addressLinePlaceholder} autocomplete="street-address">
