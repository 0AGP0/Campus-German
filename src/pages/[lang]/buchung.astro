import MainLayout from '../../layouts/MainLayout.astro';
import BookingExtrasStep from '../../components/BookingExtrasStep.astro';
import '../../styles/pages/buchung.css';
import { coursePricing } from '../../data/coursePricing.ts';
import { getFirstMondayStartDateOptions, PROMO_PRICE, LESSONS_UP_TO_200, ONLINE_LEVEL_PRICES, parseDdMmYyyy, snapToNearestMonday, getCourseEndFriday, formatCourseDateRange } from '../../utils/coursePricingHelper';
import {
    RESERVATION_DEPOSIT_EUR,
    BALANCE_DUE_DAYS,
    FULL_PAYMENT_DISCOUNT_EUR,
    STRIPE_EXTRAS,
    STRIPE_ADJUST_PRODUCT,
    TELC_PREP_EUR,
    TELC_PREP_WEEKS,
} from '../../data/stripeCatalog';
export async function getStaticPaths() {
    return [
        { params: { lang: 'tr' } },
        { params: { lang: 'de' } },
        { params: { lang: 'en' } },
        { params: { lang: 'es' } },
    ];
}

const { lang } = Astro.params;
const pricingData = coursePricing[lang === 'es' ? 'de' : (lang as 'tr' | 'de' | 'en')];
const pricingLang = lang === 'es' ? 'de' : (lang as 'tr' | 'de' | 'en');
const startDateOptions = getFirstMondayStartDateOptions(lang as 'tr' | 'de' | 'en' | 'es', 10);
const nearestStartDateValue = startDateOptions[0]?.value ?? '';
const defaultCourseStart = (() => {
    const raw = nearestStartDateValue ? parseDdMmYyyy(nearestStartDateValue) : null;
    return raw ? snapToNearestMonday(raw) : null;
})();
const defaultCourseEnd = defaultCourseStart ? getCourseEndFriday(defaultCourseStart, 8) : null;
const defaultCourseRangeLabel =
    defaultCourseStart && defaultCourseEnd
        ? formatCourseDateRange(defaultCourseStart, defaultCourseEnd, lang as 'tr' | 'de' | 'en' | 'es')
        : '';
const defaultTelcEnd = defaultCourseStart ? getCourseEndFriday(defaultCourseStart, TELC_PREP_WEEKS) : null;
const defaultTelcRangeLabel =
    defaultCourseStart && defaultTelcEnd
        ? formatCourseDateRange(defaultCourseStart, defaultTelcEnd, lang as 'tr' | 'de' | 'en' | 'es')
        : '';
const termsPath = `/agb/`;
const privacyPath = `/datenschutz/`;
const widerrufPath = `/widerrufsbelehrung/`;

/** Form checkbox metinleri sayfa dilinde; linkler Almanca kök sayfalara gider */
