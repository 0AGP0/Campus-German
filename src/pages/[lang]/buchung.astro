                    es: { 'bremen': 'Bremen', 'online': 'Online', 'hybrid': 'Hybrid' }
                };
                
                const currentLang = lang || 'tr';
                const t = courseTypeNames[currentLang] || courseTypeNames.tr;
                const s = schoolNames[currentLang] || schoolNames.tr;
                
                // Summary labels translation
                const summaryLabels = {
                    tr: {
