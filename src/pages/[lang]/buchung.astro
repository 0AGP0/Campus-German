            function updateLevelSummary() {
                const emptyEl = document.getElementById('level-summary-empty');
                const bodyEl = document.getElementById('level-summary-body');
                const titleEl = document.getElementById('level-summary-title');
                const metaEl = document.getElementById('level-summary-meta');
                const levelsEl = document.getElementById('level-summary-levels');
                if (!emptyEl || !bodyEl || !titleEl || !metaEl || !levelsEl) return;

                const program = document.querySelector('[name="program"]:checked')?.value;
                const isOnline = program === 'online';
                const unsure = document.getElementById('course-unsure-cb');
                const ordered = getOrderedSelectedCourses();
                const hasUnsure = !!(unsure && unsure.checked);
                const hasSelection = ordered.length > 0 || hasUnsure;

                titleEl.textContent = isOnline ? levelSummaryCopy.titleOnline : levelSummaryCopy.title;
                if (metaEl) {
                    metaEl.textContent = isOnline ? levelSummaryCopy.metaOnline : levelSummaryCopy.meta;
                    metaEl.hidden = true;
                }

                if (!hasSelection) {
                    emptyEl.hidden = false;
                    bodyEl.hidden = true;
                    levelsEl.replaceChildren();
                    return;
                }

                emptyEl.hidden = true;
                bodyEl.hidden = false;

                const chips = document.createElement('div');
                chips.className = 'level-summary__chips';
                ordered.forEach(function (cb) {
                    const name = bookingWebhookLabels.courseLevel[cb.value] || String(cb.value).toUpperCase();
                    const period = (window.__bookingCoursePeriods || []).find(function (p) { return p.level === cb.value; });
                    const chip = document.createElement('div');
                    chip.className = 'level-summary__chip';
                    const strong = document.createElement('strong');
                    strong.textContent = name;
                    chip.appendChild(strong);
                    if (period && period.label) {
                        const dates = document.createElement('span');
                        dates.className = 'level-summary__chip-dates';
                        dates.textContent = String(period.label).replace(/\s*→\s*/g, ' – ');
                        chip.appendChild(dates);
                    }
                    chips.appendChild(chip);
                });
                if (hasUnsure) {
                    const chip = document.createElement('div');
                    chip.className = 'level-summary__chip';
                    const strong = document.createElement('strong');
                    strong.textContent = bookingWebhookLabels.courseLevel.unsure;
                    chip.appendChild(strong);
                    chips.appendChild(chip);
                }
                levelsEl.replaceChildren(chips);
                toggleBundleInfobox();
            }

