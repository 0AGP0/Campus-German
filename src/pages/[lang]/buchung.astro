            // Short term seçiliyken diğer kurslar (A1-C1, Telc-Prep) seçilemesin; diğerleri seçilince short term kaldırılsın
            function enforceShortTermExclusion() {
                const program = document.querySelector('[name="program"]:checked')?.value;
                if (program !== 'intensive' && program !== 'online') return;
                const shortTermCb = document.querySelector('[name="course-selection"][value="short-term"]');
                const otherValues = ['a1','a2','b1','b2','c1','telc-prep'];
                const otherCbs = otherValues.map(v => document.querySelector('[name="course-selection"][value="' + v + '"]')).filter(Boolean);
                if (!shortTermCb) return;
                if (shortTermCb.checked) {
                    otherCbs.forEach(cb => { cb.checked = false; cb.disabled = true; });
                } else {
                    otherCbs.forEach(cb => { cb.disabled = false; });
                    const anyOtherChecked = otherCbs.some(cb => cb.checked);
                    if (anyOtherChecked) shortTermCb.checked = false;
                }
            }

            const COURSE_LEVEL_CHAIN_ORDER = ['a1', 'a2', 'b1', 'b2', 'c1', 'telc-prep', 'short-term'];
            /* Kısa, net FLIP: gecikmeyi azalt (önceki ~560ms → ~300ms) */
            const FLIP_EASING = 'cubic-bezier(0.25, 0.46, 0.45, 0.94)';
            const FLIP_DURATION_MS = 260;
            function updateCourseMergeAttributes(container) {
                if (!container) return;
                var labels = Array.from(container.querySelectorAll('label.option-btn'));
                labels.forEach(function (l) {
                    l.removeAttribute('data-merge-pos');
                });
                var checked = labels.filter(function (l) {
                    var i = l.querySelector('input');
                    return i && i.checked;
                });
                if (checked.length < 2) return;
                checked.forEach(function (l, idx) {
                    if (idx === 0) l.setAttribute('data-merge-pos', 'first');
                    else if (idx === checked.length - 1) l.setAttribute('data-merge-pos', 'last');
                    else l.setAttribute('data-merge-pos', 'middle');
                });
            }
            function reorderCourseSelectionChain() {
                const container = document.getElementById('course-levels-buttons');
                if (!container) return;
                const labels = Array.from(container.querySelectorAll('label.option-btn'));
                const reduceMotion = typeof window.matchMedia === 'function' && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                const prevRects = new Map();
                if (!reduceMotion) {
                    labels.forEach(function (el) {
                        const r = el.getBoundingClientRect();
                        prevRects.set(el, { left: r.left, top: r.top });
                    });
                }
                labels.sort(function (a, b) {
                    const ia = a.querySelector('input');
                    const ib = b.querySelector('input');
                    const va = ia ? ia.value : '';
                    const vb = ib ? ib.value : '';
                    const aCh = !!(ia && ia.checked);
                    const bCh = !!(ib && ib.checked);
                    if (aCh !== bCh) return aCh ? -1 : 1;
                    return COURSE_LEVEL_CHAIN_ORDER.indexOf(va) - COURSE_LEVEL_CHAIN_ORDER.indexOf(vb);
                });
                labels.forEach(function (l) {
                    container.appendChild(l);
                });
                const checked = labels.filter(function (l) {
                    const i = l.querySelector('input');
                    return i && i.checked;
                });
                const n = checked.length;
                container.setAttribute('data-selection-count', String(n));
                container.classList.toggle('course-selection-bundle', n >= 2);
                updateCourseMergeAttributes(container);
                if (reduceMotion) return;
                let moved = false;
                labels.forEach(function (el) {
                    const prev = prevRects.get(el);
                    if (!prev) return;
                    const r = el.getBoundingClientRect();
                    const dx = prev.left - r.left;
                    const dy = prev.top - r.top;
                    if (Math.abs(dx) < 0.5 && Math.abs(dy) < 0.5) return;
                    moved = true;
                    el.style.transform = 'translate(' + dx + 'px, ' + dy + 'px)';
                    el.style.transition = 'transform 0s';
                });
                if (!moved) return;
                requestAnimationFrame(function () {
                    requestAnimationFrame(function () {
                        labels.forEach(function (el) {
                            if (!el.style.transform) return;
                            el.style.transition = 'transform ' + FLIP_DURATION_MS + 'ms ' + FLIP_EASING;
                            el.style.transform = 'translate(0, 0)';
                        });
                    });
                });
                window.setTimeout(function () {
                    labels.forEach(function (el) {
                        el.style.transition = '';
                        el.style.transform = '';
                    });
                }, FLIP_DURATION_MS + 40);
            }

