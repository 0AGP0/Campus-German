        onlineLevelPrices: ONLINE_LEVEL_PRICES,
        telcPrepPriceNum: TELC_PREP_EUR,
        telcPrepWeeks: TELC_PREP_WEEKS,
        bookingWebhookLabels,
        reservationDepositEur: RESERVATION_DEPOSIT_EUR,
        fullPaymentDiscountEur: FULL_PAYMENT_DISCOUNT_EUR,
        balanceDueDays: BALANCE_DUE_DAYS,
        stripeExtras: STRIPE_EXTRAS,
        stripeAdjustProduct: STRIPE_ADJUST_PRODUCT,
        payUiCopy: {
            submitQuote: translations.paySubmitQuote,
            submitPay: translations.paySubmitPay,
            submitContinue: translations.paySubmitPay,
            needGermany: translations.payNeedGermany,
            needPlan: translations.payNeedPlan,
            needInstall: translations.payNeedInstall,
            discountTpl: translations.payFullDiscountTpl,
            installNowTpl: translations.payInstallNowTpl,
            installCourseNowTpl: translations.payInstallCourseNowTpl,
        },
        needStartDateMsg: translations.needStartDate,
        nearestStartDateValue,
