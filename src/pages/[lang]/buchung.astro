                            mapCatalogPrices: false,
                            skipWeeksPackage: true,
                            useLineItemAmounts: true,
                            chargeCents: depositInfo.chargeCents,
                            netChargeCents: depositInfo.netChargeCents,
                            stripeFeeCents: depositInfo.stripeFeeCents,
                            totalCents,
                        },

                        customerCollection: null,
                        courseCollection: null,

                        consents: {
                            terms: data['terms-accepted'] === 'yes',
                            privacy: data['privacy-accepted'] === 'yes',
                        },
                    };

                    standardizedData.customerCollection = { ...standardizedData.customer };
                    standardizedData.courseCollection = { ...standardizedData.course };

                    // Sanitize nested fields; keep payment URLs/tokens intact after.
                    standardizedData = sanitizeObject(standardizedData);
                    standardizedData.paymentChoice = paymentChoice;
                    standardizedData.checkoutUiMode = 'embedded';
                    standardizedData.returnUrl =
                        window.location.origin +
                        window.location.pathname +
                        '?payment=success&session_id={CHECKOUT_SESSION_ID}';
                    applyDepositToPayload(standardizedData, depositInfo, payPlan, totalFormatted, totalCents);
                    standardizedData.stripeLineItemsDetail = stripeLineItemsDetail;

                    try {
                        window.__pendingBookingQuotePayload = standardizedData;
                        window.__pendingPayChargeContext = {
                            chargeCalc,
                            payPlan,
                            installOpt,
                            totalFormatted,
                            totalCents,
                        };
                        window.__lastBookingPayPayload = null;
                        const modal = document.getElementById('bk-quote-pay-modal');
                        const stepChoice = document.getElementById('bk-quote-pay-step-choice');
                        const stepChannel = document.getElementById('bk-quote-pay-step-channel');
                        if (stepChoice) stepChoice.hidden = false;
                        if (stepChannel) stepChannel.hidden = true;
                        if (modal) modal.hidden = false;
                        else {
                            await postBookingWebhook(standardizedData);
                            clearPendingBookingPayloads();
                            showBookingThankYou();
                        }
                    } catch (error) {
                        console.error('Error preparing booking:', error);
                        showBookingError(lang === 'tr'
                            ? 'İşlem tamamlanamadı. Lütfen tekrar deneyin.'
                            : lang === 'de'
                                ? 'Vorgang konnte nicht abgeschlossen werden. Bitte erneut versuchen.'
                                : lang === 'es'
                                    ? 'No se pudo completar. Inténtelo de nuevo.'
                                    : 'Could not complete. Please try again.');
                    }
                });
            }

            (function initQuotePayModal() {
                const modal = document.getElementById('bk-quote-pay-modal');
                const yesBtn = document.getElementById('bk-quote-pay-yes');
                const noBtn = document.getElementById('bk-quote-pay-no');
                const stepChoice = document.getElementById('bk-quote-pay-step-choice');
                const stepChannel = document.getElementById('bk-quote-pay-step-channel');
                const channelBackBtn = document.getElementById('bk-quote-pay-channel-back');
                const channelGoBtn = document.getElementById('bk-quote-pay-channel-go');
                const cardNote = document.getElementById('bk-pay-channel-card-note');
                const bankNote = document.getElementById('bk-pay-channel-bank-note');
                const cardDueEl = document.getElementById('bk-pay-channel-card-due');
                const bankDueEl = document.getElementById('bk-pay-channel-bank-due');

                const eeaNote = document.getElementById('bk-pay-channel-eea-note');
                const cardHint = document.getElementById('bk-pay-channel-card-hint');
                const bankHint = document.getElementById('bk-pay-channel-bank-hint');
                const channelLead = document.getElementById('bk-quote-pay-channel-lead');

                function showModalStep(step) {
                    if (stepChoice) stepChoice.hidden = step !== 'choice';
                    if (stepChannel) stepChannel.hidden = step !== 'channel';
                }

                function closeModal() {
                    if (modal) modal.hidden = true;
                    showModalStep('choice');
                    if (yesBtn) yesBtn.disabled = false;
                    if (noBtn) noBtn.disabled = false;
                    if (channelGoBtn) channelGoBtn.disabled = false;
                    if (channelBackBtn) channelBackBtn.disabled = false;
                }

                function modalRateLimitError() {
                    if (window.showSuccessModal) {
                        window.showSuccessModal('error', window.successModalTranslations?.rateLimitError || 'Çok fazla istek gönderdiniz. Lütfen bir dakika bekleyin.');
                    } else {
                        const rateLimitMsg = lang === 'tr' ? 'Çok fazla istek gönderdiniz. Lütfen bir dakika bekleyin.' : lang === 'de' ? 'Zu viele Anfragen. Bitte warten Sie eine Minute.' : lang === 'es' ? 'Demasiadas solicitudes. Espere un minuto.' : 'Too many requests. Please wait a minute.';
                        alert(rateLimitMsg);
                    }
                }

                function syncModalChannelUI() {
                    const channel = getPayChannel();
                    const ctx = window.__pendingPayChargeContext;
                    const nonEea = isNonEeaCustomer();
                    const iso = resolveCustomerCountryIso() || '—';
                    const buf = typeof swiftTransferBufferEur === 'number' ? swiftTransferBufferEur : 20;

                    if (channelGoBtn) {
                        const labelCard = channelGoBtn.getAttribute('data-label-card') || channelGoBtn.textContent;
                        const labelBank = channelGoBtn.getAttribute('data-label-bank') || labelCard;
                        channelGoBtn.textContent = channel === 'bank' ? labelBank : labelCard;
                    }

                    if (cardHint) {
                        cardHint.textContent = nonEea
                            ? (lang === 'tr' ? 'Stripe · EEA dışı ücret' : lang === 'de' ? 'Stripe · Gebühr außer EWR' : lang === 'es' ? 'Stripe · comisión fuera EEE' : 'Stripe · non-EEA fee')
                            : (lang === 'tr' ? 'Stripe · otomatik ek yok' : lang === 'de' ? 'Stripe · kein Auto-Zuschlag' : lang === 'es' ? 'Stripe · sin extra auto' : 'Stripe · no auto surcharge');
                    }
                    if (bankHint) {
                        bankHint.textContent = nonEea
                            ? (lang === 'tr' ? ('+' + buf + ' € SWIFT') : lang === 'de' ? ('+' + buf + ' € SWIFT') : lang === 'es' ? ('+' + buf + ' € SWIFT') : ('+€' + buf + ' SWIFT'))
                            : (lang === 'tr' ? 'SEPA · ek yok' : lang === 'de' ? 'SEPA · kein Extra' : lang === 'es' ? 'SEPA · sin extra' : 'SEPA · no extra');
                    }

                    if (channelLead) {
                        channelLead.textContent = nonEea
                            ? (lang === 'tr'
                                ? (iso + ' · EEA dışı → ek ücret uygulanır')
                                : lang === 'de'
                                  ? (iso + ' · außer EWR → Extra-Gebühr')
                                  : lang === 'es'
                                    ? (iso + ' · fuera EEE → comisión extra')
                                    : (iso + ' · non-EEA → extra fee'))
                            : (lang === 'tr'
                                ? (iso + ' · EEA → otomatik ek yok')
                                : lang === 'de'
                                  ? (iso + ' · EWR → kein Auto-Zuschlag')
                                  : lang === 'es'
                                    ? (iso + ' · EEE → sin extra auto')
                                    : (iso + ' · EEA → no auto surcharge'));
                    }

                    if (eeaNote) {
                        eeaNote.hidden = nonEea;
                        eeaNote.textContent = lang === 'tr'
                            ? 'EEA tespit: otomatik ek yok. Non-EEA kart yine sizin sorumluluğunuz.'
                            : lang === 'de'
                              ? 'EWR erkannt: kein Auto-Zuschlag. Non-EWR-Karte bleibt Ihre Gebühr.'
                              : lang === 'es'
                                ? 'EEE detectado: sin extra auto. Tarjeta no EEE = su comisión.'
                                : 'EEA detected: no auto surcharge. Non-EEA card still your fee.';
                    }

                    if (cardNote) {
                        // Kart seçiminde herkese uyarı (EEA numarası olsa bile)
                        cardNote.hidden = channel !== 'card';
                        cardNote.textContent = nonEea
                            ? (lang === 'tr'
                                ? 'EEA dışı: ~%3,25 + 0,25 € eklenir.'
                                : lang === 'de'
                                  ? 'Außer EWR: ~3,25 % + 0,25 €.'
                                  : lang === 'es'
                                    ? 'Fuera EEE: ~3,25 % + 0,25 €.'
                                    : 'Non-EEA: ~3.25% + €0.25 added.')
                            : (lang === 'tr'
                                ? 'Otomatik ek yok. Non-EEA kart → ücret sizin.'
                                : lang === 'de'
                                  ? 'Kein Auto-Zuschlag. Non-EWR-Karte → Ihre Gebühr.'
                                  : lang === 'es'
                                    ? 'Sin extra auto. Tarjeta no EEE → su comisión.'
                                    : 'No auto surcharge. Non-EEA card → your fee.');
                    }
                    if (bankNote) {
                        bankNote.hidden = !(nonEea && channel === 'bank');
                        bankNote.textContent = lang === 'tr'
                            ? ('+' + buf + ' € SWIFT. IBAN sonra e-posta / WhatsApp.')
                            : lang === 'de'
                              ? ('+' + buf + ' € SWIFT. IBAN per E-Mail / WhatsApp.')
                              : lang === 'es'
                                ? ('+' + buf + ' € SWIFT. IBAN por email / WhatsApp.')
                                : ('+€' + buf + ' SWIFT. IBAN via email / WhatsApp.');
                    }

                    if (ctx && ctx.chargeCalc) {
                        const cardInfo = buildDepositInfo(ctx.chargeCalc, false, 'card');
                        const bankInfo = buildDepositInfo(ctx.chargeCalc, false, 'bank');
                        if (cardDueEl) cardDueEl.textContent = formatPayEur(cardInfo.chargeCents);
                        if (bankDueEl) bankDueEl.textContent = formatPayEur(bankInfo.chargeCents);
                    }
                }

                async function startSelectedPayment() {
                    const quotePayload = window.__pendingBookingQuotePayload;
                    const ctx = window.__pendingPayChargeContext;
                    if (!quotePayload || !ctx) {
                        closeModal();
                        showBookingError(lang === 'tr'
                            ? 'Ödeme bilgileri bulunamadı. Lütfen formu tekrar gönderin.'
                            : 'Payment data missing. Please submit the form again.');
                        return;
                    }
                    if (!checkRateLimit('booking', 5, 1)) {
                        modalRateLimitError();
                        return;
                    }
                    const channel = getPayChannel();
                    const payload = buildPayFollowUpPayload(
                        quotePayload,
                        ctx.chargeCalc,
                        ctx.payPlan,
                        ctx.installOpt,
                        ctx.totalFormatted,
                        ctx.totalCents,
                        channel
                    );
                    window.__lastBookingPayPayload = payload;
                    if (channelGoBtn) channelGoBtn.disabled = true;
                    const isBank = channel === 'bank';
                    try {
                        if (isBank) {
                            await postBookingWebhook(payload);
                            clearPendingBookingPayloads();
                            closeModal();
                            showBookingThankYou();
                            return;
                        }
                        const checkout = await requestPayNowCheckout(payload);
                        clearPendingBookingPayloads();
                        closeModal();
                        const chargeLabel = formatPayEur(payload.amountInCents || 0);
                        if (checkout.mode === 'embedded' && checkout.clientSecret) {
                            await mountStripeEmbeddedCheckout(checkout.clientSecret, checkout.publishableKey, chargeLabel);
                            return;
                        }
                        if (checkout.mode === 'hosted' && checkout.checkoutUrl) {
                            window.location.assign(checkout.checkoutUrl);
                            return;
                        }
                        throw new Error('no_checkout');
                    } catch (err) {
                        console.error(err);
                        if (channelGoBtn) channelGoBtn.disabled = false;
                        if (isBank) {
                            showBookingError(lang === 'tr'
                                ? 'Kayıt gönderilemedi. Lütfen tekrar deneyin.'
                                : lang === 'de'
                                  ? 'Anmeldung konnte nicht gesendet werden. Bitte erneut versuchen.'
                                  : 'Could not send registration. Please try again.');
                            return;
                        }
                        const missingKey = err && err.message === 'missing_publishable_key';
                        showBookingError(missingKey
                            ? (lang === 'tr'
                                ? 'Stripe publishable key eksik. data/booking-pay-proxy.config.php dosyasına pk_live_... ekleyin.'
                                : 'Stripe publishable key missing. Add pk_live_... to data/booking-pay-proxy.config.php.')
                            : (lang === 'tr'
                                ? 'Ödeme başlatılamadı. Lütfen tekrar deneyin.'
                                : 'Could not start payment. Please try again.'));
                    }
                }

                noBtn?.addEventListener('click', async function () {
                    const payload = window.__pendingBookingQuotePayload;
                    if (!payload) {
                        closeModal();
                        showBookingThankYou();
                        return;
                    }
                    if (!checkRateLimit('booking', 5, 1)) {
                        modalRateLimitError();
                        return;
                    }
                    noBtn.disabled = true;
                    try {
                        await postBookingWebhook(payload);
                        clearPendingBookingPayloads();
                        closeModal();
                        showBookingThankYou();
                    } catch (err) {
                        console.error(err);
                        noBtn.disabled = false;
                        showBookingError(lang === 'tr'
                            ? 'Teklif gönderilemedi. Lütfen tekrar deneyin.'
                            : lang === 'de'
                                ? 'Angebot konnte nicht gesendet werden. Bitte erneut versuchen.'
                                : lang === 'es'
                                    ? 'No se pudo enviar el presupuesto. Inténtelo de nuevo.'
                                    : 'Could not send quote. Please try again.');
                    }
                });

                yesBtn?.addEventListener('click', function () {
                    const cardRadio = modal?.querySelector('[name="pay-channel"][value="card"]');
                    if (cardRadio instanceof HTMLInputElement) cardRadio.checked = true;
                    showModalStep('channel');
                    syncModalChannelUI();
                });

                channelBackBtn?.addEventListener('click', function () {
                    showModalStep('choice');
                });

                channelGoBtn?.addEventListener('click', function () {
                    startSelectedPayment();
                });

                modal?.querySelectorAll('[name="pay-channel"]').forEach(function (el) {
                    el.addEventListener('change', syncModalChannelUI);
                });
            })();

            function applyBookingPrefillFromUrl() {
                const params = new URLSearchParams(window.location.search);
                const program = params.get('program');
                if (!program) return;

                const programRadio = document.querySelector('[name="program"][value="' + program + '"]');
                if (!(programRadio instanceof HTMLInputElement)) return;

                programRadio.checked = true;
                toggleProgramExtras();

                const courses = (params.get('courses') || '').split(',').map(function (c) { return c.trim(); }).filter(Boolean);
                courses.forEach(function (courseValue) {
                    const cb = document.querySelector('[name="course-selection"][value="' + courseValue + '"]');
                    if (cb instanceof HTMLInputElement) cb.checked = true;
                });

                const weeks = params.get('weeks');
                if (weeks && program === 'short-term') {
                    const weekRadio = document.querySelector('[name="weeks-choice"][value="' + weeks + '"]');
                    if (weekRadio instanceof HTMLInputElement) {
                        weekRadio.checked = true;
                        syncWeeksOtherVisibility();
                        syncWeeksFromControl();
                    }
                }

                toggleBundleInfobox();
                filterWeeksByLevelCourses();
                reorderCourseSelectionChain();
                syncProgramCardsUI();
                syncOnlineCourseCards();
                if (typeof window.syncBookingLessonTimeForProgram === 'function') {
                    window.syncBookingLessonTimeForProgram(program);
                }
                updatePrice();
            }

            // Initialize
            applyBookingPrefillFromUrl();
            updateProgress();
            updatePrice();
            syncProgramCardsUI();
            syncOnlineCourseCards();
            syncPaymentUI();
            syncQuoteCtaVisibility();

            const mobileDockCta = document.getElementById('bk-mobile-dock-cta');
            if (mobileDockCta) {
                syncMobileDockCta();
                mobileDockCta.addEventListener('click', function () {
                    const activeStep = document.querySelector('.form-step.active');
                    if (!activeStep || !bookingForm) return;
                    if (currentStep < totalSteps) {
                        const nextBtn = activeStep.querySelector('.btn-next');
                        if (nextBtn instanceof HTMLElement) nextBtn.click();
                        return;
                    }
                    const quoteBtn = document.getElementById('bk-submit-quote');
                    if (quoteBtn instanceof HTMLButtonElement) {
                        if (typeof bookingForm.requestSubmit === 'function') {
                            bookingForm.requestSubmit(quoteBtn);
                        } else {
                            quoteBtn.click();
                        }
                    }
                });
            }

            // Mobil dock: footer görünür olunca üstüne takılsın (fixed + bottom offset)
            (function initMobileDockAboveFooter() {
                const dock = document.getElementById('bk-mobile-dock');
                const footer = document.querySelector('footer.footer');
                if (!dock || !footer) return;
                const mq = window.matchMedia('(max-width: 900px)');
                function pinDock() {
                    if (!mq.matches || dock.hidden || getComputedStyle(dock).display === 'none') {
                        dock.style.bottom = '';
                        return;
                    }
                    const footerTop = footer.getBoundingClientRect().top;
                    const vh = window.innerHeight || document.documentElement.clientHeight;
                    if (footerTop < vh) {
                        dock.style.bottom = Math.max(0, Math.round(vh - footerTop)) + 'px';
                    } else {
                        dock.style.bottom = '0px';
                    }
                }
                window.addEventListener('scroll', pinDock, { passive: true });
                window.addEventListener('resize', pinDock, { passive: true });
                if (typeof mq.addEventListener === 'function') mq.addEventListener('change', pinDock);
                else if (typeof mq.addListener === 'function') mq.addListener(pinDock);
                pinDock();
            })();
        });
    </script>
</MainLayout>

