            async function requestPayNowCheckout(payload) {
                const proxyUrl = (bookingForm?.dataset.payProxy || '/booking-pay-proxy.php').trim();
                const response = await fetch(proxyUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload),
                });
                const text = await response.text();
                let data = null;
                try {
                    data = text ? JSON.parse(text) : null;
                } catch (_) {}
                if (!response.ok) {
                    throw new Error(data?.error || 'checkout_request_failed');
                }
                if (data && data.clientSecret) {
                    return {
                        mode: 'embedded',
                        clientSecret: data.clientSecret,
                        publishableKey: data.publishableKey || '',
                    };
                }
                if (data && data.checkoutUrl) {
                    return { mode: 'hosted', checkoutUrl: data.checkoutUrl };
                }
                throw new Error(data?.error || 'no_checkout');
            }

            let stripeEmbedCheckout = null;
            let stripeJsPromise = null;

            function loadStripeJs() {
                if (window.Stripe) return Promise.resolve(window.Stripe);
                if (stripeJsPromise) return stripeJsPromise;
                stripeJsPromise = new Promise(function (resolve, reject) {
                    const existing = document.querySelector('script[data-stripe-js]');
                    if (existing) {
                        existing.addEventListener('load', function () { resolve(window.Stripe); });
                        existing.addEventListener('error', reject);
                        return;
                    }
                    const s = document.createElement('script');
                    s.src = 'https://js.stripe.com/v3/';
                    s.async = true;
                    s.dataset.stripeJs = '1';
                    s.onload = function () { resolve(window.Stripe); };
                    s.onerror = reject;
                    document.head.appendChild(s);
                });
                return stripeJsPromise;
            }

            function setStripeEmbedStatus(message) {
                const el = document.getElementById('stripe-embed-status');
                if (el) el.textContent = message || '';
            }

            function syncPaymentAmountDisplay(overrideText) {
                const totalEl = document.getElementById('total-price');
                const payAmount = document.getElementById('booking-payment-amount');
                if (!payAmount) return;
                if (overrideText) {
                    payAmount.textContent = overrideText;
                    return;
                }
                payAmount.textContent = (totalEl && totalEl.textContent) || '—';
            }

            function enterPaymentStage(chargeLabel) {
                const form = document.getElementById('booking-form');
                const stage = document.getElementById('booking-payment-stage');
                const content = document.querySelector('.booking-content');
                if (form) form.hidden = true;
                if (stage) stage.hidden = false;
                if (content) content.classList.add('booking-content--paying');
                syncPaymentAmountDisplay(chargeLabel);
                const progress = document.querySelector('.form-progress');
                if (progress) progress.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }

            function exitPaymentStage() {
                const form = document.getElementById('booking-form');
                const stage = document.getElementById('booking-payment-stage');
                const content = document.querySelector('.booking-content');
                if (stage) stage.hidden = true;
                if (form) form.hidden = false;
                if (content) content.classList.remove('booking-content--paying');
            }

            async function destroyStripeEmbed() {
                if (stripeEmbedCheckout) {
                    try {
                        if (typeof stripeEmbedCheckout.destroy === 'function') {
                            stripeEmbedCheckout.destroy();
                        } else if (typeof stripeEmbedCheckout.unmount === 'function') {
                            stripeEmbedCheckout.unmount();
                        }
                    } catch (_) {}
                    stripeEmbedCheckout = null;
                }
                const mount = document.getElementById('stripe-embed-mount');
                if (mount) mount.innerHTML = '';
                exitPaymentStage();
                setStripeEmbedStatus('');
            }

            async function mountStripeEmbeddedCheckout(clientSecret, publishableKey, chargeLabel) {
                if (!publishableKey) {
                    throw new Error('missing_publishable_key');
                }
                const StripeCtor = await loadStripeJs();
                if (!StripeCtor) throw new Error('stripe_js_failed');

                await destroyStripeEmbed();

                const stage = document.getElementById('booking-payment-stage');
                const mount = document.getElementById('stripe-embed-mount');
                if (!stage || !mount) throw new Error('missing_embed_dom');

                enterPaymentStage(chargeLabel);
                setStripeEmbedStatus(
                    lang === 'tr' ? 'Ödeme formu yükleniyor…' :
                    lang === 'de' ? 'Zahlungsformular wird geladen…' :
                    lang === 'es' ? 'Cargando formulario de pago…' :
                    'Loading payment form…'
                );

                const stripe = StripeCtor(publishableKey);
                const fetchClientSecret = async function () { return clientSecret; };

                let checkout;
                if (typeof stripe.createEmbeddedCheckoutPage === 'function') {
                    checkout = await stripe.createEmbeddedCheckoutPage({ fetchClientSecret });
                } else if (typeof stripe.initEmbeddedCheckout === 'function') {
                    checkout = await stripe.initEmbeddedCheckout({ fetchClientSecret });
                } else {
                    throw new Error('embedded_api_unavailable');
                }

                checkout.mount('#stripe-embed-mount');
                stripeEmbedCheckout = checkout;
                setStripeEmbedStatus('');
            }

            document.getElementById('stripe-embed-close')?.addEventListener('click', function () {
                destroyStripeEmbed();
                setSubmitButtonsDisabled(false);
                restoreSubmitButtons();
            });

            function handlePaymentReturnFromStripe() {
                const params = new URLSearchParams(window.location.search);
                if (params.get('payment') !== 'success') return;
                showBookingThankYou();
                params.delete('payment');
                params.delete('session_id');
                const qs = params.toString();
                const clean = window.location.pathname + (qs ? '?' + qs : '') + window.location.hash;
                window.history.replaceState({}, '', clean);
            }
            handlePaymentReturnFromStripe();

            if (bookingForm) {
                bookingForm.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    const formData = new FormData(bookingForm);
                    const payDoc = (formData.get('pay-doc') || '').toString();
                    const payPlan = (formData.get('pay-plan') || '').toString();
                    const installOpt = (formData.get('pay-install') || '').toString();
                    const payMethod = (formData.get('pay-method') || '').toString();
                    const inGermanyRaw = (formData.get('in-germany') || '').toString();
                    const inGermany = inGermanyRaw === 'yes';

                    if (!inGermanyRaw) {
                        showBookingError(payUiCopy?.needGermany || 'Lütfen konumunuzu seçin.');
                        return;
                    }
                    if (!payDoc) {
                        showBookingError(payUiCopy?.needDoc || 'Lütfen belge seçimi yapın.');
                        return;
                    }
                    if (payDoc === 'registration') {
                        if (!payPlan) {
                            showBookingError(payUiCopy?.needPlan || 'Lütfen ödeme planı seçin.');
                            return;
                        }
                        if (payPlan === 'installment' && !installOpt) {
                            showBookingError(payUiCopy?.needInstall || 'Lütfen taksit seçeneğini seçin.');
                            return;
                        }
                        if (!payMethod) {
                            showBookingError(payUiCopy?.needMethod || 'Lütfen ödeme yöntemi seçin.');
                            return;
                        }
                        if (payMethod === 'office' && !inGermany) {
                            showBookingError(payUiCopy?.needMethod || 'Lütfen ödeme yöntemi seçin.');
                            return;
                        }
                    }

                    setSubmitButtonsDisabled(true);
                    const submittingText = lang === 'tr' ? 'Gönderiliyor...' : lang === 'de' ? 'Wird gesendet...' : lang === 'es' ? 'Enviando...' : 'Submitting...';
                    setSubmitButtonsText(submittingText);

                    // 1. Check rate limiting
                    if (!checkRateLimit('booking', 5, 1)) {
                        if (window.showSuccessModal) {
                            window.showSuccessModal('error', window.successModalTranslations?.rateLimitError || 'Çok fazla istek gönderdiniz. Lütfen bir dakika bekleyin.');
                        } else {
                            const rateLimitMsg = lang === 'tr' ? 'Çok fazla istek gönderdiniz. Lütfen bir dakika bekleyin.' : lang === 'de' ? 'Zu viele Anfragen. Bitte warten Sie eine Minute.' : lang === 'es' ? 'Demasiadas solicitudes. Espere un minuto.' : 'Too many requests. Please wait a minute.';
                            alert(rateLimitMsg);
                        }
                        setSubmitButtonsDisabled(false);
                        restoreSubmitButtons();
                        return;
                    }
                    if (!checkHoneypot(bookingForm, 'website')) {
                        console.warn('Bot detected via honeypot');
                        setSubmitButtonsDisabled(false);
                        restoreSubmitButtons();
                        return;
                    }
                    const email = bookingForm.querySelector('[name="email"]')?.value || '';
                    const phoneDialRaw = bookingForm.querySelector('[name="phone-country-code"]')?.value || '';
                    const phoneDial = phoneDialRaw.trim().replace(/\s/g, '');
                    const phoneLocal = bookingForm.querySelector('[name="phone"]')?.value || '';
                    const phone = ((phoneDial.startsWith('+') ? phoneDial : '+' + phoneDial.replace(/^\+*/, '')) + ' ' + phoneLocal).trim();
                    if (!validateEmail(email)) {
                        if (window.showSuccessModal) {
                            window.showSuccessModal('error', window.successModalTranslations?.emailError || 'Lütfen geçerli bir e-posta adresi girin.');
                        } else {
                            const emailErrorMsg = lang === 'tr' ? 'Lütfen geçerli bir e-posta adresi girin.' : lang === 'de' ? 'Bitte geben Sie eine gültige E-Mail-Adresse ein.' : lang === 'es' ? 'Introduzca un email válido.' : 'Please enter a valid email address.';
                            alert(emailErrorMsg);
                        }
                        setSubmitButtonsDisabled(false);
                        restoreSubmitButtons();
                        return;
                    }
                    if (!validatePhone(phone)) {
                        if (window.showSuccessModal) {
                            window.showSuccessModal('error', window.successModalTranslations?.phoneError || 'Lütfen geçerli bir telefon numarası girin.');
                        } else {
                            const phoneErrorMsg = lang === 'tr' ? 'Lütfen geçerli bir telefon numarası girin.' : lang === 'de' ? 'Bitte geben Sie eine gültige Telefonnummer ein.' : lang === 'es' ? 'Introduzca un número de teléfono válido.' : 'Please enter a valid phone number.';
                            alert(phoneErrorMsg);
                        }
                        setSubmitButtonsDisabled(false);
                        restoreSubmitButtons();
                        return;
                    }
                    const data = {};
                    
                    // Collect all form data
                    for (let [key, value] of formData.entries()) {
                        if (data[key]) {
                            // Handle multiple values (checkboxes, etc.)
                            if (Array.isArray(data[key])) {
                                data[key].push(value);
                            } else {
                                data[key] = [data[key], value];
                            }
                        } else {
                            data[key] = value;
                        }
                    }
                    
                    const courseSelectionArr = Array.isArray(data['course-selection']) ? data['course-selection'] : (data['course-selection'] ? [data['course-selection']] : []);
                    const program = data.program || '';
                    const courseCount = getSelectedCourseCount(courseSelectionArr);
                    const submittedWeeks = data.weeks ? String(data.weeks) : '';
                    const effectiveWeeks = (program === 'intensive' || program === 'online')
                        ? String(courseCount * WEEKS_PER_LEVEL)
                        : submittedWeeks;
                    const lessonTime = (data['timezone-slot'] || document.getElementById('booking-timezone-slot')?.value || '').trim();
                    const startDateKind = (data['start-date-mode'] || '').trim();
                    const bringFriendActive = data['bring-friend-discount'] === 'yes';
                    const yesNo = (field) => (data[field] === 'yes' ? bookingWebhookLabels.yes : bookingWebhookLabels.no);
                    const courseLevelsText = courseSelectionArr
                        .map((v) => bookingWebhookLabels.courseLevel[v] || String(v).toUpperCase())
                        .join(', ');
                    const totalFormatted = document.getElementById('total-price')?.textContent || '0 €';
                    const totalCents = parseInt(String(data.amountInCents || '0').trim(), 10) || 0;
                    const friendDiscountEuro = bringFriendActive ? FRIEND_DISCOUNT : 0;
                    const firstCourseCents = Math.round((promoPrice || 0) * 100);

                    if (payDoc === 'registration' && totalCents <= 0 && payPlan === 'full') {
                        showBookingError(lang === 'tr' ? 'Ödeme için geçerli bir tutar seçiniz.' : lang === 'de' ? 'Bitte wählen Sie einen gültigen Betrag für die Zahlung.' : lang === 'es' ? 'Seleccione un importe válido para el pago.' : 'Please select a valid amount for payment.');
                        setSubmitButtonsDisabled(false);
                        restoreSubmitButtons();
                        return;
                    }

                    const chargeCalc = computeBookingCharge({
                        totalCents,
                        firstCourseCents,
                        inGermany,
                        payDoc,
                        payPlan,
                        installOpt,
                    });
                    const depositInfo = {
                        chargeCents: chargeCalc.chargeCents,
                        remainingCents: chargeCalc.remainingCents,
                        depositEur: chargeCalc.depositEur || 0,
                        balanceDueDays: chargeCalc.depositEur ? balanceDueDays : 0,
                        kind: chargeCalc.kind,
                        fullDiscountEur: chargeCalc.fullDiscountEur || 0,
                        germanyNoRegFee: !!chargeCalc.germanyNoRegFee,
                    };
                    const paymentChoice = payDoc === 'quote'
                        ? 'quote'
                        : (payPlan === 'full' ? 'pay_now' : 'reservation');
                    const chargeEur = Math.round(depositInfo.chargeCents) / 100;
                    const chargeLabel = chargeEur.toLocaleString(lang === 'de' ? 'de-DE' : lang === 'tr' ? 'tr-TR' : lang === 'es' ? 'es-ES' : 'en-US') + ' €';

                    const weeksNumPayload = effectiveWeeks ? Number(effectiveWeeks) : 0;
                    const pricedForDiscount = courseSelectionArr.filter(function (c) { return LEVEL_RE.test(c) || c === 'telc-c1-prep'; });
                    const courseGrossEuro = (program === 'intensive' || program === 'online')
                        ? getIntensiveCourseGross(pricedForDiscount)
                        : Math.round(totalCents / 100);
                    const multiDiscount = (program === 'intensive' || program === 'online')
                        ? getMultiCourseDiscount(courseCount, courseGrossEuro)
                        : { percent: 0, amount: 0 };
                    const stripeLineItemsDetail = buildStripeLineItems({
                        program,
                        courses: courseSelectionArr,
                        weeksNum: weeksNumPayload,
                        visa: data['visa-guarantee'] === 'yes',
                        university: data['university-admission-support'] === 'yes',
                        accommodation: data['accommodation-support'] === 'yes',
                        airport: data['airport-pickup'] === 'yes',
                        friendDiscountEuro,
                        bundleDiscountEuro: multiDiscount.amount || 0,
                        courseEur: courseGrossEuro,
                        targetCents: totalCents,
                    });
                    // Checkout’ta tek satır = amountInCents (katalog / hafta paketi çift sayımını engeller)
                    const stripeLineItems = [{
                        productKey: stripeAdjustProduct.productKey,
                        name: paymentChoice === 'reservation'
                            ? ('Reservation deposit ' + reservationDepositEur + ' EUR')
                            : 'Campus German booking',
                        amountCents: depositInfo.chargeCents,
                        quantity: 1,
                        useCustomAmount: true,
                    }];

                    let standardizedData = {
                        formType: payDoc === 'quote' ? 'price-quote' : 'booking',
                        lang: typeof lang !== 'undefined' ? lang : 'tr',
                        sourcePage: data.sourcePage || window.location.pathname,
                        submittedAt: new Date().toISOString(),
                        paymentChoice,
                        paymentDoc: payDoc,
                        paymentPlan: payPlan || '',
                        paymentInstallOption: installOpt || '',
                        paymentMethod: payMethod || (payDoc === 'quote' ? 'none' : ''),
                        paymentKind: depositInfo.kind,
                        checkoutUiMode: 'embedded',
                        returnUrl:
                            window.location.origin +
                            window.location.pathname +
                            '?payment=success&session_id={CHECKOUT_SESSION_ID}',

                        customer: {
                            firstName: data.first_name || '',
                            lastName: data.last_name || '',
                            email: data.email || '',
                            phone,
                            address: '',
                            postalCode: '',
                            city: data.city || '',
                            country: data.country || '',
                        },

                        course: {
                            program: bookingWebhookLabels.program[program] || program,
                            levels: courseLevelsText,
                            weeks: effectiveWeeks ? Number(effectiveWeeks) : null,
                            lessonTime: bookingWebhookLabels.lessonTime[lessonTime] || lessonTime,
                            startDate: data['start-date'] || '',
                            startDateKind: bookingWebhookLabels.startDateKind[startDateKind] || startDateKind,
                        },

                        extras: {
                            visaSupport: yesNo('visa-guarantee'),
                            universityAdmission: yesNo('university-admission-support'),
                            accommodation: yesNo('accommodation-support'),
                            airportPickup: yesNo('airport-pickup'),
                            speakcafeMembership: yesNo('speakcafe-membership'),
                            specialRequest: (data['extras-special-request'] || '').trim(),
                        },

                        location: {
                            inGermany: yesNo('in-germany'),
                        },

                        marketing: {
                            heardFrom: '',
                            referrerName: '',
                        },

                        bringFriend: bringFriendActive
                            ? {
                                active: bookingWebhookLabels.yes,
                                discountEuro: friendDiscountEuro,
                                name: (data['bring-friend-name'] || '').trim(),
                                email: (data['bring-friend-email'] || '').trim(),
                                phone: (data['bring-friend-phone'] || '').trim(),
                            }
                            : { active: bookingWebhookLabels.no },

                        message: (data['extras-special-request'] || data.message || '').trim(),

                        price: {
                            total: totalFormatted,
                            totalCents,
                            chargeCents: depositInfo.chargeCents,
                            remainingCents: depositInfo.remainingCents,
                            depositEur: depositInfo.depositEur,
                            balanceDueDays: depositInfo.balanceDueDays,
                            depositNonRefundable: paymentChoice === 'reservation',
                        },

                        priceCollection: {
                            total: totalFormatted,
                            totalCents,
                            chargeCents: depositInfo.chargeCents,
                            remainingCents: depositInfo.remainingCents,
                        },
                        priceTotal: totalFormatted,
                        amountInCents: depositInfo.chargeCents,
                        stripeLineItems,
                        stripeLineItemsDetail,
                        stripePricing: {
                            mode: 'custom_amount_cents',
                            mapCatalogPrices: false,
                            skipWeeksPackage: true,
                            useLineItemAmounts: true,
                            chargeCents: depositInfo.chargeCents,
                            totalCents,
                        },

                        customerCollection: null,
                        courseCollection: null,

                        consents: {
                            terms: data['terms-accepted'] === 'yes',
                            privacy: data['privacy-accepted'] === 'yes',
                        },
                    };

                    standardizedData.customerCollection = { ...standardizedData.customer };
                    standardizedData.courseCollection = { ...standardizedData.course };

                    // Sanitize nested fields; keep payment URLs/tokens intact after.
                    standardizedData = sanitizeObject(standardizedData);
                    standardizedData.paymentChoice = paymentChoice;
                    standardizedData.checkoutUiMode = 'embedded';
                    standardizedData.returnUrl =
                        window.location.origin +
                        window.location.pathname +
                        '?payment=success&session_id={CHECKOUT_SESSION_ID}';
                    standardizedData.amountInCents = depositInfo.chargeCents;
                    standardizedData.price = {
                        total: totalFormatted,
                        totalCents,
                        chargeCents: depositInfo.chargeCents,
                        remainingCents: depositInfo.remainingCents,
                        depositEur: depositInfo.depositEur,
                        balanceDueDays: depositInfo.balanceDueDays,
                        depositNonRefundable: paymentChoice === 'reservation',
                    };
                    standardizedData.priceCollection = {
                        total: totalFormatted,
                        totalCents,
                        chargeCents: depositInfo.chargeCents,
                        remainingCents: depositInfo.remainingCents,
                    };
                    standardizedData.stripeLineItems = stripeLineItems;
                    standardizedData.stripeLineItemsDetail = stripeLineItemsDetail;
                    standardizedData.stripePricing = {
                        mode: 'custom_amount_cents',
                        mapCatalogPrices: false,
                        skipWeeksPackage: true,
                        useLineItemAmounts: true,
                        chargeCents: depositInfo.chargeCents,
                        totalCents,
                    };

                    async function postBookingWebhook(payload) {
                        const webhookUrl = (bookingForm?.dataset.webhook || '').trim();
                        if (!webhookUrl) throw new Error('missing_webhook');
                        const res = await fetch(webhookUrl, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload),
                        });
                        if (!res.ok) throw new Error('webhook_failed');
                    }

                    const needsStripe = payDoc === 'registration' && payMethod === 'online' && depositInfo.chargeCents > 0;
                    let paymentUiOpen = false;

                    try {
                        if (!needsStripe) {
                            await postBookingWebhook(standardizedData);
                            showBookingThankYou();
                            return;
                        }
                        const checkout = await requestPayNowCheckout(standardizedData);
                        if (checkout.mode === 'embedded' && checkout.clientSecret) {
                            await mountStripeEmbeddedCheckout(checkout.clientSecret, checkout.publishableKey, chargeLabel);
                            paymentUiOpen = true;
                            return;
                        }
                        if (checkout.mode === 'hosted' && checkout.checkoutUrl) {
                            paymentUiOpen = true;
                            window.location.assign(checkout.checkoutUrl);
                            return;
                        }
                        throw new Error('no_checkout');
                    } catch (error) {
                        console.error('Error submitting form:', error);
                        try { await destroyStripeEmbed(); } catch (_) {}
                        const missingKey = error && error.message === 'missing_publishable_key';
                        const payError = missingKey
                            ? (lang === 'tr'
                                ? 'Stripe publishable key eksik. data/booking-pay-proxy.config.php dosyasına pk_live_... ekleyin.'
                                : lang === 'de'
                                    ? 'Stripe Publishable Key fehlt. Bitte pk_live_... in data/booking-pay-proxy.config.php eintragen.'
                                    : lang === 'es'
                                        ? 'Falta la clave publicable de Stripe. Añada pk_live_... en data/booking-pay-proxy.config.php.'
                                        : 'Stripe publishable key missing. Add pk_live_... to data/booking-pay-proxy.config.php.')
                            : (lang === 'tr'
                                ? 'Gönderim tamamlanamadı. Lütfen tekrar deneyin veya bizimle iletişime geçin.'
                                : lang === 'de'
                                    ? 'Absenden fehlgeschlagen. Bitte erneut versuchen oder kontaktieren Sie uns.'
                                    : lang === 'es'
                                        ? 'No se pudo completar el envío. Inténtelo de nuevo o contáctenos.'
                                        : 'Could not complete submission. Please try again or contact us.');
                        showBookingError(payError);
                    } finally {
                        if (!paymentUiOpen) {
                            setSubmitButtonsDisabled(false);
                            restoreSubmitButtons();
                        }
                    }
                });
            }

            function applyBookingPrefillFromUrl() {
                const params = new URLSearchParams(window.location.search);
                const program = params.get('program');
                if (!program) return;

                const programRadio = document.querySelector('[name="program"][value="' + program + '"]');
                if (!(programRadio instanceof HTMLInputElement)) return;

                programRadio.checked = true;
                toggleProgramExtras();

                const courses = (params.get('courses') || '').split(',').map(function (c) { return c.trim(); }).filter(Boolean);
                courses.forEach(function (courseValue) {
                    const cb = document.querySelector('[name="course-selection"][value="' + courseValue + '"]');
                    if (cb instanceof HTMLInputElement) cb.checked = true;
                });

                const weeks = params.get('weeks');
                if (weeks && program === 'short-term') {
                    const weekRadio = document.querySelector('[name="weeks-choice"][value="' + weeks + '"]');
                    if (weekRadio instanceof HTMLInputElement) {
                        weekRadio.checked = true;
                        syncWeeksOtherVisibility();
                        syncWeeksFromControl();
                    }
                }

                syncUnsureCourseSelection();
                toggleBundleInfobox();
                filterWeeksByLevelCourses();
                reorderCourseSelectionChain();
                syncProgramCardsUI();
                syncOnlineCourseCards();
                if (typeof window.syncBookingLessonTimeForProgram === 'function') {
                    window.syncBookingLessonTimeForProgram(program);
                }
                updatePrice();
            }

            // Initialize
            applyBookingPrefillFromUrl();
            updateProgress();
            updatePrice();
            syncProgramCardsUI();
            syncOnlineCourseCards();
            syncPaymentUI();
        });
    </script>
</MainLayout>

