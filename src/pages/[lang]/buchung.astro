                        airportTransferArrival: 'Traslado aeropuerto (llegada)',
                        airportTransferDeparture: 'Traslado aeropuerto (salida)',
                        visaSupport: 'Documentos de apoyo al visado',
                        total: 'Total'
                    }
                };
                const labels = summaryLabels[currentLang] || summaryLabels.tr;
                
                // Build course summary
                if (courseSummary) {
                    let courseHtml = '<div class="summary-item">';
                    if (school) {
                        courseHtml += `<div class="summary-row"><strong>${labels.school}:</strong> <span>${s[school] || school}</span></div>`;
                    }
                    if (courseType) {
                        courseHtml += `<div class="summary-row"><strong>${labels.courseType}:</strong> <span>${t[courseType] || courseType}</span></div>`;
                    }
                    if (level) {
                        courseHtml += `<div class="summary-row"><strong>${labels.level}:</strong> <span>${level.toUpperCase()}</span></div>`;
                    }
                    if (startDate) {
                        courseHtml += `<div class="summary-row"><strong>${labels.startDate}:</strong> <span>${formatDateForDisplay(startDate)}</span></div>`;
                    }
                    if (duration) {
                        courseHtml += `<div class="summary-row"><strong>${labels.duration}:</strong> <span>${duration} ${labels.weeks}</span></div>`;
                    }
                    if (continuationLevels.length > 0) {
                        courseHtml += `<div class="summary-row"><strong>${labels.continuationLevels}:</strong> <span>${continuationLevels.map(l => l.toUpperCase()).join(', ')}</span></div>`;
                    }
                    courseHtml += '</div>';
                    courseSummary.innerHTML = courseHtml;
                }
                
                // Build accommodation summary
                const accommodationNeeded = document.querySelector('[name="accommodation-needed"]:checked')?.value;
