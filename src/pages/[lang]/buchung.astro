            function initBookingPhoneCountryPicker() {
                const picker = document.querySelector('[data-phone-country-picker]');
                if (!picker) return;
                const trigger = picker.querySelector('.phone-country-trigger');
                const menu = picker.querySelector('.phone-country-menu');
                const flagEl = picker.querySelector('[data-phone-flag]');
                const dialEl = picker.querySelector('[data-phone-dial]');
                const codeInput = picker.querySelector('#phone-country-code');
                if (!trigger || !menu) return;

                function closeMenu() {
                    menu.hidden = true;
                    trigger.setAttribute('aria-expanded', 'false');
                }

                trigger.addEventListener('click', function (e) {
                    e.stopPropagation();
                    const open = menu.hidden;
                    menu.hidden = !open;
                    trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
                });

                menu.querySelectorAll('.phone-country-option').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        const iso = btn.getAttribute('data-iso') || 'tr';
                        const dial = btn.getAttribute('data-dial') || '+90';
                        if (flagEl) flagEl.src = 'https://flagcdn.com/w40/' + iso + '.png';
                        if (dialEl) dialEl.textContent = dial;
                        if (codeInput) codeInput.value = dial;
                        closeMenu();
                    });
                });

                document.addEventListener('click', function (e) {
                    if (!picker.contains(e.target)) closeMenu();
                });
            }
            initBookingPhoneCountryPicker();

            function toggleBringFriendFields() {
                const checked = document.getElementById('bring-friend-discount')?.checked;
                const block = document.getElementById('bring-friend-fields');
                const fields = ['bring-friend-name', 'bring-friend-email', 'bring-friend-phone'];
                if (block) block.style.display = checked ? 'block' : 'none';
                fields.forEach(function (id) {
                    const el = document.getElementById(id);
                    if (!el) return;
                    if (checked) el.setAttribute('required', 'required');
                    else {
                        el.removeAttribute('required');
                        el.classList.remove('error');
                    }
                });
            }
            const bringFriendCheckbox = document.getElementById('bring-friend-discount');
            if (bringFriendCheckbox) {
                bringFriendCheckbox.addEventListener('change', function () {
                    toggleBringFriendFields();
                    toggleBundleInfobox();
                    updatePrice();
                });
                toggleBringFriendFields();
            }

            const hearAboutSelect = document.getElementById('hear-about-select');
            function toggleHearAboutExtras() {
                const v = hearAboutSelect?.value || '';
                const fr = document.getElementById('hear-about-friend-fields');
                const fn = document.getElementById('friend-referrer-name');
                if (fr) fr.style.display = v === 'friend' ? 'block' : 'none';
                if (fn) {
                    if (v === 'friend') fn.setAttribute('required', 'required');
                    else fn.removeAttribute('required');
                }
            }
            if (hearAboutSelect) {
                hearAboutSelect.addEventListener('change', toggleHearAboutExtras);
                toggleHearAboutExtras();
            }

            // ===== PRICE CALCULATION =====
            const programLabels = {
                tr: { intensive: 'Yoğun Almanca', 'short-term': 'Short term', online: 'Online kurs', 'youth-camp': 'Yaz kampı' },
                de: { intensive: 'Intensiv Deutsch', 'short-term': 'Short term', online: 'Online-Kurs', 'youth-camp': 'Sommercamp' },
                en: { intensive: 'Intensive German', 'short-term': 'Short term', online: 'Online course', 'youth-camp': 'Summer Camp' },
                es: { intensive: 'Alemán intensivo', 'short-term': 'Short term', online: 'Curso online', 'youth-camp': 'Campamento verano' }
            };
            function updatePrice() {
                const courseTypePrice = document.getElementById('course-type-price');
                const durationPrice = document.getElementById('duration-price');
                const bundleDiscountRow = document.getElementById('bundle-discount-row');
                const bundleDiscountValue = document.getElementById('bundle-discount-value');
                const visaPriceRow = document.getElementById('visa-price-row');
                const universityAdmissionPriceRow = document.getElementById('university-admission-price-row');
                const accommodationPriceRow = document.getElementById('accommodation-price-row');
                const airportPriceRow = document.getElementById('airport-price-row');
                const totalPriceElement = document.getElementById('total-price');
                const program = document.querySelector('[name="program"]:checked')?.value;
                const checkedCourses = Array.from(document.querySelectorAll('[name="course-selection"]:checked')).map(c => c.value);
                const weeks = getWeeksValue();
                const currentLang = lang || 'tr';
                const t = programLabels[currentLang] || programLabels.tr;

                if (!courseTypePrice) return;

                const courseCount = getSelectedCourseCount(checkedCourses);
                const pricedCourses = checkedCourses.filter(function (c) { return LEVEL_RE.test(c) || c === 'telc-c1-prep'; });
                const dispWeeksIntensive = getIntensiveWeeksTotal(pricedCourses);
                const weeksNum = parseInt(weeks, 10) || 0;

                if (program && (checkedCourses.length > 0 || program === 'short-term')) {
                    let coursePrice = 0;
                    let multiDiscount = { percent: 0, amount: 0 };

                    if (program === 'short-term') {
                        coursePrice = getTieredPrice(weeksNum);
                    } else if (program === 'intensive' || program === 'online') {
                        if (courseCount > 0) {
                            const gross = getIntensiveCourseGross(pricedCourses);
                            const bringFriendActive = !!document.getElementById('bring-friend-discount')?.checked;
                            multiDiscount = getMultiCourseDiscount(courseCount, gross, bringFriendActive);
                            coursePrice = gross;
                        }
                    } else if (program === 'youth-camp') {
                        for (const courseValue of checkedCourses) {
                            const levelForCourse = ['berlin-camp', 'muenster-camp', 'bremen-camp'].includes(courseValue) ? 'a1' : courseValue;
                            coursePrice += getCoursePrice(program, levelForCourse, weeks);
                        }
                    }
                    const programLabel = t[program] || program;
                    let labelSuffix = checkedCourses.length ? ' (' + checkedCourses.map(c => c.toUpperCase().replace(/-/g, ' ')).join(', ') + ')' : '';
                    if (program === 'intensive' || program === 'online') {
                        if (dispWeeksIntensive > 0) {
                            const weekWord = dispWeeksIntensive === 1
                                ? (currentLang === 'tr' ? 'hafta' : currentLang === 'de' ? 'Woche' : currentLang === 'es' ? 'semana' : 'week')
                                : (currentLang === 'tr' ? 'hafta' : currentLang === 'de' ? 'Wochen' : currentLang === 'es' ? 'semanas' : 'weeks');
                            labelSuffix = ' ' + dispWeeksIntensive + ' ' + weekWord + labelSuffix;
                        }
                    } else if (program === 'short-term' && weeksNum > 0) {
                        const weekWord = weeksNum === 1
                            ? (currentLang === 'tr' ? 'hafta' : currentLang === 'de' ? 'Woche' : currentLang === 'es' ? 'semana' : 'week')
                            : (currentLang === 'tr' ? 'hafta' : currentLang === 'de' ? 'Wochen' : currentLang === 'es' ? 'semanas' : 'weeks');
                        labelSuffix = ' ' + weeksNum + ' ' + weekWord;
                    } else if (program === 'youth-camp' && weeks) {
                        const w = parseInt(weeks, 10) || 0;
                        const weekWord = w === 1 ? (currentLang === 'tr' ? 'hafta' : currentLang === 'de' ? 'Woche' : currentLang === 'es' ? 'semana' : 'week') : (currentLang === 'tr' ? 'hafta' : currentLang === 'de' ? 'Wochen' : currentLang === 'es' ? 'semanas' : 'weeks');
                        labelSuffix = ' ' + weeks + ' ' + weekWord + labelSuffix;
                    }
                    courseTypePrice.querySelector('.price-item-label').textContent = (programLabel + labelSuffix).trim();
                    courseTypePrice.querySelector('.price-item-value').textContent = coursePrice > 0 ? coursePrice + ' €' : '-';
                    courseTypePrice.style.display = 'flex';
                    if (durationPrice) durationPrice.style.display = 'none';
                    if (bundleDiscountRow && bundleDiscountValue) {
                        if (multiDiscount.amount > 0) {
                            bundleDiscountRow.style.display = 'flex';
                            bundleDiscountValue.textContent = '-' + multiDiscount.amount + ' €';
                        } else {
                            bundleDiscountRow.style.display = 'none';
                            bundleDiscountValue.textContent = '-';
                        }
                    }
                } else {
                    courseTypePrice.querySelector('.price-item-label').textContent = currentLang === 'tr' ? 'Kurs tipi seçiniz' : currentLang === 'de' ? 'Kurstyp wählen' : currentLang === 'es' ? 'Seleccione tipo' : 'Select course type';
                    courseTypePrice.querySelector('.price-item-value').textContent = '-';
                    if (durationPrice) durationPrice.style.display = 'none';
                    if (bundleDiscountRow) {
                        bundleDiscountRow.style.display = 'none';
                        if (bundleDiscountValue) bundleDiscountValue.textContent = '-';
                    }
                }

                const courseFeeText = courseTypePrice?.querySelector('.price-item-value')?.textContent?.trim() || '';
                const courseFeeDisplayed = parseInt(courseFeeText.replace(/[^0-9]/g, ''), 10) || 0;
                let multiDiscountDisplayed = 0;
                if (bundleDiscountRow && bundleDiscountRow.style.display !== 'none' && bundleDiscountValue) {
                    const discountText = bundleDiscountValue.textContent?.trim() || '';
                    multiDiscountDisplayed = parseInt(discountText.replace(/[^0-9]/g, ''), 10) || 0;
                }
                const effectiveCourseFromDOM = Math.max(0, courseFeeDisplayed - multiDiscountDisplayed);

                const visaNeeded = document.querySelector('[name="visa-guarantee"]:checked')?.value === 'yes';
                if (visaPriceRow) {
                    visaPriceRow.style.display = visaNeeded ? 'flex' : 'none';
                }

                const universityNeeded = document.querySelector('[name="university-admission-support"]:checked')?.value === 'yes';
                if (universityAdmissionPriceRow) {
                    universityAdmissionPriceRow.style.display = universityNeeded ? 'flex' : 'none';
                }

                const accommodationNeeded = document.querySelector('[name="accommodation-support"]:checked')?.value === 'yes';
                if (accommodationPriceRow) {
                    accommodationPriceRow.style.display = accommodationNeeded ? 'flex' : 'none';
                }

                const airportPickup = document.querySelector('[name="airport-pickup"]:checked')?.value === 'yes';
                if (airportPriceRow) {
                    airportPriceRow.style.display = airportPickup ? 'flex' : 'none';
                }

                const visaAmount = visaNeeded ? VISA_SUPPORT : 0;
                const universityAmount = universityNeeded ? UNIVERSITY_ADMISSION : 0;
                const accommodationAmount = accommodationNeeded ? ACCOMMODATION_SUPPORT : 0;
                const airportAmount = airportPickup ? AIRPORT_PICKUP : 0;
                const finalTotal = Math.max(0, effectiveCourseFromDOM + visaAmount + universityAmount + accommodationAmount + airportAmount);
                if (totalPriceElement) totalPriceElement.textContent = finalTotal + ' €';
                const amountCentsEl = document.getElementById('amount-in-cents');
                if (amountCentsEl) amountCentsEl.value = String(Math.round(finalTotal * 100));
            }

            // ===== FORM SUBMISSION =====
            const bookingForm = document.getElementById('booking-form');
            function getSubmitButtons() { return bookingForm ? Array.from(bookingForm.querySelectorAll('button[type="submit"]')) : []; }
            function setSubmitButtonsDisabled(disabled) {
                getSubmitButtons().forEach(function(btn) { btn.disabled = disabled; });
            }
            function setSubmitButtonsText(html) {
                getSubmitButtons().forEach(function(btn) { btn.innerHTML = html; });
            }
            function getCompleteButtonsHtml() {
                const submitLabel = bookingForm?.dataset.submitLabel || (lang === 'tr' ? 'Rezervasyonu Tamamla' : lang === 'de' ? 'Reservierung abschließen' : lang === 'es' ? 'Completar reserva' : 'Complete Booking');
                return '<i class="fas fa-calendar-check" aria-hidden="true"></i> ' + submitLabel;
            }
            function restoreSubmitButtons() {
                const html = getCompleteButtonsHtml();
                const buttons = getSubmitButtons();
                if (buttons[0]) buttons[0].innerHTML = html;
            }

            if (bookingForm) {
                bookingForm.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    const formData = new FormData(bookingForm);

                    setSubmitButtonsDisabled(true);
                    const submittingText = lang === 'tr' ? 'Gönderiliyor...' : lang === 'de' ? 'Wird gesendet...' : lang === 'es' ? 'Enviando...' : 'Submitting...';
                    setSubmitButtonsText(submittingText);

                    // 1. Check rate limiting
                    if (!checkRateLimit('booking', 5, 1)) {
                        if (window.showSuccessModal) {
                            window.showSuccessModal('error', window.successModalTranslations?.rateLimitError || 'Çok fazla istek gönderdiniz. Lütfen bir dakika bekleyin.');
                        } else {
                            const rateLimitMsg = lang === 'tr' ? 'Çok fazla istek gönderdiniz. Lütfen bir dakika bekleyin.' : lang === 'de' ? 'Zu viele Anfragen. Bitte warten Sie eine Minute.' : lang === 'es' ? 'Demasiadas solicitudes. Espere un minuto.' : 'Too many requests. Please wait a minute.';
                            alert(rateLimitMsg);
                        }
                        setSubmitButtonsDisabled(false);
                        restoreSubmitButtons();
                        return;
                    }
                    if (!checkHoneypot(bookingForm, 'website')) {
                        console.warn('Bot detected via honeypot');
                        setSubmitButtonsDisabled(false);
                        restoreSubmitButtons();
                        return;
                    }
                    const email = bookingForm.querySelector('[name="email"]')?.value || '';
                    const phoneDial = bookingForm.querySelector('[name="phone-country-code"]')?.value || '';
                    const phoneLocal = bookingForm.querySelector('[name="phone"]')?.value || '';
                    const phone = (phoneDial + ' ' + phoneLocal).trim();
                    if (!validateEmail(email)) {
                        if (window.showSuccessModal) {
                            window.showSuccessModal('error', window.successModalTranslations?.emailError || 'Lütfen geçerli bir e-posta adresi girin.');
                        } else {
                            const emailErrorMsg = lang === 'tr' ? 'Lütfen geçerli bir e-posta adresi girin.' : lang === 'de' ? 'Bitte geben Sie eine gültige E-Mail-Adresse ein.' : lang === 'es' ? 'Introduzca un email válido.' : 'Please enter a valid email address.';
                            alert(emailErrorMsg);
                        }
                        setSubmitButtonsDisabled(false);
                        restoreSubmitButtons();
                        return;
                    }
                    if (!validatePhone(phone)) {
                        if (window.showSuccessModal) {
                            window.showSuccessModal('error', window.successModalTranslations?.phoneError || 'Lütfen geçerli bir telefon numarası girin.');
                        } else {
                            const phoneErrorMsg = lang === 'tr' ? 'Lütfen geçerli bir telefon numarası girin.' : lang === 'de' ? 'Bitte geben Sie eine gültige Telefonnummer ein.' : lang === 'es' ? 'Introduzca un número de teléfono válido.' : 'Please enter a valid phone number.';
                            alert(phoneErrorMsg);
                        }
                        setSubmitButtonsDisabled(false);
                        restoreSubmitButtons();
                        return;
                    }
                    const data = {};
                    
                    // Collect all form data
                    for (let [key, value] of formData.entries()) {
                        if (data[key]) {
                            // Handle multiple values (checkboxes, etc.)
                            if (Array.isArray(data[key])) {
                                data[key].push(value);
                            } else {
                                data[key] = [data[key], value];
                            }
                        } else {
                            data[key] = value;
                        }
                    }
                    
                    const courseSelectionArr = Array.isArray(data['course-selection']) ? data['course-selection'] : (data['course-selection'] ? [data['course-selection']] : []);
                    const program = data.program || '';
                    const courseCount = getSelectedCourseCount(courseSelectionArr);
                    const submittedWeeks = data.weeks ? String(data.weeks) : '';
                    const effectiveWeeks = (program === 'intensive' || program === 'online')
                        ? String(courseCount * WEEKS_PER_LEVEL)
                        : submittedWeeks;
                    const lessonTime = (data['timezone-slot'] || document.getElementById('booking-timezone-slot')?.value || '').trim();
                    const startDateKind = (data['start-date-mode'] || '').trim();
                    const hearAboutKey = data['hear-about'] || '';
                    const bringFriendActive = data['bring-friend-discount'] === 'yes';
                    const yesNo = (field) => (data[field] === 'yes' ? bookingWebhookLabels.yes : bookingWebhookLabels.no);
                    const courseLevelsText = courseSelectionArr
                        .map((v) => bookingWebhookLabels.courseLevel[v] || String(v).toUpperCase())
                        .join(', ');
                    const totalFormatted = document.getElementById('total-price')?.textContent || '0 €';
                    const totalCents = parseInt(String(data.amountInCents || '0').trim(), 10) || 0;

                    let standardizedData = {
                        formType: 'booking',
                        lang: typeof lang !== 'undefined' ? lang : 'tr',
                        sourcePage: data.sourcePage || window.location.pathname,
                        submittedAt: new Date().toISOString(),

                        customer: {
                            firstName: data.first_name || '',
                            lastName: data.last_name || '',
                            email: data.email || '',
                            phone,
                            address: data.address_line || '',
                            postalCode: data.postal_code || '',
                            city: data.city || '',
                            country: data.country || '',
                        },

                        course: {
                            program: bookingWebhookLabels.program[program] || program,
                            levels: courseLevelsText,
                            weeks: effectiveWeeks ? Number(effectiveWeeks) : null,
                            lessonTime: bookingWebhookLabels.lessonTime[lessonTime] || lessonTime,
                            startDate: data['start-date'] || '',
                            startDateKind: bookingWebhookLabels.startDateKind[startDateKind] || startDateKind,
                        },

                        extras: {
                            visaSupport: yesNo('visa-guarantee'),
                            universityAdmission: yesNo('university-admission-support'),
                            accommodation: yesNo('accommodation-support'),
                            airportPickup: yesNo('airport-pickup'),
                        },

                        marketing: {
                            heardFrom: bookingWebhookLabels.hearAbout[hearAboutKey] || hearAboutKey,
                            referrerName: hearAboutKey === 'friend' ? (data['friend-referrer-name'] || '').trim() : '',
                        },

                        bringFriend: bringFriendActive
                            ? {
                                active: bookingWebhookLabels.yes,
                                name: (data['bring-friend-name'] || '').trim(),
                                email: (data['bring-friend-email'] || '').trim(),
                                phone: (data['bring-friend-phone'] || '').trim(),
                            }
                            : { active: bookingWebhookLabels.no },

                        message: (data.message || '').trim(),

                        price: {
                            total: totalFormatted,
                            totalCents,
                        },

                        consents: {
                            terms: data['terms-accepted'] === 'yes',
                            privacy: data['privacy-accepted'] === 'yes',
                        },
                    };
                    
                    // Sanitize all inputs
                    standardizedData = sanitizeObject(standardizedData);

                    // Ücretsiz rezervasyon (webhook)
                    try {
                        const response = await fetch('https://hook.eu2.make.com/40s1h4a3wra21aszpa9y9erfsfooso47', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(standardizedData)
                        });
                        if (response.ok) {
                            if (window.showSuccessModal) {
                                window.showSuccessModal('success', window.successModalTranslations?.bookingSuccess || 'Rezervasyonunuz başarıyla gönderildi! En kısa sürede size dönüş yapacağız.');
                            } else {
                                const successMsg = lang === 'tr' ? 'Rezervasyonunuz başarıyla gönderildi! En kısa sürede size dönüş yapacağız.' : lang === 'de' ? 'Ihre Reservierung wurde erfolgreich gesendet! Wir werden uns so schnell wie möglich bei Ihnen melden.' : lang === 'es' ? '¡Reserva enviada! Nos pondremos en contacto lo antes posible.' : 'Your booking has been successfully submitted! We will get back to you as soon as possible.';
                                alert(successMsg);
                            }
                            bookingForm.reset();
                            const cityInput = document.getElementById('city');
                            if (cityInput) cityInput.removeAttribute('readonly');
                            showStep(1);
                            if (typeof toggleProgramExtras === 'function') toggleProgramExtras();
                            if (typeof toggleAccommodationMonths === 'function') toggleAccommodationMonths();
                            if (typeof toggleBringFriendFields === 'function') toggleBringFriendFields();
                            if (typeof window.resetBookingLessonTimeStep === 'function') window.resetBookingLessonTimeStep();
                            updatePrice();
                        } else {
                            throw new Error('Webhook request failed');
                        }
                    } catch (error) {
                        console.error('Error submitting form:', error);
                        if (window.showSuccessModal) {
                            window.showSuccessModal('error', window.successModalTranslations?.errorMessage || 'Bir hata oluştu. Lütfen tekrar deneyin veya bizimle iletişime geçin.');
                        } else {
                            const errorMsg = lang === 'tr' ? 'Bir hata oluştu. Lütfen tekrar deneyin veya bizimle iletişime geçin.' : lang === 'de' ? 'Ein Fehler ist aufgetreten. Bitte versuchen Sie es erneut oder kontaktieren Sie uns.' : lang === 'es' ? 'Ha ocurrido un error. Inténtelo de nuevo o contáctenos.' : 'An error occurred. Please try again or contact us.';
                            alert(errorMsg);
                        }
                    } finally {
                        setSubmitButtonsDisabled(false);
                        restoreSubmitButtons();
                    }
                });
            }

            function applyBookingPrefillFromUrl() {
                const params = new URLSearchParams(window.location.search);
                const program = params.get('program');
                if (!program) return;

                const programRadio = document.querySelector('[name="program"][value="' + program + '"]');
                if (!(programRadio instanceof HTMLInputElement)) return;

                programRadio.checked = true;
                toggleProgramExtras();

                const courses = (params.get('courses') || '').split(',').map(function (c) { return c.trim(); }).filter(Boolean);
                courses.forEach(function (courseValue) {
                    const cb = document.querySelector('[name="course-selection"][value="' + courseValue + '"]');
                    if (cb instanceof HTMLInputElement) cb.checked = true;
                });

                const weeks = params.get('weeks');
                if (weeks && program === 'short-term') {
                    const weekRadio = document.querySelector('[name="weeks-choice"][value="' + weeks + '"]');
                    if (weekRadio instanceof HTMLInputElement) {
                        weekRadio.checked = true;
                        syncWeeksOtherVisibility();
                        syncWeeksFromControl();
                    }
                }

                syncUnsureCourseSelection();
                toggleBundleInfobox();
                filterWeeksByLevelCourses();
                reorderCourseSelectionChain();
                syncProgramCardsUI();
                syncOnlineCourseCards();
                if (typeof window.syncBookingLessonTimeForProgram === 'function') {
                    window.syncBookingLessonTimeForProgram(program);
                }
                updatePrice();
            }

            // Initialize
            applyBookingPrefillFromUrl();
            updateProgress();
            updatePrice();
            syncProgramCardsUI();
            syncOnlineCourseCards();
        });
    </script>
</MainLayout>

