    <script define:vars={{ pricingData, lang, validCoupons: VALID_COUPONS }}>
        // Import security utilities
        const { checkRateLimit, sanitizeObject, validateEmail, validatePhone, checkHoneypot } = (() => {
            // Rate limiting
            function checkRateLimit(formType, maxRequests = 5, windowMinutes = 1) {
                const key = `form_rate_limit_${formType}`;
                const now = Date.now();
                const windowMs = windowMinutes * 60 * 1000;
                const stored = localStorage.getItem(key);
                if (!stored) {
                    localStorage.setItem(key, JSON.stringify([now]));
                    return true;
                }
                const requests = JSON.parse(stored);
                const recentRequests = requests.filter(timestamp => now - timestamp < windowMs);
                if (recentRequests.length >= maxRequests) return false;
                recentRequests.push(now);
                localStorage.setItem(key, JSON.stringify(recentRequests));
                return true;
            }
            
            // Sanitize input
            function sanitizeInput(input) {
                if (typeof input !== 'string') return '';
                const div = document.createElement('div');
                div.textContent = input;
                return div.innerHTML.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#x27;');
            }
            
            // Sanitize object
            function sanitizeObject(obj) {
                if (typeof obj === 'string') return sanitizeInput(obj);
                if (Array.isArray(obj)) return obj.map(item => sanitizeObject(item));
                if (obj && typeof obj === 'object') {
                    const sanitized = {};
                    for (const key in obj) sanitized[key] = sanitizeObject(obj[key]);
                    return sanitized;
                }
                return obj;
            }
            
            // Validate email
            function validateEmail(email) {
                return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
            }
            
            // Validate phone
            function validatePhone(phone) {
                return /^[\d\s\-\+\(\)]+$/.test(phone) && phone.replace(/\D/g, '').length >= 8;
            }
            
            // Check honeypot
            function checkHoneypot(form, fieldName = 'website') {
                const honeypot = form.querySelector(`[name="${fieldName}"]`);
                return !(honeypot && honeypot.value);
            }
            
            return { checkRateLimit, sanitizeObject, validateEmail, validatePhone, checkHoneypot };
        })();
        
        document.addEventListener('DOMContentLoaded', function() {
            // ===== STEP NAVIGATION =====
            let currentStep = 1;
            const totalSteps = 3;
            const formSteps = document.querySelectorAll('.form-step');
            const stepIndicators = document.querySelectorAll('.step-indicator');
            const progressFill = document.querySelector('.progress-fill');
            const btnNext = document.querySelectorAll('.btn-next');
            const btnPrev = document.querySelectorAll('.btn-prev');

            // Format date for display: "2 March" (day + month name, no leading zero)
            const localeForLang = (lang === 'tr' ? 'tr-TR' : lang === 'de' ? 'de-DE' : lang === 'es' ? 'es-ES' : 'en-GB');
            function formatDateLong(dateStr) {
                const date = new Date(dateStr);
                const day = date.getDate();
                const month = date.toLocaleDateString(localeForLang, { month: 'long' });
                return day + ' ' + month;
            }

            function dateStrToISO(dateStr) {
                dateStr = String(dateStr).trim();
                const [day, month] = dateStr.split('.');
                if (!day || !month) return null;
                const year = 2026;
                const iso = `${year}-${month.padStart(2, '0')}-${day.padStart(2, '0')}`;
                const d = new Date(iso);
                return isNaN(d.getTime()) ? null : iso;
            }

            // Program change: show intensive-type, course selection (levels+exam for intensive/online, camps for youth-camp), weeks
            const programRadios = document.querySelectorAll('[name="program"]');
            const weeksBlock = document.getElementById('weeks-block');
            const weeksSelect = document.getElementById('weeks');
            const intensiveTypeGroup = document.getElementById('intensive-type-group');
            const courseLevelsBlock = document.getElementById('course-levels-block');
            const courseCampsBlock = document.getElementById('course-camps-block');
            const courseSelectionGroup = document.getElementById('course-selection-group');
            const courseBundleInfobox = document.getElementById('course-bundle-infobox');
            const accommodationTypeRadios = document.querySelectorAll('[name="accommodation-type"]');

            function toggleProgramExtras() {
                const program = document.querySelector('[name="program"]:checked')?.value;
                if (courseSelectionGroup) courseSelectionGroup.style.display = program ? 'block' : 'none';
                if (intensiveTypeGroup) intensiveTypeGroup.style.display = (program === 'intensive' || program === 'online') ? 'block' : 'none';
                if (weeksBlock) weeksBlock.style.display = program === 'youth-camp' ? 'block' : 'none';
                if (weeksSelect) {
                    weeksSelect.removeAttribute('required');
                    if (program === 'youth-camp') weeksSelect.setAttribute('required', 'required');
                }
                if (courseLevelsBlock) courseLevelsBlock.style.display = (program === 'intensive' || program === 'online') ? 'block' : 'none';
                if (courseCampsBlock) courseCampsBlock.style.display = program === 'youth-camp' ? 'block' : 'none';
                document.querySelectorAll('[name="course-selection"]').forEach(cb => { cb.checked = false; });
                if (program !== 'intensive' && program !== 'online') {
                    document.querySelectorAll('[name="intensive-type"]').forEach(r => { r.checked = false; });
                }
                toggleWeeksBlockForShortTerm();
                toggleBundleInfobox();
                filterWeeksByLevelCourses();
                enforceShortTermExclusion();
                updatePrice();
            }
            // Hafta seçimi sadece Short Term seçiliyken gösterilir (intensive/online). Youth-camp’te her zaman gösterilir.
            function toggleWeeksBlockForShortTerm() {
                const program = document.querySelector('[name="program"]:checked')?.value;
                const shortTermChecked = Array.from(document.querySelectorAll('[name="course-selection"]:checked')).some(c => c.value === 'short-term');
                const weeksHint = document.getElementById('weeks-short-term-hint');
                if (program === 'youth-camp') {
                    if (weeksBlock) weeksBlock.style.display = 'block';
                    if (weeksSelect) { weeksSelect.removeAttribute('required'); weeksSelect.setAttribute('required', 'required'); }
                    Array.from(weeksSelect?.options || []).forEach(opt => { opt.disabled = false; opt.style.display = ''; });
                    if (weeksHint) weeksHint.style.display = 'none';
                    return;
                }
                if (program === 'intensive' || program === 'online') {
                    if (shortTermChecked) {
                        if (weeksBlock) weeksBlock.style.display = 'block';
                        if (weeksSelect) weeksSelect.setAttribute('required', 'required');
                        if (weeksHint) weeksHint.style.display = 'block';
                        Array.from(weeksSelect?.options || []).forEach(opt => {
                            const v = parseInt(opt.value, 10);
                            const isShortTermOpt = (v >= 1 && v <= 6) || opt.value === '';
                            opt.style.display = isShortTermOpt ? '' : 'none';
                            opt.disabled = !isShortTermOpt && opt.value !== '';
                        });
                        const cur = parseInt(weeksSelect?.value, 10);
                        if (cur < 1 || cur > 6) weeksSelect.value = '';
                    } else {
                        if (weeksBlock) weeksBlock.style.display = 'none';
                        if (weeksSelect) { weeksSelect.removeAttribute('required'); weeksSelect.value = ''; }
                        if (weeksHint) weeksHint.style.display = 'none';
                        Array.from(weeksSelect?.options || []).forEach(opt => { opt.style.display = ''; opt.disabled = false; });
                    }
                }
            }
            function toggleBundleInfobox() {
                const program = document.querySelector('[name="program"]:checked')?.value;
                const checked = Array.from(document.querySelectorAll('[name="course-selection"]:checked'));
                const levelCourses = checked.filter(c => ['a1','a2','b1','b2','c1'].includes(c.value));
                const levelCount = levelCourses.length;
                const hasTelcPrep = checked.some(c => c.value === 'telc-prep');
                const hasShortTerm = checked.some(c => c.value === 'short-term');
                const weeksVal = document.getElementById('weeks')?.value;
                const shortTermWeeks = hasShortTerm ? (parseInt(weeksVal, 10) || 0) : 0;
                const totalWeeks = (program === 'intensive' || program === 'online') ? (levelCount * 8) + (hasTelcPrep ? 8 : 0) + shortTermWeeks : parseInt(weeksVal, 10) || 0;
                const box = courseBundleInfobox;
                const textEl = document.getElementById('course-bundle-infobox-text');
                if (!box || !textEl) return;
                const show = (program === 'intensive' || program === 'online') && checked.length > 0;
                box.style.display = show ? 'flex' : 'none';
                if (!show) return;
                const msgInvite = box.dataset.msgInvite || '';
                const displayWeeks = hasShortTerm ? shortTermWeeks : totalWeeks;
                const msgTotalWeeks = displayWeeks === 1 ? (box.dataset.msgTotalWeekOne || 'Total 1 week') : (box.dataset.msgTotalWeeks || 'Total {n} weeks').replace('{n}', String(displayWeeks));
                textEl.textContent = displayWeeks > 0 ? msgInvite + ' — ' + msgTotalWeeks : msgInvite;
            }
            // Seçilen seviye kursu sayısına göre hafta seçeneklerini filtrele (sadece youth-camp; intensive/online’da hafta sadece Short Term için 1-6)
            function filterWeeksByLevelCourses() {
                const program = document.querySelector('[name="program"]:checked')?.value;
                if (program === 'intensive' || program === 'online') return;
                if (program !== 'youth-camp') return;
                const levelCourses = Array.from(document.querySelectorAll('[name="course-selection"]:checked')).filter(c => ['a1','a2','b1','b2','c1'].includes(c.value));
                const levelCount = levelCourses.length;
                const minWeeks = levelCount >= 2 ? levelCount * 8 : 1;
                const sel = document.getElementById('weeks');
                if (!sel) return;
                const currentVal = sel.value;
                Array.from(sel.options).forEach(opt => {
                    if (opt.value === '') { opt.disabled = false; return; }
                    const w = parseInt(opt.value, 10);
                    opt.disabled = w < minWeeks;
                });
                if (currentVal && parseInt(currentVal, 10) < minWeeks) {
                    sel.value = '';
                    updatePrice();
                }
            }
            programRadios.forEach(r => r.addEventListener('change', toggleProgramExtras));

            // Short term seçiliyken diğer kurslar (A1-C1, Telc-Prep) seçilemesin; diğerleri seçilince short term kaldırılsın
            function enforceShortTermExclusion() {
                const program = document.querySelector('[name="program"]:checked')?.value;
                if (program !== 'intensive' && program !== 'online') return;
                const shortTermCb = document.querySelector('[name="course-selection"][value="short-term"]');
                const otherValues = ['a1','a2','b1','b2','c1','telc-prep'];
                const otherCbs = otherValues.map(v => document.querySelector('[name="course-selection"][value="' + v + '"]')).filter(Boolean);
                if (!shortTermCb) return;
                if (shortTermCb.checked) {
                    otherCbs.forEach(cb => { cb.checked = false; cb.disabled = true; });
                } else {
                    otherCbs.forEach(cb => { cb.disabled = false; });
                    const anyOtherChecked = otherCbs.some(cb => cb.checked);
                    if (anyOtherChecked) shortTermCb.checked = false;
                }
            }

            function toggleAccommodationMonths() {
                const v = document.querySelector('[name="accommodation-type"]:checked')?.value;
                const box = document.getElementById('accommodation-room-infobox');
                if (box) box.style.display = (v === 'single' || v === 'double') ? 'flex' : 'none';
                updatePrice();
            }
            accommodationTypeRadios.forEach(r => r.addEventListener('change', toggleAccommodationMonths));
            (function showAccommodationRoomInfoboxOnLoad() {
                const v = document.querySelector('[name="accommodation-type"]:checked')?.value;
                const box = document.getElementById('accommodation-room-infobox');
                if (box) box.style.display = (v === 'single' || v === 'double') ? 'flex' : 'none';
            })();

            // Extract numeric price from string like "790€" -> 790
            function extractPrice(priceStr) {
                if (priceStr == null || priceStr === '') return 0;
                return parseInt(String(priceStr).replace(/[^0-9]/g, ''), 10) || 0;
            }

            // Get level from sublevel (a1.1 -> a1, b2.2 -> b2)
            function getMainLevel(subLevel) {
                return subLevel.split('.')[0];
            }

            const EXAM_PRICE = 800;
            const VISA_GUARANTEE = 50;
            const AIRPORT_PICKUP = 100;

            // Tiered pricing per week: Intensive 20h vs Intensive+ 25h
            // 8 hafta (tek kurs) = 120€/hafta → 960€
            const TIERS_20H = [
                { min: 1, max: 4, perWeek: 190 },
                { min: 5, max: 7, perWeek: 150 },
                { min: 8, max: 16, perWeek: 120 },
                { min: 17, max: 24, perWeek: 120 },
                { min: 25, max: 999, perWeek: 110 }
            ];
            const TIERS_24H = [
                { min: 1, max: 4, perWeek: 230 },
                { min: 5, max: 7, perWeek: 180 },
                { min: 8, max: 16, perWeek: 160 },
                { min: 17, max: 24, perWeek: 150 },
                { min: 25, max: 999, perWeek: 135 }
            ];
            function getTieredPrice(weeks, isIntensivePlus) {
                const w = parseInt(weeks, 10) || 0;
                if (w < 1) return 0;
                const tiers = isIntensivePlus ? TIERS_24H : TIERS_20H;
                const tier = tiers.find(t => w >= t.min && w <= t.max);
                return tier ? w * tier.perWeek : 0;
            }

            // Get course price: program, courseValue (a1|a2|b1|b2|c1|telc-b1|...), weeks, intensiveType (intensive|intensive-plus)
            function getCoursePrice(program, courseValue, weeks, intensiveType) {
                const mainLevel = (courseValue || '').toString().split('.')[0] || 'a1';
                const isExamCourse = ['telc-b1','telc-b2','telc-c1hs','testdaf'].includes(mainLevel) || (courseValue && ['telc-b1','telc-b2','telc-c1hs','testdaf'].includes(courseValue.toString()));
                if (isExamCourse) return EXAM_PRICE;
                if (program === 'intensive' || program === 'online') {
                    return getTieredPrice(weeks, intensiveType === 'intensive-plus');
                }
                if (program === 'youth-camp') {
                    const w = parseInt(weeks, 10) || 0;
                    if (w < 1) return 0;
                    const isA1A2 = mainLevel === 'a1' || mainLevel === 'a2';
                    const pricingKey = isA1A2 ? 'a1a2' : 'b1b2c1';
                    const weeklyPricing = pricingData.weeklyPricing?.[pricingKey];
                    if (!weeklyPricing) return 0;
                    const durations = Object.keys(weeklyPricing).map(Number).sort((a, b) => a - b);
                    const closest = durations.find(d => d >= w) || durations[durations.length - 1];
                    const pricePerWeek = extractPrice(weeklyPricing[String(closest)] || '0€');
                    return Math.round(pricePerWeek * w);
                }
                return 0;
            }

            function updateProgress() {
                const progress = Math.round((currentStep / totalSteps) * 100);
                progressFill.style.width = progress + '%';
                
                stepIndicators.forEach((indicator, index) => {
                    const stepNum = index + 1;
                    indicator.classList.remove('active', 'completed');
                    if (stepNum < currentStep) {
                        indicator.classList.add('completed');
                    } else if (stepNum === currentStep) {
                        indicator.classList.add('active');
                    }
                });
            }

            function showStep(step) {
                formSteps.forEach((s, index) => {
                    if (index + 1 === step) {
                        s.classList.add('active');
                    } else {
                        s.classList.remove('active');
                    }
                });
                currentStep = step;
                updateProgress();
                updatePrice();
            }
            
