            // Extract numeric price from string like "790€" -> 790
            function extractPrice(priceStr) {
                if (priceStr == null || priceStr === '') return 0;
                return parseInt(String(priceStr).replace(/[^0-9]/g, ''), 10) || 0;
            }

            // Get level from sublevel (a1.1 -> a1, b2.2 -> b2)
