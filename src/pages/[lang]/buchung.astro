            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
        });
        const text = await response.text();
        let data = null;
        try { data = text ? JSON.parse(text) : null; } catch (_) {}
        if (!response.ok) {
            const upstream = [data?.checkoutError, data?.error, data?.detail].filter(Boolean).join(' — ');
            throw new Error(upstream || t.payFail);
        }
        if (data && data.clientSecret) {
            return { mode: 'embedded', clientSecret: data.clientSecret, publishableKey: data.publishableKey || '' };
        }
        if (data && data.checkoutUrl) return { mode: 'hosted', checkoutUrl: data.checkoutUrl };
        throw new Error(data?.error || t.noSession);
    }
    let stripeEmbed = null;
    async function mountStripe(clientSecret, publishableKey) {
        if (!publishableKey) throw new Error(t.noKey);
        const mountEl = document.getElementById('stripe-embed-mount');
        if (mountEl) {
            // Stripe measures container size on mount — keep real dimensions
            mountEl.style.minHeight = '480px';
        }
        const StripeCtor = await loadStripeJs();
        if (stripeEmbed && stripeEmbed.destroy) {
            try { stripeEmbed.destroy(); } catch (_) {}
            stripeEmbed = null;
        }
        const stripe = StripeCtor(publishableKey);
        const checkout = await stripe.initEmbeddedCheckout({ fetchClientSecret: async () => clientSecret });
        checkout.mount('#stripe-embed-mount');
        stripeEmbed = checkout;
        // Help Stripe reflow after overlay layout
        window.dispatchEvent(new Event('resize'));
    }
    function showPayError(message) {
        const errEl = document.getElementById('pay-error');
        const loader = document.getElementById('pay-loader');
        const stage = document.getElementById('pay-stage');
        if (loader) loader.hidden = true;
        if (stage) stage.classList.remove('is-loading');
        errEl.hidden = false;
        errEl.textContent = message;
        const status = document.getElementById('pay-status');
        if (status) status.textContent = '';
    }
    function startPayLoader() {
        const loader = document.getElementById('pay-loader');
        const fill = document.getElementById('pay-bar-fill');
        const status = document.getElementById('pay-status');
        const list = document.getElementById('pay-checks');
        const stage = document.getElementById('pay-stage');
        if (!loader || !fill || !list) return async () => {};
        const hasCoupon = state.couponEur > 0;
        const labels = [t.payCheck1];
        if (hasCoupon) labels.push(fmt(t.payCheckCoupon, { money: euro(state.couponEur) }));
        [
            { key: 'svc-acc', title: t.accTitle },
            { key: 'svc-visa', title: t.visaTitle },
            { key: 'svc-cafe', title: t.cafeTitle },
            { key: 'svc-onboard', title: t.onboardTitle },
        ].forEach((svc) => {
            if (svcOn(svc.key)) labels.push(fmt(t.payCheckService, { name: svc.title }));
        });
        labels.push(t.payCheck2, t.payCheck3);
        list.innerHTML = labels.map((label, i) => `<li data-pay-step="${i}">${label}</li>`).join('');
        const checks = Array.from(list.querySelectorAll('[data-pay-step]'));
        const lastIdx = Math.max(0, checks.length - 1);
        const stepSpan = lastIdx > 0 ? Math.floor(70 / lastIdx) : 70;
        const tickMs = checks.length > 5 ? 360 : 480;
        if (stage) stage.classList.add('is-loading');
        loader.hidden = false;
        if (status) status.textContent = t.payPreparing;
        fill.style.width = '10%';
        let step = 0;
        let ready = false;
        const paintStep = () => {
            checks.forEach((li, i) => {
                li.classList.toggle('is-on', i === step || (ready && i <= step));
                li.classList.toggle('is-done', i < step || ready);
            });
            if (ready) {
                fill.style.width = '100%';
                return;
            }
            const atHold = step >= lastIdx;
            fill.style.width = atHold ? '88%' : String(12 + step * stepSpan) + '%';
        };
        const advance = () => {
            if (ready) return;
            if (step < lastIdx) step += 1;
            paintStep();
        };
        paintStep();
        const timer = setInterval(advance, tickMs);
        return async () => {
            ready = true;
            clearInterval(timer);
            step = lastIdx;
            paintStep();
            checks.forEach((li) => li.classList.add('is-on', 'is-done'));
            fill.style.width = '100%';
            await new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));
            loader.hidden = true;
            if (stage) stage.classList.remove('is-loading');
            window.dispatchEvent(new Event('resize'));
        };
    }
    function isStripeMountReady(el) {
        if (!el) return false;
        const iframe = el.querySelector('iframe');
        if (iframe) {
            const h = iframe.offsetHeight || iframe.getBoundingClientRect().height;
            if (h > 40) return true;
        }
        return el.childElementCount > 0 && (el.offsetHeight > 80 || el.scrollHeight > 80);
    }
    function waitForStripeMount(timeoutMs = 20000) {
        const el = document.getElementById('stripe-embed-mount');
        if (!el) return Promise.reject(new Error(t.noSession));
        if (isStripeMountReady(el)) return Promise.resolve();
        return new Promise((resolve, reject) => {
            let done = false;
            const finish = (ok) => {
                if (done) return;
                done = true;
                obs.disconnect();
                clearInterval(poll);
                clearTimeout(timer);
                if (ok) resolve();
                else reject(new Error(t.noSession));
            };
            const obs = new MutationObserver(() => {
                if (isStripeMountReady(el)) finish(true);
            });
            obs.observe(el, { childList: true, subtree: true, attributes: true });
            const poll = setInterval(() => {
                if (isStripeMountReady(el)) finish(true);
            }, 250);
            const timer = setTimeout(() => finish(isStripeMountReady(el)), timeoutMs);
        });
    }
    async function startPay() {
        document.getElementById('pay-error').hidden = true;
        const mountEl = document.getElementById('stripe-embed-mount');
        mountEl.replaceChildren();
        show('stripe');
        const finishLoader = startPayLoader();
        let payload;
        try { payload = buildPayPayload(); }
        catch (error) { showPayError(error.message || t.amountFail); return; }
        window.__lastPayPayload = payload;
        if (payload.amountInCents <= 0) { showPayError(t.noAmount); return; }
        try {
            const checkout = await requestCheckout(payload);
            if (checkout.mode === 'embedded') {
                await mountStripe(checkout.clientSecret, checkout.publishableKey);
                await waitForStripeMount();
                await finishLoader();
                const status = document.getElementById('pay-status');
                if (status) status.textContent = fmt(t.stripeNote, { money: payload.price.total });
                return;
            }
            if (checkout.mode === 'hosted' && checkout.checkoutUrl) {
                await finishLoader();
                window.location.assign(checkout.checkoutUrl);
                return;
            }
            throw new Error(t.noSession);
        } catch (error) {
            showPayError(error.message || t.payFail);
        }
    }
    document.getElementById('go-summary').onclick = () => {
        if (state.contact) {
            document.getElementById('thanks-title').textContent = t.requestTitle;
            document.getElementById('thanks-lead').textContent = t.firmaLead;
            show('thanks');
            return;
        }
        startPay();
    };
    const paidParams = new URLSearchParams(window.location.search);
    if (paidParams.get('payment') === 'success') {
        const paidSession = paidParams.get('session_id') || '';
        if (paidSession) {
            fetch('https://hook.eu2.make.com/40s1h4a3wra21aszpa9y9erfsfooso47', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ formType: 'booking-paid', sessionId: paidSession }),
            }).catch(() => {});
        }
        document.getElementById('thanks-title').textContent = t.thanksTitle;
        document.getElementById('thanks-lead').textContent = t.paidLead;
        show('thanks');
        const url = new URL(window.location.href);
        url.searchParams.delete('payment');
        url.searchParams.delete('session_id');
        window.history.replaceState({}, '', url.pathname + url.search + url.hash);
    }

    const overlay = document.getElementById('bk-info');
    document.addEventListener('click', (e) => {
        const info = e.target.closest('.bkx-info');
        if (!info) return;
        e.preventDefault();
        e.stopPropagation();
        document.getElementById('bk-info-title').textContent = info.dataset.infoTitle || '';
        document.getElementById('bk-info-text').textContent = info.dataset.infoDesc || '';
        overlay.hidden = false;
    }, true);
    document.getElementById('bk-info-x').onclick = () => { overlay.hidden = true; };
    overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.hidden = true; });
})();
</script>
