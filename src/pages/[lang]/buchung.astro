                const program = document.querySelector('[name="program"]:checked')?.value;
                const checkedCourses = Array.from(document.querySelectorAll('[name="course-selection"]:checked')).map(c => c.value);
                const weeks = getWeeksValue();
                const currentLang = lang || 'tr';
                const t = programLabels[currentLang] || programLabels.tr;

                if (!courseTypePrice) return;

                const courseCount = getSelectedCourseCount(checkedCourses);
                const pricedCourses = checkedCourses.filter(function (c) { return LEVEL_RE.test(c) || c === 'telc-c1-prep'; });
                const dispWeeksIntensive = getIntensiveWeeksTotal(pricedCourses);
                const weeksNum = parseInt(weeks, 10) || 0;

                if (program && (checkedCourses.length > 0 || program === 'short-term')) {
                    let coursePrice = 0;
                    let multiDiscount = { percent: 0, amount: 0 };

                    if (program === 'short-term') {
                        coursePrice = getTieredPrice(weeksNum);
                    } else if (program === 'intensive' || program === 'online') {
                        if (courseCount > 0) {
                            const gross = getIntensiveCourseGross(pricedCourses);
                            multiDiscount = getMultiCourseDiscount(courseCount, gross);
                            coursePrice = gross;
                        }
                    } else if (program === 'youth-camp') {
                        for (const courseValue of checkedCourses) {
                            const levelForCourse = ['berlin-camp', 'muenster-camp', 'bremen-camp'].includes(courseValue) ? 'a1' : courseValue;
                            coursePrice += getCoursePrice(program, levelForCourse, weeks);
                        }
                    }
                    const programLabel = t[program] || program;
                    let labelSuffix = checkedCourses.length ? ' (' + checkedCourses.map(c => c.toUpperCase().replace(/-/g, ' ')).join(', ') + ')' : '';
                    if (program === 'intensive' || program === 'online') {
                        if (dispWeeksIntensive > 0) {
                            const weekWord = dispWeeksIntensive === 1
                                ? (currentLang === 'tr' ? 'hafta' : currentLang === 'de' ? 'Woche' : currentLang === 'es' ? 'semana' : 'week')
                                : (currentLang === 'tr' ? 'hafta' : currentLang === 'de' ? 'Wochen' : currentLang === 'es' ? 'semanas' : 'weeks');
                            labelSuffix = ' ' + dispWeeksIntensive + ' ' + weekWord + labelSuffix;
                        }
                    } else if (program === 'short-term' && weeksNum > 0) {
                        const weekWord = weeksNum === 1
                            ? (currentLang === 'tr' ? 'hafta' : currentLang === 'de' ? 'Woche' : currentLang === 'es' ? 'semana' : 'week')
                            : (currentLang === 'tr' ? 'hafta' : currentLang === 'de' ? 'Wochen' : currentLang === 'es' ? 'semanas' : 'weeks');
                        labelSuffix = ' ' + weeksNum + ' ' + weekWord;
                    } else if (program === 'youth-camp' && weeks) {
                        const w = parseInt(weeks, 10) || 0;
                        const weekWord = w === 1 ? (currentLang === 'tr' ? 'hafta' : currentLang === 'de' ? 'Woche' : currentLang === 'es' ? 'semana' : 'week') : (currentLang === 'tr' ? 'hafta' : currentLang === 'de' ? 'Wochen' : currentLang === 'es' ? 'semanas' : 'weeks');
                        labelSuffix = ' ' + weeks + ' ' + weekWord + labelSuffix;
                    }
                    courseTypePrice.querySelector('.price-item-label').textContent = (programLabel + labelSuffix).trim();
                    courseTypePrice.querySelector('.price-item-value').textContent = coursePrice > 0 ? coursePrice + ' €' : '-';
                    courseTypePrice.style.display = 'flex';
                    if (durationPrice) durationPrice.style.display = 'none';
                    if (bundleDiscountRow && bundleDiscountValue) {
                        bundleDiscountRow.style.display = 'none';
                        bundleDiscountValue.textContent = '-';
                    }
                } else {
                    courseTypePrice.querySelector('.price-item-label').textContent = currentLang === 'tr' ? 'Kurs tipi seçiniz' : currentLang === 'de' ? 'Kurstyp wählen' : currentLang === 'es' ? 'Seleccione tipo' : 'Select course type';
                    courseTypePrice.querySelector('.price-item-value').textContent = '-';
                    if (durationPrice) durationPrice.style.display = 'none';
                    if (bundleDiscountRow) {
                        bundleDiscountRow.style.display = 'none';
                        if (bundleDiscountValue) bundleDiscountValue.textContent = '-';
                    }
                }

                const bringFriendActive = !!document.getElementById('bring-friend-discount')?.checked;
                if (friendDiscountRow) {
                    friendDiscountRow.style.display = bringFriendActive ? 'flex' : 'none';
                    if (friendDiscountValue) friendDiscountValue.textContent = '-' + FRIEND_DISCOUNT + ' €';
                }

                const courseFeeText = courseTypePrice?.querySelector('.price-item-value')?.textContent?.trim() || '';
                const courseFeeDisplayed = parseInt(courseFeeText.replace(/[^0-9]/g, ''), 10) || 0;
                const friendDiscountDisplayed = bringFriendActive ? FRIEND_DISCOUNT : 0;
                const couponDiscountEur = syncCouponUI();
                const effectiveCourseFromDOM = Math.max(0, courseFeeDisplayed - friendDiscountDisplayed - couponDiscountEur);

                const visaNeeded = document.querySelector('[name="visa-guarantee"]:checked')?.value === 'yes';
                if (visaPriceRow) {
                    visaPriceRow.style.display = visaNeeded ? 'flex' : 'none';
                }

                const universityNeeded = document.querySelector('[name="university-admission-support"]:checked')?.value === 'yes';
                if (universityAdmissionPriceRow) {
                    universityAdmissionPriceRow.style.display = universityNeeded ? 'flex' : 'none';
                }

                const accommodationNeeded = document.querySelector('[name="accommodation-support"]:checked')?.value === 'yes';
                if (accommodationPriceRow) {
                    accommodationPriceRow.style.display = accommodationNeeded ? 'flex' : 'none';
                }

                const airportPickup = document.querySelector('[name="airport-pickup"]:checked')?.value === 'yes';
                if (airportPriceRow) {
                    airportPriceRow.style.display = airportPickup ? 'flex' : 'none';
                }

                const speakcafeNeeded = document.querySelector('[name="speakcafe-membership"]:checked')?.value === 'yes';
                const speakcafePriceRow = document.getElementById('speakcafe-price-row');
                if (speakcafePriceRow) {
                    speakcafePriceRow.style.display = speakcafeNeeded ? 'flex' : 'none';
                }

                const visaAmount = visaNeeded ? VISA_SUPPORT : 0;
                const universityAmount = universityNeeded ? UNIVERSITY_ADMISSION : 0;
                const accommodationAmount = accommodationNeeded ? ACCOMMODATION_SUPPORT : 0;
                const airportAmount = airportPickup ? AIRPORT_PICKUP : 0;
                const finalTotal = Math.max(0, effectiveCourseFromDOM + visaAmount + universityAmount + accommodationAmount + airportAmount);
                if (totalPriceElement) totalPriceElement.textContent = finalTotal + ' €';
                const mobileTotalEarly = document.getElementById('bk-mobile-total');
                if (mobileTotalEarly && totalPriceElement) mobileTotalEarly.textContent = totalPriceElement.textContent || '0 €';
                const amountCentsEl = document.getElementById('amount-in-cents');
                if (amountCentsEl) amountCentsEl.value = String(Math.round(finalTotal * 100));
                syncCourseSlotBundlePrices();
                if (typeof toggleBundleInfobox === 'function') toggleBundleInfobox();
                if (typeof syncPaymentUI === 'function') syncPaymentUI();
            }

            // ===== FORM SUBMISSION =====
            const bookingForm = document.getElementById('booking-form');
            function getSubmitButtons() {
                if (!bookingForm) return [];
                const inside = Array.from(bookingForm.querySelectorAll('button[type="submit"]'));
                const linked = Array.from(document.querySelectorAll('button[type="submit"][form="booking-form"]'));
                const byId = document.getElementById('bk-submit-quote');
                const merged = [...inside, ...linked];
                if (byId instanceof HTMLButtonElement && !merged.includes(byId)) merged.push(byId);
                return merged;
            }
            function setSubmitButtonsDisabled(disabled) {
                getSubmitButtons().forEach(function(btn) { btn.disabled = disabled; });
            }
            function setSubmitButtonsText(text) {
                getSubmitButtons().forEach(function(btn) {
                    const label = btn.querySelector('.price-quote-cta__btn-text');
                    if (label) label.textContent = text;
                    else btn.textContent = text;
                });
            }
            function getPaySubmitHtml(isQuote) {
                if (isQuote) {
                    return payUiCopy?.submitQuote || 'Teklif al';
                }
                const label = payUiCopy?.submitPay || payUiCopy?.submitContinue || 'Ödeme yap';
                return label;
            }
            function restoreSubmitButtons() {
                const quoteBtn = document.getElementById('bk-submit-quote');
                if (!(quoteBtn instanceof HTMLButtonElement)) return;
                const label = quoteBtn.querySelector('.price-quote-cta__btn-text');
                const text = getPaySubmitHtml(true);
                if (label) label.textContent = text;
                else quoteBtn.textContent = text;
            }

            function isInGermanySelected() {
                return !!document.getElementById('bremen-resident')?.checked
                    || document.getElementById('in-germany-hidden')?.value === 'yes'
                    || document.querySelector('[name="in-germany"]:checked')?.value === 'yes';
            }

            function normalizePaySelection(rawPlan) {
                const plan = (rawPlan || '').toString();
                if (plan === 'full') return { payPlan: 'full', installOpt: '' };
                if (plan === 'course') return { payPlan: 'installment', installOpt: 'course' };
                if (plan === 'monthly') return { payPlan: 'installment', installOpt: 'monthly' };
                if (plan === 'installment') return { payPlan: 'installment', installOpt: 'course' };
                return { payPlan: plan, installOpt: '' };
            }

            function syncBremenPayLock() {
                const bremenOn = !!document.getElementById('bremen-resident')?.checked;
                const hidden = document.getElementById('in-germany-hidden');
                if (hidden) hidden.value = bremenOn ? 'yes' : 'no';
                const monthlyPlan = document.getElementById('bk-pay-monthly-plan');
                const monthlyInput = monthlyPlan?.querySelector('input[name="pay-plan"]');
                if (monthlyPlan) monthlyPlan.classList.toggle('is-disabled', !bremenOn);
                if (monthlyInput) {
                    monthlyInput.disabled = !bremenOn;
                    if (!bremenOn && monthlyInput.checked) monthlyInput.checked = false;
                }
                const plzWrap = document.getElementById('bk-bremen-plz');
                const plzInput = document.getElementById('bremen-postal');
                if (plzWrap) plzWrap.hidden = !bremenOn;
                if (plzInput) {
                    if (bremenOn) plzInput.setAttribute('required', 'required');
                    else {
                        plzInput.removeAttribute('required');
                        plzInput.value = '';
                    }
                }
                const bremenNote = document.getElementById('bk-bremen-note');
                if (bremenNote) bremenNote.hidden = bremenOn;
            }

            /** Kayıt ücreti (€): Bremen indirimi peşin + kur kur’da; aylıkta uygulanmaz */
            function getRegistrationEur(inGermany, payPlan, installOpt) {
                const isMonthly = payPlan === 'installment' && installOpt === 'monthly';
                if (isMonthly) return reservationDepositEur || 80;
                return inGermany ? 0 : (reservationDepositEur || 80);
            }

            function computeBookingCharge(opts) {
                const totalCents = opts.totalCents || 0;
                const firstCourseCents = opts.firstCourseCents || 0;
                let payPlan = opts.payPlan || '';
                let installOpt = opts.installOpt || '';
                const normalized = normalizePaySelection(payPlan);
                if (payPlan === 'full' || payPlan === 'course' || payPlan === 'monthly') {
                    payPlan = normalized.payPlan;
                    installOpt = normalized.installOpt || installOpt;
                }
                const inGermany = !!opts.inGermany;
                const courseCount = Math.max(0, opts.courseCount || 0);
                const registrationEur = getRegistrationEur(inGermany, payPlan, installOpt);
                const registrationCents = registrationEur * 100;
                const unitCourse = firstCourseCents > 0
                    ? firstCourseCents
                    : Math.round((typeof promoPrice === 'number' ? promoPrice : 0) * 100);

                if (!payPlan) {
                    return {
                        chargeCents: 0,
                        remainingCents: totalCents,
                        depositEur: 0,
                        kind: 'none',
                        fullDiscountEur: 0,
                        registrationFeeEur: 0,
                        germanyNoRegFee: false,
                        bremenCourseDiscountEur: 0,
                        bremenDiscountEur: 0,
                    };
                }
                if (payPlan === 'full') {
                    const charge = Math.max(0, totalCents + registrationCents);
                    return {
                        chargeCents: charge,
                        remainingCents: 0,
                        depositEur: 0,
                        kind: 'full',
                        fullDiscountEur: 0,
                        registrationFeeEur: registrationEur,
                        germanyNoRegFee: inGermany,
                        bremenCourseDiscountEur: 0,
                        bremenDiscountEur: inGermany ? (reservationDepositEur || 80) : 0,
                    };
                }
                if (payPlan === 'installment') {
                    if (installOpt === 'course') {
                        const charge = Math.min(unitCourse + registrationCents, totalCents + registrationCents);
                        const remaining = Math.max(0, totalCents - unitCourse);
                        return {
                            chargeCents: charge,
                            remainingCents: remaining,
                            depositEur: 0,
                            kind: 'installment_course',
                            fullDiscountEur: 0,
                            registrationFeeEur: registrationEur,
                            germanyNoRegFee: inGermany,
                            bremenCourseDiscountEur: 0,
                            bremenDiscountEur: inGermany ? (reservationDepositEur || 80) : 0,
                        };
                    }
                    if (installOpt === 'monthly') {
                        const months = Math.max(2, courseCount * 2);
                        const monthUnit = Math.round(totalCents / months);
                        const charge = monthUnit + registrationCents;
                        const remaining = Math.max(0, totalCents - monthUnit);
                        return {
                            chargeCents: charge,
                            remainingCents: remaining,
                            depositEur: 0,
                            kind: 'installment_monthly',
                            fullDiscountEur: 0,
                            registrationFeeEur: registrationEur,
                            germanyNoRegFee: false,
                            monthlyMonths: months,
                            bremenCourseDiscountEur: 0,
                            bremenDiscountEur: 0,
                        };
                    }
                    const halfPackage = Math.round(totalCents / 2);
                    const charge = halfPackage + registrationCents;
                    const remaining = Math.max(0, totalCents - halfPackage);
                    return {
                        chargeCents: charge,
                        remainingCents: remaining,
                        depositEur: 0,
                        kind: 'installment_half',
                        fullDiscountEur: 0,
                        registrationFeeEur: registrationEur,
                        germanyNoRegFee: inGermany,
                        bremenDiscountEur: 0,
                    };
                }
                return {
                    chargeCents: 0,
                    remainingCents: totalCents,
                    depositEur: 0,
                    kind: 'none',
                    fullDiscountEur: 0,
                    registrationFeeEur: 0,
                    germanyNoRegFee: inGermany,
                    bremenDiscountEur: 0,
                };
            }

            function formatPayEur(cents) {
                const eur = Math.round(cents) / 100;
                return eur.toLocaleString(lang === 'de' ? 'de-DE' : lang === 'tr' ? 'tr-TR' : lang === 'es' ? 'es-ES' : 'en-US') + ' €';
            }

            function getPayChannel() {
                const v = document.querySelector('[name="pay-channel"]:checked')?.value || '';
                return v === 'bank' ? 'bank' : 'card';
            }

            const eeaIsoSet = new Set(
                Array.isArray(eeaCountryIsoList)
                    ? eeaCountryIsoList.map(function (c) { return String(c).toUpperCase(); })
                    : []
            );

            function normalizeCountryIsoClient(raw) {
                const s = String(raw || '').trim();
                if (!s) return '';
                if (/^[a-zA-Z]{2}$/.test(s)) return s.toUpperCase();
                const map = countryNameToIso && typeof countryNameToIso === 'object' ? countryNameToIso : {};
                const key = s
                    .normalize('NFD')
                    .replace(/[\u0300-\u036f]/g, '')
                    .toLowerCase()
                    .replace(/\s+/g, ' ')
                    .trim();
                return String(map[key] || map[s.toLowerCase()] || '').toUpperCase();
            }

            /** Telefon ülke kodu (ISO) öncelikli; yoksa ülke metin alanı. */
            function resolveCustomerCountryIso() {
                const dialRaw = (document.getElementById('phone-country-code')?.value || '').trim();
                const dialNorm = dialRaw.startsWith('+') ? dialRaw : ('+' + dialRaw.replace(/^\+*/, ''));
                const phoneMatch = Array.isArray(phoneCountries)
                    ? phoneCountries.find(function (c) {
                        const d = String(c.dial || '').trim();
                        return d === dialNorm || d === dialRaw || d.replace(/\s/g, '') === dialNorm.replace(/\s/g, '');
                    })
                    : null;
                if (phoneMatch && phoneMatch.iso) {
                    return String(phoneMatch.iso).toUpperCase();
                }
                return normalizeCountryIsoClient(document.getElementById('country')?.value || '');
            }

            function isNonEeaCustomer() {
                const iso = resolveCustomerCountryIso();
                if (!iso) return true;
                return !eeaIsoSet.has(iso);
            }

            /** Net cent → Stripe çekilecek (fee dahil). Oran: uluslararası kart örneği. */
            function withStripeFeeCents(netCents) {
                const net = Math.max(0, Math.round(Number(netCents) || 0));
                if (net <= 0) return 0;
                const rate = typeof stripeFeeRate === 'number' ? stripeFeeRate : 0.0325;
                const fixed = typeof stripeFeeFixedEur === 'number' ? stripeFeeFixedEur : 0.25;
                if (!(rate > 0) || rate >= 1) return net;
                const grossEur = (net / 100 + fixed) / (1 - rate);
                return Math.max(net, Math.round(grossEur * 100));
            }

            function withSwiftBufferCents(netCents) {
                const net = Math.max(0, Math.round(Number(netCents) || 0));
                if (net <= 0) return 0;
                const bufEur = typeof swiftTransferBufferEur === 'number' ? swiftTransferBufferEur : 20;
                return net + Math.round(bufEur * 100);
            }

            function buildDepositInfo(chargeCalc, forQuote, payChannel) {
                const channel = payChannel === 'bank' || payChannel === 'card' ? payChannel : getPayChannel();
                const netChargeCents = forQuote ? 0 : chargeCalc.chargeCents;
                const nonEea = isNonEeaCustomer();
                const countryIso = resolveCustomerCountryIso();
                let chargeCents = netChargeCents;
                let stripeFeeCents = 0;
                let swiftFeeCents = 0;
                if (!forQuote && netChargeCents > 0 && nonEea) {
                    if (channel === 'bank') {
                        chargeCents = withSwiftBufferCents(netChargeCents);
                        swiftFeeCents = Math.max(0, chargeCents - netChargeCents);
                    } else {
                        chargeCents = withStripeFeeCents(netChargeCents);
                        stripeFeeCents = Math.max(0, chargeCents - netChargeCents);
                    }
                }
                return {
                    chargeCents,
                    netChargeCents,
                    stripeFeeCents,
                    swiftFeeCents,
                    payChannel: channel,
                    feeRegion: nonEea ? 'non_eea' : 'eea',
                    customerCountryIso: countryIso || '',
                    remainingCents: chargeCalc.remainingCents,
                    depositEur: chargeCalc.registrationFeeEur || 0,
                    balanceDueDays: chargeCalc.registrationFeeEur ? balanceDueDays : 0,
                    kind: forQuote ? 'quote' : chargeCalc.kind,
                    fullDiscountEur: chargeCalc.fullDiscountEur || 0,
                    germanyNoRegFee: !!chargeCalc.germanyNoRegFee,
                    registrationFeeEur: chargeCalc.registrationFeeEur || 0,
                };
            }

            function buildStripeLineItemsForDeposit(depositInfo, payPlan) {
                const isInstallmentPay = payPlan === 'installment';
                const chargeEur = Math.round(depositInfo.netChargeCents) / 100;
                const feeLineName = lang === 'tr'
                    ? 'Kart işlem ücreti'
                    : lang === 'de'
                      ? 'Kartengebühr'
                      : lang === 'es'
                        ? 'Comisión de tarjeta'
                        : 'Card processing fee';
                const swiftLineName = lang === 'tr'
                    ? 'SWIFT / havale buffer'
                    : lang === 'de'
                      ? 'SWIFT-Puffer'
                      : lang === 'es'
                        ? 'Buffer SWIFT'
                        : 'SWIFT buffer';
                const bookingLineName = isInstallmentPay
                    ? ('Installment payment ' + chargeEur + ' EUR')
                    : 'Campus German booking';
                const items = [];
                if (depositInfo.netChargeCents > 0) {
                    items.push({
                        productKey: stripeAdjustProduct.productKey,
                        name: bookingLineName,
                        amountCents: depositInfo.netChargeCents,
                        quantity: 1,
                        useCustomAmount: true,
                    });
                }
                if (depositInfo.stripeFeeCents > 0) {
                    items.push({
                        productKey: stripeAdjustProduct.productKey,
                        name: feeLineName,
                        amountCents: depositInfo.stripeFeeCents,
                        quantity: 1,
                        useCustomAmount: true,
                    });
                }
                if (depositInfo.swiftFeeCents > 0) {
                    items.push({
                        productKey: stripeAdjustProduct.productKey,
                        name: swiftLineName,
                        amountCents: depositInfo.swiftFeeCents,
                        quantity: 1,
                        useCustomAmount: true,
                    });
                }
                return items;
            }

            function applyDepositToPayload(payload, depositInfo, payPlan, totalFormatted, totalCents) {
                const isInstallmentPay = payPlan === 'installment';
                const regEur = depositInfo.registrationFeeEur || depositInfo.depositEur || 0;
                payload.paymentKind = depositInfo.kind;
                payload.payChannel = depositInfo.payChannel || 'card';
                payload.feeRegion = depositInfo.feeRegion || 'non_eea';
                payload.customerCountryIso = depositInfo.customerCountryIso || '';
                payload.amountInCents = depositInfo.chargeCents;
                payload.price = {
                    total: totalFormatted,
                    totalCents,
                    chargeCents: depositInfo.chargeCents,
                    netChargeCents: depositInfo.netChargeCents,
                    stripeFeeCents: depositInfo.stripeFeeCents,
                    swiftFeeCents: depositInfo.swiftFeeCents || 0,
                    remainingCents: depositInfo.remainingCents,
                    depositEur: regEur,
                    registrationFeeEur: regEur,
                    balanceDueDays: depositInfo.balanceDueDays,
                    depositNonRefundable: isInstallmentPay,
                };
                payload.priceCollection = {
                    total: totalFormatted,
                    totalCents,
                    chargeCents: depositInfo.chargeCents,
                    netChargeCents: depositInfo.netChargeCents,
                    stripeFeeCents: depositInfo.stripeFeeCents,
                    swiftFeeCents: depositInfo.swiftFeeCents || 0,
                    remainingCents: depositInfo.remainingCents,
                    depositEur: regEur,
                    registrationFeeEur: regEur,
                    balanceDueDays: depositInfo.balanceDueDays,
                };
                payload.priceTotal = totalFormatted;
                payload.stripeLineItems = buildStripeLineItemsForDeposit(depositInfo, payPlan);
                payload.stripePricing = {
                    mode: 'custom_amount_cents',
                    mapCatalogPrices: false,
                    skipWeeksPackage: true,
                    useLineItemAmounts: true,
                    chargeCents: depositInfo.chargeCents,
                    netChargeCents: depositInfo.netChargeCents,
                    stripeFeeCents: depositInfo.stripeFeeCents,
                    swiftFeeCents: depositInfo.swiftFeeCents || 0,
                    totalCents,
                };
                if (payload.installmentSchedule) {
                    payload.installmentSchedule = Object.assign({}, payload.installmentSchedule, {
                        nowCents: depositInfo.netChargeCents,
                        remainingCents: depositInfo.remainingCents,
                        registrationFeeEur: depositInfo.registrationFeeEur,
                    });
                }
            }

            function buildPayFollowUpPayload(quotePayload, chargeCalc, payPlan, installOpt, totalFormatted, totalCents, payChannel) {
                const channel = payChannel === 'bank' || payChannel === 'card' ? payChannel : getPayChannel();
                const payDeposit = buildDepositInfo(chargeCalc, false, channel);
                const payload = Object.assign({}, quotePayload, {
                    formType: 'booking',
                    paymentChoice: 'pay_now',
                    paymentDoc: 'registration',
                    paymentMethod: channel === 'bank' ? 'swift' : 'online',
                    payChannel: channel,
                });
                applyDepositToPayload(payload, payDeposit, payPlan, totalFormatted, totalCents);
                return payload;
            }

            function syncPaymentUI() {
                syncBremenPayLock();
                const fullAmountEl = document.getElementById('bk-pay-full-amount');
                const fullSaveEl = document.getElementById('bk-pay-full-save');
                const courseNowEl = document.getElementById('bk-pay-course-now');
                const courseHintEl = document.getElementById('bk-pay-course-hint');
                const monthlyNowEl = document.getElementById('bk-pay-monthly-now');
                const monthlyHintEl = document.getElementById('bk-pay-monthly-hint');
                const totalPriceEl = document.getElementById('total-price');
                const totalLabelEl = document.querySelector('.price-total-label');
                const rawPlan = document.querySelector('[name="pay-plan"]:checked')?.value || '';
                const inGermany = isInGermanySelected();
                const totalCents = parseInt(document.getElementById('amount-in-cents')?.value || '0', 10) || 0;
                const checkedCourses = Array.from(document.querySelectorAll('[name="course-selection"]:checked')).map(function (c) { return c.value; });
                const courseCount = getSelectedCourseCount(checkedCourses);
                const registrationEur = getRegistrationEur(
                    inGermany,
                    normalizePaySelection(rawPlan).payPlan,
                    normalizePaySelection(rawPlan).installOpt
                );
                const unitCourseCents = getFirstCourseCents(checkedCourses);

                const pricedForMulti = checkedCourses.filter(function (c) { return LEVEL_RE.test(c) || c === 'telc-c1-prep'; });
                const grossCoursesEur = pricedForMulti.length > 0 ? getIntensiveCourseGross(pricedForMulti) : 0;
                const multiForFull = getMultiCourseDiscount(courseCount, grossCoursesEur);
                const multiSaveEur = 0;
                const waivedRegEur = inGermany ? (reservationDepositEur || 0) : 0;

                const fullCharge = computeBookingCharge({
                    totalCents,
                    firstCourseCents: unitCourseCents,
                    inGermany,
                    courseCount,
                    payPlan: 'full',
                    installOpt: '',
                });
                const courseCharge = computeBookingCharge({
                    totalCents,
                    firstCourseCents: unitCourseCents,
                    inGermany,
                    courseCount,
