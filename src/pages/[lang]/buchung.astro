import { getStartDateOptions, PROMO_PRICE, LESSONS_UP_TO_200, ONLINE_LEVEL_PRICES } from '../../utils/coursePricingHelper';
import { getDatenschutzPath, getAgbPath } from '../../utils/pathHelpers';

export async function getStaticPaths() {
    return [
        { params: { lang: 'tr' } },
        { params: { lang: 'de' } },
        { params: { lang: 'en' } },
        { params: { lang: 'es' } },
    ];
}

const { lang } = Astro.params;
const pricingData = coursePricing[lang === 'es' ? 'de' : (lang as 'tr' | 'de' | 'en')];
const pricingLang = lang === 'es' ? 'de' : (lang as 'tr' | 'de' | 'en');
const START_DATE_YEAR = 2026;
const allStartDateOptions = getStartDateOptions(lang as 'tr' | 'de' | 'en' | 'es', START_DATE_YEAR);
const _today = new Date();
_today.setHours(0, 0, 0, 0);
const startDateOptions = allStartDateOptions.filter((opt) => {
    const [d, m] = opt.value.split('.').map(Number);
    if (!d || !m) return false;
    const dt = new Date(START_DATE_YEAR, m - 1, d);
    return dt >= _today;
});
const termsPath = `/${lang}/${getAgbPath(lang as 'tr' | 'de' | 'en' | 'es')}`;
const privacyPath = `/${lang}/${getDatenschutzPath(lang as 'tr' | 'de' | 'en' | 'es')}`;

const phoneCountries = [
    { iso: 'tr', dial: '+90', name: 'Türkiye' },
    { iso: 'de', dial: '+49', name: 'Deutschland' },
    { iso: 'gb', dial: '+44', name: 'United Kingdom' },
    { iso: 'us', dial: '+1', name: 'United States' },
    { iso: 'es', dial: '+34', name: 'España' },
    { iso: 'fr', dial: '+33', name: 'France' },
