import MainLayout from '../../layouts/MainLayout.astro';
import '../../styles/pages/buchung.css';
import { coursePricing } from '../../data/coursePricing.ts';
import { getFirstMondayStartDateOptions, PROMO_PRICE, LESSONS_UP_TO_200, ONLINE_LEVEL_PRICES, parseDdMmYyyy, snapToNearestMonday, getCourseEndFriday, formatCourseDateRange } from '../../utils/coursePricingHelper';
import {
    RESERVATION_DEPOSIT_EUR,
    BALANCE_DUE_DAYS,
    FULL_PAYMENT_DISCOUNT_EUR,
    STRIPE_EXTRAS,
    STRIPE_ADJUST_PRODUCT,
    TELC_PREP_EUR,
    TELC_PREP_WEEKS,
    STRIPE_FEE_RATE,
    STRIPE_FEE_FIXED_EUR,
    SWIFT_TRANSFER_BUFFER_EUR,
} from '../../data/stripeCatalog';
import { BOOKING_COUPONS, BOOKING_COUPON_DEFAULT_EUR } from '../../data/bookingCoupons';
import { EEA_COUNTRY_ISO, COUNTRY_NAME_TO_ISO } from '../../data/eeaCountries';
import { getServicesPath } from '../../utils/pathHelpers';
export async function getStaticPaths() {
    return [
        { params: { lang: 'tr' } },
        { params: { lang: 'de' } },
        { params: { lang: 'en' } },
        { params: { lang: 'es' } },
    ];
}

const { lang } = Astro.params;
const pricingData = coursePricing[lang === 'es' ? 'de' : (lang as 'tr' | 'de' | 'en')];
const pricingLang = lang === 'es' ? 'de' : (lang as 'tr' | 'de' | 'en');
const wgGuideSlug =
    lang === 'tr'
        ? 'wg-konaklama-bremen'
        : lang === 'de'
          ? 'wg-unterkunft-bremen'
          : lang === 'es'
            ? 'wg-alojamiento-bremen'
            : 'wg-accommodation-bremen';
const wgGuideHref = `/${lang}/${getServicesPath(lang as 'tr' | 'de' | 'en' | 'es')}/${wgGuideSlug}`;
const startDateOptions = getFirstMondayStartDateOptions(lang as 'tr' | 'de' | 'en' | 'es', 10);
const nearestStartDateValue = startDateOptions[0]?.value ?? '';
const defaultCourseStart = (() => {
    const raw = nearestStartDateValue ? parseDdMmYyyy(nearestStartDateValue) : null;
    return raw ? snapToNearestMonday(raw) : null;
})();
const defaultCourseEnd = defaultCourseStart ? getCourseEndFriday(defaultCourseStart, 8) : null;
const defaultCourseRangeLabel =
    defaultCourseStart && defaultCourseEnd
        ? formatCourseDateRange(defaultCourseStart, defaultCourseEnd, lang as 'tr' | 'de' | 'en' | 'es')
        : '';
const defaultTelcEnd = defaultCourseStart ? getCourseEndFriday(defaultCourseStart, TELC_PREP_WEEKS) : null;
const defaultTelcRangeLabel =
    defaultCourseStart && defaultTelcEnd
        ? formatCourseDateRange(defaultCourseStart, defaultTelcEnd, lang as 'tr' | 'de' | 'en' | 'es')
        : '';
const termsPath = `/agb/`;
const privacyPath = `/datenschutz/`;
const widerrufPath = `/widerrufsbelehrung/`;

const bookingCouponMonthNames: Record<string, string[]> = {
    tr: ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'],
    de: ['Januar', 'Februar', 'März', 'April', 'Mai', 'Juni', 'Juli', 'August', 'September', 'Oktober', 'November', 'Dezember'],
    en: ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'],
    es: ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'],
};
const bookingCouponMonth = (bookingCouponMonthNames[lang || 'en'] || bookingCouponMonthNames.en)[new Date().getMonth()];
const bookingCouponWaLabel =
    lang === 'tr'
        ? `${bookingCouponMonth} kuponunu kaçırma · WhatsApp’tan eriş`
        : lang === 'de'
          ? `${bookingCouponMonth}-Code nicht verpassen · per WhatsApp`
          : lang === 'es'
            ? `No pierdas el cupón de ${bookingCouponMonth} · WhatsApp`
            : `Don’t miss the ${bookingCouponMonth} coupon · WhatsApp`;
const bookingCouponWaText =
    lang === 'tr'
        ? `Merhaba, ${bookingCouponMonth} kupon kodumu almak istiyorum.`
        : lang === 'de'
          ? `Hallo, ich möchte den Gutscheincode für ${bookingCouponMonth} erhalten.`
          : lang === 'es'
            ? `Hola, quiero recibir el código de cupón de ${bookingCouponMonth}.`
            : `Hi, I’d like to get the ${bookingCouponMonth} coupon code.`;
const bookingCouponWaHref = `https://wa.me/4915203823792?text=${encodeURIComponent(bookingCouponWaText)}`;

/** Form checkbox metinleri sayfa dilinde; linkler Almanca kök sayfalara gider */
