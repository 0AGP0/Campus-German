            function showBookingError(message) {
                if (window.showSuccessModal) {
                    window.showSuccessModal('error', message || window.successModalTranslations?.errorMessage || 'Bir hata oluştu. Lütfen tekrar deneyin veya bizimle iletişime geçin.');
