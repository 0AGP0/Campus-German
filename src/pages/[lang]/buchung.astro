            }

            function toggleBundleInfobox() {
                const card = document.getElementById('multi-discount-card');
                const labelEl = document.getElementById('multi-discount-label');
                const amountEl = document.getElementById('multi-discount-amount');
                const subEl = document.getElementById('multi-discount-sub');
                const hintEl = document.getElementById('multi-discount-hint');
                const visaEl = document.getElementById('multi-discount-visa');
                if (!card || !labelEl || !amountEl || !hintEl) return;

                const program = document.querySelector('[name="program"]:checked')?.value;
                const checked = Array.from(document.querySelectorAll('[name="course-selection"]:checked'));
                const vals = checked.map(function (c) { return c.value; });
                const priced = vals.filter(function (c) { return LEVEL_RE.test(c) || c === 'telc-c1-prep'; });
                const courseCount = getSelectedCourseCount(vals);
                const show = (program === 'intensive' || program === 'online') && courseCount > 0;

                card.hidden = !show;
                card.classList.remove('is-active', 'is-teaser');
                if (visaEl) visaEl.hidden = true;
                if (subEl) {
                    subEl.hidden = true;
                    subEl.textContent = '';
                }
                if (!show) {
                    amountEl.textContent = '—';
                    hintEl.textContent = '';
                    return;
                }

                const gross = getIntensiveCourseGross(priced);
                const current = getMultiCourseDiscount(courseCount, gross);
                const nextUnit = estimateNextCourseUnit(program);
                const nextGross = gross + nextUnit;
                const next = getMultiCourseDiscount(courseCount + 1, nextGross);
                const moreSave = Math.max(0, next.amount - current.amount);
                const canHintNext = courseCount < MAX_MULTI_COURSE_HINT && nextUnit > 0;

                function fillTpl(tpl, map) {
                    return String(tpl || '').replace(/\{(\w+)\}/g, function (_, key) {
                        return map[key] != null ? String(map[key]) : '';
                    });
                }

                if (courseCount === 1) {
                    card.classList.add('is-teaser');
                    const nextCount = courseCount + 1;
                    const nextUnitPrice = unitPriceAfterMultiDiscount(nextUnit, nextCount);
                    labelEl.textContent = courseInfoCopy?.teaserLabel || '';
                    amountEl.textContent = nextUnitPrice > 0 ? (nextUnitPrice + ' €') : '—';
                    if (subEl) {
                        subEl.hidden = true;
                        subEl.textContent = '';
                    }
                    hintEl.textContent = fillTpl(courseInfoCopy?.teaserHint, {
                        percent: next.percent || nextCount,
                        amount: next.amount,
                        unit: nextUnitPrice,
                    });
                    if (visaEl) visaEl.hidden = true;
                    return;
                }

                card.classList.add('is-active');
                const unitNow = courseCount > 0
                    ? Math.round((gross - current.amount) / courseCount)
                    : 0;
                const perNow = courseCount > 0
                    ? Math.max(0, Math.round(gross / courseCount) - unitNow)
                    : 0;
                labelEl.textContent = courseInfoCopy?.savedLabel || courseInfoCopy?.discountLabel || '';
                amountEl.textContent = current.amount > 0 ? ('−' + current.amount + ' €') : '—';
                if (subEl) {
                    subEl.textContent = fillTpl(courseInfoCopy?.savedSub, {
                        unit: unitNow,
                        per: perNow,
                        percent: current.percent,
                    });
                    subEl.hidden = !subEl.textContent;
                }
                if (canHintNext && moreSave > 0) {
                    hintEl.textContent = fillTpl(courseInfoCopy?.nextHint, { amount: moreSave });
                } else {
                    hintEl.textContent = '';
                }
                if (visaEl) visaEl.hidden = true;
            }
            // Seçilen kamp sayısına göre hafta seçeneklerini filtrele (sadece youth-camp)
            function filterWeeksByLevelCourses() {
                const program = document.querySelector('[name="program"]:checked')?.value;
                if (program === 'intensive' || program === 'online' || program === 'short-term') return;
