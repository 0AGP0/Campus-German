            id: '4',
            name: t.fourName,
            month: PRICE.flexMonth,
            monthLabel: monthLine(PRICE.flexMonth),
            totalLabel: totalLine(PRICE.flexTotal),
            meta: fourRange,
            rate: '4 ' + t.weekWord,
            price: PRICE.flexTotal,
            weeks: 4,
            info: fmt(t.fourInfo, { range: fourRange })
