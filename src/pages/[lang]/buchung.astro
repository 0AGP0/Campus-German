---
import MainLayout from '../../layouts/MainLayout.astro';
import PersonalHelpCarousel from '../../components/PersonalHelpCarousel.astro';
import { getFirstMondayStartDateOptions } from '../../utils/coursePricingHelper';
import { bookingFormCopy } from '../../data/bookingFormCopy';
import { formatCampaignUrgency, getBookingCampaign } from '../../data/bookingCoupons';

export async function getStaticPaths() {
    return [{ params: { lang: 'tr' } }, { params: { lang: 'de' } }, { params: { lang: 'en' } }, { params: { lang: 'es' } }];
}

const { lang } = Astro.params;
const pageLang = lang === 'de' || lang === 'en' || lang === 'es' ? lang : 'tr';
const copy = bookingFormCopy[pageLang];
const startDates = getFirstMondayStartDateOptions(pageLang, 8);
const campaign = getBookingCampaign();
const campaignActive = campaign.active;
const campaignDiscountEur = campaign.discountEur;
const campaignLabel = campaign.label;
const campaignUrgency = formatCampaignUrgency(campaign.daysLeft, copy);
---

<MainLayout title={copy.pageTitle} lang={lang}>
    <section class="bkx-page booking-form-section">
        <div class="bkx">
            <div class="bkx-bar" id="step-bar-wrap" role="progressbar" aria-valuemin="1" aria-valuemax="6" aria-valuenow="1" aria-label={`${copy.step} 1 / 6`}>
                <span id="step-bar"></span>
            </div>
            <div class="bkx-shell">
            <div class="bkx-card">
                <button type="button" class="bkx-back" id="bkx-back" hidden aria-label={copy.btnBack}>
                    <i class="fas fa-chevron-left" aria-hidden="true"></i>
                </button>
                <form id="booking-form" data-lang={pageLang} data-pay-proxy="/booking-pay-proxy.php" onsubmit="return false">
                    <div class="bkx-screen is-on" data-screen="program">
                        <h2>{copy.hProgram}</h2>
                        <p class="bkx-lead">{copy.leadProgram}</p>
                        <div class="bkx-programs" id="program-options-grid"></div>
                        <button type="button" class="bkx-next" id="go-program" disabled>{copy.btnContinue}</button>
                    </div>

                    <div class="bkx-screen" data-screen="level">
                        <div class="bkx-level-head">
                            <div class="bkx-title-row">
                                <div class="bkx-back-mount"></div>
                                <div class="bkx-title-row__text">
                                    <h2>{copy.hLevel}</h2>
                                    <p class="bkx-thin">{copy.levelThin}</p>
                                </div>
                            </div>
                            <p class="bkx-hook" id="level-lead">{copy.levelHook}</p>
                        </div>
                        <div class="bkx-scale" id="level-grid"></div>
                        <PersonalHelpCarousel lang={pageLang} class="bkx-help" />
                        <button type="button" class="bkx-next" id="go-level" disabled>{copy.btnPickPack}</button>
                    </div>

                    <div class="bkx-screen" data-screen="examlevel">
                        <div class="bkx-title-row">
                            <div class="bkx-back-mount"></div>
                            <div class="bkx-title-row__text">
                                <h2>{copy.hExam}</h2>
                                <p class="bkx-lead">{copy.leadExam}</p>
                            </div>
                        </div>
                        <div class="bkx-exams" id="exam-grid"></div>
                        <button type="button" class="bkx-next" id="go-exam" disabled>{copy.btnPickPack}</button>
                    </div>

                    <div class="bkx-screen" data-screen="packages">
                        <div class="bkx-pkg-head">
                            <div class="bkx-pkg-head__left">
                                <div class="bkx-back-mount"></div>
                                <div class="bkx-pkg-head__titles">
                                    <h2>{copy.hPackage}</h2>
                                    <p class="bkx-lead" id="pkg-lead">{copy.leadLevel}</p>
                                </div>
                            </div>
                            {campaignActive && (
                                <aside class="bkx-coupon-chip" id="pkg-coupon" aria-label={copy.couponTitle}>
                                    <div class="bkx-coupon-chip__idle">
                                        <span class="bkx-coupon-chip__offer">
                                            <span class="bkx-coupon-chip__amt">−{campaignDiscountEur}&nbsp;€</span>
                                            {campaignUrgency && (
                                                <span class="bkx-coupon-chip__urgency">
                                                    <i class="fas fa-clock" aria-hidden="true"></i>
                                                    {campaignUrgency}
                                                </span>
                                            )}
                                        </span>
                                        <span class="bkx-coupon-chip__meta">
                                            <span class="bkx-coupon-chip__tag">{copy.couponTag}</span>
                                            <span class="bkx-coupon-chip__title">{copy.couponTitle}</span>
                                        </span>
                                        <button type="button" class="bkx-coupon-chip__btn" id="pkg-coupon-apply">{copy.couponApply}</button>
                                    </div>
                                    <div class="bkx-coupon-chip__done" hidden>
                                        <span class="bkx-coupon-chip__offer">
                                            <span class="bkx-coupon-chip__amt">−{campaignDiscountEur}&nbsp;€</span>
                                            {campaignUrgency && (
                                                <span class="bkx-coupon-chip__urgency">
                                                    <i class="fas fa-clock" aria-hidden="true"></i>
                                                    {campaignUrgency}
                                                </span>
                                            )}
                                        </span>
                                        <span class="bkx-coupon-chip__meta">
                                            <span class="bkx-coupon-chip__tag-row">
                                                <span class="bkx-coupon-chip__tag">{copy.couponTag}</span>
                                                <span class="bkx-coupon-chip__badge">
                                                    <i class="fas fa-check" aria-hidden="true"></i>
                                                    {copy.couponAppliedBadge}
                                                </span>
                                            </span>
                                            <span class="bkx-coupon-chip__title">{copy.couponTitle}</span>
                                        </span>
                                        <button type="button" class="bkx-coupon-chip__btn bkx-coupon-chip__btn--remove" id="pkg-coupon-remove">{copy.couponRemove}</button>
                                    </div>
                                </aside>
                            )}
                        </div>
                        <div class="bkx-pkgs" id="pack-grid"></div>
                    </div>

                    <div class="bkx-screen" data-screen="exampack">
                        <div class="bkx-title-row">
                            <div class="bkx-back-mount"></div>
                            <div class="bkx-title-row__text">
                                <h2>{copy.hExamPack}</h2>
                                <p class="bkx-lead">{copy.leadExamPack}</p>
                            </div>
                        </div>
                        <div class="bkx-pkgs" id="exampack-grid"></div>
                        <button type="button" class="bkx-next" id="go-exampack" disabled>{copy.btnExtras}</button>
                    </div>

                    <div class="bkx-screen" data-screen="special">
                        <div class="bkx-title-row">
                            <div class="bkx-back-mount"></div>
                            <h2>{copy.hSpecial}</h2>
                        </div>
                        <div class="bkx-spec" id="special-grid"></div>
                    </div>

                    <div class="bkx-screen" data-screen="extras">
                        <div class="bkx-title-row">
                            <div class="bkx-back-mount"></div>
                            <div class="bkx-title-row__text">
                                <h2>{copy.hExtras}</h2>
                                <p class="bkx-lead">{copy.leadExtras}</p>
                            </div>
                        </div>

                        <div class="bkx-extras-pair">
                            <section class="bkx-panel" aria-labelledby="bkx-start-heading">
                                <div class="bkx-panel__head">
                                    <span class="bkx-panel__icon" aria-hidden="true"><i class="fas fa-calendar-alt"></i></span>
                                    <div class="bkx-panel__titles">
                                        <h3 id="bkx-start-heading">{copy.startLabel}</h3>
                                    </div>
                                    <button type="button" class="bkx-info" data-info-title={copy.startLabel} data-info-desc={copy.startInfo} aria-label={copy.info}><i class="fas fa-info"></i></button>
                                </div>
                                <label class="bkx-sr-only" for="start-date">{copy.startLabel}</label>
                                <select id="start-date" class="bkx-select">
                                    {startDates.map((d) => <option value={d.value}>{d.label}</option>)}
                                </select>
                            </section>

                            <section class="bkx-panel" aria-labelledby="bkx-cert-heading">
                                <div class="bkx-panel__head">
                                    <span class="bkx-panel__icon bkx-panel__icon--amber" aria-hidden="true"><i class="fas fa-certificate"></i></span>
                                    <div class="bkx-panel__titles">
                                        <h3 id="bkx-cert-heading">{copy.certAsk}</h3>
                                        <p class="bkx-course-line" id="course-line"></p>
                                    </div>
                                </div>
                                <fieldset class="bkx-cert">
                                    <legend class="bkx-sr-only">{copy.certAsk}</legend>
                                    <div class="bkx-cert__choice">
                                        <label class="bkx-cert__opt">
                                            <input type="radio" name="cert" value="no" checked />
                                            <span class="bkx-cert__mark" aria-hidden="true"><i class="fas fa-times"></i></span>
                                            <span>{copy.certNo}</span>
                                        </label>
                                        <label class="bkx-cert__opt">
                                            <input type="radio" name="cert" value="yes" />
                                            <span class="bkx-cert__mark" aria-hidden="true"><i class="fas fa-check"></i></span>
                                            <span>{copy.certYes}</span>
                                        </label>
                                        <div id="cert-exams" hidden></div>
                                    </div>
                                </fieldset>
                            </section>
                        </div>

                        <div id="stay-wrap">
                            <div class="bkx-svcs" id="stay-grid"></div>
                            <p class="bkx-warn" id="acc-warn" hidden>{copy.accWarn}</p>
                        </div>
                        <button type="button" class="bkx-next bkx-next--slim" id="go-extras">{copy.btnSummary}</button>
                    </div>

                    <div class="bkx-screen" data-screen="summary">
                        <div class="bkx-title-row">
                            <div class="bkx-back-mount"></div>
                            <div class="bkx-title-row__text">
                                <h2>{copy.hSummary}</h2>
                                <p class="bkx-lead">{copy.leadSummary}</p>
                            </div>
                        </div>
                        <div class="bkx-summary" id="summary-box"></div>
                        <button type="button" class="bkx-next" id="go-summary">{copy.payGo}</button>
                    </div>

                    <div class="bkx-screen" data-screen="stripe">
                        <div class="bkx-title-row">
                            <div class="bkx-back-mount"></div>
                            <div class="bkx-title-row__text">
                                <h2>{copy.hPay}</h2>
                                <p class="bkx-lead" id="pay-status">{copy.payPreparing}</p>
                            </div>
                        </div>
                        <p class="bkx-pay-error" id="pay-error" hidden></p>
                        <div class="bkx-pay-stage" id="pay-stage">
                            <div id="pay-loader" class="bkx-pay-loader" hidden>
                                <div class="bkx-pay-bar" aria-hidden="true"><span id="pay-bar-fill"></span></div>
                                <ul class="bkx-pay-checks" id="pay-checks">
                                    <li data-pay-step="0">{copy.payCheck1}</li>
                                    <li data-pay-step="1">{copy.payCheck2}</li>
                                    <li data-pay-step="2">{copy.payCheck3}</li>
                                </ul>
                            </div>
                            <div id="stripe-embed-mount"></div>
                        </div>
                    </div>

                    <div class="bkx-screen" data-screen="thanks">
                        <div class="bkx-thanks">
                            <span class="bkx-thanks__mark"><i class="fas fa-check"></i></span>
                            <h2 id="thanks-title">{copy.thanksTitle}</h2>
                            <p class="bkx-lead" id="thanks-lead">{copy.thanksLead}</p>
                            <div class="bkx-thanks__actions">
                                <a class="bkx-next" href="https://wa.me/491636927842">WhatsApp</a>
                                <a class="bkx-next bkx-next--ink" href={`/${lang}/`}>{copy.backSite}</a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            </div>
        </div>
    </section>

    <div class="bkx-overlay" id="bk-info" hidden>
        <div class="bkx-popup" role="dialog" aria-modal="true">
            <button type="button" class="bkx-popup__x" id="bk-info-x" aria-label={copy.close}><i class="fas fa-times"></i></button>
            <h3 id="bk-info-title"></h3>
            <p id="bk-info-text"></p>
        </div>
    </div>
</MainLayout>

<style is:global>
    .bkx-page {
        background: #f5f7f9;
        padding: 28px 16px 72px;
        min-height: 70vh;
    }
    .bkx {
        width: min(760px, 100%);
        margin-inline: auto;
    }
    .bkx-bar {
        height: 6px;
        margin-bottom: 14px;
        border-radius: 99px;
        background: #e2e8f0;
        overflow: hidden;
    }
    .bkx-bar span {
        display: block;
        height: 100%;
        width: 16.6%;
        background: #0cc0df;
        border-radius: inherit;
        transition: width 0.25s ease;
    }
    /* Icon-only back chevron — absolute in mount so it does not shift the h2 */
    .bkx-title-row,
    .bkx-pkg-head__left {
        position: relative;
    }
    .bkx-title-row:has(.bkx-back:not([hidden])),
    .bkx-pkg-head__left:has(.bkx-back:not([hidden])) {
        padding-left: 32px;
    }
    .bkx-title-row {
        display: flex;
        align-items: flex-start;
    }
    .bkx-title-row__text {
        min-width: 0;
        flex: 1 1 auto;
    }
    .bkx-title-row__text h2 { margin: 0; }
    .bkx-back-mount {
        position: absolute;
        left: 0;
        top: 0.1rem;
        width: 0;
        height: 28px;
        overflow: visible;
        display: flex;
        align-items: center;
        justify-content: flex-start;
    }
    .bkx-back-mount:empty,
    .bkx-back-mount:has(.bkx-back[hidden]) { display: none; }
    .bkx-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        margin: 0;
        padding: 0;
        border: 0;
        background: transparent;
        color: #94a3b8;
        cursor: pointer;
        transition: color 0.15s ease;
        flex: 0 0 auto;
    }
    .bkx-back[hidden] { display: none !important; }
    .bkx-back i { font-size: 0.72rem; opacity: 0.9; line-height: 1; }
    .bkx-back:hover,
    .bkx-back:focus-visible {
        color: #0a2959;
        outline: none;
    }
    .bkx-shell {
        width: 100%;
        min-width: 0;
        margin-inline: auto;
    }
    .bkx-card {
        position: relative;
        background: #fff;
        border: 1px solid rgba(44, 54, 63, 0.08);
        border-radius: 20px;
        box-shadow: 0 16px 40px rgba(44, 54, 63, 0.06);
        padding: 26px 22px 22px;
        min-width: 0;
        max-width: 760px;
        width: 100%;
        box-sizing: border-box;
    }
    .bkx-pay-error {
        margin: 0 0 12px;
        padding: 10px 12px;
        border-radius: 12px;
        border: 1.5px solid #ff3a3a;
        background: #fff;
        color: #9f1239;
        font-size: 14px;
        font-weight: 700;
    }
    .bkx-pay-stage {
        position: relative;
        min-height: 480px;
    }
    #pay-loader {
        position: absolute;
        inset: 0;
        z-index: 3;
        margin: 0;
        padding: 24px 12px;
        background: #fff;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    #pay-loader[hidden] {
        display: none !important;
    }
    #stripe-embed-mount {
        min-height: 480px;
    }
    .bkx-screen { display: none; }
    .bkx-screen.is-on { display: block; }
    .bkx-level-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 4px;
    }
    .bkx-level-head .bkx-title-row {
        flex: 1 1 auto;
        min-width: 0;
    }
    .bkx-level-head h2 { margin: 0; min-width: 0; }
    .bkx-level-head .bkx-thin { margin-bottom: 12px; }
    .bkx-level-head .bkx-hook {
        margin: 0;
        flex: 0 0 auto;
        text-align: right;
        color: #0a2959;
        font-size: clamp(1.35rem, 3.2vw, 1.85rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.15;
        white-space: nowrap;
    }
    @media (max-width: 560px) {
        .bkx-level-head { flex-wrap: wrap; align-items: flex-end; }
        .bkx-level-head .bkx-hook { width: 100%; text-align: right; font-size: 1.45rem; }
    }
    .bkx-pkg-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px 16px;
        margin-bottom: 18px;
    }
    .bkx-pkg-head__left {
        display: flex;
        align-items: flex-start;
        min-width: 0;
        flex: 1 1 12rem;
    }
    .bkx-pkg-head__titles {
        min-width: 0;
    }
    .bkx-pkg-head__titles h2 {
        margin: 0;
    }
    .bkx-pkg-head__titles .bkx-lead {
        margin: 6px 0 0;
    }
    .bkx-coupon-chip {
        flex: 0 1 auto;
        width: max-content;
        min-width: min(300px, 100%);
        max-width: min(420px, 100%);
        margin: 0;
        padding: 0;
        border: 1.5px solid rgba(15, 118, 110, 0.22);
        border-radius: 14px;
        background:
            linear-gradient(135deg, rgba(15, 118, 110, 0.08), rgba(12, 192, 223, 0.1));
        box-shadow: 0 4px 14px rgba(15, 118, 110, 0.08);
        transition: border-color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
    }
    .bkx-coupon-chip.is-applied {
        border-color: rgba(12, 192, 223, 0.55);
        background:
            linear-gradient(135deg, rgba(15, 118, 110, 0.14), rgba(12, 192, 223, 0.18));
        box-shadow: 0 4px 18px rgba(12, 192, 223, 0.2);
    }
    .bkx-coupon-chip__idle,
    .bkx-coupon-chip__done {
        display: flex;
        align-items: center;
        gap: 8px 12px;
        padding: 8px 12px;
        box-sizing: border-box;
        min-width: 0;
    }
    .bkx-coupon-chip__idle[hidden],
    .bkx-coupon-chip__done[hidden] {
        display: none !important;
    }
    .bkx-coupon-chip__offer {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 5px;
        flex: 0 0 auto;
        min-width: 0;
    }
    .bkx-coupon-chip__amt {
        font-family: 'Outfit', sans-serif;
        font-size: 1.15rem;
        font-weight: 850;
        letter-spacing: -0.03em;
        line-height: 1;
        color: #0f766e;
        white-space: nowrap;
    }
    .bkx-coupon-chip__meta {
        display: flex;
        flex-direction: column;
        gap: 1px;
        min-width: 0;
        flex: 1 1 auto;
    }
    .bkx-coupon-chip__tag-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 4px 6px;
        min-width: 0;
    }
    .bkx-coupon-chip__tag {
        font-size: 0.62rem;
        font-weight: 800;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        color: #0b1f4d;
        line-height: 1.2;
    }
    .bkx-coupon-chip__badge {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        padding: 1px 7px;
        border-radius: 999px;
        background: rgba(15, 118, 110, 0.14);
        color: #0f766e;
        font-size: 0.6rem;
        font-weight: 800;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        line-height: 1.35;
        white-space: nowrap;
    }
    .bkx-coupon-chip__badge i {
        font-size: 0.55rem;
    }
    .bkx-coupon-chip__title {
        font-size: 0.78rem;
        font-weight: 700;
        color: #334155;
        line-height: 1.25;
        white-space: nowrap;
        overflow: visible;
        text-overflow: clip;
    }
    .bkx-coupon-chip__urgency {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 9px;
        border-radius: 999px;
        background: linear-gradient(135deg, #f97316, #ea580c);
        color: #fff;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.02em;
        line-height: 1.3;
        white-space: nowrap;
        box-shadow: 0 2px 8px rgba(234, 88, 12, 0.35);
    }
    .bkx-coupon-chip__urgency i {
        font-size: 0.62rem;
        color: #fff;
        flex: 0 0 auto;
    }
    .bkx-coupon-chip__btn {
        flex: 0 0 auto;
        margin: 0;
        padding: 6px 11px;
        border: 0;
        border-radius: 999px;
        background: linear-gradient(135deg, #0f766e, #0cc0df);
        color: #fff;
        font: inherit;
        font-size: 0.72rem;
        font-weight: 750;
        letter-spacing: 0.01em;
        cursor: pointer;
        white-space: nowrap;
        transition: filter 0.15s ease, transform 0.15s ease;
    }
    .bkx-coupon-chip__btn:hover,
    .bkx-coupon-chip__btn:focus-visible {
        filter: brightness(1.05);
        outline: none;
    }
    .bkx-coupon-chip__btn--remove {
        background: transparent;
        color: #64748b;
        border: 1px solid #cbd5e1;
        box-sizing: border-box;
        padding: 5px 11px;
    }
    .bkx-coupon-chip__btn--remove:hover,
    .bkx-coupon-chip__btn--remove:focus-visible {
        filter: none;
        color: #0a2959;
        border-color: #94a3b8;
        background: #f8fafc;
        outline: none;
    }
    @media (max-width: 720px) {
        .bkx-pkg-head {
            flex-wrap: wrap;
            align-items: stretch;
        }
        .bkx-coupon-chip {
            width: 100%;
            min-width: 0;
            max-width: none;
            flex: 1 1 100%;
        }
        .bkx-coupon-chip__title {
            white-space: normal;
        }
    }
    .bkx-help {
        margin: 18px 0 4px;
    }
    .bkx-pay-loader { margin: 8px 0 18px; }
    .bkx-pay-bar {
        height: 8px;
        margin: 12px 0 16px;
        border-radius: 99px;
        background: #e2e8f0;
        overflow: hidden;
    }
    .bkx-pay-bar span {
        display: block;
        height: 100%;
        width: 8%;
        border-radius: inherit;
        background: linear-gradient(90deg, #0cc0df, #5ae0f0);
        transition: width 0.45s ease;
    }
    .bkx-pay-checks {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 8px;
    }
    .bkx-pay-checks li {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #94a3b8;
        font-size: 0.92rem;
        font-weight: 600;
