                        useCustomAmount: true,
                    });
                }
                if (opts.airport) {
                    items.push({
                        productKey: adjustKey,
                        name: stripeExtras.airport.name,
                        amountCents: Math.round(stripeExtras.airport.eur * 100),
                        quantity: 1,
                        useCustomAmount: true,
                    });
                }

                if (opts.friendDiscountEuro > 0) {
                    items.push({
                        productKey: adjustKey,
                        name: 'Bring-a-friend discount',
                        amountCents: -Math.round(opts.friendDiscountEuro * 100),
                        quantity: 1,
                        useCustomAmount: true,
                    });
                }
                if (opts.bundleDiscountEuro > 0) {
                    items.push({
                        productKey: adjustKey,
                        name: 'Multi-course discount',
                        amountCents: -Math.round(opts.bundleDiscountEuro * 100),
                        quantity: 1,
                        useCustomAmount: true,
                    });
                }

                const filtered = items.filter(function (it) { return it.amountCents !== 0; });

                // Form toplamı ile satır toplamı uyuşmazsa tek satıra düş (çift paket / katalog sapması önlemi)
                const targetCents = Math.round(Number(opts.targetCents) || 0);
                if (targetCents > 0) {
                    const sumCents = filtered.reduce(function (s, it) { return s + it.amountCents * (it.quantity || 1); }, 0);
                    if (sumCents !== targetCents) {
                        return [{
                            productKey: adjustKey,
                            name: 'Campus German booking total',
                            amountCents: targetCents,
