const translations = t[lang as keyof typeof t];
---

<MainLayout title={`${translations.title} - CampusGerman`} lang={lang}>
    <!-- Hero Section -->
    <section class="booking-hero">
        <div class="container">
            <div class="hero-content">
                <h1 class="hero-title">
                    <span class="title-main">{translations.heroTitle.split(' ')[0]}</span>
                    <span class="title-highlight">{translations.heroTitle.split(' ').slice(1).join(' ')}</span>
                </h1>
                <p class="hero-description">
                    {translations.heroDescription}
                </p>
            </div>
        </div>
    </section>

    <!-- Booking Form Section -->
    <section class="booking-form-section">
        <div class="container">
            <div class="booking-form-container">
                <!-- Main Form Section -->
                <div class="booking-form-main">
                    <!-- Progress Steps (3 steps) -->
                    <div class="form-progress">
                        <div class="progress-bar">
                            <div class="progress-fill" style="width: 33.33%"></div>
                        </div>
                        <div class="step-indicators">
                            <div class="step-indicator active" data-step="1">
                                <span class="step-number">1</span>
                                <span class="step-label">{translations.step1}</span>
                            </div>
                            <div class="step-indicator" data-step="2">
                                <span class="step-number">2</span>
                                <span class="step-label">{translations.step2}</span>
                            </div>
                            <div class="step-indicator" data-step="3">
                                <span class="step-number">3</span>
                                <span class="step-label">{translations.step3}</span>
                            </div>
                        </div>
                    </div>

                    <!-- Booking Content Grid -->
                    <div class="booking-content">
                        <!-- Form Section -->
                        <div class="form-section">
                            <!-- Booking Form -->
                            <form id="booking-form" class="booking-form" data-coupon-success={translations.couponSuccess} data-coupon-invalid={translations.couponInvalid} data-checkout-api={import.meta.env.PUBLIC_MAKE_STRIPE_CHECKOUT_WEBHOOK ?? ''}>
                                <input type="hidden" name="sourcePage" value={Astro.url.pathname} />
                                <input type="hidden" name="amountInCents" id="amount-in-cents" value="0" />
                                <!-- Honeypot field for spam protection -->
                                <input type="text" name="website" style="position: absolute; left: -9999px; opacity: 0; pointer-events: none; tabindex: -1;" autocomplete="off" aria-hidden="true" />
                                <!-- Step 1: Program -->
                                <div class="form-step active" data-step="1">
                                    <div class="step-header">
                                        <h2>{translations.courseInfo}</h2>
                                        <p>{translations.courseInfoDesc}</p>
                                    </div>
                                    <div class="form-grid">
                                        <div class="form-group full-width">
                                            <label>{translations.programLabel} *</label>
                                            <div class="option-buttons program-options" role="group" aria-label={translations.programLabel}>
                                                <label class="option-btn">
                                                    <input type="radio" name="program" value="intensive" required>
                                                    <span class="option-btn-text">🎓 {translations.intensiveAcademic}</span>
                                                </label>
                                                <label class="option-btn">
                                                    <input type="radio" name="program" value="online">
                                                    <span class="option-btn-text">💻 {translations.onlineCourse}</span>
                                                </label>
                                                <label class="option-btn">
                                                    <input type="radio" name="program" value="youth-camp">
                                                    <span class="option-btn-text">🏖️ {translations.youthCamp}</span>
                                                </label>
                                            </div>
                                        </div>
                                        <div class="form-group full-width" id="intensive-type-group" style="display: none;">
                                            <label>{translations.intensiveTypeLabel} *</label>
                                            <div class="option-buttons" role="group">
                                                <label class="option-btn">
                                                    <input type="radio" name="intensive-type" value="intensive">
                                                    <span class="option-btn-text">{translations.intensive20}</span>
                                                </label>
                                                <label class="option-btn">
                                                    <input type="radio" name="intensive-type" value="intensive-plus">
                                                    <span class="option-btn-text">{translations.intensivePlus25}</span>
                                                </label>
                                            </div>
                                        </div>
                                        <div class="form-group full-width" id="course-selection-group" style="display: none;">
                                            <label>{translations.courseSelectionLabel} *</label>
                                            <div id="course-bundle-infobox" class="form-infobox" style="display: none;" role="status" data-msg-applied={translations.bundleDiscountApplied} data-msg-invite={translations.bundleInfobox} data-msg-total-weeks={translations.totalWeeksInfo} data-msg-total-week-one={translations.totalWeekOne}>
                                                <i class="fas fa-info-circle" aria-hidden="true"></i>
                                                <span id="course-bundle-infobox-text">{translations.bundleInfobox}</span>
                                            </div>
                                            <div id="course-levels-block" class="course-options-group course-options-inline" style="display: none;">
                                                <div class="option-buttons option-buttons-checkboxes" role="group">
                                                    <label class="option-btn option-btn-with-weeks"><input type="checkbox" name="course-selection" value="a1"><span class="option-btn-text">A1</span><span class="option-btn-sublabel">{translations.courseWeeksLabel}</span></label>
                                                    <label class="option-btn option-btn-with-weeks"><input type="checkbox" name="course-selection" value="a2"><span class="option-btn-text">A2</span><span class="option-btn-sublabel">{translations.courseWeeksLabel}</span></label>
                                                    <label class="option-btn option-btn-with-weeks"><input type="checkbox" name="course-selection" value="b1"><span class="option-btn-text">B1</span><span class="option-btn-sublabel">{translations.courseWeeksLabel}</span></label>
                                                    <label class="option-btn option-btn-with-weeks"><input type="checkbox" name="course-selection" value="b2"><span class="option-btn-text">B2</span><span class="option-btn-sublabel">{translations.courseWeeksLabel}</span></label>
                                                    <label class="option-btn option-btn-with-weeks"><input type="checkbox" name="course-selection" value="c1"><span class="option-btn-text">C1</span><span class="option-btn-sublabel">{translations.courseWeeksLabel}</span></label>
                                                    <label class="option-btn option-btn-with-weeks"><input type="checkbox" name="course-selection" value="telc-prep"><span class="option-btn-text">{translations.telcPrepLabel}</span><span class="option-btn-sublabel">{translations.courseWeeksLabel}</span></label>
                                                    <label class="option-btn option-btn-with-weeks"><input type="checkbox" name="course-selection" value="short-term"><span class="option-btn-text">{translations.shortTermLabel}</span><span class="option-btn-sublabel">{translations.shortTermSublabel}</span></label>
                                                </div>
                                            </div>
                                            <div id="course-camps-block" class="course-options-group" style="display: none;">
                                                <div class="option-buttons option-buttons-checkboxes" role="group">
                                                    <label class="option-btn"><input type="checkbox" name="course-selection" value="berlin-camp"><span class="option-btn-text">{translations.campBerlin}</span></label>
                                                    <label class="option-btn"><input type="checkbox" name="course-selection" value="muenster-camp"><span class="option-btn-text">{translations.campMuenchen}</span></label>
                                                    <label class="option-btn"><input type="checkbox" name="course-selection" value="bremen-camp"><span class="option-btn-text">{translations.campBremen}</span></label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="form-group full-width" id="weeks-block" style="display: none;">
                                            <label for="weeks">{translations.weeksLabel} *</label>
                                            <select id="weeks" name="weeks">
                                                <option value="">{translations.weeksPlaceholder}</option>
                                                <option value="1">{translations.weeksOption1}</option>
                                                <option value="2">{translations.weeksOption2}</option>
                                                <option value="3">3</option>
                                                <option value="4">{translations.weeksOption4}</option>
                                                <option value="5">5</option>
                                                <option value="6">6</option>
                                                <option value="8" class="weeks-non-short">{translations.weeksOption8}</option>
                                                <option value="16" class="weeks-non-short">{translations.weeksOption16}</option>
                                                <option value="24" class="weeks-non-short">{translations.weeksOption24}</option>
                                                <option value="32" class="weeks-non-short">{translations.weeksOption32}</option>
                                                <option value="40" class="weeks-non-short">{translations.weeksOption40}</option>
                                                <option value="48" class="weeks-non-short">{translations.weeksOption48}</option>
                                            </select>
                                            <p class="field-hint" id="weeks-short-term-hint" style="display: none;">{translations.weeksMax}</p>
                                        </div>
                                        <div class="form-group full-width">
                                            <label for="start-date">{translations.startDate} *</label>
                                            <p class="field-hint field-hint-under-label">{translations.startDateHint}</p>
                                            <select id="start-date" name="start-date" required>
                                                <option value="">{translations.startDatePlaceholder}</option>
                                                {startDateOptions.map((opt) => (
                                                    <option value={opt.value}>{opt.label}</option>
                                                ))}
                                            </select>
                                        </div>
                                        <div class="form-group full-width">
                                            <label>{translations.timezoneLabel}</label>
                                            <p class="field-hint">{translations.timezoneHint}</p>
                                            <div class="option-buttons option-buttons-checkboxes timezone-options" role="group">
                                                <label class="option-btn"><input type="checkbox" name="timezone" value="morning"><span class="option-btn-text">{translations.timeMorning} ({pricingData?.schedule?.morning?.all?.time ?? '09:00 – 12:30'})</span></label>
                                                <label class="option-btn"><input type="checkbox" name="timezone" value="afternoon"><span class="option-btn-text">{translations.timeAfternoon} ({pricingData?.schedule?.afternoon?.all?.time ?? '13:00 – 16:30'})</span></label>
                                                <label class="option-btn"><input type="checkbox" name="timezone" value="evening"><span class="option-btn-text">{translations.timeEvening} ({pricingData?.schedule?.evening?.all?.time ?? '18:30 – 22:00'})</span></label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-navigation">
                                        <button type="button" class="btn-next">{translations.continueBtn}</button>
                                    </div>
                                </div>

                                <!-- Step 2: Extralar -->
                                <div class="form-step" data-step="2">
                                    <div class="step-header">
                                        <h2>{translations.step2}</h2>
                                        <p>{translations.extrasDesc}</p>
                                    </div>
                                    <div class="form-grid">
                                        <div class="form-group">
                                            <label>{translations.visaLabel} *</label>
                                            <div class="option-buttons" role="group">
                                                <label class="option-btn">
                                                    <input type="radio" name="visa-needed" value="yes" required>
                                                    <span class="option-btn-text">{translations.visaYes}</span>
                                                </label>
                                                <label class="option-btn">
                                                    <input type="radio" name="visa-needed" value="no" checked>
                                                    <span class="option-btn-text">{translations.visaNo}</span>
                                                </label>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label>{translations.accommodationLabel} *</label>
                                            <div class="option-buttons" role="group">
                                                <label class="option-btn">
                                                    <input type="radio" name="accommodation-type" value="single" required>
                                                    <span class="option-btn-text">{translations.accommodationSingle}</span>
                                                </label>
                                                <label class="option-btn">
                                                    <input type="radio" name="accommodation-type" value="double">
                                                    <span class="option-btn-text">{translations.accommodationDouble}</span>
                                                </label>
                                                <label class="option-btn">
                                                    <input type="radio" name="accommodation-type" value="no" checked>
                                                    <span class="option-btn-text">{translations.accommodationNo}</span>
                                                </label>
                                            </div>
                                            <div id="accommodation-room-infobox" class="form-infobox mt-2" style="display: none;" role="status">
                                                <i class="fas fa-info-circle" aria-hidden="true"></i>
                                                <span>{translations.accommodationRoomPriceInfo}</span>
                                            </div>
                                        </div>
                                        <div class="form-group full-width">
                                            <label>{translations.airportLabel} *</label>
                                            <div class="option-buttons" role="group">
                                                <label class="option-btn">
                                                    <input type="radio" name="airport-pickup" value="yes" required>
                                                    <span class="option-btn-text">{translations.airportYes}</span>
                                                </label>
                                                <label class="option-btn">
                                                    <input type="radio" name="airport-pickup" value="no" checked>
                                                    <span class="option-btn-text">{translations.airportNo}</span>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-navigation">
                                        <button type="button" class="btn-prev">{translations.back}</button>
                                        <button type="button" class="btn-next">{translations.continueBtn}</button>
                                    </div>
                                </div>

                                <!-- Step 3: Talep -->
                                <div class="form-step" data-step="3">
                                    <div class="step-header">
                                        <h2>{translations.step3}</h2>
                                        <p>{translations.requestDesc}</p>
                                    </div>
                                    <div class="form-grid">
                                        <div class="form-group full-width">
                                            <label for="full-name">{translations.nameLabel} *</label>
                                            <input type="text" id="full-name" name="full-name" required placeholder={translations.namePlaceholder}>
                                        </div>
                                        <div class="form-group">
                                            <label for="city">{translations.cityLabel} *</label>
                                            <input type="text" id="city" name="city" required placeholder={translations.cityPlaceholder}>
                                        </div>
                                        <div class="form-group">
                                            <label for="country">{translations.countryLabel} *</label>
                                            <input type="text" id="country" name="country" required placeholder={translations.countryPlaceholder}>
                                        </div>
                                        <div class="form-group">
                                            <label for="phone">{translations.phoneLabel} *</label>
                                            <input type="tel" id="phone" name="phone" required placeholder={translations.phonePlaceholder}>
                                        </div>
