---

<MainLayout title={`${translations.title} - CampusGerman`} lang={lang}>
    <section class="booking-form-section">
        <div class="container">
            <div class="booking-form-container">
                <!-- Main Form Section -->
                <div class="booking-form-main">
                    <!-- Progress Steps (3 steps) -->
                    <div class="form-progress">
                        <div class="progress-bar">
                            <div class="progress-fill" style="width: 25%"></div>
                        </div>
                        <div class="step-indicators">
                            <div class="step-indicator active" data-step="1">
                                <span class="step-number">1</span>
                                <span class="step-label">{translations.step1}</span>
                            </div>
                            <div class="step-indicator" data-step="2">
                                <span class="step-number">2</span>
                                <span class="step-label">{translations.step2}</span>
                            </div>
                            <div class="step-indicator" data-step="3">
                                <span class="step-number">3</span>
                                <span class="step-label">{translations.step3}</span>
                            </div>
                            <div class="step-indicator" data-step="4">
                                <span class="step-number">4</span>
                                <span class="step-label">{translations.step4}</span>
                            </div>
                        </div>
                    </div>

                    <!-- Booking Content Grid -->
                    <div class="booking-content">
                        <!-- Form Section -->
                        <div class="form-section">
                            <!-- Booking Form -->
                            <form id="booking-form" class="booking-form" data-submit-label={translations.completeBooking}>
                                <input type="hidden" name="sourcePage" value={Astro.url.pathname} />
                                <input type="hidden" name="amountInCents" id="amount-in-cents" value="0" />
                                <!-- Honeypot field for spam protection -->
                                <input type="text" name="website" style="position: absolute; left: -9999px; opacity: 0; pointer-events: none; tabindex: -1;" autocomplete="off" aria-hidden="true" />
                                <!-- Step 1: Program -->
                                <div class="form-step active" data-step="1">
                                    <div class="step-header">
                                        <h2>{translations.courseInfo}</h2>
                                        <p>{translations.courseInfoDesc}</p>
                                    </div>
                                    <div class="form-grid">
                                        <div class="form-group full-width">
                                            <label>{translations.programLabel} *</label>
                                            <div class="program-slot-grid" id="program-options-grid" role="group" aria-label={translations.programLabel}>
                                                {programCardItems.map((item) => (
                                                    <label class={`program-slot program-slot--${item.mod}`}>
                                                        <input type="radio" name="program" value={item.value} />
                                                        <span class="program-slot__sel-mark" aria-hidden="true"><i class="fas fa-check"></i></span>
                                                        <div class="program-slot__head">
                                                            <img src={item.image} alt="" width="480" height="280" loading="lazy" class="program-slot__photo" />
                                                            <div class="program-slot__head-inner">
                                                                <span class="program-slot__icon"><i class={`fas fa-${item.icon}`}></i></span>
                                                                <div class="program-slot__head-copy">
                                                                    <span class="program-slot__title">{item.title}</span>
                                                                    <span class="program-slot__meta">{item.desc}</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </label>
                                                ))}
                                            </div>
                                        </div>
                                        <input type="hidden" name="intensive-type" id="intensive-type-hidden" value="intensive" />
                                        <div class="form-group full-width" id="course-selection-group" style="display: none;">
                                            <label>{translations.courseSelectionLabel} *</label>
                                            <div id="course-bundle-infobox" class="form-infobox" style="display: none;" role="status">
                                                <i class="fas fa-info-circle" aria-hidden="true"></i>
                                                <span id="course-bundle-infobox-text"></span>
                                            </div>
                                            <div id="course-levels-block" class="course-options-group" style="display: none;">
                                                <div id="course-levels-buttons" class="course-slot-grid" role="group">
                                                    {courseCardLevels.map((level) => {
                                                        const theme = courseSlotThemes[level];
                                                        const isOnlineOnlyLevel = level === 'a1' || level === 'a2';
                                                        return (
                                                            <label class={`course-slot course-slot--${theme.mod}${isOnlineOnlyLevel ? '' : ' course-slot--intensive-only'}`} data-course-level={level}>
                                                                <input type="checkbox" name="course-selection" value={level} class="course-level-cb course-priced-cb" />
                                                                <div class="course-slot__head" aria-hidden="true">
                                                                    <span class="course-slot__sel-mark" aria-hidden="true"></span>
                                                                    <span class="course-slot__icon"><i class={`fas fa-${theme.icon}`}></i></span>
                                                                    <div class="course-slot__head-copy">
                                                                        <span class="course-slot__level-label">{level.toUpperCase()}</span>
                                                                        <span class="course-slot__head-meta">{translations.courseWeeksLabel}</span>
                                                                    </div>
                                                                </div>
                                                                <div class="course-slot__main">
                                                                    <div class="course-slot__tags">
                                                                        <span class="course-slot__badge course-slot__badge--lessons course-slot__mode-intensive">{courseCardLessonsBadge}</span>
                                                                        <span class="course-slot__badge course-slot__badge--period course-slot__mode-intensive">{translations.courseCardInPerson}</span>
                                                                        <span class="course-slot__badge course-slot__badge--lessons course-slot__mode-online">{translations.courseCardOnlineLessons}</span>
                                                                    </div>
                                                                    <ul class="course-slot__features course-slot__mode-intensive">
                                                                        <li><i class="fas fa-check" aria-hidden="true"></i><span>{translations.courseCardFeatureClub}</span></li>
                                                                        <li><i class="fas fa-check" aria-hidden="true"></i><span>{translations.courseCardFeatureNative}</span></li>
                                                                        <li><i class="fas fa-check" aria-hidden="true"></i><span>{translations.courseCardFeatureVisa}</span></li>
                                                                        <li><i class="fas fa-check" aria-hidden="true"></i><span>{translations.courseCardLessons}</span></li>
                                                                    </ul>
                                                                    <ul class="course-slot__features course-slot__mode-online">
                                                                        <li><i class="fas fa-check" aria-hidden="true"></i><span>{translations.courseCardOnlineNoNative}</span></li>
                                                                        <li><i class="fas fa-check" aria-hidden="true"></i><span>{translations.courseCardOnlineNoVisa}</span></li>
                                                                        <li><i class="fas fa-check" aria-hidden="true"></i><span>{translations.courseCardOnlineEvening}</span></li>
                                                                    </ul>
                                                                    <div class="course-slot__foot course-slot__foot--promo course-slot__mode-intensive">
                                                                        <PromoPrice lang={lang} variant="card" />
                                                                    </div>
                                                                    {(level === 'a1' || level === 'a2') && (
                                                                        <div class="course-slot__foot course-slot__foot--promo course-slot__foot--fixed-price course-slot__mode-online">
                                                                            <div class="course-slot__fixed-price">
                                                                                <span class="course-slot__fixed-price-amount">{ONLINE_LEVEL_PRICES[level]} €</span>
                                                                                <span class="course-slot__fixed-price-note">{translations.courseWeeksLabel}</span>
                                                                            </div>
                                                                        </div>
                                                                    )}
                                                                </div>
                                                            </label>
                                                        );
                                                    })}
                                                    <label class="course-slot course-slot--telc course-slot--intensive-only">
                                                        <input type="checkbox" name="course-selection" value="telc-c1-prep" class="course-priced-cb course-telc-cb" />
                                                        <div class="course-slot__head" aria-hidden="true">
                                                            <span class="course-slot__sel-mark" aria-hidden="true"></span>
                                                            <span class="course-slot__icon"><i class="fas fa-certificate"></i></span>
                                                            <div class="course-slot__head-copy">
                                                                <span class="course-slot__level-label course-slot__level-label--sm">{translations.telcC1PrepLabel}</span>
                                                                <span class="course-slot__head-meta">{translations.telcWeeksLabel}</span>
                                                            </div>
                                                        </div>
                                                        <div class="course-slot__main">
                                                            <div class="course-slot__tags">
                                                                <span class="course-slot__badge course-slot__badge--lessons">{translations.telcWeeksLabel}</span>
                                                                <span class="course-slot__badge course-slot__badge--period">{translations.courseCardInPerson}</span>
                                                            </div>
                                                            <ul class="course-slot__features">
                                                                <li><i class="fas fa-check" aria-hidden="true"></i><span>{translations.courseCardFeatureClub}</span></li>
                                                                <li><i class="fas fa-check" aria-hidden="true"></i><span>{translations.courseCardFeatureNative}</span></li>
                                                                <li><i class="fas fa-check" aria-hidden="true"></i><span>{translations.courseCardFeatureVisa}</span></li>
                                                                <li><i class="fas fa-check" aria-hidden="true"></i><span>{translations.courseCardLessons}</span></li>
                                                            </ul>
                                                            <div class="course-slot__foot course-slot__foot--promo course-slot__foot--fixed-price">
                                                                <div class="course-slot__fixed-price">
                                                                    <div class="course-slot__fixed-price-row">
                                                                        <span class="course-slot__fixed-price-amount">{telcPrepPrice}</span>
                                                                        <span class="course-slot__fixed-price-badge">{translations.telcPriceBadge}</span>
                                                                    </div>
                                                                    <span class="course-slot__fixed-price-note">{translations.telcPriceNote}</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </label>
                                                    <label class="course-slot course-slot--unsure">
                                                        <input type="checkbox" name="course-selection" value="unsure" id="course-unsure-cb" />
                                                        <div class="course-slot__head" aria-hidden="true">
                                                            <span class="course-slot__sel-mark" aria-hidden="true"></span>
                                                            <span class="course-slot__icon"><i class="fas fa-question"></i></span>
                                                            <div class="course-slot__head-copy">
                                                                <span class="course-slot__level-label course-slot__level-label--sm">{translations.courseUnsureLabel}</span>
                                                                <span class="course-slot__head-meta">{translations.courseCardUnsureNote}</span>
                                                            </div>
                                                        </div>
                                                    </label>
                                                </div>
                                            </div>
                                            <div id="course-camps-block" class="course-options-group" style="display: none;">
                                                <div class="option-buttons option-buttons-checkboxes" role="group">
                                                    <label class="option-btn"><input type="checkbox" name="course-selection" value="berlin-camp"><span class="option-btn-text">{translations.campBerlin}</span></label>
                                                    <label class="option-btn"><input type="checkbox" name="course-selection" value="muenster-camp"><span class="option-btn-text">{translations.campMuenchen}</span></label>
                                                    <label class="option-btn"><input type="checkbox" name="course-selection" value="bremen-camp"><span class="option-btn-text">{translations.campBremen}</span></label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="form-group full-width" id="weeks-block" style="display: none;">
                                            <input type="hidden" id="weeks-value" name="weeks" value="" />
                                            <label id="weeks-label">{translations.weeksLabel} *</label>
                                            <div id="weeks-buttons-wrap" class="week-slot-grid" role="group" aria-label={translations.weeksLabel} style="display: none;">
                                                {shortTermWeekOptions.map((opt) => (
                                                    <label class={`course-slot course-slot--week course-slot--week-${opt.value}`}>
                                                        <input type="radio" name="weeks-choice" value={String(opt.value)} class="weeks-choice-radio" />
                                                        <div class="course-slot__head" aria-hidden="true">
                                                            <span class="course-slot__sel-mark" aria-hidden="true"></span>
                                                            <span class="course-slot__icon"><i class="fas fa-calendar-week"></i></span>
                                                            <div class="course-slot__head-copy">
                                                                <span class="course-slot__level-label">{opt.value}</span>
                                                                <span class="course-slot__head-meta">{translations.weeksUnitLabel}</span>
                                                            </div>
                                                        </div>
                                                        <div class="course-slot__main course-slot__main--compact-week">
                                                            <ul class="course-slot__features">
                                                                {opt.features.map((feature) => (
                                                                    <li><i class="fas fa-check" aria-hidden="true"></i><span>{feature}</span></li>
                                                                ))}
                                                            </ul>
                                                        </div>
                                                    </label>
                                                ))}
                                                <label class="course-slot course-slot--week course-slot--week-other">
                                                    <input type="radio" name="weeks-choice" value="other" class="weeks-choice-radio" />
                                                    <div class="course-slot__head" aria-hidden="true">
                                                        <span class="course-slot__sel-mark" aria-hidden="true"></span>
                                                        <span class="course-slot__icon"><i class="fas fa-sliders-h"></i></span>
                                                        <div class="course-slot__head-copy">
                                                            <span class="course-slot__level-label course-slot__level-label--sm">{translations.weeksBtnOther}</span>
                                                            <span class="course-slot__head-meta">{translations.weeksOtherPlaceholder}</span>
                                                        </div>
                                                    </div>
                                                    <div class="course-slot__main course-slot__main--compact-week">
                                                        <ul class="course-slot__features">
                                                            {weekCardOtherFeatures.map((feature) => (
                                                                <li><i class="fas fa-check" aria-hidden="true"></i><span>{feature}</span></li>
                                                            ))}
                                                        </ul>
                                                    </div>
                                                </label>
                                            </div>
                                            <div id="weeks-other-wrap" class="weeks-other-panel" style="display: none;">
                                                <label for="weeks-other-input" class="weeks-other-panel__label">{translations.weeksOtherPlaceholder}</label>
                                                <div class="weeks-number-input-wrap">
                                                    <input type="number" id="weeks-other-input" min="1" max="48" placeholder="1–48" aria-label={translations.weeksOtherPlaceholder} class="booking-text-input" />
                                                    <span class="weeks-number-unit">{translations.weeksUnitLabel}</span>
                                                </div>
                                            </div>
                                            <div id="weeks-select-wrap" class="weeks-control-wrap" style="display: none;">
                                                <select id="weeks" aria-label={translations.weeksLabel}>
