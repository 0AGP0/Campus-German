            function validateStep(step) {
                const currentStepElement = formSteps[step - 1];
                let isValid = true;

                if (step === 1) {
                    const program = document.querySelector('[name="program"]:checked')?.value;
                    const courseSelectionGroup = document.getElementById('course-selection-group');
                    const checkedCourses = Array.from(document.querySelectorAll('[name="course-selection"]:checked')).map(c => c.value);
                    const courseLevelsBlock = document.getElementById('course-levels-block');
                    const courseCampsBlock = document.getElementById('course-camps-block');
                    const hasLevelOrUnsure = checkedCourses.includes('unsure') || checkedCourses.some(c => LEVEL_RE.test(c) || c === 'telc-c1-prep');
                    const hasVisibleCourseSelection =
                        (program === 'intensive' || program === 'online')
                            ? (courseLevelsBlock?.offsetParent && hasLevelOrUnsure)
                            : (program === 'short-term')
                                ? true
                            : (program === 'youth-camp')
                                ? (courseCampsBlock?.offsetParent && checkedCourses.length > 0)
                                : false;
                    if (!program) { document.querySelector('[name="program"]')?.closest('.form-group')?.classList.add('error'); isValid = false; } else { document.querySelector('[name="program"]')?.closest('.form-group')?.classList.remove('error'); }
                    if (program && !hasVisibleCourseSelection) { if (courseSelectionGroup) courseSelectionGroup.classList.add('error'); isValid = false; } else { if (courseSelectionGroup) courseSelectionGroup.classList.remove('error'); }
                    if (program === 'short-term' || program === 'youth-camp') {
                        syncWeeksFromControl();
                        const weeks = getWeeksValue();
                        const weeksValid = weeks && parseInt(weeks, 10) >= 1;
                        if (!weeksValid) { weeksBlock?.classList.add('error'); isValid = false; } else { weeksBlock?.classList.remove('error'); }
                    }
                    if (isValid && typeof window.validateBookingLessonTimeStep === 'function') {
                        isValid = window.validateBookingLessonTimeStep();
                    }
                    return isValid;
                }

                if (step === 3) {
                    return validatePaymentChoices(true);
                }

                if (step === 4) {
                    const bringFriend = document.getElementById('bring-friend-discount')?.checked;
                    if (bringFriend) {
                        ['bring-friend-name', 'bring-friend-email', 'bring-friend-phone'].forEach(function (id) {
                            const el = document.getElementById(id);
                            const val = el?.value?.trim();
                            if (!val) {
                                el?.classList.add('error');
                                isValid = false;
                            } else {
                                el?.classList.remove('error');
                            }
                        });
                    }
                }

                const requiredFields = currentStepElement.querySelectorAll('[required]');
                requiredFields.forEach(field => {
                    if (field.offsetParent !== null) {
                        if (!field.value || (field.type === 'radio' && !currentStepElement.querySelector(`[name="${field.name}"]:checked`))) {
                            isValid = false;
                            field.classList.add('error');
                        } else {
                            field.classList.remove('error');
                        }
                    }
                });
                return isValid;
            }

            function validatePaymentChoices(showError) {
                const formData = bookingForm ? new FormData(bookingForm) : null;
                const payPlan = (formData?.get('pay-plan') || '').toString();
                const installOpt = (formData?.get('pay-install') || '').toString();
                const inGermanyRaw = (formData?.get('in-germany') || '').toString();
                const fail = function (msg) {
                    if (showError) showBookingError(msg);
                    return false;
                };
                if (!inGermanyRaw) {
                    return fail(payUiCopy?.needGermany || 'Lütfen konumunuzu seçin.');
                }
                if (!payPlan) {
                    return fail(payUiCopy?.needPlan || 'Lütfen ödeme planı seçin.');
                }
                if (payPlan === 'installment' && !installOpt) {
                    return fail(payUiCopy?.needInstall || 'Lütfen taksit seçeneğini seçin.');
                }
                return true;
            }

            // Next button handlers
            btnNext.forEach(btn => {
                btn.addEventListener('click', function() {
                    if (validateStep(currentStep)) {
                        if (currentStep < totalSteps) {
                            showStep(currentStep + 1);
                        }
                    }
                });
            });

            // Prev button handlers
            btnPrev.forEach(btn => {
                btn.addEventListener('click', function() {
                    if (currentStep > 1) {
                        showStep(currentStep - 1);
                    }
                });
            });

            // Program, course-selection, weeks, extras → update price
            document.querySelectorAll('[name="course-selection"]').forEach(function (el) {
                el.addEventListener('change', function () {
                    enforceShortTermExclusion();
                    syncUnsureCourseSelection();
                    toggleBundleInfobox();
                    filterWeeksByLevelCourses();
                    updatePrice();
                    reorderCourseSelectionChain();
                });
            });
            reorderCourseSelectionChain();
            weeksSelect?.addEventListener('change', function() { setWeeksValue(this.value); toggleBundleInfobox(); updatePrice(); });
            document.querySelectorAll('[name="visa-guarantee"]').forEach(el => el.addEventListener('change', updatePrice));
            document.querySelectorAll('[name="university-admission-support"]').forEach(el => el.addEventListener('change', updatePrice));
            document.querySelectorAll('[name="accommodation-support"]').forEach(el => el.addEventListener('change', updatePrice));
            document.querySelectorAll('[name="airport-pickup"]').forEach(el => el.addEventListener('change', updatePrice));
            document.querySelectorAll('[name="speakcafe-membership"]').forEach(el => el.addEventListener('change', updatePrice));

            function initBookingPhoneDialInput() {
                const dialInput = document.getElementById('phone-country-code');
                if (!(dialInput instanceof HTMLInputElement)) return;
                function normalizeDial() {
                    let v = dialInput.value.trim().replace(/\s/g, '');
                    if (!v) return;
                    if (!v.startsWith('+')) v = '+' + v.replace(/^\+*/, '');
                    dialInput.value = v;
                }
                dialInput.addEventListener('blur', normalizeDial);
                dialInput.addEventListener('change', normalizeDial);
            }
            initBookingPhoneDialInput();

            function toggleBringFriendFields() {
                const checked = document.getElementById('bring-friend-discount')?.checked;
                const block = document.getElementById('bring-friend-fields');
                const fields = ['bring-friend-name', 'bring-friend-email', 'bring-friend-phone'];
                if (block) block.style.display = checked ? 'block' : 'none';
                fields.forEach(function (id) {
                    const el = document.getElementById(id);
                    if (!el) return;
                    if (checked) el.setAttribute('required', 'required');
                    else {
                        el.removeAttribute('required');
                        el.classList.remove('error');
                    }
                });
            }
            const bringFriendCheckbox = document.getElementById('bring-friend-discount');
            if (bringFriendCheckbox) {
                bringFriendCheckbox.addEventListener('change', function () {
                    toggleBringFriendFields();
                    toggleBundleInfobox();
                    updatePrice();
                });
                toggleBringFriendFields();
            }

            // ===== PRICE CALCULATION =====
            const programLabels = {
                tr: { intensive: 'Yoğun Almanca', 'short-term': 'Short term', online: 'Online kurs', 'youth-camp': 'Yaz kampı' },
                de: { intensive: 'Intensiv Deutsch', 'short-term': 'Short term', online: 'Online-Kurs', 'youth-camp': 'Sommercamp' },
                en: { intensive: 'Intensive German', 'short-term': 'Short term', online: 'Online course', 'youth-camp': 'Summer Camp' },
                es: { intensive: 'Alemán intensivo', 'short-term': 'Short term', online: 'Curso online', 'youth-camp': 'Campamento verano' }
            };
            function updatePrice() {
                const courseTypePrice = document.getElementById('course-type-price');
                const durationPrice = document.getElementById('duration-price');
                const bundleDiscountRow = document.getElementById('bundle-discount-row');
                const bundleDiscountValue = document.getElementById('bundle-discount-value');
                const friendDiscountRow = document.getElementById('friend-discount-row');
                const friendDiscountValue = document.getElementById('friend-discount-value');
                const visaPriceRow = document.getElementById('visa-price-row');
                const universityAdmissionPriceRow = document.getElementById('university-admission-price-row');
                const accommodationPriceRow = document.getElementById('accommodation-price-row');
                const airportPriceRow = document.getElementById('airport-price-row');
                const totalPriceElement = document.getElementById('total-price');
                const program = document.querySelector('[name="program"]:checked')?.value;
                const checkedCourses = Array.from(document.querySelectorAll('[name="course-selection"]:checked')).map(c => c.value);
                const weeks = getWeeksValue();
                const currentLang = lang || 'tr';
                const t = programLabels[currentLang] || programLabels.tr;

                if (!courseTypePrice) return;

                const courseCount = getSelectedCourseCount(checkedCourses);
                const pricedCourses = checkedCourses.filter(function (c) { return LEVEL_RE.test(c) || c === 'telc-c1-prep'; });
                const dispWeeksIntensive = getIntensiveWeeksTotal(pricedCourses);
                const weeksNum = parseInt(weeks, 10) || 0;

                if (program && (checkedCourses.length > 0 || program === 'short-term')) {
                    let coursePrice = 0;
                    let multiDiscount = { percent: 0, amount: 0 };

                    if (program === 'short-term') {
                        coursePrice = getTieredPrice(weeksNum);
                    } else if (program === 'intensive' || program === 'online') {
                        if (courseCount > 0) {
                            const gross = getIntensiveCourseGross(pricedCourses);
                            multiDiscount = getMultiCourseDiscount(courseCount, gross);
                            coursePrice = gross;
                        }
                    } else if (program === 'youth-camp') {
                        for (const courseValue of checkedCourses) {
                            const levelForCourse = ['berlin-camp', 'muenster-camp', 'bremen-camp'].includes(courseValue) ? 'a1' : courseValue;
                            coursePrice += getCoursePrice(program, levelForCourse, weeks);
                        }
                    }
                    const programLabel = t[program] || program;
                    let labelSuffix = checkedCourses.length ? ' (' + checkedCourses.map(c => c.toUpperCase().replace(/-/g, ' ')).join(', ') + ')' : '';
                    if (program === 'intensive' || program === 'online') {
                        if (dispWeeksIntensive > 0) {
                            const weekWord = dispWeeksIntensive === 1
                                ? (currentLang === 'tr' ? 'hafta' : currentLang === 'de' ? 'Woche' : currentLang === 'es' ? 'semana' : 'week')
                                : (currentLang === 'tr' ? 'hafta' : currentLang === 'de' ? 'Wochen' : currentLang === 'es' ? 'semanas' : 'weeks');
                            labelSuffix = ' ' + dispWeeksIntensive + ' ' + weekWord + labelSuffix;
                        }
                    } else if (program === 'short-term' && weeksNum > 0) {
                        const weekWord = weeksNum === 1
                            ? (currentLang === 'tr' ? 'hafta' : currentLang === 'de' ? 'Woche' : currentLang === 'es' ? 'semana' : 'week')
                            : (currentLang === 'tr' ? 'hafta' : currentLang === 'de' ? 'Wochen' : currentLang === 'es' ? 'semanas' : 'weeks');
                        labelSuffix = ' ' + weeksNum + ' ' + weekWord;
                    } else if (program === 'youth-camp' && weeks) {
                        const w = parseInt(weeks, 10) || 0;
                        const weekWord = w === 1 ? (currentLang === 'tr' ? 'hafta' : currentLang === 'de' ? 'Woche' : currentLang === 'es' ? 'semana' : 'week') : (currentLang === 'tr' ? 'hafta' : currentLang === 'de' ? 'Wochen' : currentLang === 'es' ? 'semanas' : 'weeks');
                        labelSuffix = ' ' + weeks + ' ' + weekWord + labelSuffix;
                    }
                    courseTypePrice.querySelector('.price-item-label').textContent = (programLabel + labelSuffix).trim();
                    courseTypePrice.querySelector('.price-item-value').textContent = coursePrice > 0 ? coursePrice + ' €' : '-';
                    courseTypePrice.style.display = 'flex';
                    if (durationPrice) durationPrice.style.display = 'none';
                    if (bundleDiscountRow && bundleDiscountValue) {
                        if (multiDiscount.amount > 0) {
                            bundleDiscountRow.style.display = 'flex';
                            const pctLabel = multiDiscount.percent
                                ? (' (−%' + multiDiscount.percent + ')')
                                : '';
                            const labelEl = bundleDiscountRow.querySelector('.price-item-label');
                            if (labelEl) {
                                const baseLabel = labelEl.getAttribute('data-base-label') || labelEl.textContent || '';
                                if (!labelEl.getAttribute('data-base-label')) {
                                    labelEl.setAttribute('data-base-label', baseLabel.replace(/\s*\(−%\d+\)\s*$/, ''));
                                }
                                labelEl.textContent = (labelEl.getAttribute('data-base-label') || '') + pctLabel;
                            }
                            bundleDiscountValue.textContent = '-' + multiDiscount.amount + ' €';
                        } else {
                            bundleDiscountRow.style.display = 'none';
                            bundleDiscountValue.textContent = '-';
                            const labelEl = bundleDiscountRow.querySelector('.price-item-label');
                            if (labelEl && labelEl.getAttribute('data-base-label')) {
                                labelEl.textContent = labelEl.getAttribute('data-base-label');
                            }
                        }
                    }
                } else {
                    courseTypePrice.querySelector('.price-item-label').textContent = currentLang === 'tr' ? 'Kurs tipi seçiniz' : currentLang === 'de' ? 'Kurstyp wählen' : currentLang === 'es' ? 'Seleccione tipo' : 'Select course type';
                    courseTypePrice.querySelector('.price-item-value').textContent = '-';
                    if (durationPrice) durationPrice.style.display = 'none';
                    if (bundleDiscountRow) {
                        bundleDiscountRow.style.display = 'none';
                        if (bundleDiscountValue) bundleDiscountValue.textContent = '-';
                    }
                }

                const bringFriendActive = !!document.getElementById('bring-friend-discount')?.checked;
                if (friendDiscountRow) {
                    friendDiscountRow.style.display = bringFriendActive ? 'flex' : 'none';
                    if (friendDiscountValue) friendDiscountValue.textContent = '-' + FRIEND_DISCOUNT + ' €';
                }

                const courseFeeText = courseTypePrice?.querySelector('.price-item-value')?.textContent?.trim() || '';
                const courseFeeDisplayed = parseInt(courseFeeText.replace(/[^0-9]/g, ''), 10) || 0;
                let multiDiscountDisplayed = 0;
                if (bundleDiscountRow && bundleDiscountRow.style.display !== 'none' && bundleDiscountValue) {
                    const discountText = bundleDiscountValue.textContent?.trim() || '';
                    multiDiscountDisplayed = parseInt(discountText.replace(/[^0-9]/g, ''), 10) || 0;
                }
                const friendDiscountDisplayed = bringFriendActive ? FRIEND_DISCOUNT : 0;
                const effectiveCourseFromDOM = Math.max(0, courseFeeDisplayed - multiDiscountDisplayed - friendDiscountDisplayed);

                const visaNeeded = document.querySelector('[name="visa-guarantee"]:checked')?.value === 'yes';
                if (visaPriceRow) {
                    visaPriceRow.style.display = visaNeeded ? 'flex' : 'none';
                }

                const universityNeeded = document.querySelector('[name="university-admission-support"]:checked')?.value === 'yes';
                if (universityAdmissionPriceRow) {
                    universityAdmissionPriceRow.style.display = universityNeeded ? 'flex' : 'none';
                }

                const accommodationNeeded = document.querySelector('[name="accommodation-support"]:checked')?.value === 'yes';
                if (accommodationPriceRow) {
                    accommodationPriceRow.style.display = accommodationNeeded ? 'flex' : 'none';
                }

                const airportPickup = document.querySelector('[name="airport-pickup"]:checked')?.value === 'yes';
                if (airportPriceRow) {
                    airportPriceRow.style.display = airportPickup ? 'flex' : 'none';
                }

                const speakcafeNeeded = document.querySelector('[name="speakcafe-membership"]:checked')?.value === 'yes';
                const speakcafePriceRow = document.getElementById('speakcafe-price-row');
                if (speakcafePriceRow) {
                    speakcafePriceRow.style.display = speakcafeNeeded ? 'flex' : 'none';
                }

                const visaAmount = visaNeeded ? VISA_SUPPORT : 0;
                const universityAmount = universityNeeded ? UNIVERSITY_ADMISSION : 0;
                const accommodationAmount = accommodationNeeded ? ACCOMMODATION_SUPPORT : 0;
                const airportAmount = airportPickup ? AIRPORT_PICKUP : 0;
                const finalTotal = Math.max(0, effectiveCourseFromDOM + visaAmount + universityAmount + accommodationAmount + airportAmount);
                if (totalPriceElement) totalPriceElement.textContent = finalTotal + ' €';
                const amountCentsEl = document.getElementById('amount-in-cents');
                if (amountCentsEl) amountCentsEl.value = String(Math.round(finalTotal * 100));
                syncCourseSlotBundlePrices();
                if (typeof toggleBundleInfobox === 'function') toggleBundleInfobox();
                if (typeof syncPaymentUI === 'function') syncPaymentUI();
            }

            // ===== FORM SUBMISSION =====
            const bookingForm = document.getElementById('booking-form');
            function getSubmitButtons() { return bookingForm ? Array.from(bookingForm.querySelectorAll('button[type="submit"]')) : []; }
            function setSubmitButtonsDisabled(disabled) {
                getSubmitButtons().forEach(function(btn) { btn.disabled = disabled; });
            }
            function setSubmitButtonsText(html) {
                getSubmitButtons().forEach(function(btn) { btn.innerHTML = html; });
            }
            function getPaySubmitHtml(isQuote) {
                if (isQuote) {
                    return payUiCopy?.submitQuote || 'Teklif al';
                }
                const label = payUiCopy?.submitPay || payUiCopy?.submitContinue || 'Ödeme yap';
                return '<i class="fas fa-credit-card" aria-hidden="true"></i> ' + label;
            }
            function restoreSubmitButtons() {
                const quoteBtn = bookingForm?.querySelector('#bk-submit-quote');
                const payBtn = bookingForm?.querySelector('#bk-pay-submit');
                if (quoteBtn) quoteBtn.innerHTML = getPaySubmitHtml(true);
                if (payBtn) payBtn.innerHTML = getPaySubmitHtml(false);
            }

            function isInGermanySelected() {
                return document.querySelector('[name="in-germany"]:checked')?.value === 'yes';
            }

            function computeBookingCharge(opts) {
                const totalCents = opts.totalCents || 0;
                const firstCourseCents = opts.firstCourseCents || 0;
                const payPlan = opts.payPlan || '';
                const installOpt = opts.installOpt || '';
                const inGermany = !!opts.inGermany;
                const courseCount = opts.courseCount || 0;
                // Almanya + 2 kur → kayıt ücreti yok; aksi halde tek seferlik kayıt ücreti
                const waiveRegFee = inGermany && courseCount >= 2;
                const depositEur = waiveRegFee ? 0 : (reservationDepositEur || 0);
                const depositCents = depositEur * 100;
                const fullDiscEur = waiveRegFee ? 0 : (fullPaymentDiscountEur || 0);
                const fullDiscCents = fullDiscEur * 100;
                const unitCourse = firstCourseCents > 0
                    ? firstCourseCents
                    : Math.round((typeof promoPrice === 'number' ? promoPrice : 0) * 100);

                if (!payPlan) {
                    return {
                        chargeCents: 0,
                        remainingCents: totalCents,
                        depositEur: 0,
                        kind: 'none',
                        fullDiscountEur: 0,
                        registrationFeeEur: 0,
                        germanyNoRegFee: waiveRegFee,
                    };
                }
                if (payPlan === 'full') {
                    const charge = Math.max(0, totalCents + depositCents - fullDiscCents);
                    return {
                        chargeCents: charge,
                        remainingCents: 0,
                        depositEur: 0,
                        kind: 'full',
                        fullDiscountEur: fullDiscEur,
                        registrationFeeEur: depositEur,
                        germanyNoRegFee: waiveRegFee,
                    };
                }
                if (payPlan === 'installment') {
                    if (installOpt === 'course') {
                        // 1. kur + kayıt (varsa); kalan kurlar CRM’de (başlangıç −17 gün)
                        const charge = Math.min(unitCourse + depositCents, totalCents + depositCents);
                        const remaining = Math.max(0, totalCents - unitCourse);
                        return {
                            chargeCents: charge,
                            remainingCents: remaining,
                            depositEur: depositEur,
                            kind: 'installment_course',
                            fullDiscountEur: 0,
                            registrationFeeEur: depositEur,
                            germanyNoRegFee: waiveRegFee,
                        };
                    }
                    // %50/%50: kurs toplamı yarıya; ilk takside +kayıt (varsa)
                    const halfPackage = Math.round(totalCents / 2);
                    const charge = halfPackage + depositCents;
                    const remaining = Math.max(0, totalCents - halfPackage);
                    return {
                        chargeCents: charge,
                        remainingCents: remaining,
                        depositEur: depositEur,
                        kind: 'installment_half',
                        fullDiscountEur: 0,
                        registrationFeeEur: depositEur,
                        germanyNoRegFee: waiveRegFee,
                    };
                }
                return {
                    chargeCents: 0,
                    remainingCents: totalCents,
                    depositEur: 0,
                    kind: 'none',
                    fullDiscountEur: 0,
                    registrationFeeEur: 0,
                    germanyNoRegFee: waiveRegFee,
                };
            }

            function formatPayEur(cents) {
                const eur = Math.round(cents) / 100;
                return eur.toLocaleString(lang === 'de' ? 'de-DE' : lang === 'tr' ? 'tr-TR' : lang === 'es' ? 'es-ES' : 'en-US') + ' €';
            }

            function syncPaymentUI() {
                const planWrap = document.getElementById('bk-pay-plan');
                const installWrap = document.getElementById('bk-pay-install');
                const fullAmountEl = document.getElementById('bk-pay-full-amount');
                const fullSaveEl = document.getElementById('bk-pay-full-save');
                const installAmountEl = document.getElementById('bk-pay-install-amount');
                const totalPriceEl = document.getElementById('total-price');
                const totalLabelEl = document.querySelector('.price-total-label');
                const germanyVal = document.querySelector('[name="in-germany"]:checked')?.value || '';
                const payPlan = document.querySelector('[name="pay-plan"]:checked')?.value || '';
                const installOpt = document.querySelector('[name="pay-install"]:checked')?.value || '';
                const inGermany = germanyVal === 'yes';
                const totalCents = parseInt(document.getElementById('amount-in-cents')?.value || '0', 10) || 0;
                const checkedCourses = Array.from(document.querySelectorAll('[name="course-selection"]:checked')).map(function (c) { return c.value; });
                const courseCount = getSelectedCourseCount(checkedCourses);
                const waiveRegFee = inGermany && courseCount >= 2;
                const depositEur = waiveRegFee ? 0 : (reservationDepositEur || 0);
                const depositCents = depositEur * 100;
                const fullDiscEur = waiveRegFee ? 0 : (fullPaymentDiscountEur || 0);
                const fullDiscCents = fullDiscEur * 100;
                const unitCourseCents = courseCount > 0
                    ? Math.round(totalCents / courseCount)
                    : Math.round((promoPrice || 0) * 100);

                // Konum → doğrudan plan (belge/yöntem yok)
                if (planWrap) planWrap.hidden = !germanyVal;
                if (!germanyVal) {
                    document.querySelectorAll('[name="pay-plan"]').forEach(function (r) { r.checked = false; });
                    document.querySelectorAll('[name="pay-install"]').forEach(function (r) { r.checked = false; });
                }

                // Taksit alt seçenekleri: Almanya ve yurtdışı aynı
                const showInstallOpts = !!(germanyVal && payPlan === 'installment');
                if (installWrap) {
                    if (showInstallOpts) {
                        installWrap.hidden = false;
                        installWrap.removeAttribute('hidden');
                        installWrap.style.display = '';
                        installWrap.setAttribute('aria-hidden', 'false');
                    } else {
                        installWrap.hidden = true;
                        installWrap.setAttribute('hidden', '');
                        installWrap.setAttribute('aria-hidden', 'true');
                    }
                }
                if (!showInstallOpts) {
                    document.querySelectorAll('[name="pay-install"]').forEach(function (r) { r.checked = false; });
                }

                const pricedForMulti = checkedCourses.filter(function (c) { return LEVEL_RE.test(c) || c === 'telc-c1-prep'; });
                const grossCoursesEur = pricedForMulti.length > 0 ? getIntensiveCourseGross(pricedForMulti) : 0;
                const multiForFull = getMultiCourseDiscount(courseCount, grossCoursesEur);
                const multiSaveEur = multiForFull.amount || 0;
                const multiSaveCents = multiSaveEur * 100;
                const discEur = Math.max(0, Math.round(fullDiscCents / 100));
                // Paket totalCents zaten çoklu kur % indirimli (tam ödeme ve taksit aynı paket)
                const fullPackageCents = totalCents;
                const fullChargeCents = Math.max(0, fullPackageCents + depositCents - fullDiscCents);
                const fullWasCents = fullPackageCents + multiSaveCents + depositCents;

                if (fullAmountEl) fullAmountEl.textContent = formatPayEur(fullChargeCents);
                const fullWasEl = document.getElementById('bk-pay-full-was');
                if (fullWasEl) {
                    // Toplu ödemede % indirimi yeşil kart / üstü çizili brüt ile yansıt
                    if (multiSaveEur > 0 && fullPackageCents > 0) {
                        fullWasEl.hidden = false;
                        fullWasEl.textContent = formatPayEur(fullWasCents);
                    } else if (discEur > 0 && fullPackageCents > 0) {
                        fullWasEl.hidden = false;
                        fullWasEl.textContent = formatPayEur(fullPackageCents + depositCents);
                    } else {
                        fullWasEl.hidden = true;
                        fullWasEl.textContent = '';
                    }
                }
                if (fullSaveEl) {
                    // Yeşil kart: yapılan çoklu kur % indirimi (tam ödeme kartında her zaman görünür)
                    if (multiSaveEur > 0) {
                        fullSaveEl.hidden = false;
                        const pct = multiForFull.percent ? (' −%' + multiForFull.percent) : '';
                        const tpl = (payUiCopy && payUiCopy.discountTpl) || '−{amount} €';
                        fullSaveEl.textContent = String(tpl).replace(/\{amount\}/g, String(multiSaveEur)) + pct;
                    } else if (discEur > 0 && fullPackageCents > 0) {
                        // Tek kursta kayıt iptali (+80/−80) yeşil etiket
                        fullSaveEl.hidden = false;
                        const tpl = (payUiCopy && payUiCopy.discountTpl) || '−{amount} €';
                        fullSaveEl.textContent = String(tpl).replace(/\{amount\}/g, String(discEur));
                    } else {
                        fullSaveEl.hidden = true;
                        fullSaveEl.textContent = '';
                    }
                }

                // Sidebar: kayıt ücreti / tam ödeme indirimi
                const regFeeRow = document.getElementById('registration-fee-row');
                const fullDiscRow = document.getElementById('full-payment-discount-row');
                const showRegFee = !!payPlan && totalCents > 0 && depositEur > 0;
                const showFullDisc = showRegFee && payPlan === 'full' && fullDiscEur > 0;
                if (regFeeRow) regFeeRow.style.display = showRegFee ? 'flex' : 'none';
                if (fullDiscRow) fullDiscRow.style.display = showFullDisc ? 'flex' : 'none';
                const regFeeVal = document.getElementById('registration-fee-value');
                const fullDiscVal = document.getElementById('full-payment-discount-value');
                if (regFeeVal) regFeeVal.textContent = depositEur + ' €';
                if (fullDiscVal) fullDiscVal.textContent = '-' + fullDiscEur + ' €';

                // %50/%50: yarı paket + kayıt | Kur kur: 1 kur + kayıt
                const halfPackageCents = Math.round(totalCents / 2);
                const halfNowCents = halfPackageCents + depositCents;
                const halfRestCents = Math.max(0, totalCents - halfPackageCents);
                const courseNowCents = unitCourseCents + depositCents;
                const courseRestCents = Math.max(0, totalCents - unitCourseCents);

                const halfNowEl = document.getElementById('bk-pay-half-now');
                const halfRestEl = document.getElementById('bk-pay-half-rest');
                const courseNowEl = document.getElementById('bk-pay-course-now');
                const courseRestEl = document.getElementById('bk-pay-course-rest');
                if (halfNowEl) halfNowEl.textContent = formatPayEur(halfNowCents);
                if (halfRestEl) halfRestEl.textContent = formatPayEur(halfRestCents);
                if (courseNowEl) courseNowEl.textContent = formatPayEur(courseNowCents);
                if (courseRestEl) courseRestEl.textContent = formatPayEur(courseRestCents);

                if (installAmountEl) {
                    const hintNow = installOpt === 'course' ? courseNowCents : halfNowCents;
                    installAmountEl.textContent = formatPayEur(payPlan === 'installment' ? hintNow : halfNowCents);
                }

                const charge = computeBookingCharge({
                    totalCents,
                    firstCourseCents: unitCourseCents,
                    inGermany,
                    courseCount,
                    payPlan,
                    installOpt,
                });

                // Sidebar tutarı: satırlarla uyumlu
                if (totalPriceEl && totalLabelEl) {
                    const labelTotal = lang === 'tr' ? 'Toplam Tutar' : lang === 'de' ? 'Gesamtbetrag' : lang === 'es' ? 'Importe total' : 'Total Amount';
                    const labelDue = lang === 'tr' ? 'Ödenecek' : lang === 'de' ? 'Zu zahlen' : lang === 'es' ? 'A pagar' : 'Amount due';
                    const installReady = payPlan !== 'installment' || !!installOpt;
                    const readyDue = !!germanyVal && !!payPlan && installReady;
                    let packageDisplayCents = totalCents;
                    if (payPlan && totalCents > 0) {
                        packageDisplayCents += depositCents;
                        if (payPlan === 'full') packageDisplayCents -= fullDiscCents;
