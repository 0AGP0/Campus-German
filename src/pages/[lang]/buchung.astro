                    if (accommodationSummary && accommodationSummarySection) {
                        let accHtml = '<div class="summary-item">';
                        if (accommodationType) {
                            const accTypeNames = {
                                tr: {
                                    'einzelzimmer': 'Tek Kişilik Oda (Einzelzimmer)',
                                    'doppelzimmer': 'Paylaşımlı Oda (Doppelzimmer)',
                                    'roadmap': 'Sadece Konaklama Yol Haritası'
                                },
                                de: {
                                    'einzelzimmer': 'Einzelzimmer',
                                    'doppelzimmer': 'Doppelzimmer',
                                    'roadmap': 'Nur Unterkunfts-Roadmap'
                                },
                                en: {
                                    'einzelzimmer': 'Single Room (Einzelzimmer)',
                                    'doppelzimmer': 'Shared Room (Doppelzimmer)',
                                    'roadmap': 'Accommodation Roadmap Only'
                                }
                            };
                            const accT = accTypeNames[currentLang] || accTypeNames.tr;
                            accHtml += `<div class="summary-row"><strong>${labels.accommodationType}:</strong> <span>${accT[accommodationType] || accommodationType}</span></div>`;
