    <script define:vars={{
        pricingData,
        lang,
        phoneCountries,
        courseInfoCopy,
        levelSummaryCopy,
        promoPrice: PROMO_PRICE.discounted,
        promoPriceOriginal: PROMO_PRICE.original,
        intensiveLevelPrice: PROMO_PRICE.discounted,
        onlineLevelPrices: ONLINE_LEVEL_PRICES,
        telcPrepPriceNum: TELC_PREP_EUR,
        telcPrepWeeks: TELC_PREP_WEEKS,
        bookingWebhookLabels,
        reservationDepositEur: RESERVATION_DEPOSIT_EUR,
        fullPaymentDiscountEur: FULL_PAYMENT_DISCOUNT_EUR,
        bookingCoupons: BOOKING_COUPONS,
        bookingCouponDefaultEur: BOOKING_COUPON_DEFAULT_EUR,
        stripeFeeRate: STRIPE_FEE_RATE,
        stripeFeeFixedEur: STRIPE_FEE_FIXED_EUR,
        swiftTransferBufferEur: SWIFT_TRANSFER_BUFFER_EUR,
        eeaCountryIsoList: Array.from(EEA_COUNTRY_ISO),
        countryNameToIso: COUNTRY_NAME_TO_ISO,
        balanceDueDays: BALANCE_DUE_DAYS,
        stripeExtras: STRIPE_EXTRAS,
        stripeAdjustProduct: STRIPE_ADJUST_PRODUCT,
        payUiCopy: {
            submitQuote: translations.paySubmitQuote,
            submitPay: translations.paySubmitPay,
            submitContinue: translations.continueBtn,
            needGermany: translations.payNeedGermany,
            needPlan: translations.payNeedPlan,
            needMethod: translations.payNeedMethod,
            needInstall: translations.payNeedInstall,
            discountTpl: translations.payFullDiscountTpl,
            installNowTpl: translations.payInstallNowTpl,
            installCourseNowTpl: translations.payInstallCourseNowTpl,
        },
        extraInfoCopy: {
            general: extrasStepCopy.infoGeneral,
            accommodation: extrasStepCopy.infoAccommodation,
            speakcafe: extrasStepCopy.infoSpeakcafe,
            bremen: lang === 'tr'
                ? 'Bremen indirimi yalnızca Almanya’da ikamet edenler için uygundur. Aylık ödeme bu seçenek işaretlenmeden kullanılamaz.'
                : lang === 'de'
                  ? 'Der Bremen-Rabatt gilt nur für Personen mit Wohnsitz in Deutschland. Monatliche Zahlung ist ohne diese Option nicht verfügbar.'
                  : lang === 'es'
                    ? 'El descuento Bremen solo aplica a residentes en Alemania. El pago mensual no está disponible sin esta opción.'
                    : 'The Bremen discount is only for residents in Germany. Monthly payment cannot be used without this option.',
        },
        needStartDateMsg: translations.needStartDate,
        nearestStartDateValue,
        courseDateCopy: {
            chainHint: translations.courseDateChainHint,
            weeksLabel: translations.courseWeeksLabel,
            telcWeeksLabel: translations.telcWeeksLabel,
        },
    }}>
        // Import security utilities
        const { checkRateLimit, sanitizeObject, validateEmail, validatePhone, checkHoneypot } = (() => {
            // Rate limiting
            function checkRateLimit(formType, maxRequests = 5, windowMinutes = 1) {
                const key = `form_rate_limit_${formType}`;
                const now = Date.now();
                const windowMs = windowMinutes * 60 * 1000;
                const stored = localStorage.getItem(key);
                if (!stored) {
                    localStorage.setItem(key, JSON.stringify([now]));
                    return true;
                }
                const requests = JSON.parse(stored);
                const recentRequests = requests.filter(timestamp => now - timestamp < windowMs);
                if (recentRequests.length >= maxRequests) return false;
                recentRequests.push(now);
                localStorage.setItem(key, JSON.stringify(recentRequests));
                return true;
            }
            
            // Sanitize input
            function sanitizeInput(input) {
                if (typeof input !== 'string') return '';
                const div = document.createElement('div');
                div.textContent = input;
                return div.innerHTML.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#x27;');
            }
            
            // Sanitize object
            function sanitizeObject(obj) {
                if (typeof obj === 'string') return sanitizeInput(obj);
                if (Array.isArray(obj)) return obj.map(item => sanitizeObject(item));
                if (obj && typeof obj === 'object') {
                    const sanitized = {};
                    for (const key in obj) sanitized[key] = sanitizeObject(obj[key]);
                    return sanitized;
                }
                return obj;
            }
            
            // Validate email
            function validateEmail(email) {
                return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
            }
            
            // Validate phone
            function validatePhone(phone) {
                return /^[\d\s\-\+\(\)]+$/.test(phone) && phone.replace(/\D/g, '').length >= 8;
            }
            
            // Check honeypot
            function checkHoneypot(form, fieldName = 'website') {
                const honeypot = form.querySelector(`[name="${fieldName}"]`);
                return !(honeypot && honeypot.value);
            }
            
            return { checkRateLimit, sanitizeObject, validateEmail, validatePhone, checkHoneypot };
        })();
        
        document.addEventListener('DOMContentLoaded', function() {
            // ===== STEP NAVIGATION =====
            let currentStep = 1;
            const totalSteps = 2;
            const formSteps = document.querySelectorAll('.form-step');
            const stepIndicators = document.querySelectorAll('.step-indicator');
            const progressFill = document.querySelector('.progress-fill');
            const btnNext = document.querySelectorAll('#booking-form .btn-next');

            // Format date for display: "2 March" (day + month name, no leading zero)
            const localeForLang = (lang === 'tr' ? 'tr-TR' : lang === 'de' ? 'de-DE' : lang === 'es' ? 'es-ES' : 'en-GB');
            function formatDateLong(dateStr) {
                const date = new Date(dateStr);
                const day = date.getDate();
                const month = date.toLocaleDateString(localeForLang, { month: 'long' });
                return day + ' ' + month;
            }

            function dateStrToISO(dateStr) {
                dateStr = String(dateStr).trim();
                const [day, month] = dateStr.split('.');
                if (!day || !month) return null;
                const year = 2026;
                const iso = `${year}-${month.padStart(2, '0')}-${day.padStart(2, '0')}`;
                const d = new Date(iso);
                return isNaN(d.getTime()) ? null : iso;
            }

            function syncProgramCardsUI() {
                const grid = document.getElementById('program-options-grid');
                const selected = document.querySelector('[name="program"]:checked');
                if (!grid) return;
                grid.classList.toggle('program-slot-grid--compact', !!selected);
                grid.querySelectorAll('.program-slot').forEach(function (card) {
                    card.classList.toggle('program-slot--selected', !!card.querySelector('input')?.checked);
                });
            }

            function resetWeeksControls() {
                document.querySelectorAll('[name="weeks-choice"]').forEach(function (r) { r.checked = false; });
                const otherInput = document.getElementById('weeks-other-input');
                if (otherInput) otherInput.value = '';
                const otherWrap = document.getElementById('weeks-other-wrap');
                if (otherWrap) otherWrap.style.display = 'none';
                if (weeksSelect) weeksSelect.value = '';
                setWeeksValue('');
            }

            function syncWeeksOtherVisibility() {
                const otherWrap = document.getElementById('weeks-other-wrap');
                const otherSelected = document.querySelector('[name="weeks-choice"][value="other"]:checked');
                if (otherWrap) otherWrap.style.display = otherSelected ? 'block' : 'none';
            }

            // Program change: show intensive-type, course selection (levels+exam for intensive/online, camps for youth-camp), weeks
            const programRadios = document.querySelectorAll('[name="program"]');
            const weeksBlock = document.getElementById('weeks-block');
            const weeksSelect = document.getElementById('weeks');
            const courseLevelsBlock = document.getElementById('course-levels-block');
            const courseCampsBlock = document.getElementById('course-camps-block');
            const courseSelectionGroup = document.getElementById('course-selection-group');
            const LEVEL_RE = /^(a1|a2|b1|b2|c1)$/;
            const WEEKS_PER_LEVEL = 8;
            const MAX_MULTI_COURSE_HINT = 5;
            function mainLevelsFromCourseSelection(values) {
                const mains = new Set();
                for (const v of values) {
                    if (v === 'unsure') continue;
                    const m = String(v).split('.')[0];
                    if (LEVEL_RE.test(m)) mains.add(m);
                }
                return [...mains];
            }
            function levelModuleCount(values) {
                return values.filter(function (v) { return LEVEL_RE.test(v) || v === 'telc-c1-prep'; }).length;
            }
            function syncIntensiveTypeFromProgram() {
                const program = document.querySelector('[name="program"]:checked')?.value;
                const hid = document.getElementById('intensive-type-hidden');
                if (!hid) return;
                if (program === 'intensive' || program === 'online') hid.value = 'intensive';
                else hid.value = '';
            }

            function getSelectedCourseCount(values) {
                return levelModuleCount(values);
            }
            function getMultiCourseDiscount(/* courseCount, grossTotal */) {
                // Toplu kurs yüzdelik indirimi kaldırıldı.
                return { percent: 0, amount: 0 };
            }

            function unitPriceAfterMultiDiscount(baseEur /*, courseCount */) {
                if (!(baseEur > 0)) return 0;
                return Math.round(baseEur);
            }

            function normalizeCouponCode(raw) {
                return String(raw || '').trim().toUpperCase().replace(/\s+/g, '');
            }

            function getCouponDiscountEur(raw) {
                const code = normalizeCouponCode(raw);
                if (!code || !Array.isArray(bookingCoupons)) return 0;
                const hit = bookingCoupons.find(function (c) {
                    return c && c.active !== false && normalizeCouponCode(c.code) === code;
                });
                if (!hit) return 0;
                const amount = Number(hit.discountEur);
                if (Number.isFinite(amount) && amount > 0) return amount;
                return Number(bookingCouponDefaultEur) || 50;
            }

            function syncCouponUI() {
                const input = document.getElementById('coupon-code');
                const status = document.getElementById('bk-coupon-status');
                const row = document.getElementById('coupon-discount-row');
                const rowVal = document.getElementById('coupon-discount-value');
                const raw = input instanceof HTMLInputElement ? input.value : '';
                const discount = getCouponDiscountEur(raw);
                const code = normalizeCouponCode(raw);
                if (status) {
                    if (!code) {
                        status.textContent = '';
                        status.hidden = true;
                        status.classList.remove('is-ok', 'is-bad');
                    } else if (discount > 0) {
                        status.hidden = false;
                        status.classList.add('is-ok');
                        status.classList.remove('is-bad');
                        status.textContent = lang === 'tr'
                            ? ('Kupon geçerli: −' + discount + ' €')
                            : lang === 'de'
                              ? ('Gutschein gültig: −' + discount + ' €')
                              : ('Coupon valid: −€' + discount);
                    } else {
                        status.hidden = false;
                        status.classList.add('is-bad');
                        status.classList.remove('is-ok');
                        status.textContent = lang === 'tr'
                            ? 'Geçersiz kupon kodu'
                            : lang === 'de'
                              ? 'Ungültiger Gutscheincode'
                              : 'Invalid coupon code';
                    }
                }
                if (row && rowVal) {
                    if (discount > 0) {
                        row.style.display = 'flex';
                        rowVal.textContent = '-' + discount + ' €';
                    } else {
                        row.style.display = 'none';
                        rowVal.textContent = '-';
                    }
                }
                return discount;
            }

            function syncOnlineCourseCards() {
                const program = document.querySelector('[name="program"]:checked')?.value;
                const isOnline = program === 'online';
                const grid = document.getElementById('course-levels-buttons');
                if (grid) grid.classList.toggle('course-slot-grid--online', isOnline);
                document.querySelectorAll('.course-slot--intensive-only').forEach(function (el) {
                    el.style.display = isOnline ? 'none' : '';
                    if (isOnline) {
                        const cb = el.querySelector('input[name="course-selection"]');
                        if (cb instanceof HTMLInputElement) cb.checked = false;
                    }
                });
                updateLevelSummary();
            }

            function toggleProgramExtras() {
                syncIntensiveTypeFromProgram();
                const program = document.querySelector('[name="program"]:checked')?.value;
                if (courseSelectionGroup) courseSelectionGroup.style.display = (program === 'intensive' || program === 'online' || program === 'youth-camp') ? 'block' : 'none';
                if (weeksBlock) weeksBlock.style.display = (program === 'short-term' || program === 'youth-camp') ? 'block' : 'none';
                if (weeksSelect) {
                    weeksSelect.removeAttribute('required');
                    if (program === 'youth-camp') weeksSelect.setAttribute('required', 'required');
                }
                if (courseLevelsBlock) courseLevelsBlock.style.display = (program === 'intensive' || program === 'online') ? 'block' : 'none';
                if (courseCampsBlock) courseCampsBlock.style.display = program === 'youth-camp' ? 'block' : 'none';
                const levelSummaryEl = document.getElementById('level-summary');
                if (levelSummaryEl) {
                    levelSummaryEl.hidden = !(program === 'intensive' || program === 'online');
                }
                document.querySelectorAll('[name="course-selection"]').forEach(cb => { cb.checked = false; cb.disabled = false; });
                resetWeeksControls();
                toggleYouthCampWeeksOnly();
                syncProgramCardsUI();
                syncOnlineCourseCards();
                syncBookingStartDateVisibility(program || '');
                toggleBundleInfobox();
                filterWeeksByLevelCourses();
                reorderCourseSelectionChain();
                updatePrice();
            }

            const levelStartSelect = document.getElementById('level-start-date');
            const fallbackStartSelect = document.getElementById('fallback-start-date');
            const startDateHidden = document.getElementById('start-date');
            const startDateModeHidden = document.getElementById('booking-start-date-mode');
            const startFallbackBlock = document.getElementById('booking-start-fallback');
            const startDateErrorEl = document.getElementById('booking-start-date-error');

            function activeStartDateSelect() {
                return levelStartSelect || fallbackStartSelect;
            }

            function syncStartDateFromUI() {
                const select = activeStartDateSelect();
                const value = select?.value || nearestStartDateValue || '';
                if (startDateHidden) startDateHidden.value = value;
                if (startDateModeHidden) startDateModeHidden.value = value ? 'preset' : '';
                if (typeof syncCourseSlotDates === 'function') syncCourseSlotDates();
                return value;
            }

            function syncBookingStartDateVisibility(program) {
                if (startFallbackBlock) startFallbackBlock.hidden = true;
                if (startDateErrorEl) startDateErrorEl.hidden = true;
                if (fallbackStartSelect) fallbackStartSelect.classList.remove('error');
                if (levelStartSelect) levelStartSelect.classList.remove('error');
                // Keep hidden fallback in sync with visible date for any legacy readers
                if (levelStartSelect && fallbackStartSelect && levelStartSelect.value) {
                    fallbackStartSelect.value = levelStartSelect.value;
                }
                syncStartDateFromUI();
            }

            function resetBookingStartDate() {
                if (levelStartSelect && nearestStartDateValue) levelStartSelect.value = nearestStartDateValue;
                if (fallbackStartSelect && nearestStartDateValue) fallbackStartSelect.value = nearestStartDateValue;
                syncStartDateFromUI();
                if (startDateErrorEl) startDateErrorEl.hidden = true;
                if (levelStartSelect) levelStartSelect.classList.remove('error');
                if (fallbackStartSelect) fallbackStartSelect.classList.remove('error');
            }

            function validateBookingStartDate() {
                const program = document.querySelector('[name="program"]:checked')?.value;
                if (!program) return true;
                const value = syncStartDateFromUI();
                const select = activeStartDateSelect();
                const ok = !!value;
                if (select) select.classList.toggle('error', !ok);
                if (startDateErrorEl) {
                    startDateErrorEl.hidden = ok || (program !== 'short-term' && program !== 'youth-camp');
                    if (!ok) startDateErrorEl.textContent = needStartDateMsg;
                }
                if (!ok && (program === 'intensive' || program === 'online') && select) {
                    select.setAttribute('aria-invalid', 'true');
                }
                return ok;
            }

            window.validateBookingLessonTimeStep = validateBookingStartDate;
            window.resetBookingLessonTimeStep = resetBookingStartDate;

            levelStartSelect?.addEventListener('change', syncStartDateFromUI);
            fallbackStartSelect?.addEventListener('change', function () {
                if (startDateErrorEl) startDateErrorEl.hidden = true;
                fallbackStartSelect.classList.remove('error');
                syncStartDateFromUI();
            });
            syncBookingStartDateVisibility(document.querySelector('[name="program"]:checked')?.value || '');
            syncStartDateFromUI();
            const weeksButtonsWrap = document.getElementById('weeks-buttons-wrap');
            const weeksOtherInput = document.getElementById('weeks-other-input');
            const weeksValueInput = document.getElementById('weeks-value');
            const weeksSelectWrap = document.getElementById('weeks-select-wrap');
            function getWeeksValue() { return (weeksValueInput && weeksValueInput.value) || ''; }
            function setWeeksValue(v) { if (weeksValueInput) weeksValueInput.value = String(v || ''); }
            function getIntensiveWeeksForCourse(courseValue) {
                if (courseValue === 'telc-c1-prep') return telcPrepWeeks;
                if (LEVEL_RE.test(courseValue)) return WEEKS_PER_LEVEL;
                return 0;
            }
            function getIntensiveWeeksTotal(courses) {
                return courses.reduce(function (sum, c) { return sum + getIntensiveWeeksForCourse(c); }, 0);
            }
            function getIntensiveCourseGross(courses) {
                const program = document.querySelector('[name="program"]:checked')?.value;
                return courses.reduce(function (sum, c) {
                    if (c === 'telc-c1-prep') return sum + telcPrepPriceNum;
                    if (LEVEL_RE.test(c)) {
                        if (program === 'online') return sum + (onlineLevelPrices[c] || 0);
                        return sum + promoPrice;
                    }
                    return sum;
                }, 0);
            }

            /** Kur-kur ilk çekim: ekstra/kupon paylaştırmadan ilk seviye brüt fiyatı */
            function getFirstCourseCents(courses) {
                const list = Array.isArray(courses) ? courses : [];
                const program = document.querySelector('[name="program"]:checked')?.value;
                const first = list.find(function (c) {
                    return LEVEL_RE.test(c) || c === 'telc-c1-prep';
                });
                if (!first) return Math.round((promoPrice || 0) * 100);
                if (first === 'telc-c1-prep') return Math.round((telcPrepPriceNum || 0) * 100);
                if (program === 'online') {
                    return Math.round((onlineLevelPrices[first] || promoPrice || 0) * 100);
                }
                return Math.round((promoPrice || 0) * 100);
            }

            /**
             * Checkout satırları — site fiyatı (amountCents) kanonik.
             * Hepsi adjust ürünü + useCustomAmount; eski haftalık paket productKey’leri kullanılmaz.
             */
            function buildStripeLineItems(opts) {
                const items = [];
                const program = opts.program;
                const courses = opts.courses || [];
                const weeksNum = opts.weeksNum || 0;
                const priced = courses.filter(function (c) { return LEVEL_RE.test(c) || c === 'telc-c1-prep'; });
                const adjustKey = stripeAdjustProduct.productKey;

                if (program === 'short-term' && weeksNum > 0) {
                    const eur = getTieredPrice(weeksNum);
                    items.push({
                        productKey: adjustKey,
                        name: 'German Intensive short-term - ' + weeksNum + ' Weeks',
                        amountCents: Math.round(eur * 100),
                        quantity: 1,
                        weeks: weeksNum,
                        useCustomAmount: true,
                    });
                } else if (program === 'intensive' || program === 'online') {
                    priced.forEach(function (c) {
                        if (c === 'telc-c1-prep') {
                            items.push({
                                productKey: adjustKey,
                                name: 'TELC B2/C1 Prep. 20L/W - 4 Weeks',
                                amountCents: Math.round(telcPrepPriceNum * 100),
                                quantity: 1,
                                weeks: telcPrepWeeks,
                                useCustomAmount: true,
                            });
                            return;
                        }
                        if (program === 'online') {
                            const eur = onlineLevelPrices[c] || 0;
                            items.push({
