            function initBookingPhoneDialInput() {
                const dialInput = document.getElementById('phone-country-code');
                const flagEl = document.getElementById('phone-dial-flag');
                if (!(dialInput instanceof HTMLInputElement)) return;

                const countries = Array.isArray(phoneCountries) ? phoneCountries : [];
                const globeSrc = 'data:image/svg+xml,' + encodeURIComponent(
                    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="#64748b" stroke-width="1.5"/><path d="M3 12h18M12 3c2.5 2.8 3.8 6 3.8 9s-1.3 6.2-3.8 9M12 3C9.5 5.8 8.2 9 8.2 12s1.3 6.2 3.8 9" stroke="#64748b" stroke-width="1.5"/></svg>'
                );

                function normalizeDialValue(raw) {
                    let v = String(raw || '').trim().replace(/\s/g, '');
                    if (!v) return '';
                    if (!v.startsWith('+')) v = '+' + v.replace(/^\+*/, '');
                    return v;
                }

                function findCountryByDial(raw) {
                    const v = normalizeDialValue(raw);
                    if (!v || v === '+') return null;
                    const exact = countries.find(function (c) { return c.dial === v; });
                    if (exact) return exact;
                    const uniquePrefix = countries.filter(function (c) { return c.dial.startsWith(v); });
                    if (uniquePrefix.length === 1) return uniquePrefix[0];
                    const dialPrefix = countries
                        .filter(function (c) { return v.startsWith(c.dial); })
                        .sort(function (a, b) { return b.dial.length - a.dial.length; });
                    return dialPrefix[0] || null;
                }

                function updateDialFlag() {
                    if (!(flagEl instanceof HTMLImageElement)) return;
                    const match = findCountryByDial(dialInput.value);
                    if (match && match.iso) {
                        flagEl.src = 'https://flagcdn.com/w40/' + match.iso + '.png';
                        flagEl.alt = match.name || '';
                    } else {
                        flagEl.src = globeSrc;
                        flagEl.alt = '';
                    }
                }

                function normalizeDial() {
                    const v = normalizeDialValue(dialInput.value);
                    if (v) dialInput.value = v;
                    updateDialFlag();
                }

                dialInput.addEventListener('input', updateDialFlag);
                dialInput.addEventListener('blur', normalizeDial);
                dialInput.addEventListener('change', normalizeDial);
                updateDialFlag();
            }
            initBookingPhoneDialInput();

