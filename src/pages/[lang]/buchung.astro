                    syncWeeksFromControl();
                    return;
                }
                if (program === 'intensive' || program === 'online') {
                    if (shortTermChecked) {
                        if (weeksBlock) weeksBlock.style.display = 'block';
                        if (weeksSelectWrap) weeksSelectWrap.style.display = 'none';
                        if (weeksShortTermWrap) weeksShortTermWrap.style.display = 'block';
                        if (weeksLabel) weeksLabel.setAttribute('for', 'weeks-short-term');
                        if (weeksShortTermInput) {
                            weeksShortTermInput.setAttribute('required', 'required');
