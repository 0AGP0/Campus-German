                    } else {
                        if (weeksBlock) weeksBlock.style.display = 'none';
                        if (weeksSelectWrap) weeksSelectWrap.style.display = 'block';
                        if (weeksShortTermWrap) weeksShortTermWrap.style.display = 'none';
                        if (weeksSelect) { weeksSelect.removeAttribute('required'); weeksSelect.value = ''; }
                        if (weeksShortTermInput) { weeksShortTermInput.removeAttribute('required'); weeksShortTermInput.value = '1'; }
