            // Extract numeric price from string like "790€" -> 790
            function extractPrice(priceStr) {
                if (priceStr == null || priceStr === '') return 0;
                return parseInt(String(priceStr).replace(/[^0-9]/g, ''), 10) || 0;
            }

            // Get level from sublevel (a1.1 -> a1, b2.2 -> b2)
            function getMainLevel(subLevel) {
                return subLevel.split('.')[0];
            }

            const VISA_SUPPORT = stripeExtras.visa.eur;
            const UNIVERSITY_ADMISSION = stripeExtras.university.eur;
            const ACCOMMODATION_SUPPORT = stripeExtras.accommodation.eur;
            const AIRPORT_PICKUP = stripeExtras.airport.eur;
            const FRIEND_DISCOUNT = 50;

            // Tiered pricing per week — short-term, Stripe paketinde yoksa
            const TIERS_20H = [
                { min: 1, max: 4, perWeek: 190 },
                { min: 5, max: 8, perWeek: 150 },
                { min: 9, max: 15, perWeek: 130 },
                { min: 16, max: 24, perWeek: 120 },
                { min: 25, max: 999, perWeek: 110 }
            ];
            function getTieredPrice(weeks) {
                const w = parseInt(weeks, 10) || 0;
                if (w < 1) return 0;
                const tier = TIERS_20H.find(t => w >= t.min && w <= t.max);
                return tier ? w * tier.perWeek : 0;
            }

            function getCoursePrice(program, courseValue, weeks) {
                const mainLevel = (courseValue || '').toString().split('.')[0] || 'a1';
                if (program === 'online' && LEVEL_RE.test(mainLevel)) {
                    return onlineLevelPrices[mainLevel] || 0;
                }
                if (program === 'intensive') {
                    return promoPrice;
                }
                if (program === 'short-term') {
                    return getTieredPrice(weeks);
                }
                if (program === 'youth-camp') {
                    const w = parseInt(weeks, 10) || 0;
                    if (w < 1) return 0;
                    const isA1A2 = mainLevel === 'a1' || mainLevel === 'a2';
                    const pricingKey = isA1A2 ? 'a1a2' : 'b1b2c1';
                    const weeklyPricing = pricingData.weeklyPricing?.[pricingKey];
                    if (!weeklyPricing) return 0;
                    const durations = Object.keys(weeklyPricing).map(Number).sort((a, b) => a - b);
                    const closest = durations.find(d => d >= w) || durations[durations.length - 1];
                    const pricePerWeek = extractPrice(weeklyPricing[String(closest)] || '0€');
                    return Math.round(pricePerWeek * w);
                }
                return 0;
            }

            function syncCourseSlotBundlePrices() {
                const program = document.querySelector('[name="program"]:checked')?.value;
                const checked = Array.from(document.querySelectorAll('[name="course-selection"]:checked'))
                    .map(function (c) { return c.value; })
                    .filter(function (c) { return LEVEL_RE.test(c) || c === 'telc-c1-prep'; });
                const count = checked.length;
                const nextCount = count + 1;
                const nextPercent = nextCount >= 2 ? nextCount : 0;
                const showBundle = program === 'intensive' && count >= 1;
                const baseOld = String(promoPriceOriginal) + '€';
                const baseNow = String(promoPrice) + '€';

                document.querySelectorAll('.lvl-opt.course-slot').forEach(function (slot) {
                    const input = slot.querySelector('[name="course-selection"]');
                    if (!(input instanceof HTMLInputElement)) return;
                    const isLevel = LEVEL_RE.test(input.value);
                    const oldEl = slot.querySelector('[data-lvl-price-old]');
                    const nowEl = slot.querySelector('[data-lvl-price-now]');
                    const multiTag = slot.querySelector('[data-lvl-multi-tag]');
                    if (!oldEl && !nowEl) return;

                    const showTeaser = isLevel && !input.checked && showBundle && nextPercent > 0;
                    if (showTeaser) {
                        const unit = Math.round(promoPrice * (100 - nextPercent) / 100);
                        if (oldEl) oldEl.textContent = baseNow;
                        if (nowEl) nowEl.textContent = unit + '€';
                        if (multiTag) {
                            multiTag.hidden = false;
                            multiTag.textContent = '−' + nextPercent + '%';
                        }
                    } else {
                        if (oldEl) oldEl.textContent = baseOld;
                        if (nowEl) nowEl.textContent = baseNow;
                        if (multiTag) {
                            multiTag.hidden = true;
                            multiTag.textContent = '';
                        }
                    }
                });
            }

