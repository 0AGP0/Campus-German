            function validateStep(step) {
                const currentStepElement = formSteps[step - 1];
                let isValid = true;

                if (step === 1) {
                    const program = document.querySelector('[name="program"]:checked')?.value;
                    const courseSelectionGroup = document.getElementById('course-selection-group');
                    const checkedCourses = Array.from(document.querySelectorAll('[name="course-selection"]:checked')).map(c => c.value);
                    const courseLevelsBlock = document.getElementById('course-levels-block');
                    const courseCampsBlock = document.getElementById('course-camps-block');
                    const hasLevel = checkedCourses.some(c => LEVEL_RE.test(c) || c === 'telc-c1-prep');
                    const hasVisibleCourseSelection =
                        (program === 'intensive' || program === 'online')
                            ? (courseLevelsBlock?.offsetParent && hasLevel)
                            : (program === 'short-term')
                                ? true
                            : (program === 'youth-camp')
                                ? (courseCampsBlock?.offsetParent && checkedCourses.length > 0)
                                : false;
                    if (!program) { document.querySelector('[name="program"]')?.closest('.form-group')?.classList.add('error'); isValid = false; } else { document.querySelector('[name="program"]')?.closest('.form-group')?.classList.remove('error'); }
                    if (program && !hasVisibleCourseSelection) { if (courseSelectionGroup) courseSelectionGroup.classList.add('error'); isValid = false; } else { if (courseSelectionGroup) courseSelectionGroup.classList.remove('error'); }
                    if (program === 'short-term' || program === 'youth-camp') {
                        syncWeeksFromControl();
                        const weeks = getWeeksValue();
                        const weeksValid = weeks && parseInt(weeks, 10) >= 1;
                        if (!weeksValid) { weeksBlock?.classList.add('error'); isValid = false; } else { weeksBlock?.classList.remove('error'); }
                    }
                    return isValid;
                }

                if (step === 2) {
                    if (typeof window.validateBookingLessonTimeStep === 'function') {
                        if (!window.validateBookingLessonTimeStep()) isValid = false;
                    }
                    if (!validatePaymentChoices(false)) isValid = false;
                }

                const requiredFields = currentStepElement.querySelectorAll('[required]');
                requiredFields.forEach(field => {
                    if (field.offsetParent !== null) {
                        let fieldInvalid = false;
                        if (field.type === 'checkbox') {
                            fieldInvalid = !field.checked;
                        } else if (field.type === 'radio') {
                            fieldInvalid = !currentStepElement.querySelector(`[name="${field.name}"]:checked`);
                        } else {
                            fieldInvalid = !String(field.value || '').trim();
                        }
                        if (fieldInvalid) {
                            isValid = false;
                            field.classList.add('error');
                            field.closest('.checkbox-label, .form-group')?.classList.add('error');
                        } else {
                            field.classList.remove('error');
                            field.closest('.checkbox-label, .form-group')?.classList.remove('error');
                        }
                    }
                });
                return isValid;
            }

