                    // Total
                    priceHtml += `<div class="summary-row summary-total"><strong>${labels.total}:</strong> <span>${totalPrice}</span></div>`;
                    priceHtml += '</div>';
                    priceSummary.innerHTML = priceHtml;
                }
            }

            function validateStep(step) {
                const currentStepElement = formSteps[step - 1];
                let isValid = true;

                if (step === 1) {
                    const program = document.querySelector('[name="program"]:checked')?.value;
                    const startDate = document.getElementById('start-date')?.value;
                    const courseSelectionGroup = document.getElementById('course-selection-group');
                    const checkedCourses = Array.from(document.querySelectorAll('[name="course-selection"]:checked')).map(c => c.value);
                    const courseLevelsBlock = document.getElementById('course-levels-block');
                    const courseCampsBlock = document.getElementById('course-camps-block');
                    const courseExamBlock = document.getElementById('course-exam-block');
                    const hasVisibleCourseSelection = (program === 'intensive' || program === 'weekly') ? (courseLevelsBlock?.offsetParent && checkedCourses.length > 0) :
                        (program === 'youth-camp') ? (courseCampsBlock?.offsetParent && checkedCourses.length > 0) :
                        (program === 'exam-prep') ? (courseExamBlock?.offsetParent && checkedCourses.length > 0) : false;
                    if (!program) { document.querySelector('[name="program"]')?.closest('.form-group')?.classList.add('error'); isValid = false; } else { document.querySelector('[name="program"]')?.closest('.form-group')?.classList.remove('error'); }
                    if (!startDate) { document.getElementById('start-date')?.classList.add('error'); isValid = false; } else { document.getElementById('start-date')?.classList.remove('error'); }
                    if (program && !hasVisibleCourseSelection) { if (courseSelectionGroup) courseSelectionGroup.classList.add('error'); isValid = false; } else { if (courseSelectionGroup) courseSelectionGroup.classList.remove('error'); }
                    if (program === 'weekly' || program === 'youth-camp') {
                        const weeks = document.getElementById('weeks')?.value;
                        if (!weeks) { document.getElementById('weeks')?.classList.add('error'); isValid = false; } else { document.getElementById('weeks')?.classList.remove('error'); }
                    }
                    return isValid;
                }

                const requiredFields = currentStepElement.querySelectorAll('[required]');
                requiredFields.forEach(field => {
                    if (field.offsetParent !== null) {
                        if (!field.value || (field.type === 'radio' && !currentStepElement.querySelector(`[name="${field.name}"]:checked`))) {
                            isValid = false;
                            field.classList.add('error');
                        } else {
                            field.classList.remove('error');
                        }
                    }
                });
                return isValid;
            }

            // Next button handlers
            btnNext.forEach(btn => {
                btn.addEventListener('click', function() {
                    if (validateStep(currentStep)) {
                        if (currentStep < totalSteps) {
                            showStep(currentStep + 1);
                        }
                    }
                });
            });

            // Prev button handlers
            btnPrev.forEach(btn => {
                btn.addEventListener('click', function() {
                    if (currentStep > 1) {
                        showStep(currentStep - 1);
                    }
                });
            });

            // Program, course-selection, weeks, extras → update price
            document.querySelectorAll('[name="course-selection"]').forEach(el => el.addEventListener('change', updatePrice));
            document.getElementById('weeks')?.addEventListener('change', function() {
                const w = parseInt(this.value, 10);
                if (weeksHint) weeksHint.style.display = (w >= 6 && w > 0) ? 'block' : 'none';
                updatePrice();
            });
            document.querySelectorAll('[name="visa-needed"]').forEach(el => el.addEventListener('change', updatePrice));
            document.querySelectorAll('[name="accommodation-type"]').forEach(el => el.addEventListener('change', updatePrice));
            document.querySelectorAll('[name="airport-pickup"]').forEach(el => el.addEventListener('change', updatePrice));

            // ===== COUPON =====
            let appliedCoupon = null;
            const couponInput = document.getElementById('coupon-input');
            const couponApplyBtn = document.getElementById('coupon-apply-btn');
            const couponMessage = document.getElementById('coupon-message');
            const couponDiscountRow = document.getElementById('coupon-discount-row');
            const couponDiscountValue = document.getElementById('coupon-discount-value');
            const couponDiscountPercentInput = document.getElementById('coupon-discount-percent');
            const formEl = document.getElementById('booking-form');
            const couponSuccessText = (formEl && formEl.dataset.couponSuccess) ? formEl.dataset.couponSuccess : (lang === 'tr' ? '%10 indirim uygulandı' : lang === 'de' ? '10 % Rabatt angewendet' : lang === 'es' ? '10% de descuento aplicado' : '10% discount applied');
            const couponInvalidText = (formEl && formEl.dataset.couponInvalid) ? formEl.dataset.couponInvalid : (lang === 'tr' ? 'Geçersiz kupon' : lang === 'de' ? 'Ungültiger Gutschein' : lang === 'es' ? 'Cupón no válido' : 'Invalid coupon');
            function applyCoupon() {
                const raw = couponInput?.value?.trim() || '';
                const code = raw.toUpperCase();
                const found = Array.isArray(validCoupons) && validCoupons.find(function(c) { return (c.code || '').toUpperCase() === code; });
                if (found) {
                    appliedCoupon = found;
                    if (couponDiscountPercentInput) couponDiscountPercentInput.value = String(found.discountPercent || 0);
                    if (couponMessage) { couponMessage.textContent = couponSuccessText; couponMessage.style.display = 'block'; couponMessage.classList.remove('coupon-message-error'); couponMessage.classList.add('coupon-message-success'); }
                    if (couponInput) couponInput.disabled = true;
                    if (couponApplyBtn) couponApplyBtn.disabled = true;
                    updatePrice();
                } else {
                    appliedCoupon = null;
                    if (couponDiscountPercentInput) couponDiscountPercentInput.value = '';
                    if (couponMessage) { couponMessage.textContent = couponInvalidText; couponMessage.style.display = 'block'; couponMessage.classList.remove('coupon-message-success'); couponMessage.classList.add('coupon-message-error'); }
                    if (couponDiscountRow) couponDiscountRow.style.display = 'none';
                    updatePrice();
                }
            }
            if (couponApplyBtn) couponApplyBtn.addEventListener('click', applyCoupon);
            if (couponInput) couponInput.addEventListener('keydown', function(e) { if (e.key === 'Enter') { e.preventDefault(); applyCoupon(); } });
            if (couponInput?.value?.trim() && Array.isArray(validCoupons) && validCoupons.find(function(c) { return (c.code || '').toUpperCase() === couponInput.value.trim().toUpperCase(); })) {
                setTimeout(applyCoupon, 100);
            }

            // ===== PRICE CALCULATION =====
            const programLabels = { tr: { intensive: 'Yoğun', weekly: 'Haftalık', 'youth-camp': 'Yaz Kampı', 'exam-prep': 'Sınav Hazırlığı' }, de: { intensive: 'Intensiv', weekly: 'Wöchentlich', 'youth-camp': 'Sommercamp', 'exam-prep': 'Prüfungsvorbereitung' }, en: { intensive: 'Intensive', weekly: 'Weekly', 'youth-camp': 'Summer Camp', 'exam-prep': 'Exam Prep' }, es: { intensive: 'Intensivo', weekly: 'Semanal', 'youth-camp': 'Campamento verano', 'exam-prep': 'Preparación exámenes' } };
            function updatePrice() {
                let total = 0;
                const courseTypePrice = document.getElementById('course-type-price');
                const durationPrice = document.getElementById('duration-price');
                const visaPriceRow = document.getElementById('visa-price-row');
                const accommodationPriceRow = document.getElementById('accommodation-price-row');
                const airportPriceRow = document.getElementById('airport-price-row');
                const totalPriceElement = document.getElementById('total-price');
                const program = document.querySelector('[name="program"]:checked')?.value;
                const checkedCourses = Array.from(document.querySelectorAll('[name="course-selection"]:checked')).map(c => c.value);
                const firstCourse = checkedCourses[0] || '';
                const levelForPrice = (firstCourse && ['a1','a2','b1','b2','c1'].includes(firstCourse)) ? firstCourse : (program === 'exam-prep' ? 'exam' : 'a1');
                const weeks = document.getElementById('weeks')?.value;
                const currentLang = lang || 'tr';
                const t = programLabels[currentLang] || programLabels.tr;

                if (!courseTypePrice) return;

                if (program && (checkedCourses.length > 0 || program === 'exam-prep')) {
                    const level = levelForPrice === 'exam' ? 'b1' : levelForPrice;
                    const coursePrice = program === 'exam-prep' ? EXAM_PRICE : getCoursePrice(program, level, weeks);
                    const programLabel = t[program] || program;
                    let labelSuffix = checkedCourses.length ? ' (' + checkedCourses.map(c => c.toUpperCase().replace(/-/g, ' ')).join(', ') + ')' : '';
                    if (program === 'weekly' || program === 'youth-camp') labelSuffix = weeks ? ' ' + weeks + ' ' + (currentLang === 'tr' ? 'hafta' : currentLang === 'de' ? 'Wochen' : currentLang === 'es' ? 'semanas' : 'weeks') + labelSuffix : labelSuffix;
                    if (program === 'exam-prep') labelSuffix = ' (800 €)';
                    courseTypePrice.querySelector('.price-item-label').textContent = (programLabel + labelSuffix).trim();
                    courseTypePrice.querySelector('.price-item-value').textContent = coursePrice > 0 ? coursePrice + ' €' : '-';
                    courseTypePrice.style.display = 'flex';
                    if (coursePrice > 0) total += coursePrice;
                    if (durationPrice) durationPrice.style.display = 'none';
                } else {
                    courseTypePrice.querySelector('.price-item-label').textContent = currentLang === 'tr' ? 'Kurs tipi seçiniz' : currentLang === 'de' ? 'Kurstyp wählen' : currentLang === 'es' ? 'Seleccione tipo' : 'Select course type';
                    courseTypePrice.querySelector('.price-item-value').textContent = '-';
                    if (durationPrice) durationPrice.style.display = 'none';
                }

                const visaNeeded = document.querySelector('[name="visa-needed"]:checked')?.value === 'yes';
                if (visaPriceRow) {
                    visaPriceRow.style.display = visaNeeded ? 'flex' : 'none';
                    if (visaNeeded) total += VISA_GUARANTEE;
                }

                // Konaklama fiyat yansıtılmaz (fiyatı olmasın)
                if (accommodationPriceRow) accommodationPriceRow.style.display = 'none';

                const airportPickup = document.querySelector('[name="airport-pickup"]:checked')?.value === 'yes';
                if (airportPriceRow) {
                    airportPriceRow.style.display = airportPickup ? 'flex' : 'none';
                    if (airportPickup) total += AIRPORT_PICKUP;
                }

                if (appliedCoupon && appliedCoupon.discountPercent) {
                    const discount = Math.round(total * appliedCoupon.discountPercent / 100);
                    total -= discount;
                    if (couponDiscountRow) { couponDiscountRow.style.display = 'flex'; }
                    if (couponDiscountValue) couponDiscountValue.textContent = '-' + discount + ' €';
                } else {
                    if (couponDiscountRow) couponDiscountRow.style.display = 'none';
                }
                if (totalPriceElement) totalPriceElement.textContent = total + ' €';
            }

            // ===== FORM SUBMISSION =====
            const bookingForm = document.getElementById('booking-form');
            if (bookingForm) {
                bookingForm.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    
                    // Security checks
                    const submitButton = bookingForm.querySelector('button[type="submit"]');
                    if (submitButton) {
                        submitButton.disabled = true;
                        const submittingText = lang === 'tr' ? 'Gönderiliyor...' : lang === 'de' ? 'Wird gesendet...' : lang === 'es' ? 'Enviando...' : 'Submitting...';
                        submitButton.textContent = submittingText;
                    }
                    
                    // 1. Check rate limiting
                    if (!checkRateLimit('booking', 5, 1)) {
                        if (window.showSuccessModal) {
                            window.showSuccessModal('error', window.successModalTranslations?.rateLimitError || 'Çok fazla istek gönderdiniz. Lütfen bir dakika bekleyin.');
                        } else {
                            const rateLimitMsg = lang === 'tr' ? 'Çok fazla istek gönderdiniz. Lütfen bir dakika bekleyin.' : lang === 'de' ? 'Zu viele Anfragen. Bitte warten Sie eine Minute.' : lang === 'es' ? 'Demasiadas solicitudes. Espere un minuto.' : 'Too many requests. Please wait a minute.';
                            alert(rateLimitMsg);
                        }
                        if (submitButton) {
                            submitButton.disabled = false;
                            const completeText = lang === 'tr' ? 'Rezervasyonu Tamamla' : lang === 'de' ? 'Reservierung abschließen' : lang === 'es' ? 'Completar reserva' : 'Complete Booking';
                            submitButton.innerHTML = '<i class="fas fa-check"></i> ' + completeText;
                        }
                        return;
                    }
                    
                    // 2. Check honeypot
                    if (!checkHoneypot(bookingForm, 'website')) {
                        console.warn('Bot detected via honeypot');
                        if (submitButton) {
                            submitButton.disabled = false;
                            const completeText = lang === 'tr' ? 'Rezervasyonu Tamamla' : lang === 'de' ? 'Reservierung abschließen' : lang === 'es' ? 'Completar reserva' : 'Complete Booking';
                            submitButton.innerHTML = '<i class="fas fa-check"></i> ' + completeText;
                        }
                        return;
                    }
                    
                    // 3. Validate email and phone
                    const email = bookingForm.querySelector('[name="email"]')?.value || '';
                    const phone = bookingForm.querySelector('[name="phone"]')?.value || '';
                    
                    if (!validateEmail(email)) {
                        if (window.showSuccessModal) {
                            window.showSuccessModal('error', window.successModalTranslations?.emailError || 'Lütfen geçerli bir e-posta adresi girin.');
                        } else {
                            const emailErrorMsg = lang === 'tr' ? 'Lütfen geçerli bir e-posta adresi girin.' : lang === 'de' ? 'Bitte geben Sie eine gültige E-Mail-Adresse ein.' : lang === 'es' ? 'Introduzca un email válido.' : 'Please enter a valid email address.';
                            alert(emailErrorMsg);
                        }
                        if (submitButton) {
                            submitButton.disabled = false;
                            const completeText = lang === 'tr' ? 'Rezervasyonu Tamamla' : lang === 'de' ? 'Reservierung abschließen' : lang === 'es' ? 'Completar reserva' : 'Complete Booking';
                            submitButton.innerHTML = '<i class="fas fa-check"></i> ' + completeText;
                        }
                        return;
                    }
                    
                    if (!validatePhone(phone)) {
                        if (window.showSuccessModal) {
                            window.showSuccessModal('error', window.successModalTranslations?.phoneError || 'Lütfen geçerli bir telefon numarası girin.');
                        } else {
                            const phoneErrorMsg = lang === 'tr' ? 'Lütfen geçerli bir telefon numarası girin.' : lang === 'de' ? 'Bitte geben Sie eine gültige Telefonnummer ein.' : lang === 'es' ? 'Introduzca un número de teléfono válido.' : 'Please enter a valid phone number.';
                            alert(phoneErrorMsg);
                        }
                        if (submitButton) {
                            submitButton.disabled = false;
                            const completeText = lang === 'tr' ? 'Rezervasyonu Tamamla' : lang === 'de' ? 'Reservierung abschließen' : lang === 'es' ? 'Completar reserva' : 'Complete Booking';
                            submitButton.innerHTML = '<i class="fas fa-check"></i> ' + completeText;
                        }
                        return;
                    }
                    
                    // Get form data
                    const formData = new FormData(bookingForm);
                    const data = {};
                    
                    // Collect all form data
                    for (let [key, value] of formData.entries()) {
                        if (data[key]) {
                            // Handle multiple values (checkboxes, etc.)
                            if (Array.isArray(data[key])) {
                                data[key].push(value);
                            } else {
                                data[key] = [data[key], value];
                            }
                        } else {
                            data[key] = value;
                        }
                    }
                    
                    const courseSelectionArr = Array.isArray(data['course-selection']) ? data['course-selection'] : (data['course-selection'] ? [data['course-selection']] : []);
                    const timezoneArr = Array.isArray(data.timezone) ? data.timezone : (data.timezone ? [data.timezone] : []);
                    let standardizedData = {
                        formType: 'booking',
                        sourcePage: data.sourcePage || window.location.pathname,
                        lang: typeof lang !== 'undefined' ? lang : 'tr',
                        name: data['full-name'] || '',
                        city: data.city || '',
                        country: data.country || '',
                        tel: data.phone || '',
                        email: data.email || '',
                        program: data.program || '',
                        level: courseSelectionArr[0] || data.level || '',
                        courseSelection: courseSelectionArr,
                        startDate: data['start-date'] || '',
                        timezone: timezoneArr,
                        weeks: data.weeks || '',
                        examType: (data.program === 'exam-prep' && courseSelectionArr.length) ? courseSelectionArr.join(', ') : (data['exam-type'] || ''),
                        visaNeeded: data['visa-needed'] || 'no',
                        accommodationType: data['accommodation-type'] || 'no',
                        airportPickup: data['airport-pickup'] || 'no',
                        termsAccepted: data['terms-accepted'] || false,
                        privacyAccepted: data['privacy-accepted'] || false,
                        totalPrice: document.getElementById('total-price')?.textContent || '0 €',
                        timestamp: new Date().toISOString()
                    };
                    
                    // Sanitize all inputs
                    standardizedData = sanitizeObject(standardizedData);
                    
                    // Send to webhook
                    try {
                        const response = await fetch('https://hook.eu2.make.com/40s1h4a3wra21aszpa9y9erfsfooso47', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify(standardizedData)
                        });
                        
                        if (response.ok) {
                            if (window.showSuccessModal) {
                                window.showSuccessModal('success', window.successModalTranslations?.bookingSuccess || 'Rezervasyonunuz başarıyla gönderildi! En kısa sürede size dönüş yapacağız.');
                            } else {
                                const successMsg = lang === 'tr' ? 'Rezervasyonunuz başarıyla gönderildi! En kısa sürede size dönüş yapacağız.' : lang === 'de' ? 'Ihre Reservierung wurde erfolgreich gesendet! Wir werden uns so schnell wie möglich bei Ihnen melden.' : lang === 'es' ? '¡Reserva enviada! Nos pondremos en contacto lo antes posible.' : 'Your booking has been successfully submitted! We will get back to you as soon as possible.';
                                alert(successMsg);
                            }
                            bookingForm.reset();
                            // Reset to first step and hide conditional blocks
                            showStep(1);
                            if (typeof toggleProgramExtras === 'function') toggleProgramExtras();
                            if (typeof toggleAccommodationMonths === 'function') toggleAccommodationMonths();
                            updatePrice();
                        } else {
                            throw new Error('Webhook request failed');
                        }
                    } catch (error) {
                        console.error('Error submitting form:', error);
                        if (window.showSuccessModal) {
                            window.showSuccessModal('error', window.successModalTranslations?.errorMessage || 'Bir hata oluştu. Lütfen tekrar deneyin veya bizimle iletişime geçin.');
                        } else {
                            const errorMsg = lang === 'tr' ? 'Bir hata oluştu. Lütfen tekrar deneyin veya bizimle iletişime geçin.' : lang === 'de' ? 'Ein Fehler ist aufgetreten. Bitte versuchen Sie es erneut oder kontaktieren Sie uns.' : lang === 'es' ? 'Ha ocurrido un error. Inténtelo de nuevo o contáctenos.' : 'An error occurred. Please try again or contact us.';
                            alert(errorMsg);
                        }
                    } finally {
                        if (submitButton) {
                            submitButton.disabled = false;
                            const completeText = lang === 'tr' ? 'Rezervasyonu Tamamla' : lang === 'de' ? 'Reservierung abschließen' : lang === 'es' ? 'Completar reserva' : 'Complete Booking';
                            submitButton.innerHTML = '<i class="fas fa-check"></i> ' + completeText;
                        }
                    }
                });
            }

            // Initialize
            updateProgress();
            updatePrice();
        });
    </script>
</MainLayout>

