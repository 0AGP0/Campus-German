                        airportTransferArrival: 'Flughafentransfer (Ankunft)',
                        airportTransferDeparture: 'Flughafentransfer (Abreise)',
                        visaSupport: 'Visumunterstützungsdokumente',
                        total: 'Gesamt'
                    },
                    en: {
                        school: 'School',
                        courseType: 'Course Type',
                        level: 'Level',
                        startDate: 'Start Date',
                        duration: 'Duration',
                        weeks: 'Weeks',
                        continuationLevels: 'Continuation Levels',
                        accommodationType: 'Accommodation Type',
                        month: 'Month',
                        price: 'Price',
                        registrationFee: 'Registration Fee',
                        airportTransferArrival: 'Airport Transfer (Arrival)',
                        airportTransferDeparture: 'Airport Transfer (Departure)',
                        visaSupport: 'Visa Support Documents',
                        total: 'Total'
                    },
                    es: {
                        school: 'Centro',
                        courseType: 'Tipo de curso',
                        level: 'Nivel',
                        startDate: 'Fecha de inicio',
                        duration: 'Duración',
                        weeks: 'Semanas',
                        continuationLevels: 'Niveles de continuación',
                        accommodationType: 'Tipo de alojamiento',
                        month: 'Mes',
                        price: 'Precio',
