            function isInGermanySelected() {
                return document.querySelector('[name="in-germany"]:checked')?.value === 'yes';
            }

            function computeBookingCharge(opts) {
                const totalCents = opts.totalCents || 0;
                const firstCourseCents = opts.firstCourseCents || 0;
                const inGermany = !!opts.inGermany;
                const payDoc = opts.payDoc || '';
                const payPlan = opts.payPlan || '';
                const installOpt = opts.installOpt || '';
                const depositCents = reservationDepositEur * 100;
                const fullDiscCents = (fullPaymentDiscountEur || 0) * 100;

                if (payDoc === 'quote') {
                    return { chargeCents: 0, remainingCents: totalCents, depositEur: 0, kind: 'quote', fullDiscountEur: 0 };
                }
                if (payDoc !== 'registration') {
                    return { chargeCents: 0, remainingCents: totalCents, depositEur: 0, kind: 'none', fullDiscountEur: 0 };
                }
                if (payPlan === 'full') {
                    let charge = Math.max(0, totalCents - fullDiscCents);
                    // Almanya + tam ödeme: kayıt ücreti alınmaz (150 ekstra yok; toplam zaten kurs)
                    return {
                        chargeCents: charge,
                        remainingCents: 0,
                        depositEur: 0,
                        kind: 'full',
                        fullDiscountEur: fullPaymentDiscountEur || 0,
                        germanyNoRegFee: inGermany,
                    };
                }
                if (payPlan === 'installment') {
                    if (installOpt === 'course') {
                        const charge = firstCourseCents > 0 ? firstCourseCents : Math.min(depositCents, totalCents || depositCents);
                        return {
                            chargeCents: charge,
                            remainingCents: Math.max(0, totalCents - charge),
                            depositEur: 0,
                            kind: 'installment_course',
                            fullDiscountEur: 0,
                        };
                    }
                    // 2 taksit (veya henüz alt seçim yokken varsayılan): 150 € şimdi
                    const charge = Math.min(depositCents, totalCents || depositCents);
                    return {
                        chargeCents: charge,
                        remainingCents: Math.max(0, totalCents - charge),
                        depositEur: reservationDepositEur,
                        kind: inGermany ? 'installment_de' : 'installment_two',
                        fullDiscountEur: 0,
                    };
                }
                return { chargeCents: 0, remainingCents: totalCents, depositEur: 0, kind: 'none', fullDiscountEur: 0 };
            }

            function formatPayEur(cents) {
                const eur = Math.round(cents) / 100;
                return eur.toLocaleString(lang === 'de' ? 'de-DE' : lang === 'tr' ? 'tr-TR' : lang === 'es' ? 'es-ES' : 'en-US') + ' €';
            }

            function syncPaymentUI() {
                const docStep = document.getElementById('bk-pay-step-doc');
                const planWrap = document.getElementById('bk-pay-plan');
                const installWrap = document.getElementById('bk-pay-install');
                const methodWrap = document.getElementById('bk-pay-method');
                const fullAmountEl = document.getElementById('bk-pay-full-amount');
                const fullSaveEl = document.getElementById('bk-pay-full-save');
                const installAmountEl = document.getElementById('bk-pay-install-amount');
                const totalPriceEl = document.getElementById('total-price');
                const totalLabelEl = document.querySelector('.price-total-label');
                const germanyVal = document.querySelector('[name="in-germany"]:checked')?.value || '';
                const payDoc = document.querySelector('[name="pay-doc"]:checked')?.value || '';
                const payPlan = document.querySelector('[name="pay-plan"]:checked')?.value || '';
                const installOpt = document.querySelector('[name="pay-install"]:checked')?.value || '';
                const inGermany = germanyVal === 'yes';
                const totalCents = parseInt(document.getElementById('amount-in-cents')?.value || '0', 10) || 0;
                const firstCourseCents = Math.round((promoPrice || 0) * 100);
                const depositCents = (reservationDepositEur || 0) * 100;
                const fullDiscCents = (fullPaymentDiscountEur || 0) * 100;

                if (docStep) docStep.hidden = !germanyVal;

                if (planWrap) planWrap.hidden = !(germanyVal && payDoc === 'registration');
                if (payDoc !== 'registration') {
                    document.querySelectorAll('[name="pay-plan"]').forEach(function (r) { r.checked = false; });
                    document.querySelectorAll('[name="pay-install"]').forEach(function (r) { r.checked = false; });
                }

                // Taksitli ödeme seçilince alt seçenekler (2 taksit / 1 kur) — konumdan bağımsız
                const showInstallOpts = !!(germanyVal && payDoc === 'registration' && payPlan === 'installment');
                if (installWrap) {
                    if (showInstallOpts) {
                        installWrap.hidden = false;
                        installWrap.removeAttribute('hidden');
                        installWrap.style.display = '';
                        installWrap.setAttribute('aria-hidden', 'false');
                    } else {
                        installWrap.hidden = true;
                        installWrap.setAttribute('hidden', '');
                        installWrap.setAttribute('aria-hidden', 'true');
                    }
                }
                if (!showInstallOpts) {
                    document.querySelectorAll('[name="pay-install"]').forEach(function (r) { r.checked = false; });
                }

                const showMethod = germanyVal && payDoc === 'registration' && !!payPlan && (payPlan !== 'installment' || !!installOpt);
                if (methodWrap) methodWrap.hidden = !showMethod;
                if (!showMethod) {
                    document.querySelectorAll('[name="pay-method"]').forEach(function (r) { r.checked = false; });
                }

                // Ofis ödemesi yalnızca Almanya'dayım seçiliyken
                const officeOpt = document.getElementById('bk-pay-method-office');
                const officeRadio = document.querySelector('[name="pay-method"][value="office"]');
                if (officeOpt) officeOpt.hidden = !inGermany;
                if (!inGermany && officeRadio instanceof HTMLInputElement && officeRadio.checked) {
                    officeRadio.checked = false;
                }

                const fullChargeCents = Math.max(0, totalCents - fullDiscCents);
                if (fullAmountEl) fullAmountEl.textContent = formatPayEur(fullChargeCents);
                if (fullSaveEl) {
                    if (fullDiscCents > 0 && totalCents > 0) {
                        fullSaveEl.hidden = false;
                        fullSaveEl.textContent = '−' + formatPayEur(fullDiscCents);
                    } else {
                        fullSaveEl.hidden = true;
                    }
                }
                if (installAmountEl) {
                    const installNow = (installOpt === 'course' && firstCourseCents > 0)
                        ? firstCourseCents
                        : Math.min(depositCents, totalCents || depositCents);
                    installAmountEl.textContent = formatPayEur(installNow);
                }

                const charge = computeBookingCharge({
                    totalCents,
                    firstCourseCents,
                    inGermany,
                    payDoc,
                    payPlan,
                    installOpt,
                });

                // Sidebar tutarı = gerçekten ödenecek (formdaki ayrı “Ödenecek” kalktı)
                if (totalPriceEl && totalLabelEl) {
                    const labelTotal = lang === 'tr' ? 'Toplam Tutar' : lang === 'de' ? 'Gesamtbetrag' : lang === 'es' ? 'Importe total' : 'Total Amount';
                    const labelDue = lang === 'tr' ? 'Ödenecek' : lang === 'de' ? 'Zu zahlen' : lang === 'es' ? 'A pagar' : 'Amount due';
                    const readyDue = !!germanyVal && (
                        payDoc === 'quote'
                        || (payDoc === 'registration' && !!payPlan && (payPlan !== 'installment' || !!installOpt))
                    );
                    if (readyDue) {
                        totalLabelEl.textContent = labelDue;
                        totalPriceEl.textContent = formatPayEur(charge.chargeCents);
                    } else {
                        totalLabelEl.textContent = labelTotal;
                        totalPriceEl.textContent = formatPayEur(totalCents);
                    }
                }
                restoreSubmitButtons();
            }

            document.querySelectorAll('[name="pay-doc"], [name="pay-plan"], [name="pay-install"], [name="pay-method"], [name="in-germany"]').forEach(function (el) {
                el.addEventListener('change', syncPaymentUI);
            });

            // Desktop: sidebar yalnızca kendi hizasını geçince sabitlenir (üstte orijinal yerinde kalır)
            (function initPinnedPriceSidebar() {
                const col = document.getElementById('price-calculator-col');
                const calc = document.getElementById('price-calculator');
                const content = document.querySelector('.booking-content');
                const box = document.querySelector('.booking-form-container');
                if (!col || !calc || !content) return;

                function headerOffset() {
                    const raw = getComputedStyle(document.documentElement).getPropertyValue('--header-height').trim();
                    const n = parseFloat(raw);
                    return (Number.isFinite(n) ? n : 96) + 16;
                }

                function unpin() {
                    calc.classList.remove('is-pinned');
                    calc.style.left = '';
                    calc.style.width = '';
                    calc.style.top = '';
                    calc.style.maxHeight = '';
                    col.style.height = '';
                }

                function pinSidebar() {
                    if (window.matchMedia('(max-width: 992px)').matches) {
                        unpin();
                        return;
                    }

                    const topGap = headerOffset();
                    const contentRect = content.getBoundingClientRect();
                    const boxRect = box ? box.getBoundingClientRect() : contentRect;
                    const colRect = col.getBoundingClientRect();
                    const calcHeight = calc.offsetHeight || colRect.height;

                    // Placeholder hâlâ header altında değilse → orijinal konum (progress’in üstüne binmez)
                    if (colRect.top >= topGap - 0.5) {
                        unpin();
                        return;
                    }

                    // Booking içeriği ekrandan çıktıysa bırak
                    if (contentRect.bottom <= topGap + 24) {
                        unpin();
                        return;
                    }

                    let top = topGap;
                    const maxTop = contentRect.bottom - calcHeight - 8;
                    if (top > maxTop) top = maxTop;

                    // booking-content üstünün üstüne çıkmasın
                    if (top < contentRect.top) top = contentRect.top;

                    let left = colRect.left;
                    let width = colRect.width;
                    const pad = 2;
                    if (left < boxRect.left + pad) left = boxRect.left + pad;
                    if (left + width > boxRect.right - pad) {
                        width = Math.max(200, boxRect.right - pad - left);
                    }

                    col.style.height = calcHeight + 'px';
                    calc.classList.add('is-pinned');
                    calc.style.top = top + 'px';
                    calc.style.left = left + 'px';
                    calc.style.width = width + 'px';
                    calc.style.maxHeight = Math.max(120, Math.min(
                        window.innerHeight - top - 16,
                        contentRect.bottom - top - 8
                    )) + 'px';
                }

                let ticking = false;
                function onScrollOrResize() {
                    if (ticking) return;
                    ticking = true;
                    requestAnimationFrame(function () {
                        pinSidebar();
                        ticking = false;
                    });
                }
                window.addEventListener('scroll', onScrollOrResize, { passive: true });
                window.addEventListener('resize', onScrollOrResize);
                pinSidebar();
                setTimeout(pinSidebar, 100);
            })();

