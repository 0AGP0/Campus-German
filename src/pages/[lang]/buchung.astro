            save: t.saveLine,
            meta: twelveRange,
            rate: '12 ' + t.weekWord,
            price: PRICE.visaTotal,
            weeks: 12,
            info: fmt(t.twelveInfo, { range: twelveRange })
        };
        return level === 'C1' ? [four, full] : [four, twelve, full];
