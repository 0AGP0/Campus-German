                const cta = document.getElementById('bk-mobile-dock-cta');
                if (!(cta instanceof HTMLElement)) return;
                const isFinal = currentStep >= totalSteps;
                cta.textContent = isFinal
                    ? (payUiCopy?.submitQuote || 'Teklif al')
