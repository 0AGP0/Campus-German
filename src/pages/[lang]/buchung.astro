    infoBtnLabel: translations.extraInfoBtnLabel,
    cards: [
        { field: 'visa-guarantee', title: translations.extraShortVisa, fullTitle: translations.visaGuaranteeLabel, price: STRIPE_EXTRAS.visa.eur, image: extraServiceImages.visa, icon: 'passport', theme: 'visa' as const, infoType: 'general' as const },
        { field: 'university-admission-support', title: translations.extraShortUniversity, fullTitle: translations.universityAdmissionPriceLabel, price: STRIPE_EXTRAS.university.eur, image: extraServiceImages.university, icon: 'user-graduate', theme: 'university' as const, infoType: 'general' as const },
        { field: 'accommodation-support', title: translations.extraShortAccommodation, fullTitle: translations.accommodationSupportLabel, price: STRIPE_EXTRAS.accommodation.eur, image: extraServiceImages.accommodation, icon: 'home', theme: 'accommodation' as const, infoType: 'accommodation' as const },
        { field: 'airport-pickup', title: translations.extraShortAirport, fullTitle: translations.airportPickupPrice, price: STRIPE_EXTRAS.airport.eur, image: extraServiceImages.airport, icon: 'plane-arrival', theme: 'airport' as const, infoType: 'general' as const },
        {
            field: 'speakcafe-membership',
            title: translations.extraShortSpeakcafe,
            fullTitle: translations.speakcafeLabel,
            price: 0,
            listPrice: 500,
            free: true,
            image: extraServiceImages.speakcafe,
            icon: 'comments',
            theme: 'speakcafe' as const,
            infoType: 'speakcafe' as const,
        },
    ],
};
---

<MainLayout title={`${translations.title} - CampusGerman`} lang={lang}>
    <section class="booking-form-section">
        <div class="container">
            <div class="booking-form-container">
                <!-- Main Form Section -->
                <div class="booking-form-main">
                    <!-- Progress Steps (4 steps) -->
                    <div class="form-progress">
                        <div class="progress-bar">
                            <div class="progress-fill" style="width: 20%"></div>
                        </div>
                        <div class="step-indicators">
                            <div class="step-indicator active" data-step="1">
                                <span class="step-number">1</span>
                                <span class="step-label">{translations.step1}</span>
                            </div>
                            <div class="step-indicator" data-step="2">
                                <span class="step-number">2</span>
                                <span class="step-label">{translations.step2}</span>
                            </div>
                            <div class="step-indicator" data-step="3">
                                <span class="step-number">3</span>
                                <span class="step-label">{translations.step3}</span>
                            </div>
                            <div class="step-indicator" data-step="4">
                                <span class="step-number">4</span>
                                <span class="step-label">{translations.step4}</span>
                            </div>
                        </div>
                    </div>

                    <!-- Booking Content Grid -->
                    <div class="booking-content">
                        <!-- Form Section -->
                        <div class="form-section">
                            <!-- Booking Form -->
                            <form id="booking-form" class="booking-form" data-submit-label={translations.completeBooking} data-pay-label={translations.payNowBooking} data-webhook="https://hook.eu2.make.com/40s1h4a3wra21aszpa9y9erfsfooso47" data-pay-proxy="/booking-pay-proxy.php" data-checkout-ui="embedded">
                                <input type="hidden" name="sourcePage" value={Astro.url.pathname} />
                                <input type="hidden" name="amountInCents" id="amount-in-cents" value="0" />
                                <!-- Honeypot field for spam protection -->
                                <input type="text" name="website" style="position: absolute; left: -9999px; opacity: 0; pointer-events: none; tabindex: -1;" autocomplete="off" aria-hidden="true" />
                                <!-- Step 1: Program -->
                                <div class="form-step active" data-step="1">
                                    <div class="step-header">
                                        <h2>{translations.courseInfo}</h2>
                                        <p>{translations.courseInfoDesc}</p>
                                    </div>
                                    <div class="form-grid">
                                        <div class="form-group full-width">
                                            <label>{translations.programLabel} *</label>
                                            <div class="program-slot-grid" id="program-options-grid" role="group" aria-label={translations.programLabel}>
                                                {programCardItems.map((item) => (
                                                    <label class={`program-slot program-slot--${item.mod}`}>
                                                        <input type="radio" name="program" value={item.value} />
                                                        <span class="program-slot__sel-mark" aria-hidden="true"><i class="fas fa-check"></i></span>
                                                        <div class="program-slot__head">
                                                            <img src={item.image} alt="" width="480" height="280" loading="lazy" class="program-slot__photo" />
                                                            <div class="program-slot__head-inner">
                                                                <span class="program-slot__icon"><i class={`fas fa-${item.icon}`}></i></span>
                                                                <div class="program-slot__head-copy">
                                                                    <span class="program-slot__tag">{item.tag}</span>
                                                                    <span class="program-slot__title">{item.title}</span>
                                                                    <span class="program-slot__meta">{item.desc}</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="program-slot__body">
                                                            <div class="program-slot__keywords">
                                                                {item.keywords.map((kw) => (
                                                                    <span class="program-slot__keyword">{kw}</span>
                                                                ))}
                                                            </div>
                                                            {item.priceOnRequest ? (
                                                                <p class="program-slot__price program-slot__price--request">
                                                                    <span class="program-slot__price-request">{translations.programPriceOnRequest}</span>
                                                                </p>
                                                            ) : (
                                                                <p class="program-slot__price">
                                                                    {translations.programPriceFromPrefix && (
                                                                        <span class="program-slot__price-prefix">{translations.programPriceFromPrefix}</span>
                                                                    )}
                                                                    <span class="program-slot__price-value">
                                                                        <span class="program-slot__price-num">{item.priceAmount}</span>
                                                                        <span class="program-slot__price-cur">€</span>
                                                                    </span>
                                                                    {translations.programPriceFrom && (
                                                                        <span class="program-slot__price-suffix">{translations.programPriceFrom}</span>
                                                                    )}
                                                                    {item.priceUnit && (
                                                                        <span class="program-slot__price-unit">{item.priceUnit}</span>
                                                                    )}
                                                                </p>
                                                            )}
                                                        </div>
                                                    </label>
                                                ))}
                                            </div>
                                        </div>
                                        <input type="hidden" name="intensive-type" id="intensive-type-hidden" value="intensive" />
                                        <div class="form-group full-width" id="course-selection-group" style="display: none;">
                                            <label>{translations.courseSelectionLabel} *</label>
                                            <div id="course-levels-block" class="course-options-group" style="display: none;">
                                                <div class="level-picker" id="level-picker">
                                                    <div class="level-picker__tiles">
                                                        <div id="course-levels-buttons" class="course-slot-grid level-tile-grid" role="group" aria-label={translations.courseSelectionLabel}>
                                                            <div class="lvl-opt lvl-opt--start" id="level-summary-start">
                                                                <span class="lvl-opt__start-icon" aria-hidden="true"><i class="fas fa-calendar-alt"></i></span>
                                                                <div class="lvl-opt__start-body">
                                                                    <label class="lvl-opt__start-label" for="level-start-date">{translations.startDateNearest}</label>
                                                                    <div class="level-summary__select-wrap">
                                                                        <select id="level-start-date" class="level-summary__select" aria-label={translations.startDateNearest}>
                                                                            {startDateOptions.map((opt, i) => (
                                                                                <option value={opt.value} selected={i === 0 ? true : undefined}>{opt.label}</option>
                                                                            ))}
                                                                        </select>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            {courseCardLevels.map((level) => {
                                                                const theme = courseSlotThemes[level];
                                                                const isOnlineOnlyLevel = level === 'a1' || level === 'a2';
                                                                const levelTitle = level.toUpperCase();
                                                                const levelDesc = levelSummaryCopy.desc[level] || '';
                                                                return (
                                                                    <label class={`lvl-opt course-slot course-slot--${theme.mod}${isOnlineOnlyLevel ? '' : ' course-slot--intensive-only'}`} data-course-level={level}>
                                                                        <input type="checkbox" name="course-selection" value={level} class="course-level-cb course-priced-cb" />
                                                                        <span class="lvl-opt__mark course-slot__sel-mark" aria-hidden="true"></span>
                                                                        <span class="lvl-opt__main">
                                                                            <span class="lvl-opt__code">{levelTitle}</span>
                                                                            <span class="lvl-opt__meta">
                                                                                <span class="lvl-opt__weeks">{translations.courseWeeksLabel}</span>
                                                                                {defaultCourseRangeLabel && (
                                                                                    <span class="lvl-opt__dates" data-lvl-dates>{defaultCourseRangeLabel}</span>
                                                                                )}
                                                                            </span>
                                                                        </span>
                                                                        <span class="lvl-opt__price course-slot__pricing-data">
                                                                            <span class="lvl-opt__price-block course-slot__mode-intensive">
                                                                                <span class="lvl-opt__strike" data-lvl-price-old>{PROMO_PRICE.originalText}</span>
                                                                                <span class="lvl-opt__tag">
                                                                                    <span class="lvl-opt__now" data-lvl-price-now>{PROMO_PRICE.discountedText}</span>
                                                                                </span>
                                                                                <span class="lvl-opt__multi-tag" data-lvl-multi-tag hidden></span>
                                                                            </span>
                                                                            {(level === 'a1' || level === 'a2') && (
                                                                                <span class="lvl-opt__price-block course-slot__mode-online">
                                                                                    <span class="lvl-opt__tag">
                                                                                        <span class="lvl-opt__amount">{ONLINE_LEVEL_PRICES[level]} €</span>
                                                                                    </span>
                                                                                </span>
                                                                            )}
                                                                        </span>
                                                                        <button
                                                                            type="button"
                                                                            class="bk-extra-info-btn lvl-opt__info"
                                                                            data-level-info={level}
                                                                            data-info-title={levelTitle}
                                                                            data-info-desc={levelDesc}
                                                                            aria-label={`${translations.extraInfoBtnLabel}: ${levelTitle}`}
                                                                        >
                                                                            <i class="fas fa-info" aria-hidden="true"></i>
                                                                        </button>
                                                                    </label>
                                                                );
                                                            })}
                                                            <label class="lvl-opt lvl-opt--aux course-slot course-slot--telc course-slot--intensive-only">
                                                                <input type="checkbox" name="course-selection" value="telc-c1-prep" class="course-priced-cb course-telc-cb" />
                                                                <span class="lvl-opt__mark course-slot__sel-mark" aria-hidden="true"></span>
                                                                <span class="lvl-opt__main">
                                                                    <span class="lvl-opt__code lvl-opt__code--sm">{translations.telcC1PrepLabel}</span>
                                                                    <span class="lvl-opt__meta">
                                                                        <span class="lvl-opt__weeks">{translations.telcWeeksLabel}</span>
                                                                        {defaultTelcRangeLabel && (
                                                                            <span class="lvl-opt__dates" data-lvl-dates>{defaultTelcRangeLabel}</span>
                                                                        )}
                                                                    </span>
                                                                </span>
                                                                <span class="lvl-opt__price course-slot__pricing-data">
                                                                    <span class="lvl-opt__tag">
                                                                        <span class="lvl-opt__amount">{telcPrepPrice}</span>
                                                                    </span>
                                                                </span>
                                                                <button
                                                                    type="button"
                                                                    class="bk-extra-info-btn lvl-opt__info"
                                                                    data-level-info="telc-c1-prep"
                                                                    data-info-title={translations.telcC1PrepLabel}
                                                                    data-info-desc={translations.telcPriceNote}
                                                                    aria-label={`${translations.extraInfoBtnLabel}: ${translations.telcC1PrepLabel}`}
                                                                >
                                                                    <i class="fas fa-info" aria-hidden="true"></i>
                                                                </button>
                                                            </label>
                                                            <label class="lvl-opt lvl-opt--aux lvl-opt--unsure course-slot course-slot--unsure">
                                                                <input type="checkbox" name="course-selection" value="unsure" id="course-unsure-cb" />
                                                                <span class="lvl-opt__mark course-slot__sel-mark" aria-hidden="true"></span>
                                                                <span class="lvl-opt__main">
                                                                    <span class="lvl-opt__code lvl-opt__code--sm">{translations.courseUnsureLabel}</span>
                                                                </span>
                                                                <button
                                                                    type="button"
                                                                    class="bk-extra-info-btn lvl-opt__info"
                                                                    data-level-info="unsure"
                                                                    data-info-title={translations.courseUnsureLabel}
                                                                    data-info-desc={translations.courseUnsureInfoDesc}
                                                                    aria-label={`${translations.extraInfoBtnLabel}: ${translations.courseUnsureLabel}`}
                                                                >
                                                                    <i class="fas fa-info" aria-hidden="true"></i>
                                                                </button>
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div id="course-camps-block" class="course-options-group" style="display: none;">
                                                <div class="option-buttons option-buttons-checkboxes" role="group">
                                                    <label class="option-btn"><input type="checkbox" name="course-selection" value="berlin-camp"><span class="option-btn-text">{translations.campBerlin}</span></label>
                                                    <label class="option-btn"><input type="checkbox" name="course-selection" value="muenster-camp"><span class="option-btn-text">{translations.campMuenchen}</span></label>
                                                    <label class="option-btn"><input type="checkbox" name="course-selection" value="bremen-camp"><span class="option-btn-text">{translations.campBremen}</span></label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="form-group full-width" id="weeks-block" style="display: none;">
                                            <input type="hidden" id="weeks-value" name="weeks" value="" />
                                            <label id="weeks-label">{translations.weeksLabel} *</label>
                                            <div id="weeks-buttons-wrap" class="week-slot-grid" role="group" aria-label={translations.weeksLabel} style="display: none;">
                                                {shortTermWeekOptions.map((opt) => (
                                                    <label class={`course-slot course-slot--week course-slot--week-${opt.value}`}>
                                                        <input type="radio" name="weeks-choice" value={String(opt.value)} class="weeks-choice-radio" />
                                                        <div class="course-slot__head" aria-hidden="true">
                                                            <span class="course-slot__sel-mark" aria-hidden="true"></span>
                                                            <span class="course-slot__icon"><i class="fas fa-calendar-week"></i></span>
                                                            <div class="course-slot__head-copy">
                                                                <span class="course-slot__level-label">{opt.value}</span>
                                                                <span class="course-slot__head-meta">{translations.weeksUnitLabel}</span>
                                                            </div>
                                                        </div>
                                                        <div class="course-slot__main course-slot__main--compact-week">
                                                            <ul class="course-slot__features">
                                                                {opt.features.map((feature) => (
                                                                    <li><i class="fas fa-check" aria-hidden="true"></i><span>{feature}</span></li>
                                                                ))}
                                                            </ul>
                                                        </div>
                                                    </label>
                                                ))}
                                                <label class="course-slot course-slot--week course-slot--week-other">
                                                    <input type="radio" name="weeks-choice" value="other" class="weeks-choice-radio" />
                                                    <div class="course-slot__head" aria-hidden="true">
                                                        <span class="course-slot__sel-mark" aria-hidden="true"></span>
                                                        <span class="course-slot__icon"><i class="fas fa-sliders-h"></i></span>
                                                        <div class="course-slot__head-copy">
                                                            <span class="course-slot__level-label course-slot__level-label--sm">{translations.weeksBtnOther}</span>
                                                            <span class="course-slot__head-meta">{translations.weeksOtherPlaceholder}</span>
                                                        </div>
                                                    </div>
                                                    <div class="course-slot__main course-slot__main--compact-week">
                                                        <ul class="course-slot__features">
                                                            {weekCardOtherFeatures.map((feature) => (
                                                                <li><i class="fas fa-check" aria-hidden="true"></i><span>{feature}</span></li>
                                                            ))}
                                                        </ul>
                                                    </div>
                                                </label>
                                            </div>
                                            <div id="weeks-other-wrap" class="weeks-other-panel" style="display: none;">
                                                <label for="weeks-other-input" class="weeks-other-panel__label">{translations.weeksOtherPlaceholder}</label>
                                                <div class="weeks-number-input-wrap">
                                                    <input type="number" id="weeks-other-input" min="1" max="48" placeholder="1–48" aria-label={translations.weeksOtherPlaceholder} class="booking-text-input" />
                                                    <span class="weeks-number-unit">{translations.weeksUnitLabel}</span>
                                                </div>
                                            </div>
                                            <div id="weeks-select-wrap" class="weeks-control-wrap" style="display: none;">
                                                <select id="weeks" aria-label={translations.weeksLabel}>
                                                    <option value="">{translations.weeksPlaceholder}</option>
                                                    <option value="1">{translations.weeksOption1}</option>
                                                    <option value="2">{translations.weeksOption2}</option>
                                                    <option value="4">{translations.weeksOption4}</option>
                                                    <option value="8">{translations.weeksOption8}</option>
                                                    <option value="16">{translations.weeksOption16}</option>
                                                    <option value="24">{translations.weeksOption24}</option>
                                                    <option value="32">{translations.weeksOption32}</option>
                                                    <option value="40">{translations.weeksOption40}</option>
                                                    <option value="48">{translations.weeksOption48}</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group full-width booking-start-fallback" id="booking-start-fallback" hidden>
                                        <label for="fallback-start-date">{translations.startDateNearest} *</label>
                                        <div class="level-summary__select-wrap">
                                            <select id="fallback-start-date" class="level-summary__select" aria-label={translations.startDateNearest}>
                                                {startDateOptions.map((opt, i) => (
                                                    <option value={opt.value} selected={i === 0 ? true : undefined}>{opt.label}</option>
                                                ))}
                                            </select>
                                        </div>
                                        <p class="booking-start-fallback__error" id="booking-start-date-error" hidden role="alert">{translations.needStartDate}</p>
                                    </div>
                                    <input type="hidden" id="start-date" name="start-date" value={nearestStartDateValue} />
                                    <input type="hidden" id="booking-start-date-mode" name="start-date-mode" value="preset" />
                                    <input type="hidden" name="timezone-slot" id="booking-timezone-slot" value="" />

                                    <div class="form-navigation">
                                        <button type="button" class="btn-next">{translations.continueBtn}</button>
                                    </div>
                                </div>

                                <BookingExtrasStep copy={extrasStepCopy} />

                                <!-- Step 3: Payment -->
                                <div class="form-step" data-step="3">
                                    <div class="step-header">
                                        <h2>{translations.step3}</h2>
                                        <p>{translations.payStepDesc}</p>
                                    </div>

                                    <div class="bk-pay" id="bk-pay">
                                        <ol class="bk-pay__path">
                                            <li class="bk-pay__step" data-pay-step="1">
                                                <div class="bk-pay__head">
                                                    <span class="bk-pay__num" aria-hidden="true">1</span>
                                                    <span class="bk-pay__head-label">{translations.germanyLocationLabel}</span>
                                                </div>
                                                <div class="bk-pay__opts bk-pay__opts--2 bk-pay__opts--location" role="radiogroup" aria-label={translations.germanyLocationLabel}>
                                                    <label class="bk-pay__opt bk-pay__opt--location">
                                                        <input type="radio" name="in-germany" value="yes" />
                                                        <span class="bk-pay__radio" aria-hidden="true"></span>
                                                        <span class="bk-pay__opt-body bk-pay__opt-body--location">
                                                            <span class="bk-pay__flag bk-pay__flag--de" aria-hidden="true" title="Deutschland">
                                                                <span class="bk-pay__flag-stripe bk-pay__flag-stripe--black"></span>
                                                                <span class="bk-pay__flag-stripe bk-pay__flag-stripe--red"></span>
                                                                <span class="bk-pay__flag-stripe bk-pay__flag-stripe--gold"></span>
                                                            </span>
                                                            <span class="bk-pay__opt-title">{translations.germanyLocationYes}</span>
                                                        </span>
                                                    </label>
                                                    <label class="bk-pay__opt bk-pay__opt--location">
                                                        <input type="radio" name="in-germany" value="no" />
                                                        <span class="bk-pay__radio" aria-hidden="true"></span>
                                                        <span class="bk-pay__opt-body bk-pay__opt-body--location">
                                                            <span class="bk-pay__flag bk-pay__flag--world" aria-hidden="true" title="International">
                                                                <i class="fas fa-globe-europe" aria-hidden="true"></i>
                                                            </span>
                                                            <span class="bk-pay__opt-title">{translations.germanyLocationNo}</span>
                                                        </span>
                                                    </label>
                                                </div>
                                            </li>

                                            <li class="bk-pay__step" id="bk-pay-plan" hidden data-pay-step="2">
                                                <div class="bk-pay__head">
                                                    <span class="bk-pay__num" aria-hidden="true">2</span>
                                                    <span class="bk-pay__head-label">{translations.payPlanLabel}</span>
                                                </div>
                                                <div class="bk-pay__opts bk-pay__opts--2" role="radiogroup" aria-label={translations.payPlanLabel}>
                                                    <label class="bk-pay__opt bk-pay__opt--plan bk-pay__opt--visa">
                                                        <input type="radio" name="pay-plan" value="full" />
                                                        <span class="bk-pay__radio" aria-hidden="true"></span>
                                                        <span class="bk-pay__opt-body">
                                                            <span class="bk-pay__visa">{translations.payFullVisaInfo}</span>
                                                            <span class="bk-pay__opt-title">{translations.payPlanFull}</span>
                                                            <span class="bk-pay__opt-meta">
                                                                <span class="bk-pay__save" id="bk-pay-full-save" hidden></span>
                                                            </span>
                                                        </span>
                                                        <span class="bk-pay__price-block">
                                                            <span class="bk-pay__opt-was" id="bk-pay-full-was" hidden></span>
                                                            <span class="bk-pay__opt-price" id="bk-pay-full-amount">—</span>
                                                            <span class="bk-pay__price-cap">{translations.payPriceOnce}</span>
                                                        </span>
                                                    </label>
                                                    <label class="bk-pay__opt bk-pay__opt--plan">
                                                        <input type="radio" name="pay-plan" value="installment" />
                                                        <span class="bk-pay__radio" aria-hidden="true"></span>
                                                        <span class="bk-pay__opt-body">
                                                            <span class="bk-pay__opt-title">{translations.payPlanInstall}</span>
                                                        </span>
                                                        <span class="bk-pay__price-block">
                                                            <span class="bk-pay__opt-price" id="bk-pay-install-amount">—</span>
                                                            <span class="bk-pay__price-cap" id="bk-pay-install-hint">{translations.payInstallDepositHint}</span>
                                                        </span>
                                                    </label>
                                                </div>
                                                <div class="bk-pay__branch" id="bk-pay-install" hidden role="radiogroup" aria-label={translations.payPlanInstall}>
                                                    <label class="bk-pay__branch-opt bk-pay__branch-opt--featured">
                                                        <input type="radio" name="pay-install" value="half" />
                                                        <span class="bk-pay__radio" aria-hidden="true"></span>
                                                        <span class="bk-pay__branch-body">
                                                            <span class="bk-pay__branch-title-row">
                                                                <span class="bk-pay__branch-text">{translations.payInstallHalfTitle}</span>
                                                                <span class="bk-pay__branch-badge">{translations.payInstallHalfBadge}</span>
                                                            </span>
                                                            <span class="bk-pay__branch-prices">
                                                                <span class="bk-pay__branch-row">
                                                                    <span>{translations.payNowShort}</span>
                                                                    <strong id="bk-pay-half-now">—</strong>
                                                                </span>
                                                                <span class="bk-pay__branch-row bk-pay__branch-row--muted" id="bk-pay-half-rest-row">
                                                                    <span id="bk-pay-half-rest-label">{translations.payInstallHalfRest}</span>
                                                                    <span id="bk-pay-half-rest">—</span>
                                                                </span>
                                                            </span>
                                                        </span>
                                                    </label>
                                                    <label class="bk-pay__branch-opt">
