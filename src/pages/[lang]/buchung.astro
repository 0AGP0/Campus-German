            const unsureCb = document.getElementById('course-unsure-cb');
            if (unsureCb) unsureCb.addEventListener('change', syncUnsureCourseSelection);

            const COURSE_LEVEL_CHAIN_ORDER = ['a1','a2','b1','b2','c1','telc-c1-prep','unsure'];
            const WEEKS_PER_COURSE = 8;

            function parseDdMmYyyyClient(value) {
                const m = String(value || '').trim().match(/^(\d{1,2})\.(\d{1,2})\.(\d{4})$/);
                if (!m) return null;
                const d = new Date(parseInt(m[3], 10), parseInt(m[2], 10) - 1, parseInt(m[1], 10));
                d.setHours(0, 0, 0, 0);
                return isNaN(d.getTime()) ? null : d;
            }
            function snapToNearestMondayClient(date) {
                const d = new Date(date);
                d.setHours(0, 0, 0, 0);
                const day = d.getDay();
                if (day === 1) return d;
                const toPrev = day === 0 ? 6 : day - 1;
                const toNext = day === 0 ? 1 : 8 - day;
                if (toNext < toPrev) d.setDate(d.getDate() + toNext);
                else d.setDate(d.getDate() - toPrev);
                return d;
            }
            function snapToNearestFridayClient(date) {
                const d = new Date(date);
                d.setHours(0, 0, 0, 0);
                const day = d.getDay();
                if (day === 5) return d;
                const toPrev = (day - 5 + 7) % 7;
                const toNext = (5 - day + 7) % 7;
                if (toNext === 0) return d;
                if (toNext <= toPrev) d.setDate(d.getDate() + toNext);
                else d.setDate(d.getDate() - toPrev);
                return d;
            }
            function getCourseEndFridayClient(startMonday, weeks) {
                const w = Math.max(1, Math.round(weeks) || 1);
                const start = snapToNearestMondayClient(startMonday);
                const ideal = new Date(start);
                ideal.setDate(ideal.getDate() + (w - 1) * 7 + 4);
                const end = snapToNearestFridayClient(ideal);
                const maxEnd = new Date(start);
                maxEnd.setDate(maxEnd.getDate() + w * 7);
                if (end.getTime() > maxEnd.getTime()) return snapToNearestFridayClient(maxEnd);
                return end;
            }
            function getNextCourseMondayClient(endFriday) {
                const d = new Date(endFriday);
                d.setHours(0, 0, 0, 0);
                const day = d.getDay();
                const add = day === 5 ? 3 : day === 6 ? 2 : day === 0 ? 1 : (8 - day);
                d.setDate(d.getDate() + add);
                return snapToNearestMondayClient(d);
            }
            function formatCourseDayMonthClient(date) {
                const day = date.getDate();
                const month = date.getMonth() + 1;
                const names = {
                    tr: ['', 'Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'],
                    de: ['', 'Januar', 'Februar', 'März', 'April', 'Mai', 'Juni', 'Juli', 'August', 'September', 'Oktober', 'November', 'Dezember'],
                    en: ['', 'January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'],
                    es: ['', 'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'],
                };
                const monthName = (names[lang] || names.en)[month];
                if (lang === 'en') return monthName + ' ' + day;
                if (lang === 'de') return day + '. ' + monthName;
                return day + ' ' + monthName;
            }
            function formatCourseRangeClient(start, end) {
                return formatCourseDayMonthClient(start) + ' → ' + formatCourseDayMonthClient(end);
            }
            function toDdMmYyyyClient(date) {
                const dd = String(date.getDate()).padStart(2, '0');
                const mm = String(date.getMonth() + 1).padStart(2, '0');
                return dd + '.' + mm + '.' + date.getFullYear();
            }
            function getAnchorStartMonday() {
                const select = typeof activeStartDateSelect === 'function' ? activeStartDateSelect() : null;
                const raw = (select && select.value)
                    || (startDateHidden && startDateHidden.value)
                    || nearestStartDateValue
                    || '';
                const parsed = parseDdMmYyyyClient(raw);
                return parsed ? snapToNearestMondayClient(parsed) : null;
            }

            /** Seçili kurslar için Pzt→Cum aralıkları; seçilmemiş kartlar bir sonraki zincir slotunu gösterir. */
            function buildCourseDateChain() {
                const anchor = getAnchorStartMonday();
                if (!anchor) return { byValue: {}, nextPreview: null, periods: [] };
                const ordered = getOrderedSelectedCourses();
                const byValue = {};
                const periods = [];
                let cursor = new Date(anchor);
                ordered.forEach(function (cb) {
                    const weeks = getIntensiveWeeksForCourse(cb.value) || WEEKS_PER_COURSE;
                    const start = new Date(cursor);
                    const end = getCourseEndFridayClient(start, weeks);
                    byValue[cb.value] = { start: start, end: end, range: formatCourseRangeClient(start, end), weeks: weeks, chained: periods.length > 0 };
                    periods.push({
                        level: cb.value,
                        weeks: weeks,
                        start: toDdMmYyyyClient(start),
                        end: toDdMmYyyyClient(end),
                        label: formatCourseRangeClient(start, end),
                    });
                    cursor = getNextCourseMondayClient(end);
                });
                const nextWeeks = WEEKS_PER_COURSE;
                const nextStart = new Date(cursor);
                const nextEnd = getCourseEndFridayClient(nextStart, nextWeeks);
                return {
                    byValue: byValue,
                    nextPreview: { start: nextStart, end: nextEnd, range: formatCourseRangeClient(nextStart, nextEnd), weeks: nextWeeks, chained: ordered.length > 0 },
                    periods: periods,
                };
            }

            function syncCourseSlotDates() {
                const program = document.querySelector('[name="program"]:checked')?.value;
                const show = program === 'intensive' || program === 'online';
                const chain = show ? buildCourseDateChain() : { byValue: {}, nextPreview: null, periods: [] };
                window.__bookingCoursePeriods = chain.periods || [];

                document.querySelectorAll('#course-levels-buttons .lvl-opt.course-slot').forEach(function (slot) {
                    const input = slot.querySelector('[name="course-selection"]');
                    const datesEl = slot.querySelector('[data-lvl-dates]');
                    if (!(input instanceof HTMLInputElement) || !(datesEl instanceof HTMLElement)) return;
                    if (input.value === 'unsure') {
                        datesEl.textContent = '';
                        datesEl.hidden = true;
                        return;
                    }
                    if (!show) {
                        datesEl.hidden = true;
                        return;
                    }
                    const weeks = getIntensiveWeeksForCourse(input.value) || WEEKS_PER_COURSE;
                    let info = null;
                    if (input.checked && chain.byValue[input.value]) {
                        info = chain.byValue[input.value];
                    } else if (chain.nextPreview) {
                        // Seçili değilse: bir sonraki slot (zincir) — Telc 4 hafta özel
                        if (input.value === 'telc-c1-prep') {
                            const start = new Date(chain.nextPreview.start);
                            const end = getCourseEndFridayClient(start, weeks);
                            info = { range: formatCourseRangeClient(start, end), chained: chain.nextPreview.chained };
                        } else {
                            info = chain.nextPreview;
                        }
                    }
                    if (info && info.range) {
                        datesEl.textContent = info.range;
