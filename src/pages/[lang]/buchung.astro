            function updateCourseSelectionUI() {
                const container = document.getElementById('course-levels-buttons');
                if (!container) return;

                const ordered = getOrderedSelectedCourses();
                const n = ordered.length;
                container.setAttribute('data-selection-count', String(n));
                container.classList.toggle('course-slot-grid--multi', n >= 2);

                container.querySelectorAll('label.course-slot').forEach(function (label) {
                    label.removeAttribute('data-selection-order');
                    const mark = label.querySelector('.course-slot__sel-mark');
                    if (mark) mark.textContent = '';
                });

                ordered.forEach(function (cb, idx) {
                    const label = cb.closest('label.course-slot');
                    if (!label) return;
                    const order = idx + 1;
                    label.setAttribute('data-selection-order', String(order));
                    const mark = label.querySelector('.course-slot__sel-mark');
                    if (mark) mark.textContent = n >= 2 ? String(order) : '✓';
                });
                updateLevelSummary();
            }

            function updateLevelSummary() {
                const emptyEl = document.getElementById('level-summary-empty');
                const bodyEl = document.getElementById('level-summary-body');
                const titleEl = document.getElementById('level-summary-title');
                const metaEl = document.getElementById('level-summary-meta');
                const levelsEl = document.getElementById('level-summary-levels');
                const descEl = document.getElementById('level-summary-desc');
                if (!emptyEl || !bodyEl || !titleEl || !metaEl || !levelsEl) return;

                const program = document.querySelector('[name="program"]:checked')?.value;
                const isOnline = program === 'online';
                const unsure = document.getElementById('course-unsure-cb');
                const ordered = getOrderedSelectedCourses();
                const hasUnsure = !!(unsure && unsure.checked);
                const hasSelection = ordered.length > 0 || hasUnsure;

                titleEl.textContent = isOnline ? levelSummaryCopy.titleOnline : levelSummaryCopy.title;
                metaEl.textContent = isOnline ? levelSummaryCopy.metaOnline : levelSummaryCopy.meta;

                if (!hasSelection) {
                    emptyEl.hidden = false;
                    bodyEl.hidden = true;
                    levelsEl.textContent = '';
                    if (descEl) descEl.textContent = '';
                    return;
                }

                emptyEl.hidden = true;
                bodyEl.hidden = false;

                const labels = ordered.map(function (cb) {
                    return bookingWebhookLabels.courseLevel[cb.value] || String(cb.value).toUpperCase();
                });
                if (hasUnsure) labels.push(bookingWebhookLabels.courseLevel.unsure);
                levelsEl.textContent = labels.join(' · ');

                if (descEl) {
                    const focusVal = ordered.length
                        ? ordered[ordered.length - 1].value
                        : (hasUnsure ? 'unsure' : '');
                    const main = LEVEL_RE.test(focusVal) ? focusVal : focusVal;
                    descEl.textContent = levelSummaryCopy.desc[main] || levelSummaryCopy.desc[focusVal] || '';
                }
                toggleBundleInfobox();
            }

