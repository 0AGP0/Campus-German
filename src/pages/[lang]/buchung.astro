                            accHtml += `<div class="summary-row"><strong>${labels.price}:</strong> <span>${accPrice} €</span></div>`;
                        }
                        accHtml += '</div>';
                        accommodationSummary.innerHTML = accHtml;
                        accommodationSummarySection.style.display = 'block';
                    }
                } else {
                    if (accommodationSummarySection) {
                        accommodationSummarySection.style.display = 'none';
                    }
                }
                
                // Build price summary
                if (priceSummary) {
                    const totalPrice = document.getElementById('total-price')?.textContent || '0 €';
                    let priceHtml = '<div class="summary-item">';
                    
                    // Registration fee
                    priceHtml += `<div class="summary-row"><strong>${labels.registrationFee}:</strong> <span>50 €</span></div>`;
                    
                    // Course price
                    const courseTypePriceEl = document.getElementById('course-type-price');
                    if (courseTypePriceEl && courseTypePriceEl.style.display !== 'none') {
                        const courseLabel = courseTypePriceEl.querySelector('.price-item-label')?.textContent || '';
                        const courseValue = courseTypePriceEl.querySelector('.price-item-value')?.textContent || '';
                        if (courseLabel && courseValue) {
                            priceHtml += `<div class="summary-row"><strong>${courseLabel}:</strong> <span>${courseValue}</span></div>`;
                        }
                    }
                    
                    // Optional services
                    const transferArrival = document.querySelector('[name="transfer-arrival"]:checked');
                    const transferDeparture = document.querySelector('[name="transfer-departure"]:checked');
                    const visaSupport = document.querySelector('[name="visa-support"]:checked');
                    
                    if (transferArrival) {
                        priceHtml += `<div class="summary-row"><strong>${labels.airportTransferArrival}:</strong> <span>100 €</span></div>`;
                    }
                    if (transferDeparture) {
                        priceHtml += `<div class="summary-row"><strong>${labels.airportTransferDeparture}:</strong> <span>100 €</span></div>`;
                    }
                    if (visaSupport) {
                        priceHtml += `<div class="summary-row"><strong>${labels.visaSupport}:</strong> <span>50 €</span></div>`;
                    }
                    
                    // Total
                    priceHtml += `<div class="summary-row summary-total"><strong>${labels.total}:</strong> <span>${totalPrice}</span></div>`;
                    priceHtml += '</div>';
                    priceSummary.innerHTML = priceHtml;
                }
            }

            function validateStep(step) {
                const currentStepElement = formSteps[step - 1];
                let isValid = true;

                if (step === 1) {
                    const program = document.querySelector('[name="program"]:checked')?.value;
                    const startDate = document.getElementById('start-date')?.value;
                    const intensiveType = document.querySelector('[name="intensive-type"]:checked')?.value;
                    const courseSelectionGroup = document.getElementById('course-selection-group');
                    const checkedCourses = Array.from(document.querySelectorAll('[name="course-selection"]:checked')).map(c => c.value);
                    const courseLevelsBlock = document.getElementById('course-levels-block');
                    const courseCampsBlock = document.getElementById('course-camps-block');
                    const pathwayBundleOk = (program === 'intensive' || program === 'online') && resolvePromoBundlePrice() === 5990;
                    const hasVisibleCourseSelection = (program === 'intensive' || program === 'online') ? (courseLevelsBlock?.offsetParent && (checkedCourses.length > 0 || pathwayBundleOk)) :
                        (program === 'youth-camp') ? (courseCampsBlock?.offsetParent && checkedCourses.length > 0) : false;
                    if (!program) { document.querySelector('[name="program"]')?.closest('.form-group')?.classList.add('error'); isValid = false; } else { document.querySelector('[name="program"]')?.closest('.form-group')?.classList.remove('error'); }
                    if ((program === 'intensive' || program === 'online') && !intensiveType) { const g = document.getElementById('intensive-type-group'); if (g) g.classList.add('error'); isValid = false; } else { const g = document.getElementById('intensive-type-group'); if (g) g.classList.remove('error'); }
                    if (!startDate) { document.getElementById('start-date')?.classList.add('error'); isValid = false; } else { document.getElementById('start-date')?.classList.remove('error'); }
                    if (program && !hasVisibleCourseSelection) { if (courseSelectionGroup) courseSelectionGroup.classList.add('error'); isValid = false; } else { if (courseSelectionGroup) courseSelectionGroup.classList.remove('error'); }
                    if (program === 'intensive' || program === 'online' || program === 'youth-camp') {
                        const weeks = getWeeksValue();
                        const needWeeks = (program === 'youth-camp') || (checkedCourses.includes('short-term'));
                        if (needWeeks && !weeks) { weeksBlock?.classList.add('error'); isValid = false; } else { weeksBlock?.classList.remove('error'); }
                    }
                    return isValid;
                }

                const requiredFields = currentStepElement.querySelectorAll('[required]');
                requiredFields.forEach(field => {
                    if (field.offsetParent !== null) {
                        if (!field.value || (field.type === 'radio' && !currentStepElement.querySelector(`[name="${field.name}"]:checked`))) {
                            isValid = false;
                            field.classList.add('error');
                        } else {
                            field.classList.remove('error');
                        }
                    }
                });
                return isValid;
            }

            // Next button handlers
            btnNext.forEach(btn => {
                btn.addEventListener('click', function() {
                    if (validateStep(currentStep)) {
                        if (currentStep < totalSteps) {
                            showStep(currentStep + 1);
                        }
                    }
                });
            });

            // Prev button handlers
            btnPrev.forEach(btn => {
                btn.addEventListener('click', function() {
                    if (currentStep > 1) {
                        showStep(currentStep - 1);
                    }
                });
            });

            // Program, course-selection, weeks, extras → update price
            document.querySelectorAll('[name="course-selection"]').forEach(function (el) {
                el.addEventListener('change', function () {
                    const pathwayToggle = document.getElementById('pathway-bundle-quick-toggle');
                    if (pathwayToggle?.checked) {
                        pathwayToggle.checked = false;
                        if (promoBundleId === 'pathway') {
                            promoBundleId = null;
                            syncPromoBundleHidden();
                        }
                    }
                    enforceShortTermExclusion();
                    toggleWeeksBlockForShortTerm();
                    toggleBundleInfobox();
                    filterWeeksByLevelCourses();
                    updatePrice();
                    reorderCourseSelectionChain();
                });
            });
            reorderCourseSelectionChain();
            document.querySelectorAll('[name="intensive-type"]').forEach(el => el.addEventListener('change', function() { toggleBundleInfobox(); updatePrice(); }));
            weeksSelect?.addEventListener('change', function() { setWeeksValue(this.value); toggleBundleInfobox(); updatePrice(); });
            if (weeksShortTermInput) {
                weeksShortTermInput.addEventListener('input', function() { setWeeksValue(this.value); toggleBundleInfobox(); updatePrice(); });
                weeksShortTermInput.addEventListener('change', function() {
                    let v = parseInt(this.value, 10);
                    if (v < 1) this.value = 1; else if (v > 24) this.value = 24;
                    setWeeksValue(this.value); toggleBundleInfobox(); updatePrice();
                });
            }
            document.querySelectorAll('[name="visa-needed"]').forEach(el => el.addEventListener('change', updatePrice));
            document.querySelectorAll('[name="accommodation-type"]').forEach(el => el.addEventListener('change', updatePrice));
            document.querySelectorAll('[name="airport-pickup"]').forEach(el => el.addEventListener('change', updatePrice));

            // ===== COUPON =====
            let appliedCoupon = null;
            const couponInput = document.getElementById('coupon-input');
            const couponApplyBtn = document.getElementById('coupon-apply-btn');
            const couponMessage = document.getElementById('coupon-message');
            const couponDiscountRow = document.getElementById('coupon-discount-row');
            const couponDiscountValue = document.getElementById('coupon-discount-value');
            const couponDiscountPercentInput = document.getElementById('coupon-discount-percent');
            const formEl = document.getElementById('booking-form');
            const couponInvalidText = (formEl && formEl.dataset.couponInvalid) ? formEl.dataset.couponInvalid : (lang === 'tr' ? 'Geçersiz kupon' : lang === 'de' ? 'Ungültiger Gutschein' : lang === 'es' ? 'Cupón no válido' : 'Invalid coupon');
            function getCouponSuccessText(pct) {
                return lang === 'tr' ? '%' + pct + ' indirim uygulandı' : lang === 'de' ? pct + ' % Rabatt angewendet' : lang === 'es' ? pct + '% de descuento aplicado' : pct + '% discount applied';
            }
            function applyCoupon() {
                const raw = couponInput?.value?.trim() || '';
                const code = raw.toUpperCase();
                const found = Array.isArray(validCoupons) && validCoupons.find(function(c) { return (c.code || '').toUpperCase() === code; });
                if (found) {
                    appliedCoupon = found;
                    const pct = found.discountPercent || 0;
                    const successText = getCouponSuccessText(pct);
                    if (couponDiscountPercentInput) couponDiscountPercentInput.value = String(pct);
                    if (couponMessage) { couponMessage.textContent = successText; couponMessage.style.display = 'block'; couponMessage.classList.remove('coupon-message-error'); couponMessage.classList.add('coupon-message-success'); }
                    const couponRowLabel = document.querySelector('#coupon-discount-row .price-item-label');
                    if (couponRowLabel) couponRowLabel.textContent = successText;
                    if (couponInput) couponInput.disabled = true;
                    if (couponApplyBtn) couponApplyBtn.disabled = true;
                    updatePrice();
                } else {
                    appliedCoupon = null;
                    if (couponDiscountPercentInput) couponDiscountPercentInput.value = '';
                    if (couponMessage) { couponMessage.textContent = couponInvalidText; couponMessage.style.display = 'block'; couponMessage.classList.remove('coupon-message-success'); couponMessage.classList.add('coupon-message-error'); }
                    if (couponDiscountRow) couponDiscountRow.style.display = 'none';
                    updatePrice();
                }
            }
            if (couponApplyBtn) couponApplyBtn.addEventListener('click', applyCoupon);
            if (couponInput) couponInput.addEventListener('keydown', function(e) { if (e.key === 'Enter') { e.preventDefault(); applyCoupon(); } });
            if (couponInput?.value?.trim() && Array.isArray(validCoupons) && validCoupons.find(function(c) { return (c.code || '').toUpperCase() === couponInput.value.trim().toUpperCase(); })) {
                setTimeout(applyCoupon, 100);
            }

            // ===== PRICE CALCULATION =====
            const programLabels = { tr: { intensive: 'Yoğun', online: 'Online', 'youth-camp': 'Yaz Kampı' }, de: { intensive: 'Intensiv', online: 'Online', 'youth-camp': 'Sommercamp' }, en: { intensive: 'Intensive', online: 'Online', 'youth-camp': 'Summer Camp' }, es: { intensive: 'Intensivo', online: 'Online', 'youth-camp': 'Campamento verano' } };
            function updatePrice() {
                let total = 0;
                let courseTotal = 0;
                let courseAmountAfterBundle = 0; // Kupon indirimi buna uygulanır (bundle sonrası kurs tutarı)
                const courseTypePrice = document.getElementById('course-type-price');
                const durationPrice = document.getElementById('duration-price');
                const bundleDiscountRow = document.getElementById('bundle-discount-row');
                const bundleDiscountValue = document.getElementById('bundle-discount-value');
                const visaPriceRow = document.getElementById('visa-price-row');
                const accommodationPriceRow = document.getElementById('accommodation-price-row');
                const airportPriceRow = document.getElementById('airport-price-row');
                const totalPriceElement = document.getElementById('total-price');
                const program = document.querySelector('[name="program"]:checked')?.value;
                const intensiveType = document.querySelector('[name="intensive-type"]:checked')?.value;
                const checkedCourses = Array.from(document.querySelectorAll('[name="course-selection"]:checked')).map(c => c.value);
                const weeks = getWeeksValue();
                const currentLang = lang || 'tr';
                const t = programLabels[currentLang] || programLabels.tr;

                if (!courseTypePrice) return;

                const promoCoursePrice = resolvePromoBundlePrice();
                const activeBundleSlug = currentPromoBundleSlug();
                if (program && (checkedCourses.length > 0 || promoCoursePrice != null)) {
                    let coursePrice = 0;
                    let totalWeeksNoShort = 0;
                    const levelCourses = checkedCourses.filter(c => ['a1','a2','b1','b2','c1'].includes(c));
                    const hasTelcPrep = checkedCourses.includes('telc-prep');
                    const hasShortTerm = checkedCourses.includes('short-term');

                    if (program === 'intensive' || program === 'online') {
                        if (promoCoursePrice != null) {
                            coursePrice = promoCoursePrice;
                        } else {
                            const shortTermWeeks = hasShortTerm ? (parseInt(weeks, 10) || 0) : 0;
                            totalWeeksNoShort = (levelCourses.length * 8) + (hasTelcPrep ? 8 : 0);
                            if (hasShortTerm && shortTermWeeks > 0) {
                                coursePrice += getTieredPrice(shortTermWeeks, intensiveType === 'intensive-plus');
                            } else if (totalWeeksNoShort > 0) {
                                coursePrice += getTieredPrice(totalWeeksNoShort, intensiveType === 'intensive-plus');
                            }
                        }
                    } else if (program === 'youth-camp') {
                        for (const courseValue of checkedCourses) {
                            const levelForCourse = ['berlin-camp','muenster-camp','bremen-camp'].includes(courseValue) ? 'a1' : courseValue;
                            coursePrice += getCoursePrice(program, levelForCourse, weeks, intensiveType);
                        }
                    }
                    courseTotal = coursePrice;
                    courseAmountAfterBundle = coursePrice;
                    const programLabel = t[program] || program;
                    let labelSuffix = checkedCourses.length ? ' (' + checkedCourses.map(c => c.toUpperCase().replace(/-/g, ' ')).join(', ') + ')' : '';
                    if (program === 'intensive' || program === 'online') {
                        if (activeBundleSlug === 'pathway' && promoCoursePrice === 5990) {
                            labelSuffix = ' — ' + pathwayBundleCourseLabel;
                        } else if (activeBundleSlug === 'a2c1') {
                            const shortTermWeeks = hasShortTerm ? (parseInt(weeks, 10) || 0) : 0;
                            const dispWeeks = hasShortTerm ? shortTermWeeks : ((levelCourses.length * 8) + (hasTelcPrep ? 8 : 0));
                            const weekWord = dispWeeks === 1
                                ? (currentLang === 'tr' ? 'hafta' : currentLang === 'de' ? 'Woche' : currentLang === 'es' ? 'semana' : 'week')
                                : (currentLang === 'tr' ? 'hafta' : currentLang === 'de' ? 'Wochen' : currentLang === 'es' ? 'semanas' : 'weeks');
                            labelSuffix = ' ' + dispWeeks + ' ' + weekWord + labelSuffix + ' — ' + bookingBundlePromoLabels.a2c1;
                        } else if (activeBundleSlug === 'b1c1') {
                            const shortTermWeeks = hasShortTerm ? (parseInt(weeks, 10) || 0) : 0;
                            const dispWeeks = hasShortTerm ? shortTermWeeks : ((levelCourses.length * 8) + (hasTelcPrep ? 8 : 0));
                            const weekWord = dispWeeks === 1
                                ? (currentLang === 'tr' ? 'hafta' : currentLang === 'de' ? 'Woche' : currentLang === 'es' ? 'semana' : 'week')
                                : (currentLang === 'tr' ? 'hafta' : currentLang === 'de' ? 'Wochen' : currentLang === 'es' ? 'semanas' : 'weeks');
                            labelSuffix = ' ' + dispWeeks + ' ' + weekWord + labelSuffix + ' — ' + bookingBundlePromoLabels.b1c1;
                        } else {
                            const shortTermWeeks = hasShortTerm ? (parseInt(weeks, 10) || 0) : 0;
                            const dispWeeks = hasShortTerm ? shortTermWeeks : ((levelCourses.length * 8) + (hasTelcPrep ? 8 : 0));
                            if (dispWeeks) {
                                const weekWord = dispWeeks === 1
                                    ? (currentLang === 'tr' ? 'hafta' : currentLang === 'de' ? 'Woche' : currentLang === 'es' ? 'semana' : 'week')
                                    : (currentLang === 'tr' ? 'hafta' : currentLang === 'de' ? 'Wochen' : currentLang === 'es' ? 'semanas' : 'weeks');
                                labelSuffix = ' ' + dispWeeks + ' ' + weekWord + labelSuffix;
                            }
                        }
                    } else if (program === 'youth-camp' && weeks) {
                        const w = parseInt(weeks, 10) || 0;
                        const weekWord = w === 1 ? (currentLang === 'tr' ? 'hafta' : currentLang === 'de' ? 'Woche' : currentLang === 'es' ? 'semana' : 'week') : (currentLang === 'tr' ? 'hafta' : currentLang === 'de' ? 'Wochen' : currentLang === 'es' ? 'semanas' : 'weeks');
                        labelSuffix = ' ' + weeks + ' ' + weekWord + labelSuffix;
                    }
                    courseTypePrice.querySelector('.price-item-label').textContent = (programLabel + labelSuffix).trim();
                    courseTypePrice.querySelector('.price-item-value').textContent = coursePrice > 0 ? coursePrice + ' €' : '-';
                    courseTypePrice.style.display = 'flex';
                    if (coursePrice > 0) total += coursePrice;
                    if (durationPrice) durationPrice.style.display = 'none';
                    // Bundle indirimi devre dışı: satırı her zaman gizle
                    if (bundleDiscountRow) {
                        bundleDiscountRow.style.display = 'none';
                        if (bundleDiscountValue) bundleDiscountValue.textContent = '-';
                    }
                } else {
                    courseTypePrice.querySelector('.price-item-label').textContent = currentLang === 'tr' ? 'Kurs tipi seçiniz' : currentLang === 'de' ? 'Kurstyp wählen' : currentLang === 'es' ? 'Seleccione tipo' : 'Select course type';
                    courseTypePrice.querySelector('.price-item-value').textContent = '-';
                    if (durationPrice) durationPrice.style.display = 'none';
                if (bundleDiscountRow) {
                    bundleDiscountRow.style.display = 'none';
                    if (bundleDiscountValue) bundleDiscountValue.textContent = '-';
                }
                }

                // Toplam tutarı MUTLAKA ekrandaki kurs ücretinden türet (DOM'dan oku – böylece her zaman tutarlı)
                const courseFeeText = courseTypePrice?.querySelector('.price-item-value')?.textContent?.trim() || '';
                const courseFeeDisplayed = parseInt(courseFeeText.replace(/[^0-9]/g, ''), 10) || 0;
                let bundleDiscountDisplayed = 0;
                if (bundleDiscountRow && bundleDiscountRow.style.display !== 'none' && bundleDiscountValue) {
                    const bundleText = bundleDiscountValue.textContent?.trim() || '';
                    bundleDiscountDisplayed = parseInt(bundleText.replace(/[^0-9]/g, ''), 10) || 0;
                }
                const effectiveCourseFromDOM = Math.max(0, courseFeeDisplayed - bundleDiscountDisplayed);

                const visaNeeded = document.querySelector('[name="visa-needed"]:checked')?.value === 'yes';
                if (visaPriceRow) {
                    visaPriceRow.style.display = visaNeeded ? 'flex' : 'none';
                    if (visaNeeded) total += VISA_GUARANTEE;
                }

                // Konaklama fiyat yansıtılmaz (fiyatı olmasın)
                if (accommodationPriceRow) accommodationPriceRow.style.display = 'none';

                const airportPickup = document.querySelector('[name="airport-pickup"]:checked')?.value === 'yes';
                if (airportPriceRow) {
                    airportPriceRow.style.display = airportPickup ? 'flex' : 'none';
                    if (airportPickup) total += AIRPORT_PICKUP;
                }

                // Kupon indirimi: ekrandaki efektif kurs tutarına (bundle sonrası) uygulanır
                let couponDiscountAmount = 0;
                if (appliedCoupon && appliedCoupon.discountPercent && effectiveCourseFromDOM > 0) {
                    couponDiscountAmount = Math.round(effectiveCourseFromDOM * appliedCoupon.discountPercent / 100);
                    if (couponDiscountRow) { couponDiscountRow.style.display = 'flex'; }
                    if (couponDiscountValue) couponDiscountValue.textContent = '-' + couponDiscountAmount + ' €';
                } else {
                    if (couponDiscountRow) couponDiscountRow.style.display = 'none';
                }

                // Toplam = ekrandaki kurs (bundle sonrası) + vize + havaalanı - kupon
                const visaAmount = visaNeeded ? VISA_GUARANTEE : 0;
                const airportAmount = airportPickup ? AIRPORT_PICKUP : 0;
                const finalTotal = Math.max(0, effectiveCourseFromDOM + visaAmount + airportAmount - couponDiscountAmount);
                if (totalPriceElement) totalPriceElement.textContent = finalTotal + ' €';
                const amountCentsEl = document.getElementById('amount-in-cents');
                if (amountCentsEl) amountCentsEl.value = String(Math.round(finalTotal * 100));

                syncPromoBundleHidden();
            }

            // ===== FORM SUBMISSION =====
            const bookingForm = document.getElementById('booking-form');
            const CHECKOUT_API = bookingForm?.getAttribute('data-checkout-api') || '/api/create-checkout';
            function getSubmitButtons() { return bookingForm ? Array.from(bookingForm.querySelectorAll('button[type="submit"]')) : []; }
            function setSubmitButtonsDisabled(disabled) {
                getSubmitButtons().forEach(function(btn) { btn.disabled = disabled; });
            }
            function setSubmitButtonsText(html) {
                getSubmitButtons().forEach(function(btn) { btn.innerHTML = html; });
            }
            function getCompleteButtonsHtml() {
                const freeText = lang === 'tr' ? 'Ücretsiz rezervasyon' : lang === 'de' ? 'Kostenlose Reservierung' : lang === 'es' ? 'Reserva gratuita' : 'Free reservation';
                const payText = lang === 'tr' ? 'Ödemeye geç' : lang === 'de' ? 'Zur Kasse' : lang === 'es' ? 'Pagar ahora' : 'Proceed to payment';
                return [
                    '<i class="fas fa-calendar-check" aria-hidden="true"></i> ' + freeText,
                    '<i class="fas fa-credit-card" aria-hidden="true"></i> ' + payText
                ];
            }
            function restoreSubmitButtons() {
                const htmls = getCompleteButtonsHtml();
                const buttons = getSubmitButtons();
                if (buttons[0]) buttons[0].innerHTML = htmls[0];
                if (buttons[1]) buttons[1].innerHTML = htmls[1];
            }

            if (bookingForm) {
                bookingForm.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    const formData = new FormData(bookingForm);
                    // Tıklanan butona göre bookingAction'ı belirle
                    let bookingAction = formData.get('bookingAction') || 'free';
                    const submitter = e.submitter;
                    if (submitter && submitter.name === 'bookingAction') {
                        bookingAction = submitter.value || bookingAction;
                    }

                    setSubmitButtonsDisabled(true);
                    const submittingText = lang === 'tr' ? 'Gönderiliyor...' : lang === 'de' ? 'Wird gesendet...' : lang === 'es' ? 'Enviando...' : 'Submitting...';
                    setSubmitButtonsText(submittingText);

                    // 1. Check rate limiting
                    if (!checkRateLimit('booking', 5, 1)) {
                        if (window.showSuccessModal) {
                            window.showSuccessModal('error', window.successModalTranslations?.rateLimitError || 'Çok fazla istek gönderdiniz. Lütfen bir dakika bekleyin.');
                        } else {
                            const rateLimitMsg = lang === 'tr' ? 'Çok fazla istek gönderdiniz. Lütfen bir dakika bekleyin.' : lang === 'de' ? 'Zu viele Anfragen. Bitte warten Sie eine Minute.' : lang === 'es' ? 'Demasiadas solicitudes. Espere un minuto.' : 'Too many requests. Please wait a minute.';
                            alert(rateLimitMsg);
                        }
                        setSubmitButtonsDisabled(false);
                        restoreSubmitButtons();
                        return;
                    }
                    if (!checkHoneypot(bookingForm, 'website')) {
                        console.warn('Bot detected via honeypot');
                        setSubmitButtonsDisabled(false);
                        restoreSubmitButtons();
                        return;
                    }
                    const email = bookingForm.querySelector('[name="email"]')?.value || '';
                    const phone = bookingForm.querySelector('[name="phone"]')?.value || '';
                    if (!validateEmail(email)) {
                        if (window.showSuccessModal) {
                            window.showSuccessModal('error', window.successModalTranslations?.emailError || 'Lütfen geçerli bir e-posta adresi girin.');
                        } else {
                            const emailErrorMsg = lang === 'tr' ? 'Lütfen geçerli bir e-posta adresi girin.' : lang === 'de' ? 'Bitte geben Sie eine gültige E-Mail-Adresse ein.' : lang === 'es' ? 'Introduzca un email válido.' : 'Please enter a valid email address.';
                            alert(emailErrorMsg);
                        }
                        setSubmitButtonsDisabled(false);
                        restoreSubmitButtons();
                        return;
                    }
                    if (!validatePhone(phone)) {
                        if (window.showSuccessModal) {
                            window.showSuccessModal('error', window.successModalTranslations?.phoneError || 'Lütfen geçerli bir telefon numarası girin.');
                        } else {
                            const phoneErrorMsg = lang === 'tr' ? 'Lütfen geçerli bir telefon numarası girin.' : lang === 'de' ? 'Bitte geben Sie eine gültige Telefonnummer ein.' : lang === 'es' ? 'Introduzca un número de teléfono válido.' : 'Please enter a valid phone number.';
                            alert(phoneErrorMsg);
                        }
                        setSubmitButtonsDisabled(false);
                        restoreSubmitButtons();
                        return;
                    }
                    const data = {};
                    
                    // Collect all form data
                    for (let [key, value] of formData.entries()) {
                        if (data[key]) {
                            // Handle multiple values (checkboxes, etc.)
                            if (Array.isArray(data[key])) {
                                data[key].push(value);
                            } else {
                                data[key] = [data[key], value];
                            }
                        } else {
                            data[key] = value;
                        }
                    }
                    
                    const courseSelectionArr = Array.isArray(data['course-selection']) ? data['course-selection'] : (data['course-selection'] ? [data['course-selection']] : []);
                    const timezoneArr = Array.isArray(data.timezone) ? data.timezone : (data.timezone ? [data.timezone] : []);
                    const program = data.program || '';
                    const levelCount = courseSelectionArr.filter(c => ['a1','a2','b1','b2','c1'].includes(c)).length;
                    const hasTelcPrep = courseSelectionArr.includes('telc-prep');
                    const hasShortTerm = courseSelectionArr.includes('short-term');
                    const submittedWeeks = data.weeks ? String(data.weeks) : '';
                    const effectiveWeeks = (program === 'intensive' || program === 'online')
                        ? (levelCount * 8) + (hasTelcPrep ? 8 : 0) + (hasShortTerm ? (parseInt(submittedWeeks, 10) || 0) : 0)
                        : submittedWeeks;
                    const examCoursesForType = courseSelectionArr.filter(c => ['telc-prep','short-term'].includes(c) ? false : c).filter(Boolean);
                    let standardizedData = {
                        formType: 'booking',
                        sourcePage: data.sourcePage || window.location.pathname,
                        lang: typeof lang !== 'undefined' ? lang : 'tr',
                        promoBundle: (document.getElementById('promo-bundle-input')?.value || '').trim(),
                        firstName: data.first_name || '',
                        lastName: data.last_name || '',
                        name: `${String(data.first_name || '').trim()} ${String(data.last_name || '').trim()}`.trim(),
                        birthDate: data.birth_date || '',
                        birthPlace: data.birth_place || '',
                        nationality: data.nationality || '',
                        passportNo: data.passport_no || '',
                        addressLine: data.address_line || '',
                        postalCode: data.postal_code || '',
                        city: data.city || '',
                        country: data.country || '',
                        tel: data.phone || '',
                        email: data.email || '',
                        program: program,
                        intensiveType: data['intensive-type'] || '',
                        level: courseSelectionArr[0] || data.level || '',
                        courseSelection: courseSelectionArr,
                        startDate: data['start-date'] || '',
                        timezone: timezoneArr,
                        weeks: effectiveWeeks || data.weeks || '',
                        examType: (hasTelcPrep ? 'Telc-Prep' : '') + (hasShortTerm ? (hasTelcPrep ? ', Short Term' : 'Short Term') : '') || (data['exam-type'] || ''),
                        visaNeeded: data['visa-needed'] || 'no',
                        accommodationType: data['accommodation-type'] || 'no',
                        airportPickup: data['airport-pickup'] || 'no',
                        coupon: (document.getElementById('coupon-input')?.value || '').trim(),
                        couponDiscountPercent: document.getElementById('coupon-discount-percent')?.value || '',
                        message: (data.message || '').trim(),
                        termsAccepted: data['terms-accepted'] || false,
                        privacyAccepted: data['privacy-accepted'] || false,
                        totalPrice: document.getElementById('total-price')?.textContent || '0 €',
                        timestamp: new Date().toISOString()
                    };
                    
                    // Sanitize all inputs
                    standardizedData = sanitizeObject(standardizedData);

                    if (bookingAction === 'payment') {
                        // Ödemeye geç: Stripe Checkout için backend'e istek
                        const amountInCents = parseInt(document.getElementById('amount-in-cents')?.value || '0', 10);
                        if (amountInCents <= 0) {
                            const zeroMsg = lang === 'tr' ? 'Ödeme için önce program ve seçenekleri belirleyin; toplam 0 € olamaz.' : lang === 'de' ? 'Bitte wählen Sie Programm und Optionen – der Gesamtbetrag darf nicht 0 € sein.' : lang === 'es' ? 'Seleccione programa y opciones; el total no puede ser 0 €.' : 'Please select program and options; total cannot be 0 €.';
                            if (window.showSuccessModal) window.showSuccessModal('error', zeroMsg);
                            else alert(zeroMsg);
                            setSubmitButtonsDisabled(false);
                            restoreSubmitButtons();
                            return;
                        }
                        try {
                            const payload = {
                                amountInCents: amountInCents,
                                currency: 'eur',
                                successUrl: window.location.origin + window.location.pathname + '?payment=success',
                                cancelUrl: window.location.origin + window.location.pathname + '?payment=cancelled',
                                booking: standardizedData
                            };
                            const response = await fetch(CHECKOUT_API, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify(payload)
                            });
                            const json = await response.json().catch(function() { return {}; });
                            if (response.ok && json.url) {
                                window.location.href = json.url;
                                return;
                            }
                            const payErrorMsg = lang === 'tr' ? 'Ödeme sayfası şu an kullanılamıyor. Lütfen ücretsiz rezervasyonu deneyin veya bizimle iletişime geçin.' : lang === 'de' ? 'Zahlungsseite derzeit nicht verfügbar. Bitte wählen Sie die kostenlose Reservierung oder kontaktieren Sie uns.' : lang === 'es' ? 'Pago no disponible. Use la reserva gratuita o contáctenos.' : 'Payment page is not available. Please try free reservation or contact us.';
                            if (window.showSuccessModal) window.showSuccessModal('error', payErrorMsg);
                            else alert(payErrorMsg);
                        } catch (err) {
                            console.error('Checkout request failed:', err);
                            const payErrorMsg = lang === 'tr' ? 'Ödeme bağlantısı kurulamadı. Ücretsiz rezervasyonu deneyebilir veya bizimle iletişime geçebilirsiniz.' : lang === 'de' ? 'Zahlungsverbindung fehlgeschlagen. Nutzen Sie die kostenlose Reservierung oder kontaktieren Sie uns.' : lang === 'es' ? 'No se pudo conectar con el pago. Pruebe la reserva gratuita o contáctenos.' : 'Could not connect to payment. Try free reservation or contact us.';
                            if (window.showSuccessModal) window.showSuccessModal('error', payErrorMsg);
                            else alert(payErrorMsg);
                        }
                        setSubmitButtonsDisabled(false);
                        restoreSubmitButtons();
                        return;
                    }

                    // Ücretsiz rezervasyon: mevcut webhook
                    try {
                        const response = await fetch('https://hook.eu2.make.com/40s1h4a3wra21aszpa9y9erfsfooso47', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(standardizedData)
                        });
                        if (response.ok) {
                            if (window.showSuccessModal) {
                                window.showSuccessModal('success', window.successModalTranslations?.bookingSuccess || 'Rezervasyonunuz başarıyla gönderildi! En kısa sürede size dönüş yapacağız.');
                            } else {
                                const successMsg = lang === 'tr' ? 'Rezervasyonunuz başarıyla gönderildi! En kısa sürede size dönüş yapacağız.' : lang === 'de' ? 'Ihre Reservierung wurde erfolgreich gesendet! Wir werden uns so schnell wie möglich bei Ihnen melden.' : lang === 'es' ? '¡Reserva enviada! Nos pondremos en contacto lo antes posible.' : 'Your booking has been successfully submitted! We will get back to you as soon as possible.';
                                alert(successMsg);
                            }
                            bookingForm.reset();
                            promoBundleId = null;
                            syncPromoBundleHidden();
                            showStep(1);
                            if (typeof toggleProgramExtras === 'function') toggleProgramExtras();
                            if (typeof toggleAccommodationMonths === 'function') toggleAccommodationMonths();
                            updatePrice();
                        } else {
                            throw new Error('Webhook request failed');
                        }
                    } catch (error) {
                        console.error('Error submitting form:', error);
                        if (window.showSuccessModal) {
                            window.showSuccessModal('error', window.successModalTranslations?.errorMessage || 'Bir hata oluştu. Lütfen tekrar deneyin veya bizimle iletişime geçin.');
                        } else {
                            const errorMsg = lang === 'tr' ? 'Bir hata oluştu. Lütfen tekrar deneyin veya bizimle iletişime geçin.' : lang === 'de' ? 'Ein Fehler ist aufgetreten. Bitte versuchen Sie es erneut oder kontaktieren Sie uns.' : lang === 'es' ? 'Ha ocurrido un error. Inténtelo de nuevo o contáctenos.' : 'An error occurred. Please try again or contact us.';
                            alert(errorMsg);
                        }
                    } finally {
                        setSubmitButtonsDisabled(false);
                        restoreSubmitButtons();
                    }
                });
            }

            function applyBundleFromQuery(bundleKey) {
                if (!['a2c1', 'b1c1', 'pathway'].includes(bundleKey)) return;
                promoBundleId = bundleKey;
                bundlePresetPending = true;
                document.querySelectorAll('[name="course-selection"]').forEach(cb => { cb.checked = false; });
                const intensiveRadio = document.querySelector('[name="program"][value="intensive"]');
                if (intensiveRadio) intensiveRadio.checked = true;
                const intensive20h = document.querySelector('[name="intensive-type"][value="intensive"]');
                if (intensive20h) intensive20h.checked = true;
                if (bundleKey === 'a2c1') {
                    ['a2', 'b1', 'b2', 'c1'].forEach(function (v) {
                        const cb = document.querySelector('[name="course-selection"][value="' + v + '"]');
                        if (cb) cb.checked = true;
                    });
                } else if (bundleKey === 'b1c1') {
                    ['b1', 'b2', 'c1'].forEach(function (v) {
                        const cb = document.querySelector('[name="course-selection"][value="' + v + '"]');
                        if (cb) cb.checked = true;
                    });
                }
                toggleProgramExtras();
                bundlePresetPending = false;
                if (bundleKey === 'pathway') {
                    const msgEl = document.getElementById('message');
                    if (msgEl && typeof pathwayBundlePrefill !== 'undefined') msgEl.value = pathwayBundlePrefill;
                }
                const pathwayToggle = document.getElementById('pathway-bundle-quick-toggle');
                if (pathwayToggle) pathwayToggle.checked = bundleKey === 'pathway';
                enforceShortTermExclusion();
                reorderCourseSelectionChain();
                toggleWeeksBlockForShortTerm();
                toggleBundleInfobox();
                updatePrice();
            }
            const pathwayQuickToggle = document.getElementById('pathway-bundle-quick-toggle');
            pathwayQuickToggle?.addEventListener('change', function () {
                if (this.checked) {
                    applyBundleFromQuery('pathway');
                } else if (promoBundleId === 'pathway') {
                    promoBundleId = null;
                    syncPromoBundleHidden();
                    toggleBundleInfobox();
                    updatePrice();
                }
            });

            // Initialize
            const bundleParam = new URLSearchParams(window.location.search).get('bundle');
            if (bundleParam) {
                applyBundleFromQuery(bundleParam);
                const u = new URL(window.location.href);
                u.searchParams.delete('bundle');
                const next = u.searchParams.toString() ? u.pathname + '?' + u.searchParams.toString() : u.pathname;
                history.replaceState(null, '', next);
                const bookingFormEl = document.getElementById('booking-form');
                if (bookingFormEl) bookingFormEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
            updateProgress();
            updatePrice();
        });
    </script>
</MainLayout>

