            function syncWeeksFromControl() {
                if (weeksShortTermWrap && weeksShortTermWrap.style.display !== 'none') {
                    const v = weeksShortTermInput ? parseInt(weeksShortTermInput.value, 10) : 0;
                    setWeeksValue((v >= 1 && v <= 24) ? v : '');
