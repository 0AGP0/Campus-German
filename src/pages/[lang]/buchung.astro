                                                        <input type="radio" name="in-germany" value="no" />
                                                        <span class="bk-pay__radio" aria-hidden="true"></span>
                                                        <span class="bk-pay__opt-body">
                                                            <span class="bk-pay__opt-title">{translations.germanyLocationNo}</span>
                                                        </span>
                                                    </label>
