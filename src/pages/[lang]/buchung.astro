                }
            });

            // Short term seçiliyken diğer kurslar (A1-C1, Telc-Prep) seçilemesin; diğerleri seçilince short term kaldırılsın
            function enforceShortTermExclusion() {}

            function syncUnsureCourseSelection() {
                const unsure = document.getElementById('course-unsure-cb');
                const pricedCbs = document.querySelectorAll('.course-priced-cb');
                if (!unsure) return;
                if (unsure.checked) {
                    pricedCbs.forEach(function (cb) { cb.checked = false; cb.disabled = true; });
