    function buildPayPayload() {
        const course = state.pack ? Number(state.pack.price) || 0 : 0;
        const disc = couponDiscountFor(course);
        const courseNet = Math.max(0, course - disc);
        const accOn = svcOn('svc-acc');
        const visaOn = svcOn('svc-visa');
        const onboardOn = svcOn('svc-onboard');
        const cafeOn = svcOn('svc-cafe');
        const extra = (accOn ? 100 : 0) + (visaOn ? 80 : 0);
        const totalCents = Math.round((courseNet + extra) * 100);
        const program = programs.find((p) => p.id === state.program) || {};
        const packName = state.pack ? ((state.pack.name || state.pack.title) + (state.pack.meta ? ' · ' + state.pack.meta : '')) : '';
        const pace = state.program === 'online' ? t.paceOnline : (state.program === 'exam' ? t.paceExam : (state.program === 'special' ? t.paceSpecial : t.paceIntensive));
        const startDate = document.getElementById('start-date') ? document.getElementById('start-date').value : '';
        const items = [];
        if (courseNet > 0) {
            items.push({
                productKey: ADJUST_KEY,
                name: packName || 'Campus German paket',
                amountCents: Math.round(courseNet * 100),
                quantity: 1,
                weeks: state.pack.weeks || 0,
                useCustomAmount: true,
            });
        }
        if (accOn) items.push({ productKey: ADJUST_KEY, name: 'Accommodation Placement Service', amountCents: 10000, quantity: 1, useCustomAmount: true });
        if (visaOn) items.push({ productKey: ADJUST_KEY, name: 'Visa guaranteed enrolment', amountCents: 8000, quantity: 1, useCustomAmount: true });
        const sum = items.reduce((s, it) => s + it.amountCents * (it.quantity || 1), 0);
        if (sum !== totalCents) throw new Error(t.mismatch);
        const form = document.getElementById('booking-form');
        const money = moneyOf(totalCents);
        return {
            formType: 'booking',
            formVersion: 'package-v1',
            lang: form?.dataset.lang || 'tr',
            sourcePage: window.location.pathname,
            submittedAt: new Date().toISOString(),
            paymentChoice: 'pay_now',
            paymentKind: 'full',
            paymentPlan: 'full',
            paymentDoc: 'registration',
            paymentMethod: 'online',
            payChannel: 'card',
            checkoutUiMode: 'embedded',
            returnUrl: window.location.origin + window.location.pathname + '?payment=success&session_id={CHECKOUT_SESSION_ID}',
            amountInCents: totalCents,
            priceTotal: money,
            customer: { firstName: '', lastName: '', email: '', phone: '', address: '', postalCode: '', city: '', country: '' },
            course: {
                program: program.title || state.program,
                packageId: state.pack ? state.pack.id : '',
