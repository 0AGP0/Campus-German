                level: state.level || state.exam || '',
                weeks: state.pack ? state.pack.weeks : null,
                startDate,
                pace,
                languageCertificate: certPick() || 'no',
            },
            extras: {
                accommodation: accOn ? 'yes' : 'no',
                airportPickup: 'no',
                visaRegistration: visaOn ? 'yes' : 'no',
                onboarding: onboardOn ? 'yes' : 'no',
                speakcafeMembership: cafeOn ? 'yes' : 'no',
            },
            coupon: disc > 0 ? { code: state.couponCode, discountEur: disc } : null,
            location: { bremenResident: 'no', bremenChangesTotal: false },
            price: {
                total: money,
                totalCents,
                chargeCents: totalCents,
                netChargeCents: totalCents,
                stripeFeeCents: 0,
                remainingCents: 0,
                depositEur: 0,
                registrationFeeEur: 0,
                couponDiscountEur: disc,
            },
            stripeLineItems: items,
            stripePricing: {
                mode: 'custom_amount_cents',
                mapCatalogPrices: false,
                skipWeeksPackage: true,
                useLineItemAmounts: true,
                chargeCents: totalCents,
                netChargeCents: totalCents,
                stripeFeeCents: 0,
                totalCents,
            },
        };
    }
