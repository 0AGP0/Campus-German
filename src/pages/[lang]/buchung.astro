        privacyLabel: 'Datenschutz',
        privacyAfter: ' habe ich zur Kenntnis genommen. *',
    },
    en: {
        termsBefore: '(*) I have read and accept the ',
        agbLabel: 'General Terms and Conditions',
        widerrufMid: ' (and the ',
        widerrufLabel: 'Withdrawal Notice',
