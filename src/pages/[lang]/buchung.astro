                }
            }
            const BUNDLE_LEVEL_ORDER_A2C1 = ['a2', 'b1', 'b2', 'c1'];
            const BUNDLE_LEVEL_ORDER_B1C1 = ['b1', 'b2', 'c1'];
            function formatBundleHintLevels(ids, andW) {
                const labels = ids.map(id => String(id).toUpperCase());
                if (labels.length === 1) return labels[0];
                if (labels.length === 2) return `${labels[0]} ${andW} ${labels[1]}`;
                return `${labels.slice(0, -1).join(', ')} ${andW} ${labels[labels.length - 1]}`;
            }
            /** En az ek seviye ile tamamlanabilen kampanya paketini seçer; yoksa null. */
            function getNearestPromoBundleHint(levelValues) {
                const set = new Set(levelValues);
                const cands = [];
                const a2c1 = new Set(BUNDLE_LEVEL_ORDER_A2C1);
                const b1c1 = new Set(BUNDLE_LEVEL_ORDER_B1C1);
                const okA2 = [...set].every(l => a2c1.has(l));
                const okB1 = [...set].every(l => b1c1.has(l));
                if (okA2 && set.size > 0) {
                    const missing = BUNDLE_LEVEL_ORDER_A2C1.filter(l => !set.has(l));
                    if (missing.length > 0 && missing.length < 4)
                        cands.push({ id: 'a2c1', missing, n: missing.length });
                }
                if (okB1 && set.size > 0) {
                    const missing = BUNDLE_LEVEL_ORDER_B1C1.filter(l => !set.has(l));
                    if (missing.length > 0 && missing.length < 3)
                        cands.push({ id: 'b1c1', missing, n: missing.length });
                }
                if (!cands.length) return null;
                cands.sort((a, b) => a.n - b.n || (a.id === 'a2c1' ? -1 : 1));
                return cands[0];
            }
            function toggleBundleInfobox() {
                const program = document.querySelector('[name="program"]:checked')?.value;
                const checked = Array.from(document.querySelectorAll('[name="course-selection"]:checked'));
                const levelCourses = checked.filter(c => ['a1','a2','b1','b2','c1'].includes(c.value));
                const levelCount = levelCourses.length;
                const hasTelcPrep = checked.some(c => c.value === 'telc-prep');
                const hasShortTerm = checked.some(c => c.value === 'short-term');
                const weeksVal = getWeeksValue();
                const shortTermWeeks = hasShortTerm ? (parseInt(weeksVal, 10) || 0) : 0;
                const totalWeeks = (program === 'intensive' || program === 'online') ? (levelCount * 8) + (hasTelcPrep ? 8 : 0) + shortTermWeeks : parseInt(weeksVal, 10) || 0;
                const box = courseBundleInfobox;
                const textEl = document.getElementById('course-bundle-infobox-text');
                if (!box || !textEl) return;
                const pathwayToggleEl = document.getElementById('pathway-bundle-quick-toggle');
                const rp = resolvePromoBundlePrice();
                const bundleSlug = currentPromoBundleSlug();
                const show =
                    (program === 'intensive' || program === 'online') &&
                    (checked.length > 0 || pathwayToggleEl?.checked);
                box.style.display = show ? 'flex' : 'none';
                if (!show) {
                    box.classList.remove('form-infobox--bundle');
                    return;
                }
                const msgInvite = box.dataset.msgInvite || '';
                const displayWeeks = hasShortTerm ? shortTermWeeks : totalWeeks;
                const msgTotalWeeks = displayWeeks === 1 ? (box.dataset.msgTotalWeekOne || 'Total 1 week') : (box.dataset.msgTotalWeeks || 'Total {n} weeks').replace('{n}', String(displayWeeks));
                let baseMsg = msgInvite;
                let useBundleStyle = false;
                if (rp === 5990) {
                    baseMsg = bundlePromoInfoboxTexts.pathway || '';
                    useBundleStyle = true;
                } else if (bundleSlug === 'a2c1') {
                    baseMsg = bundlePromoInfoboxTexts.a2c1 || '';
                    useBundleStyle = true;
                } else if (bundleSlug === 'b1c1') {
                    baseMsg = bundlePromoInfoboxTexts.b1c1 || '';
                    useBundleStyle = true;
                } else if (levelCount >= 2) {
                    useBundleStyle = true;
                    const andW = bundleNearHintCopy?.andWord || 'and';
                    let hint = null;
                    if (!hasTelcPrep && !hasShortTerm)
                        hint = getNearestPromoBundleHint(levelCourses.map(c => c.value));
                    if (hint) {
                        const levelsStr = formatBundleHintLevels(hint.missing, andW);
                        const tpl = hint.id === 'a2c1' ? bundleNearHintCopy?.a2c1 : bundleNearHintCopy?.b1c1;
                        baseMsg = (tpl || '').replace(/\{levels\}/g, levelsStr);
                    } else {
                        baseMsg = bundleNearHintCopy?.multiFallback || msgInvite;
                    }
                }
                box.classList.toggle('form-infobox--bundle', useBundleStyle);
                textEl.textContent = displayWeeks > 0 ? baseMsg + ' — ' + msgTotalWeeks : baseMsg;
            }
            // Seçilen seviye kursu sayısına göre hafta seçeneklerini filtrele (sadece youth-camp)
            function filterWeeksByLevelCourses() {
                const program = document.querySelector('[name="program"]:checked')?.value;
                if (program === 'intensive' || program === 'online') return;
                if (program !== 'youth-camp') return;
                const levelCourses = Array.from(document.querySelectorAll('[name="course-selection"]:checked')).filter(c => ['a1','a2','b1','b2','c1'].includes(c.value));
                const levelCount = levelCourses.length;
                const minWeeks = levelCount >= 2 ? levelCount * 8 : 1;
                const sel = document.getElementById('weeks');
                if (!sel) return;
                const currentVal = sel.value;
                Array.from(sel.options).forEach(opt => {
                    if (opt.value === '') { opt.disabled = false; return; }
                    const w = parseInt(opt.value, 10);
                    opt.disabled = w < minWeeks;
                });
                if (currentVal && parseInt(currentVal, 10) < minWeeks) {
                    sel.value = '';
                    setWeeksValue('');
                    updatePrice();
                } else {
                    syncWeeksFromControl();
                }
            }
