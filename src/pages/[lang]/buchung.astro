            function syncQuoteCtaVisibility() {
                const cta = document.getElementById('price-quote-cta');
                if (!(cta instanceof HTMLElement)) return;
                const paymentStage = document.getElementById('booking-payment-stage');
                const paying = document.body.classList.contains('booking-content--paying')
