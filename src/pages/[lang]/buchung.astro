    { iso: 'at', dial: '+43', name: 'Österreich' },
    { iso: 'ch', dial: '+41', name: 'Schweiz' },
];
const defaultPhoneIso = lang === 'tr' ? 'tr' : lang === 'de' ? 'de' : lang === 'es' ? 'es' : 'gb';
const defaultPhoneCountry = phoneCountries.find((c) => c.iso === defaultPhoneIso) ?? phoneCountries[0];

