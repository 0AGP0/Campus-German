    couponCode: 'HBCampusGerman',
    intensive: 'Cursos Intensivos de Alemán (Presencial)',
    online: 'Cursos de Alemán Online',
    weekly: 'Tarifas Semanales',
    weeklyNote: 'Precio semanal según número de semanas. A1-A2 y B1-C1 con precios distintos.',
    examPrep: 'Cursos de Preparación de Exámenes',
    goetheTelc: 'Cursos Goethe / TELC por Nivel',
    testdafDsh: 'Preparación TestDaF / DSH',
    schedule: 'Horarios de Cursos',
    scheduleNote: 'Lunes–Viernes. Grupos de mañana, tarde y noche.',
    morning: 'Mañana',
    afternoon: 'Tarde',
    evening: 'Noche',
    startDates: 'Fechas de Inicio 2026',
    startDatesSubtitle: 'La inscripción a los cursos se abre en las siguientes fechas.',
    holidays: 'Días Festivos 2026',
    visaInfo: 'Información de visado',
    lessonInfo: 'Información de lección',
    bookCta: 'Reservar Curso',
    level: 'Nivel',
    price: 'Precio',
    lessons: 'Lecciones',
    duration: 'Duración',
    weekly: 'Semanal',
    weeks: 'Semanas',
    startNote: '(Todos los niveles A1–C1 comienzan en los mismos bloques de fechas.)',
    startingDatesBoxTitle: 'Fechas de inicio',
    startingDatesBoxIntro: 'Cada lunes (excepto para principiantes absolutos). Fechas de inicio para principiantes absolutos:',
  },
}[lang];

const levels = ['a1', 'a2', 'b1', 'b2', 'c1'] as const;
const levelLabels = { a1: 'A1', a2: 'A2', b1: 'B1', b2: 'B2', c1: 'C1' };
const bookingSlug =
  lang === 'tr' || lang === 'de' ? 'buchung' : lang === 'en' ? 'booking' : 'reservar';

const year = 2026;
// Ham tarihleri al, kronolojik sırala, her birini o ay içindeki en yakın Pazartesiye çevir
const rawA1 = data.startDates.a1;
const allDdMm = [...(rawA1.a1_1 || []), ...(rawA1.a1_2 || [])];
const uniqueDdMm = [...new Set(allDdMm)].sort((a, b) => {
  const [da, ma] = a.split('.').map(Number);
  const [db, mb] = b.split('.').map(Number);
  return (ma * 100 + da) - (mb * 100 + db);
});
const uniqueDdMmMonday = uniqueDdMm.map((ddmm) => getNearestMondayDdmm(ddmm, year));

// Rozetler ve kutu için formatlanmış tarih listesi (Pazartesi tarihleri)
const simpleStartDates = uniqueDdMmMonday.map((ddmm) =>
  formatCourseDate(ddmm, lang as 'tr' | 'de' | 'en' | 'es')
);
const formattedAbsBeginnerDates =
  uniqueDdMmMonday
    .map((ddmm) => formatCourseDate(ddmm, lang as 'tr' | 'de' | 'en' | 'es'))
    .join(' / ') + ' ' + year;
---

<MainLayout title={`${t.title} - CampusGerman`} lang={lang}>
  <section class="fiyatlar-hero">
    <div class="container">
      <h1 class="page-title">{t.title}</h1>
      <p class="fiyatlar-hero-intro">{t.heroIntro}</p>
      <div class="fiyatlar-coupon-block">
        <h2 class="fiyatlar-coupon-title">{t.couponTitle}</h2>
        <p class="fiyatlar-coupon-code">
          <code>{t.couponCode}</code>
        </p>
      </div>
    </div>
  </section>

  <!-- Yeni fiyat yapısı: Intensive 20h / Intensive+ 25h -->
  <IntensivePricingSection lang={lang} showSectionTitle={true} />

  <!-- Kurs Saatleri -->
  <section class="fiyatlar-section">
    <div class="container">
      <h2 class="fiyatlar-section-title">{t.schedule}</h2>
      <p class="fiyatlar-note">
        {t.scheduleNote} {data.schedule.days}
      </p>
      <div class="fiyatlar-schedule-grid">
        <div class="fiyatlar-schedule-card">
          <h4>{t.morning}</h4>
          <p>
            <strong>{data.schedule.morning.all.time}</strong>
          </p>
          <p>{data.schedule.morning.all.lessons}</p>
          <p>{data.schedule.morning.all.break}</p>
        </div>
        <div class="fiyatlar-schedule-card">
          <h4>{t.afternoon}</h4>
          <p>
            <strong>{data.schedule.afternoon.all.time}</strong>
          </p>
          <p>{data.schedule.afternoon.all.lessons}</p>
          <p>{data.schedule.afternoon.all.break}</p>
        </div>
        <div class="fiyatlar-schedule-card">
          <h4>{t.evening}</h4>
          <p>
            <strong>{data.schedule.evening.all.time}</strong>
          </p>
          <p>{data.schedule.evening.all.lessons}</p>
          <p>{data.schedule.evening.all.break}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Başlangıç Tarihleri -->
  <section class="fiyatlar-section">
    <div class="container">
      <h2 class="fiyatlar-section-title">{t.startDates}</h2>
      <p class="fiyatlar-dates-subtitle">{t.startDatesSubtitle}</p>
      <div class="fiyatlar-dates-badges">
        {simpleStartDates.map((dateStr) => (
          <span class="fiyatlar-date-badge">{dateStr} 2026</span>
        ))}
      </div>
      <p class="fiyatlar-lessons-note">
        <strong>{LESSONS_UP_TO_200[lang as keyof typeof LESSONS_UP_TO_200]}</strong>{' '}
        {lang === 'tr'
          ? '(kurs başına)'
          : lang === 'de'
          ? '(pro Kurs)'
          : lang === 'es'
          ? '(por curso)'
          : '(per course)'}
      </p>
      <div class="fiyatlar-starting-dates-box">
        <h3 class="fiyatlar-starting-dates-box-title">{t.startingDatesBoxTitle}</h3>
        <p class="fiyatlar-starting-dates-box-intro">{t.startingDatesBoxIntro}</p>
        <p class="fiyatlar-starting-dates-box-dates">{formattedAbsBeginnerDates}</p>
      </div>
    </div>
  </section>

  <!-- Tatiller -->
  <section class="fiyatlar-section">
    <div class="container">
      <h2 class="fiyatlar-section-title">{t.holidays}</h2>
      <ul class="fiyatlar-holidays-list">
        {data.holidays.map((h: { name: string; date: string }) => (
          <li>
            <span>{h.name}</span>
            <span>{h.date}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Vize Bilgisi -->
  <section class="fiyatlar-section">
    <div class="container">
      <h2 class="fiyatlar-section-title">{t.visaInfo}</h2>
      <div class="fiyatlar-info-box">{data.visaInfo}</div>
    </div>
  </section>

  <!-- CTA -->
  <section class="fiyatlar-cta">
    <div class="container">
      <a href={`/${lang}/${bookingSlug}`} class="btn-buchung">
        <i class="fas fa-calendar-check"></i>
        {t.bookCta}
      </a>
    </div>
  </section>
</MainLayout>

