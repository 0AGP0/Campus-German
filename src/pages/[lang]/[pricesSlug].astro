const monthNamesCoupon: Record<string, string[]> = {
  tr: ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'],
  de: ['Januar', 'Februar', 'März', 'April', 'Mai', 'Juni', 'Juli', 'August', 'September', 'Oktober', 'November', 'Dezember'],
  en: ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'],
  es: ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'],
};
const couponMonth = (monthNamesCoupon[lang] || monthNamesCoupon.en)[new Date().getMonth()];
const couponMonthHint = String(t.couponMonthHint || '').replace('{month}', couponMonth);
const couponWaText =
  lang === 'tr'
    ? `Merhaba, ${couponMonth} kupon kodumu almak istiyorum.`
    : lang === 'de'
      ? `Hallo, ich möchte den Gutscheincode für ${couponMonth} erhalten.`
      : lang === 'es'
        ? `Hola, quiero recibir el código de cupón de ${couponMonth}.`
        : `Hi, I’d like to get the ${couponMonth} coupon code.`;
const couponWaHref = `https://wa.me/4915203823792?text=${encodeURIComponent(couponWaText)}`;

const levels = ['a1', 'a2', 'b1', 'b2', 'c1'] as const;
const levelLabels = { a1: 'A1', a2: 'A2', b1: 'B1', b2: 'B2', c1: 'C1' };
const bookingSlug = getBookingPath(lang as 'tr' | 'de' | 'en' | 'es');

const year = 2026;
// Ham tarihleri al, kronolojik sırala, her birini o ay içindeki en yakın Pazartesiye çevir
const rawA1 = data.startDates.a1;
const allDdMm = [...(rawA1.a1_1 || []), ...(rawA1.a1_2 || [])];
const uniqueDdMm = [...new Set(allDdMm)].sort((a, b) => {
  const [da, ma] = a.split('.').map(Number);
  const [db, mb] = b.split('.').map(Number);
  return (ma * 100 + da) - (mb * 100 + db);
});
const uniqueDdMmMonday = uniqueDdMm.map((ddmm) => getNearestMondayDdmm(ddmm, year));

// Rozetler ve kutu için formatlanmış tarih listesi (Pazartesi tarihleri)
const simpleStartDates = uniqueDdMmMonday.map((ddmm) =>
  formatCourseDate(ddmm, lang as 'tr' | 'de' | 'en' | 'es')
);
---

<MainLayout title={`${t.title} - CampusGerman`} lang={lang}>
  <section class="fiyatlar-intro">
    <div class="container">
      <div class="fiyatlar-intro-headline">
        <h1>{t.heroTitle}</h1>
        <p>{t.heroText}</p>
      </div>

      <div class="fiyatlar-promo-grid">
        <article class="fiyatlar-promo-card fiyatlar-promo-card--hero">
          <h3>{t.officeCardTitle}</h3>
          <p>{couponMonthHint}</p>
          <p>{t.officeCardText}</p>
          <a href={couponWaHref} target="_blank" rel="noopener noreferrer" class="fiyatlar-wa-btn">
            <i class="fab fa-whatsapp"></i>
            {t.officeCardCta}
          </a>
        </article>
        <article class="fiyatlar-promo-card fiyatlar-promo-card--hero fiyatlar-promo-card--highlight">
          <h3>{t.bremenCardTitle}</h3>
          <p>{t.bremenCardText}</p>
          <div class="fiyatlar-promo-tags">
            <span>{t.heroPoint3}</span>
          </div>
          <a href="https://wa.me/4915203823792" target="_blank" rel="noopener noreferrer" class="fiyatlar-wa-btn">
            <i class="fab fa-whatsapp"></i>
            {t.bremenCardCta}
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- Yeni fiyat yapısı: Intensive 20h / Intensive 25h -->
  <IntensivePricingSection lang={lang} showSectionTitle={true} />

  <!-- Kurs Saatleri -->
  <section class="fiyatlar-section">
    <div class="container">
      <h2 class="fiyatlar-section-title">{t.schedule}</h2>
      <p class="fiyatlar-note">
        {t.scheduleNote} {data.schedule.days}
      </p>
      <div class="fiyatlar-schedule-grid">
        <div class="fiyatlar-schedule-card">
          <h4>{t.morning}</h4>
          <p>
            <strong>{data.schedule.morning.all.time}</strong>
          </p>
          <p>{data.schedule.morning.all.lessons}</p>
          <p>{data.schedule.morning.all.break}</p>
        </div>
        <div class="fiyatlar-schedule-card">
          <h4>{t.afternoon}</h4>
          <p>
            <strong>{data.schedule.afternoon.all.time}</strong>
          </p>
          <p>{data.schedule.afternoon.all.lessons}</p>
          <p>{data.schedule.afternoon.all.break}</p>
        </div>
        <div class="fiyatlar-schedule-card">
          <h4>{t.evening}</h4>
          <p>
            <strong>{data.schedule.evening.all.time}</strong>
          </p>
          <p>{data.schedule.evening.all.lessons}</p>
          <p>{data.schedule.evening.all.break}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Başlangıç Tarihleri -->
  <section class="fiyatlar-section">
    <div class="container">
      <h2 class="fiyatlar-section-title">{t.startDates}</h2>
      <p class="fiyatlar-dates-subtitle">{t.startDatesSubtitle}</p>
      <div class="fiyatlar-dates-badges">
        {simpleStartDates.map((dateStr) => (
          <span class="fiyatlar-date-badge">{dateStr} 2026</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Tatiller -->
  <section class="fiyatlar-section">
    <div class="container">
      <h2 class="fiyatlar-section-title">{t.holidays}</h2>
      <ul class="fiyatlar-holidays-list">
        {data.holidays.map((h: { name: string; date: string }) => (
          <li>
            <span>{h.name}</span>
            <span>{h.date}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Vize Bilgisi -->
  <section class="fiyatlar-section">
    <div class="container">
      <h2 class="fiyatlar-section-title">{t.visaInfo}</h2>
      <div class="fiyatlar-info-box">{data.visaInfo}</div>
    </div>
  </section>

  <!-- CTA -->
  <section class="fiyatlar-cta">
    <div class="container">
      <a href={`/${lang}/${bookingSlug}`} class="btn-buchung">
        <i class="fas fa-calendar-check"></i>
        {t.bookCta}
      </a>
    </div>
  </section>
</MainLayout>

