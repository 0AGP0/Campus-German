---
import MainLayout from '../../layouts/MainLayout.astro';
import IntensivePricingSection from '../../components/IntensivePricingSection.astro';
import '../../styles/pages/fiyatlar-tarihler.css';
import { coursePricing } from '../../data/coursePricing';
import { VALID_COUPONS } from '../../data/coupons';
import { isValidLang, getPricesDatesPath } from '../../utils/pathHelpers';
import { LESSONS_UP_TO_200, formatCourseDate, getNearestMondayDdmm } from '../../utils/coursePricingHelper';

export async function getStaticPaths() {
  const priceSlugs = [
    { lang: 'tr', slug: getPricesDatesPath('tr') },
    { lang: 'de', slug: getPricesDatesPath('de') },
    { lang: 'en', slug: getPricesDatesPath('en') },
    { lang: 'es', slug: getPricesDatesPath('es') },
  ] as const;

  return priceSlugs.map(({ lang, slug }) => ({
    params: { lang, pricesSlug: slug },
  }));
}

const { lang, pricesSlug } = Astro.params;

if (!isValidLang(lang)) {
  throw new Error(`Invalid language: ${lang}`);
}

// Eğer slug dil ile uyumlu değilse ana sayfaya yönlendir
const expectedSlug = getPricesDatesPath(lang);
if (pricesSlug !== expectedSlug) {
  return Astro.redirect(302, `/${lang}/`);
}

const pricingLang = lang === 'es' ? 'de' : lang;
const data = coursePricing[pricingLang as keyof typeof coursePricing];

const t = {
