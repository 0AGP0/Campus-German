---
import { getCollection } from 'astro:content';
import MainLayout from '../../../layouts/MainLayout.astro';
import GlobalCourseWidget from '../../../components/GlobalCourseWidget.astro';
import { cleanSlug, getAdvantagesPath, getContactPath, isValidLang } from '../../../utils/pathHelpers';

export async function getStaticPaths() {
  const allAvantajlarimiz = await getCollection('unsere-vorteile');
  
  const paths = [];
  
  // Sadece Türkçe sayfalar için
  const turkceAvantajlar = allAvantajlarimiz.filter(avantaj => avantaj.data.lang === 'tr');
  
  const EXCLUDED_SLUGS = new Set(['para-iade-garantisi']);
  
  for (const avantaj of turkceAvantajlar) {
    const langCode = 'tr';
    
    // Use customSlug if available, otherwise use default slug cleaning
    let finalSlug;
    if (avantaj.data.customSlug) {
      finalSlug = avantaj.data.customSlug;
    } else {
      finalSlug = cleanSlug(avantaj.slug);
    }
    
    if (EXCLUDED_SLUGS.has(finalSlug)) continue;
    
    paths.push({
      params: { 
        lang: langCode,
        slug: finalSlug
      },
      props: { avantaj },
    });
  }
  
  return paths;
}

const { avantaj } = Astro.props;
const { lang } = Astro.params;
const { Content } = await avantaj.render();

// Lang tip kontrolü
if (!isValidLang(lang)) {
    throw new Error(`Invalid language: ${lang}`);
}

// Path helper'ları
const advantagesPath = getAdvantagesPath(lang);
const contactPath = getContactPath(lang);
---

<MainLayout title={`${avantaj.data.title} - CampusGerman`} lang={lang} includeHizmetCSS={true}>
    <!-- Main Content -->
    <main>
        <!-- Article Section -->
        <section class="article-section">
            <div class="container">
                <div class="article-layout">
                    <!-- Article Content -->
                    <article class="article-content">
                        <div class="article-header">
                            <h1 class="article-title">{avantaj.data.title}</h1>
                            <div class="article-meta">
                                <span class="article-date">
                                    <i class="fas fa-calendar"></i>
                                    {avantaj.data.date}
                                </span>
                                <span class="article-author">
                                    <i class="fas fa-user"></i>
                                    {avantaj.data.author}
                                </span>
                                <span class="article-category">
                                    <i class="fas fa-tag"></i>
                                    {avantaj.data.category}
                                </span>
                            </div>
                        </div>

                        <div class="article-image">
                            <img src={avantaj.data.image} alt={avantaj.data.title}>
                        </div>

                        <div class="article-body">
                            <Content />
                        </div>

                        <div class="article-footer">
                            <div class="article-tags">
                                <span class="tag-label">{lang === 'tr' ? 'Etiketler:' : 'Tags:'}</span>
                                <a href="#" class="tag">{lang === 'tr' ? 'Almanca' : 'Deutsch'}</a>
                                <a href="#" class="tag">{lang === 'tr' ? 'Avantajlar' : 'Vorteile'}</a>
                                <a href="#" class="tag">{lang === 'tr' ? 'CampusGerman' : 'CampusGerman'}</a>
                            </div>
                            <div class="article-share">
                                <span class="share-label">{lang === 'tr' ? 'Paylaş:' : 'Teilen:'}</span>
                                <a href="#" class="share-link" aria-label="Facebook">
                                    <i class="fab fa-facebook-f"></i>
                                </a>
                                <a href="#" class="share-link" aria-label="Twitter">
                                    <i class="fab fa-twitter"></i>
                                </a>
                                <a href="#" class="share-link" aria-label="LinkedIn">
                                    <i class="fab fa-linkedin-in"></i>
                                </a>
                                <a href="#" class="share-link" aria-label="WhatsApp">
                                    <i class="fab fa-whatsapp"></i>
                                </a>
                            </div>
                        </div>
                    </article>

                    <!-- Sidebar -->
                    <aside class="article-sidebar">
                        <!-- Quick Contact Widget -->
                        <div class="sidebar-widget">
                            <h3 class="widget-title">
                                <i class="fas fa-phone-alt"></i>
                                {lang === 'tr' ? 'Hızlı İletişim' : lang === 'de' ? 'Schneller Kontakt' : 'Quick Contact'}
                            </h3>
                            <div class="widget-content">
                                <p>{lang === 'tr' ? 'Avantajlarımız hakkında daha fazla bilgi almak için bizimle iletişime geçin.' : 'Kontaktieren Sie uns für weitere Informationen zu unseren Vorteilen.'}</p>
                                <a href={`/${lang}/${contactPath}`} class="widget-button">
                                    <i class="fas fa-envelope"></i>
                                    {lang === 'tr' ? 'İletişime Geç' : lang === 'de' ? 'Kontakt aufnehmen' : 'Contact Us'}
                                </a>
                            </div>
                        </div>

                        <!-- Related Advantages Widget -->
                        <div class="sidebar-widget">
                            <h3 class="widget-title">
                                <i class="fas fa-list"></i>
                                {lang === 'tr' ? 'Diğer Avantajlarımız' : lang === 'de' ? 'Weitere Vorteile' : 'Other Advantages'}
                            </h3>
                            <div class="widget-content">
                                <ul class="related-list">
                                    <li>
                                        <a href={`/${lang}/${advantagesPath}/hibrit-egitim`}>
                                            <i class="fas fa-laptop-house"></i>
                                            {lang === 'tr' ? 'Hibrit Eğitim' : 'Hybrides Lernen'}
                                        </a>
                                    </li>
                                    <li>
                                        <a href={`/${lang}/${advantagesPath}/sehir-gezileri`}>
                                            <i class="fas fa-map-marked-alt"></i>
                                            {lang === 'tr' ? 'Şehir ve Üniversite Gezileri' : 'Stadt- und Universitätstouren'}
                                        </a>
                                    </li>
                                    <li>
                                        <a href={`/${lang}/${advantagesPath}/konusma-kulubu`}>
                                            <i class="fas fa-comments"></i>
                                            {lang === 'tr' ? 'Konuşma Kulübü' : 'Sprachclub'}
                                        </a>
                                    </li>
                                    <li>
                                        <a href={`/${lang}/${advantagesPath}/egitim-koclugu`}>
                                            <i class="fas fa-user-graduate"></i>
                                            {lang === 'tr' ? 'Eğitim Koçluğu' : 'Lerncoaching'}
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <!-- CTA Widget -->
                        <div class="sidebar-widget cta-widget">
                            <h3 class="widget-title">
                                <i class="fas fa-rocket"></i>
                                {lang === 'tr' ? 'Hemen Başla' : lang === 'de' ? 'Jetzt starten' : 'Get Started'}
                            </h3>
                            <div class="widget-content">
                                <p>{lang === 'tr' ? 'Almanca öğrenme yolculuğunuza bugün başlayın!' : 'Starten Sie heute Ihre Deutschlernreise!'}</p>
                                <a href={`/${lang}/buchung`} class="widget-cta-button">
                                    <i class="fas fa-arrow-right"></i>
                                    {lang === 'tr' ? 'Hemen Başvur Yap' : 'Jetzt bewerben'}
                                </a>
                            </div>
                        </div>
                    </aside>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="cta-section">
            <div class="container">
                <div class="cta-content">
                    <div class="cta-text">
                        <h2 class="cta-title">{lang === 'tr' ? 'Avantajlarımızdan Yararlanmaya Hazır mısınız?' : 'Bereit, unsere Vorteile zu nutzen?'}</h2>
                        <p class="cta-description">
                            {lang === 'tr' 
                                ? 'CampusGerman ile Almanca öğrenme yolculuğunuza başlayın. Uzman eğitmenlerimiz ve modern eğitim metodlarımızla hedeflerinize ulaşın.'
                                : 'Starten Sie Ihre Deutschlernreise mit CampusGerman. Erreichen Sie Ihre Ziele mit unseren Expertenlehrern und modernen Unterrichtsmethoden.'}
                        </p>
                        <div class="cta-buttons">
                            <a href={`/${lang}/buchung`} class="cta-primary">
                                <i class="fas fa-arrow-right"></i>
                                {lang === 'tr' ? 'Hemen Başvur Yap' : 'Jetzt bewerben'}
                            </a>
                            <a href={`/${lang}/${contactPath}`} class="cta-secondary">
                                <i class="fas fa-envelope"></i>
                                {lang === 'tr' ? 'İletişime Geç' : 'Kontakt aufnehmen'}
                            </a>
                        </div>
                    </div>
                    <div class="cta-form">
                        <GlobalCourseWidget lang={lang} />
                    </div>
                </div>
            </div>
        </section>
    </main>
</MainLayout>

<style is:global>
  .cta-section .cta-content {
    display: flex !important;
    gap: 1.5rem !important;
    align-items: start;
  }

  .cta-section .cta-text {
    min-width: 0;
    flex: 0 0 38% !important;
    max-width: 38% !important;
  }

  .cta-section .cta-form {
    min-width: 0;
    flex: 1 1 62% !important;
    max-width: 62% !important;
    overflow: visible !important;
  }

  @media (max-width: 980px) {
    .cta-section .cta-content {
      display: flex !important;
      flex-direction: column !important;
    }
    .cta-section .cta-text,
    .cta-section .cta-form {
      flex: 1 1 100% !important;
      max-width: 100% !important;
      width: 100% !important;
    }
    .cta-section .cta-form { order: 2; }
  }
</style>
