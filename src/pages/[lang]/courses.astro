---
import MainLayout from '../../layouts/MainLayout.astro';
import IntensivePricingSection from '../../components/IntensivePricingSection.astro';
import '../../styles/pages/kurslar.css';
import { getCollection } from 'astro:content';
import { coursePricing } from '../../data/coursePricing';
import { cleanSlug, isOverviewPage, getSectionPath, getContactPath, isValidLang } from '../../utils/pathHelpers';
import { getSimpleCourseStartDates, LESSONS_UP_TO_200 } from '../../utils/coursePricingHelper';

export async function getStaticPaths() {
    return [
        { params: { lang: 'en' } },
    ];
}

const { lang } = Astro.params;

// Lang tip kontrolü
if (!isValidLang(lang)) {
    throw new Error(`Invalid language: ${lang}`);
}

// Path helper'ları
const sectionPath = getSectionPath(lang);
const contactPath = getContactPath(lang);
const simpleStartDates = getSimpleCourseStartDates(lang as 'tr' | 'de' | 'en' | 'es');

// Tüm kursları al ve kategorilere ayır
const allKurslar = await getCollection('kurslar');
const kurslarByLang = allKurslar.filter(kurs => kurs.data.lang === lang);

// Ana kurslar (genel bakış sayfaları hariç)
const anaKurslar = kurslarByLang.filter(kurs => {
    return !isOverviewPage(kurs.slug);
});

// Kategorilere göre ayır
const yogunKurslar = anaKurslar.filter(kurs => 
    (kurs.slug.startsWith('intensiv-') || kurs.slug.startsWith('yogun-')) && 
    !kurs.slug.includes('studentenvisum') && !kurs.slug.includes('ogrenci-vizesi')
);
const onlineKurslar = anaKurslar.filter(kurs => 
    kurs.slug.startsWith('online-')
);
const donemselKurslar = anaKurslar.filter(kurs => 
    kurs.slug.includes('woechentlich-') || 
    kurs.slug.includes('haftalik-') || 
    kurs.slug.includes('sommerschule') || 
    kurs.slug.includes('yaz-okulu') || 
    kurs.slug.includes('abend-') ||
    kurs.slug.includes('aksam-') ||
    kurs.slug.includes('saisonal-') ||
    kurs.slug.includes('donemsel-')
);
const sinavKurslar = anaKurslar.filter(kurs => 
    kurs.slug.includes('goethe-') || 
    kurs.slug.includes('telc-') || 
    kurs.slug.includes('testdaf-') || 
    kurs.slug.includes('dsh-') ||
    kurs.slug.includes('pruefungsvorbereitung-')
);
const kurumsalKurslar = anaKurslar.filter(kurs => 
    kurs.slug.includes('firmenkurs') ||
    kurs.slug.includes('firma-') || 
    kurs.slug.includes('bildungszeit') || 
    kurs.slug.includes('daad-') || 
    kurs.slug.includes('erasmus-') || 
    kurs.slug.includes('beruf-') ||
    kurs.slug.includes('meslek-') || 
    kurs.slug.includes('career-') || 
    kurs.slug.includes('medizin-') ||
    kurs.slug.includes('tip-') || 
    kurs.slug.includes('fsp-') || 
    kurs.slug.includes('ingenieurwesen-') ||
    kurs.slug.includes('muhendislik-') || 
    kurs.slug.includes('wirtschaft-') ||
    kurs.slug.includes('ekonomi-')
);
---

<MainLayout title={lang === 'tr' 
                                ? "Kurslar - CampusGerman"
                                : lang === 'de' ? "Kurse - CampusGerman" : "Courses - CampusGerman"} lang={lang}>
    <!-- Hero Section -->
    <section class="courses-hero-section">
        <div class="container">
            <!-- Main Hero Content -->
            <div class="courses-hero-content">
                <div class="hero-left">
                    <h1 class="hero-title">
                        {lang === 'tr' 
                                ? "CampusGerman'da Almanca Dil Kursları!"
                                : lang === 'de' ? "Deutschkurse bei CampusGerman!" : "German Language Courses at CampusGerman!"}
                    </h1>
                    
                    <div class="hero-content">
                        <p class="hero-description">
                            {lang === 'tr' 
                                ? "Almanya'da üniversite okumak, Almanya'da çalışmak, meslek eğitimi başlatmak veya sadece Almanca bilginizi geliştirmek için Almanca öğrenmek ister misiniz? Motivasyonunuz ne olursa olsun, Almanya'nın canlı üniversite şehirlerindeki CampusGerman Dil Okulu'nda sizin için uygun olan Almanca kursu bulunmaktadır!"
                                : lang === 'de' ? "Möchten Sie Deutsch lernen, um in Deutschland zu studieren, zu arbeiten, eine Berufsausbildung zu beginnen oder einfach Ihre Deutschkenntnisse zu verbessern? Was auch immer Ihre Motivation ist, bei CampusGerman Sprachschule in den lebendigen Universitätsstädten Deutschlands finden Sie den passenden Deutschkurs für Sie!" : "Do you want to learn German to study in Germany, work in Germany, start vocational training, or simply improve your German knowledge? Whatever your motivation, you will find the right German course for you at CampusGerman Language School in the vibrant university cities of Germany!"}
                        </p>
                        
                        <p class="hero-description">
                            {lang === 'tr' 
                                ? "CampusGerman'daki Almanca dil kurslarımızı seçmek, hedefinize rahat ve samimi bir öğrenme ortamında verimli ve keyifli bir şekilde ulaşmanızı sağlayacaktır."
                                : lang === 'de' ? "Die Wahl unserer Deutschkurse bei CampusGerman ermöglicht es Ihnen, Ihr Ziel in einer entspannten und freundlichen Lernumgebung effizient und mit Freude zu erreichen." : "Choosing our German courses at CampusGerman will enable you to reach your goal efficiently and enjoyably in a relaxed and friendly learning environment."}
                        </p>
                    </div>
                    
                    <div class="hero-actions">
                        <a href="#kurs-kartlari" class="btn-primary">
                            <i class="fas fa-arrow-down"></i>
                            {lang === 'tr' ? 'Kursları İncele' : lang === 'de' ? 'Kurse entdecken' : 'Explore Courses'}
                        </a>
                        <button class="btn-secondary" id="contactBtn">
                            <i class="fas fa-envelope"></i>
                            {lang === 'tr' ? 'İletişime Geç' : lang === 'de' ? 'Kontakt aufnehmen' : 'Get in Touch'}
                        </button>
                    </div>
                </div>
                
                <div class="hero-right">
                    <div class="hero-cta-card">
                        <div class="cta-icon">
                            <i class="fas fa-graduation-cap"></i>
                        </div>
                        <h3 class="cta-title">{lang === 'tr' ? 'Kurslarımızı Keşfedin' : lang === 'de' ? 'Entdecken Sie unsere Kurse' : 'Discover Our Courses'}</h3>
                        <p class="cta-description">
                            {lang === 'tr' 
                                ? "Her seviyeye uygun özel hazırlanmış kurslar, deneyimli eğitmenler ve esnek program seçenekleri."
                                : lang === 'de' ? "Speziell entwickelte Kurse für jedes Niveau, erfahrene Lehrkräfte und flexible Programmoptionen." : "Specially designed courses for every level, experienced instructors and flexible program options."}
                        </p>
                        <div class="cta-stats">
                            <div class="cta-stat">
                                <div class="stat-number">6</div>
                                <div class="stat-label">{lang === 'tr' ? 'Seviye' : lang === 'de' ? 'Niveau' : 'Level'}</div>
                            </div>
                            <div class="cta-stat">
                                <div class="stat-number">50+</div>
                                <div class="stat-label">{lang === 'tr' ? 'Kurs' : lang === 'de' ? 'Kurs' : 'Courses'}</div>
                            </div>
                            <div class="cta-stat">
                                <div class="stat-number">98%</div>
                                <div class="stat-label">{lang === 'tr' ? 'Başarı' : lang === 'de' ? 'Erfolg' : 'Success'}</div>
                            </div>
                        </div>
                        <a href="#kurs-kartlari" class="cta-button">
                            <i class="fas fa-arrow-down"></i>
                            {lang === 'tr' ? 'Tüm Kursları Görüntüle' : lang === 'de' ? 'Alle Kurse anzeigen' : 'View All Courses'}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Kurs Kartları Section -->
    <section class="courses-section" id="kurs-kartlari">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">{lang === 'tr' ? 'Almanca Kurslarımız' : lang === 'de' ? 'Unsere Deutschkurse' : 'Our German Courses'}</h2>
                <p class="section-subtitle">{lang === 'tr' ? 'Her seviyeye ve ihtiyaca uygun özel hazırlanmış kurslar' : lang === 'de' ? 'Speziell entwickelte Kurse für jedes Niveau und jeden Bedarf' : 'Specially designed courses for every level and need'}</p>
            </div>
            
            <!-- Filtreleme ve Arama -->
            <div class="courses-filter-section">
                <div class="filter-search-box">
                    <div class="search-wrapper">
                        <i class="fas fa-search"></i>
                        <input 
                            type="text" 
                            id="courseSearchInput" 
                            placeholder={lang === 'tr' ? 'Kurs ara...' : lang === 'de' ? 'Kurs suchen...' : 'Search course...'}
                        />
                        <button class="search-clear" id="searchClearBtn" style="display: none;">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
                
                <div class="filter-buttons-row">
                    <div class="filter-btn-wrapper">
                        <button class="filter-btn" id="levelFilterBtn">
                            <span>{lang === 'tr' ? 'Dil Seviyesi' : lang === 'de' ? 'Sprachniveau' : 'Language Level'}</span>
                            <i class="fas fa-chevron-down"></i>
                        </button>
                        <div class="filter-menu" id="levelFilterDropdown">
                            <a href="#" class="filter-item" data-value="all">{lang === 'tr' ? 'Tüm Seviyeler' : lang === 'de' ? 'Alle Niveaus' : 'All Levels'}</a>
                            <a href="#" class="filter-item" data-value="a1">A1</a>
                            <a href="#" class="filter-item" data-value="a2">A2</a>
                            <a href="#" class="filter-item" data-value="b1">B1</a>
                            <a href="#" class="filter-item" data-value="b2">B2</a>
                            <a href="#" class="filter-item" data-value="c1">C1</a>
                            <a href="#" class="filter-item" data-value="c2">C2</a>
                        </div>
                    </div>
                    
                    <div class="filter-btn-wrapper">
                        <button class="filter-btn" id="typeFilterBtn">
                            <span>{lang === 'tr' ? 'Kurs Türü' : lang === 'de' ? 'Kurstyp' : 'Course Type'}</span>
                            <i class="fas fa-chevron-down"></i>
                        </button>
                        <div class="filter-menu" id="typeFilterDropdown">
                            <a href="#" class="filter-item" data-value="all">{lang === 'tr' ? 'Tüm Kurslar' : lang === 'de' ? 'Alle Kurse' : 'All Courses'}</a>
                            <a href="#" class="filter-item" data-value="yuz-yuze">{lang === 'tr' ? 'Yüz Yüze' : lang === 'de' ? 'Präsenz' : 'Face-to-face'}</a>
                            <a href="#" class="filter-item" data-value="online">Online</a>
                        </div>
                    </div>
                    
                    <div class="filter-btn-wrapper">
                        <button class="filter-btn" id="periodFilterBtn">
                            <span>{lang === 'tr' ? 'Dönem' : lang === 'de' ? 'Zeitraum' : 'Period'}</span>
                            <i class="fas fa-chevron-down"></i>
                        </button>
                        <div class="filter-menu" id="periodFilterDropdown">
                            <a href="#" class="filter-item" data-value="all">{lang === 'tr' ? 'Tüm Dönemler' : lang === 'de' ? 'Alle Zeiträume' : 'All Periods'}</a>
                            <a href="#" class="filter-item" data-value="yaz-donemi">{lang === 'tr' ? 'Yaz Dönemi' : lang === 'de' ? 'Sommersemester' : 'Summer Semester'}</a>
                            <a href="#" class="filter-item" data-value="yil-boyu">{lang === 'tr' ? 'Yıl Boyu' : lang === 'de' ? 'Ganzjährig' : 'Year-round'}</a>
                        </div>
                    </div>
                    
                    <button class="clear-btn" id="clearFiltersBtn" style="display: none;">
                        <i class="fas fa-times"></i>
                        {lang === 'tr' ? 'Temizle' : lang === 'de' ? 'Zurücksetzen' : 'Reset'}
                    </button>
                </div>
                
                <div class="results-count" id="resultsInfo">
                    <span id="resultsCount">{anaKurslar.length}</span> {lang === 'tr' ? 'kurs bulundu' : lang === 'de' ? 'Kurse gefunden' : 'courses found'}
                </div>
            </div>
            
            <div class="courses-grid" id="coursesGrid">
                {anaKurslar.map(kurs => {
                    // Kurs tipini belirle (filtreleme için)
                    let courseType = 'yuz-yuze';
                    let courseLevel = 'all';
                    let coursePeriod = 'yil-boyu';
                    
                    const cleanedSlug = cleanSlug(kurs.slug);
                    
                    if (cleanedSlug.startsWith('online-')) {
                        courseType = 'online';
                    }
                    
                    // Seviye belirleme
                    if (cleanedSlug.includes('-a1') || cleanedSlug.includes('a1-')) {
                        courseLevel = 'a1';
                    } else if (cleanedSlug.includes('-a2') || cleanedSlug.includes('a2-')) {
                        courseLevel = 'a2';
                    } else if (cleanedSlug.includes('-b1') || cleanedSlug.includes('b1-')) {
                        courseLevel = 'b1';
                    } else if (cleanedSlug.includes('-b2') || cleanedSlug.includes('b2-')) {
                        courseLevel = 'b2';
                    } else if (cleanedSlug.includes('-c1') || cleanedSlug.includes('c1-')) {
                        courseLevel = 'c1';
                    }
                    
                    // Dönem belirleme
                    if (cleanedSlug.includes('yaz-okulu')) {
                        coursePeriod = 'yaz-donemi';
                    }
                    
                    return (
                        <div class="course-card" data-level={`all ${courseLevel}`} data-type={courseType} data-period={coursePeriod}>
                            <div class="course-image">
                                <img src={kurs.data.image} alt={kurs.data.title}>
                            </div>
                            <div class="course-content">
                                <h3 class="course-title">{kurs.data.title}</h3>
                                <div class="course-details">
                                    <div class="course-detail">
                                        <i class="fas fa-chalkboard-teacher"></i>
                                        <span>{lang === 'tr' ? 'İnteraktif Eğitim Akıllı Tahta ile' : lang === 'de' ? 'Interaktive Ausbildung mit Smartboard' : 'Interactive Education with Smart Board'}</span>
                                    </div>
                                    <div class="course-detail">
                                        <i class="fas fa-layer-group"></i>
                                        <span>{lang === 'tr' ? 'Ek Modüler Yapı Desteği' : lang === 'de' ? 'und modulare Strukturunterstützung' : 'and Additional Modular Structure Support'}</span>
                                    </div>
                                </div>
                                <p class="course-description">
                                    {kurs.data.description}
                                </p>
                                <a href={`/${lang}/${sectionPath}/${kurs.data.customSlug || cleanSlug(kurs.slug)}`} class="course-btn">
                                    <span>{lang === 'tr' ? 'Detayları Gör' : lang === 'de' ? 'Details ansehen' : 'View Details'}</span>
                                    <i class="fas fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    );
                })}
            </div>
            
            <!-- Pagination -->
            <div class="pagination-wrapper" id="paginationContainer" style="display: none;">
                <div class="pagination">
                    <button class="page-btn prev" id="prevPageBtn" disabled>
                        <i class="fas fa-chevron-left"></i>
                    </button>
                    <div class="page-numbers" id="paginationNumbers"></div>
                    <button class="page-btn next" id="nextPageBtn">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </div>
                <div class="page-info" id="paginationInfo">
                    {lang === 'tr' ? 'Sayfa' : lang === 'de' ? 'Seite' : 'Page'} <span id="currentPageNum">1</span> / <span id="totalPagesNum">1</span>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Fiyatlar ve Tarihler Section -->
    <section class="pricing-dates-section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">{lang === 'tr' ? 'Fiyatlar ve Tarihler' : lang === 'de' ? 'Preise und Termine' : 'Prices and Dates'}</h2>
                <p class="section-subtitle">{lang === 'tr' ? 'Almanca Kursları fiyatları ve başlangıç tarihleri' : lang === 'de' ? 'Preise und Starttermine für Deutschkurse' : 'Prices and start dates for German courses'}</p>
            </div>
            
            <div class="pricing-content">
                <IntensivePricingSection lang={lang} showSectionTitle={false} />
                
                <!-- Kurs Zamanları -->
                <div class="pricing-block">
                    <h3 class="pricing-block-title">{lang === 'tr' ? 'Kurs Zamanları' : lang === 'de' ? 'Kurszeiten' : 'Course Times'}</h3>
                    <div class="schedule-grid">
                        <div class="schedule-card">
                            <h4><i class="fas fa-sun"></i> {lang === 'tr' ? 'Sabah Kursları' : lang === 'de' ? 'Vormittagskurse' : 'Morning Courses'}</h4>
                            <div class="schedule-item">
                                <p>{coursePricing[lang as 'tr' | 'de' | 'en'].schedule.morning.all.time}</p>
                                <p class="schedule-break">{coursePricing[lang as 'tr' | 'de' | 'en'].schedule.morning.all.break}</p>
                                <p class="schedule-lessons">{coursePricing[lang as 'tr' | 'de' | 'en'].schedule.morning.all.lessons}</p>
                            </div>
                        </div>
                        <div class="schedule-card">
                            <h4><i class="fas fa-moon"></i> {lang === 'tr' ? 'Öğleden Sonra Kursları' : lang === 'de' ? 'Nachmittagskurse' : 'Afternoon Courses'}</h4>
                            <div class="schedule-item">
                                <p>{coursePricing[lang as 'tr' | 'de' | 'en'].schedule.afternoon.all.time}</p>
                                <p class="schedule-break">{coursePricing[lang as 'tr' | 'de' | 'en'].schedule.afternoon.all.break}</p>
                                <p class="schedule-lessons">{coursePricing[lang as 'tr' | 'de' | 'en'].schedule.afternoon.all.lessons}</p>
                            </div>
                        </div>
                        <div class="schedule-card">
                            <h4><i class="fas fa-cloud-moon"></i> {lang === 'tr' ? 'Akşam Kursları' : lang === 'de' ? 'Abendkurse' : 'Evening Courses'}</h4>
                            <div class="schedule-item">
                                <p>{coursePricing[lang as 'tr' | 'de' | 'en'].schedule.evening.all.time}</p>
                                <p class="schedule-break">{coursePricing[lang as 'tr' | 'de' | 'en'].schedule.evening.all.break}</p>
                                <p class="schedule-lessons">{coursePricing[lang as 'tr' | 'de' | 'en'].schedule.evening.all.lessons}</p>
                            </div>
                        </div>
                    </div>
                    <p class="schedule-days"><i class="fas fa-calendar-week"></i> {coursePricing[lang as 'tr' | 'de' | 'en'].schedule.days}</p>
                </div>
                
                <!-- Kurs Başlangıç Tarihleri -->
                <div class="pricing-block">
                    <h3 class="pricing-block-title">{lang === 'tr' ? 'Kurs Tarihlerimiz' : lang === 'de' ? 'Unsere Kurstermine' : 'Our Course Dates'}</h3>
                    <p class="pricing-subtitle">{lang === 'tr' ? 'Kurslara kayıt aşağıdaki tarihlerde açılır.' : lang === 'de' ? 'Die Kursanmeldung öffnet an den folgenden Terminen.' : 'Course registration opens on the following dates.'}</p>
                    <div class="course-dates-badges">
                        {simpleStartDates.map((dateStr) => (
                            <span class="course-date-badge">{dateStr} 2026</span>
                        ))}
                    </div>
                    <div class="course-dates-info">
                        <p><strong>{lang === 'tr' ? 'A1 · 8 hafta · ' : lang === 'de' ? 'A1 · 8 Wochen · ' : 'A1 · 8 weeks · '}{LESSONS_UP_TO_200[lang as keyof typeof LESSONS_UP_TO_200]}</strong></p>
                        <p><strong>{lang === 'tr' ? 'A2 · 8 hafta · ' : lang === 'de' ? 'A2 · 8 Wochen · ' : 'A2 · 8 weeks · '}{LESSONS_UP_TO_200[lang as keyof typeof LESSONS_UP_TO_200]}</strong></p>
                        <p><strong>{lang === 'tr' ? 'B1 · 8 hafta · ' : lang === 'de' ? 'B1 · 8 Wochen · ' : 'B1 · 8 weeks · '}{LESSONS_UP_TO_200[lang as keyof typeof LESSONS_UP_TO_200]}</strong></p>
                        <p><strong>{lang === 'tr' ? 'B2 · 8 hafta · ' : lang === 'de' ? 'B2 · 8 Wochen · ' : 'B2 · 8 weeks · '}{LESSONS_UP_TO_200[lang as keyof typeof LESSONS_UP_TO_200]}</strong></p>
                        <p><strong>{lang === 'tr' ? 'C1 · 8 hafta · ' : lang === 'de' ? 'C1 · 8 Wochen · ' : 'C1 · 8 weeks · '}{LESSONS_UP_TO_200[lang as keyof typeof LESSONS_UP_TO_200]}</strong></p>
                    </div>
                </div>
                
                <!-- Tatiller -->
                <div class="pricing-block">
                    <h3 class="pricing-block-title">{lang === 'tr' ? 'Tatiller 2026' : lang === 'de' ? 'Feiertage 2026' : 'Holidays 2026'}</h3>
                    <div class="holidays-list">
                        {coursePricing[lang as 'tr' | 'de' | 'en'].holidays.map(holiday => (
                            <div class="holiday-item">
                                <span class="holiday-name">{holiday.name}</span>
                                <span class="holiday-date">{holiday.date}</span>
                            </div>
                        ))}
                    </div>
                </div>
                
                <!-- Vize Bilgisi -->
                <div class="pricing-block pricing-info-box">
                    <p><i class="fas fa-info-circle"></i> {coursePricing[lang as 'tr' | 'de' | 'en'].visaInfo}</p>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Dil Seviyeleri Section -->
    <section class="language-levels-section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">{lang === 'tr' 
                                ? "Dil Seviyeleri A1 – C1"
                                : lang === 'de' ? "Sprachniveaus A1 – C1" : "Language Levels A1 – C1"}</h2>
                <p class="section-subtitle">{lang === 'tr' 
                                ? "Almanya'da A1 Almanca Kursları ve çok daha fazlası!"
                                : lang === 'de' ? "A1 Deutschkurse in Deutschland und vieles mehr!" : "A1 German courses in Germany and much more!"}</p>
            </div>
            
            <div class="levels-content">
                <div class="levels-text">
                    <p class="levels-description">
                        {lang === 'tr' 
                                ? "İlk kurs gününüzde seviye belirleme sınavı yapacaksınız, ardından size en uygun seviyedeki sınıfa katılacaksınız. Okuma, dinleme, yazma ve konuşma olmak üzere dört dil becerisi, Avrupa Ortak Dil Referans Çerçevesi (CEFR) standartlarına göre ölçülür ve seviyeleri şu şekilde yapılandırılmıştır:"
                                : lang === 'de' ? "Am ersten Kurstag machen Sie einen Einstufungstest und nehmen dann an der Klasse teil, die Ihrem Niveau am besten entspricht. Die vier Sprachfertigkeiten Lesen, Hören, Schreiben und Sprechen werden nach den Standards des Gemeinsamen Europäischen Referenzrahmens (CEFR) gemessen und die Niveaus sind wie folgt strukturiert:" : "On your first day of the course, you will take a placement test and then join the class that best suits your level. The four language skills of reading, listening, writing and speaking are measured according to the Common European Framework of Reference (CEFR) standards and the levels are structured as follows:"}
                    </p>
                    
                    <div class="levels-info">
                        <div class="level-group">
                            <h3>A1 ve A2</h3>
                            <p>{lang === 'tr' 
                                ? "Başlangıç ve temel seviye"
                                : lang === 'de' ? "Anfänger- und Grundstufe" : "Beginner and Elementary Level"}</p>
                        </div>
                        <div class="level-group">
                            <h3>B1 ve B2</h3>
                            <p>{lang === 'tr' 
                                ? "Orta öncesi ve orta seviye"
                                : lang === 'de' ? "Mittelstufe und obere Mittelstufe" : "Intermediate and Upper Intermediate Level"}</p>
                        </div>
                        <div class="level-group">
                            <h3>C1</h3>
