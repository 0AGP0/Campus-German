---
import KonaklamaPageContent from '../../../components/KonaklamaPageContent.astro';
import { isValidLang } from '../../../utils/pathHelpers';

export async function getStaticPaths() {
  return [{ params: { lang: 'es' } }];
}

const { lang } = Astro.params;
if (!isValidLang(lang)) {
  throw new Error(`Invalid language: ${lang}`);
}
---

<KonaklamaPageContent lang={lang} />
