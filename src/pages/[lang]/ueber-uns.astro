---
import MainLayout from '../../layouts/MainLayout.astro';
import '../../styles/pages/ueber-uns.css';
import { getContactPath, getSectionPath, isValidLang } from '../../utils/pathHelpers';

export async function getStaticPaths() {
    // Sadece Almanca: /de/ueber-uns/ — Türkçe içerik /tr/hakkimizda/ altında; eski /tr/ueber-uns* URL'leri .htaccess + _redirects ile 301
    return [{ params: { lang: 'de' } }];
}

const { lang } = Astro.params;

if (!isValidLang(lang)) {
    throw new Error(`Invalid language: ${lang}`);
}

const contactPath = getContactPath(lang);

// Translations
const translations = {
    tr: {
        title: "Hakkımızda - Campus German",
        missionTitle: "Misyonumuz",
        missionP1: "Campus German olarak, Almanca öğrenme yolculuğunuzda güvenilir partneriniz olmaktan gurur duyuyoruz. 2020 yılından bu yana, binlerce öğrencinin dil hedeflerine ulaşmasına yardımcı olan deneyimli ekibimizle, sadece dil öğretmekle kalmıyor, aynı zamanda Almanya'da eğitim ve kariyer fırsatlarınızı açan kapıları aralıyoruz.",
        missionP2: "Misyonumuz, her öğrencinin benzersiz öğrenme tarzını ve hedeflerini anlayarak, kişiselleştirilmiş eğitim programları sunmaktır. Modern teknoloji ile geleneksel eğitim metodlarını harmanlayarak, etkili ve kalıcı öğrenme deneyimleri yaratıyoruz. Almanca'yı sadece bir ders olarak değil, yaşamınızın bir parçası haline getirmenizi sağlıyoruz.",
        feature1Title: "Kaliteli Eğitim",
        feature1Desc: "Ana dili Almanca olan ve Türkçe bilen uzman eğitmenlerimizle, en yüksek standartlarda eğitim sunuyoruz. Her eğitmenimiz, Almanca öğretmenliği konusunda akademik eğitim almış ve yıllarca deneyim sahibi profesyonellerdir.",
        feature2Title: "Kişiye Özel Program",
        feature2Desc: "Her öğrencinin öğrenme hızı, hedefleri ve özel ihtiyaçları farklıdır. Bu nedenle, her öğrencimiz için özel olarak tasarlanmış kurs programları hazırlıyoruz. Grup derslerinden birebir özel derslere kadar geniş yelpazede seçenekler sunuyoruz.",
        feature3Title: "Uluslararası Sertifikalar",
        feature3Desc: "TestDaF, Goethe Institut, telc gibi dünya çapında geçerli Almanca sertifikalarına hazırlık konusunda uzmanız. Öğrencilerimizin %95'i hedefledikleri seviyeye ulaşarak sertifikalarını başarıyla almaktadır.",
        teamTitle: "Ekibimiz",
        teamSubtitle: "Deneyimli ve uzman eğitmenlerimizle Almanca öğrenme yolculuğunuzda yanınızdayız. Her biri kendi alanında uzmanlaşmış, öğrenci odaklı yaklaşımlarıyla fark yaratan profesyonellerden oluşan ekibimiz, sadece dil öğretmekle kalmıyor, aynı zamanda Almanya'da eğitim ve kariyer hedeflerinize ulaşmanız için rehberlik ediyor.",
        team1Name: "Akman",
        team1Role: "Eğitim Koordinatörü",
        team1Desc: "Akman, kurs programlarımızı her seviyeye uygun net ve etkili bir öğrenme yolu sunacak şekilde tasarlar ve geliştirir. Modern yöntemleri kanıtlanmış yaklaşımlarla birleştirir; programları öğrenci geri bildirimleri doğrultusunda güncel tutar.",
        team2Name: "Elif",
        team2Role: "İngilizce, Almanca",
        team2Desc: "Elif, her seviyede net anlatım, konuşma pratiği ve sınav odaklı rehberlikle öğrencilerin yanında. Almanya’da eğitim ve günlük yaşam için güvenli Almanca becerileri kazanmalarına yardımcı olur.",
        team3Name: "Lara",
        team3Role: "İspanyolca, İngilizce",
        team3Desc: "Lara, kurs sürecinde kişisel öğrenme planları ve sürekli motivasyonla öğrencilerin yanındadır. Almanya’da eğitim ve kariyer fırsatları konusunda da rehberlik eder.",
        team4Name: "Emir",
        team4Role: "Türkçe",
        team4Desc: "Emir, online öğrenme platformumuzu geliştirir ve iyileştirerek modern, sorunsuz bir deneyim sunar. Güvenilir araçlar, teknik destek ve sürekli ürün geliştirmeye odaklanır.",
        timelineTitle: "Yolculuğumuz",
        timelineSubtitle: "Campus German'ın kuruluşundan bugüne kadar geçen süreç, sürekli gelişim ve öğrenci odaklı yaklaşımımızın hikayesidir. Her yıl, binlerce öğrencinin hayatına dokunarak, onların Almanya'da eğitim ve kariyer hedeflerine ulaşmalarına yardımcı oluyoruz.",
        timeline1Title: "2020 - Kuruluş",
        timeline1Desc: "Campus German, Almanca eğitiminde kalite ve güvenilirlik odaklı yaklaşımıyla kuruldu. İlk öğrencilerimizle birlikte başarı hikayelerimizi yazmaya başladık. Kuruluş amacımız, Türk öğrencilerin Almanya'da eğitim ve kariyer fırsatlarını değerlendirebilmesi için gerekli dil becerilerini kazandırmaktı.",
        timeline2Title: "2021 - Ekip Genişlemesi",
        timeline2Desc: "Deneyimli eğitmenlerimizi ekibimize kattık. Farklı seviyelerde uzmanlaşmış öğretmenlerimizle daha kapsamlı eğitim programları sunmaya başladık. Bu yıl, öğrenci sayımızın hızla artmasıyla birlikte, daha kişiselleştirilmiş eğitim yaklaşımları geliştirdik.",
        timeline3Title: "2022 - Online Platform",
        timeline3Desc: "Modern online eğitim platformumuzu hayata geçirdik. Artık öğrencilerimiz hem yüz yüze hem de online olarak eğitim alabiliyorlar. Pandemi sürecinde geliştirdiğimiz bu platform, öğrencilerimizin evden de etkili şekilde Almanca öğrenebilmesini sağladı. Interaktif ders materyalleri ve sanal sınıf ortamları ile eğitim kalitemizi artırdık.",
        timeline4Title: "2023 - Başarılar",
        timeline4Desc: "Öğrencilerimizin %95'i hedefledikleri seviyeye ulaştı. TestDaF, Goethe ve diğer uluslararası sınavlarda yüksek başarı oranları elde ettik. Bu yıl, Almanya'da üniversite kabulü alan öğrenci sayımızda önemli artışlar kaydettik. Başarı hikayelerimiz, yeni öğrencilerimiz için ilham kaynağı oldu.",
        timeline5Title: "2024 - Sürekli Gelişim",
        timeline5Desc: "Eğitim metodlarımızı sürekli geliştiriyoruz. Yapay zeka destekli öğrenme araçları ve kişiselleştirilmiş eğitim programları ile öncü olmaya devam ediyoruz. Bu yıl, öğrenci memnuniyet oranımızı %98'e çıkardık ve Almanya'daki partner üniversitelerimizle işbirliğimizi güçlendirdik.",
        stat1: "Mezun Öğrenci",
        stat2: "Uzman Eğitmen",
        stat3: "Başarı Oranı",
        stat4: "Yıllık Deneyim",
        ctaTitle: "Almanca Öğrenme Yolculuğunuza Başlayın",
        ctaDesc: "Uzman ekibimizle birlikte dil hedeflerinize ulaşın. Ücretsiz seviye tespit sınavımıza katılın ve size özel programımızı keşfedin. Almanya'da eğitim ve kariyer fırsatlarınızı değerlendirmek için gerekli dil becerilerini kazanın. Her seviyeden öğrenci için uygun kurs programlarımızla, başarıya giden yolda yanınızdayız.",
        ctaBtn1: "Ücretsiz Danışmanlık",
        ctaBtn2: "Kurslarımızı İncele",
        skill1: "Program Geliştirme",
        skill2: "Müfredat Tasarımı",
        skill3: "Kalite Kontrol",
        skill4: "A1–C2 Seviyeleri",
        skill5: "Konuşma Pratiği",
        skill6: "Sınav Hazırlık",
        skill7: "Öğrenci Danışmanlığı",
        skill8: "İlerleme Takibi",
        skill9: "Motivasyon",
        skill10: "Platform Geliştirme",
        skill11: "Teknik Destek",
        skill12: "İnovasyon"
    },
    de: {
        title: "Über uns - Campus German",
        missionTitle: "Unsere Mission",
        missionP1: "Als Campus German sind wir stolz darauf, Ihr zuverlässiger Partner auf Ihrer Reise zum Deutschlernen zu sein. Seit 2020 helfen wir mit unserem erfahrenen Team tausenden von Studenten, ihre Sprachziele zu erreichen. Wir unterrichten nicht nur die deutsche Sprache, sondern öffnen auch die Türen zu Bildungs- und Karrieremöglichkeiten in Deutschland.",
        missionP2: "Unsere Mission ist es, personalisierte Bildungsprogramme anzubieten, indem wir den einzigartigen Lernstil und die Ziele jedes Studenten verstehen. Durch die Kombination moderner Technologie mit traditionellen Lehrmethoden schaffen wir effektive und dauerhafte Lernerfahrungen. Wir helfen Ihnen, Deutsch nicht nur als Unterrichtsfach, sondern als Teil Ihres Lebens zu etablieren.",
        feature1Title: "Hochwertige Bildung",
        feature1Desc: "Mit unseren muttersprachlichen Deutschlehrern, die auch Türkisch sprechen, bieten wir Bildung auf höchstem Niveau. Jeder unserer Lehrer ist akademisch in Deutsch als Fremdsprache ausgebildet und verfügt über jahrelange Erfahrung.",
        feature2Title: "Individuelles Programm",
        feature2Desc: "Jeder Student hat unterschiedliche Lerngeschwindigkeiten, Ziele und besondere Bedürfnisse. Deshalb erstellen wir für jeden unserer Studenten speziell zugeschnittene Kursprogramme. Wir bieten eine breite Palette von Optionen, von Gruppenkursen bis hin zu Einzelunterricht.",
        feature3Title: "Internationale Zertifikate",
        feature3Desc: "Wir sind Experten in der Vorbereitung auf weltweit anerkannte Deutschzertifikate wie TestDaF, Goethe-Institut und telc. 95% unserer Studenten erreichen erfolgreich ihr angestrebtes Niveau und erhalten ihre Zertifikate.",
        teamTitle: "Unser Team",
        teamSubtitle: "Mit unseren erfahrenen und qualifizierten Lehrern stehen wir Ihnen auf Ihrer Deutschlernreise zur Seite. Unser Team besteht aus Fachleuten, die jeweils auf ihrem Gebiet spezialisiert sind und mit ihrem studentenorientierten Ansatz einen Unterschied machen. Sie unterrichten nicht nur die Sprache, sondern begleiten Sie auch dabei, Ihre Bildungs- und Karriereziele in Deutschland zu erreichen.",
        team1Name: "Akman",
        team1Role: "Bildungskoordinator",
        team1Desc: "Akman gestaltet und optimiert unsere Kursprogramme, damit jedes Niveau einen klaren und wirksamen Lernweg hat. Er verbindet moderne Methoden mit bewährten Ansätzen und hält die Programme anhand von Studierendenfeedback aktuell.",
        team2Name: "Elif",
        team2Role: "Englisch, Deutsch",
        team2Desc: "Elif begleitet Lernende auf allen Niveaus mit klaren Erklärungen, Konversationstraining und prüfungsorientierter Unterstützung. Sie hilft dabei, sicheres Deutsch für Studium und Alltag aufzubauen.",
        team3Name: "Lara",
        team3Role: "Spanisch, Englisch",
        team3Desc: "Lara begleitet Studierende während des Kurses mit persönlichen Lernplänen und kontinuierlicher Motivation. Sie berät auch zu Bildungs- und Karrieremöglichkeiten in Deutschland.",
        team4Name: "Emir",
        team4Role: "Türkisch",
        team4Desc: "Emir entwickelt und verbessert unsere Online-Lernplattform für ein modernes, reibungsloses Lernerlebnis. Sein Fokus liegt auf zuverlässigen Tools, technischem Support und kontinuierlicher Produktverbesserung.",
        timelineTitle: "Unsere Reise",
        timelineSubtitle: "Der Prozess von der Gründung von Campus German bis heute ist die Geschichte unseres kontinuierlichen Wachstums und unseres studentenorientierten Ansatzes. Jedes Jahr berühren wir das Leben tausender Studenten und helfen ihnen, ihre Bildungs- und Karriereziele in Deutschland zu erreichen.",
        timeline1Title: "2020 - Gründung",
        timeline1Desc: "Campus German wurde mit einem qualitäts- und zuverlässigkeitsorientierten Ansatz in der Deutschbildung gegründet. Mit unseren ersten Studenten begannen wir, unsere Erfolgsgeschichten zu schreiben. Unser Gründungszweck war es, türkischen Studenten die notwendigen Sprachkenntnisse zu vermitteln, um Bildungs- und Karrieremöglichkeiten in Deutschland nutzen zu können.",
        timeline2Title: "2021 - Teamerweiterung",
        timeline2Desc: "Wir haben erfahrene Lehrer in unser Team aufgenommen. Mit unseren auf verschiedene Niveaus spezialisierten Lehrern begannen wir, umfassendere Bildungsprogramme anzubieten. In diesem Jahr entwickelten wir mit dem schnellen Anstieg unserer Studentenzahl personalisiertere Bildungsansätze.",
        timeline3Title: "2022 - Online-Plattform",
        timeline3Desc: "Wir haben unsere moderne Online-Bildungsplattform ins Leben gerufen. Nun können unsere Studenten sowohl persönlich als auch online lernen. Diese Plattform, die wir während der Pandemie entwickelt haben, ermöglichte es unseren Studenten, auch von zu Hause aus effektiv Deutsch zu lernen. Mit interaktiven Unterrichtsmaterialien und virtuellen Klassenräumen haben wir unsere Bildungsqualität verbessert.",
        timeline4Title: "2023 - Erfolge",
        timeline4Desc: "95% unserer Studenten erreichten ihr angestrebtes Niveau. Wir erzielten hohe Erfolgsquoten bei TestDaF, Goethe und anderen internationalen Prüfungen. In diesem Jahr verzeichneten wir einen deutlichen Anstieg der Anzahl von Studenten, die an deutschen Universitäten angenommen wurden. Unsere Erfolgsgeschichten wurden zur Inspiration für neue Studenten.",
        timeline5Title: "2024 - Kontinuierliche Entwicklung",
        timeline5Desc: "Wir entwickeln unsere Lehrmethoden kontinuierlich weiter. Mit KI-gestützten Lernwerkzeugen und personalisierten Bildungsprogrammen bleiben wir Vorreiter. In diesem Jahr haben wir unsere Studentenzufriedenheitsrate auf 98% gesteigert und unsere Zusammenarbeit mit Partneruniversitäten in Deutschland verstärkt.",
        stat1: "Absolventen",
        stat2: "Experten-Lehrer",
        stat3: "Erfolgsquote",
        stat4: "Jahre Erfahrung",
        ctaTitle: "Beginnen Sie Ihre Deutschlernreise",
        ctaDesc: "Erreichen Sie Ihre Sprachziele gemeinsam mit unserem Expertenteam. Nehmen Sie an unserem kostenlosen Einstufungstest teil und entdecken Sie Ihr persönliches Programm. Erwerben Sie die notwendigen Sprachkenntnisse, um Bildungs- und Karrieremöglichkeiten in Deutschland zu nutzen. Mit unseren für alle Niveaus geeigneten Kursprogrammen sind wir an Ihrer Seite auf dem Weg zum Erfolg.",
        ctaBtn1: "Kostenlose Beratung",
        ctaBtn2: "Kurse ansehen",
        skill1: "Programmentwicklung",
        skill2: "Curriculum-Design",
        skill3: "Qualitätskontrolle",
        skill4: "A1–C2 Niveaus",
        skill5: "Konversationspraxis",
        skill6: "Prüfungsvorbereitung",
        skill7: "Studienberatung",
        skill8: "Fortschrittsverfolgung",
        skill9: "Motivation",
        skill10: "Plattformentwicklung",
        skill11: "Technischer Support",
        skill12: "Innovation"
    }
};

const t = translations[lang as 'tr' | 'de'];
---

<MainLayout title={t.title} lang={lang}>
    <!-- Mission Section -->
    <section class="mission-section">
        <div class="container">
            <div class="mission-content">
                <div class="mission-text">
                    <h2 class="section-title">{t.missionTitle}</h2>
                    <p class="mission-description">
                        {t.missionP1}
                    </p>
                    <p class="mission-description">
                        {t.missionP2}
                    </p>
                    <div class="mission-features">
                        <div class="feature-item">
                            <i class="fas fa-graduation-cap"></i>
                            <div>
                                <h4>{t.feature1Title}</h4>
                                <p>{t.feature1Desc}</p>
                            </div>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-users"></i>
                            <div>
                                <h4>{t.feature2Title}</h4>
                                <p>{t.feature2Desc}</p>
                            </div>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-certificate"></i>
                            <div>
                                <h4>{t.feature3Title}</h4>
                                <p>{t.feature3Desc}</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mission-image">
                    <img src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=1200&q=80" alt="Öğrencilerin birlikte çalıştığı sınıf ortamı" class="mission-photo">
                </div>
            </div>
        </div>
    </section>

    <!-- Team Section -->
    <section class="team-section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">{t.teamTitle}</h2>
                <p class="section-subtitle">
                    {t.teamSubtitle}
                </p>
            </div>
            <div class="team-grid">
                <div class="team-card">
                    <div class="team-avatar">
                        <img src="/images/team/akman.jpg" alt={t.team1Name} class="team-photo">
                    </div>
                    <h3 class="team-name">{t.team1Name}</h3>
                    <p class="team-role">{t.team1Role}</p>
                    <p class="team-description">
                        {t.team1Desc}
                    </p>
                    <div class="team-skills">
                        <span class="skill-tag">{t.skill1}</span>
                        <span class="skill-tag">{t.skill2}</span>
                        <span class="skill-tag">{t.skill3}</span>
                    </div>
                </div>
                <div class="team-card">
                    <div class="team-avatar">
                        <img src="/images/team/elif.jpg" alt={t.team2Name} class="team-photo">
                    </div>
                    <h3 class="team-name">{t.team2Name}</h3>
                    <p class="team-role">{t.team2Role}</p>
                    <p class="team-description">
                        {t.team2Desc}
                    </p>
                    <div class="team-skills">
                        <span class="skill-tag">{t.skill4}</span>
                        <span class="skill-tag">{t.skill5}</span>
                        <span class="skill-tag">{t.skill6}</span>
                    </div>
                </div>
                <div class="team-card">
                    <div class="team-avatar">
                        <img src="/images/team/lara.jpg" alt={t.team3Name} class="team-photo">
                    </div>
                    <h3 class="team-name">{t.team3Name}</h3>
                    <p class="team-role">{t.team3Role}</p>
                    <p class="team-description">
                        {t.team3Desc}
                    </p>
                    <div class="team-skills">
                        <span class="skill-tag">{t.skill7}</span>
                        <span class="skill-tag">{t.skill8}</span>
                        <span class="skill-tag">{t.skill9}</span>
                    </div>
                </div>
                <div class="team-card">
                    <div class="team-avatar">
                        <img src="/images/team/emir.jpg" alt={t.team4Name} class="team-photo">
                    </div>
                    <h3 class="team-name">{t.team4Name}</h3>
                    <p class="team-role">{t.team4Role}</p>
                    <p class="team-description">
                        {t.team4Desc}
                    </p>
                    <div class="team-skills">
                        <span class="skill-tag">{t.skill10}</span>
                        <span class="skill-tag">{t.skill11}</span>
                        <span class="skill-tag">{t.skill12}</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Timeline Section -->
    <section class="timeline-section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">{t.timelineTitle}</h2>
                <p class="section-subtitle">
                    {t.timelineSubtitle}
                </p>
            </div>
            <div class="timeline">
                <div class="timeline-item">
                    <div class="timeline-marker">
                        <i class="fas fa-rocket"></i>
                    </div>
                    <div class="timeline-content">
                        <h3 class="timeline-title">{t.timeline1Title}</h3>
                        <p class="timeline-description">
                            {t.timeline1Desc}
                        </p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="timeline-content">
                        <h3 class="timeline-title">{t.timeline2Title}</h3>
                        <p class="timeline-description">
                            {t.timeline2Desc}
                        </p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker">
                        <i class="fas fa-laptop"></i>
                    </div>
                    <div class="timeline-content">
                        <h3 class="timeline-title">{t.timeline3Title}</h3>
                        <p class="timeline-description">
                            {t.timeline3Desc}
                        </p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker">
                        <i class="fas fa-trophy"></i>
                    </div>
                    <div class="timeline-content">
                        <h3 class="timeline-title">{t.timeline4Title}</h3>
                        <p class="timeline-description">
                            {t.timeline4Desc}
                        </p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker">
                        <i class="fas fa-star"></i>
                    </div>
                    <div class="timeline-content">
                        <h3 class="timeline-title">{t.timeline5Title}</h3>
                        <p class="timeline-description">
                            {t.timeline5Desc}
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="stats-section">
        <div class="container">
            <div class="stats-grid">
                <div class="stat-item">
                    <div class="stat-icon">
                        <i class="fas fa-graduation-cap"></i>
                    </div>
                    <div class="stat-number">500+</div>
                    <div class="stat-label">{t.stat1}</div>
                </div>
                <div class="stat-item">
                    <div class="stat-icon">
                        <i class="fas fa-chalkboard-teacher"></i>
                    </div>
                    <div class="stat-number">15+</div>
                    <div class="stat-label">{t.stat2}</div>
                </div>
                <div class="stat-item">
                    <div class="stat-icon">
                        <i class="fas fa-certificate"></i>
                    </div>
                    <div class="stat-number">95%</div>
                    <div class="stat-label">{t.stat3}</div>
                </div>
                <div class="stat-item">
                    <div class="stat-icon">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="stat-number">4</div>
                    <div class="stat-label">{t.stat4}</div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
        <div class="container">
            <div class="cta-content">
                <h2 class="cta-title">{t.ctaTitle}</h2>
                <p class="cta-description">
                    {t.ctaDesc}
                </p>
                <div class="cta-buttons">
                    <a href={`/${lang}/${contactPath}`} class="cta-btn primary">
                        <i class="fas fa-phone"></i>
                        <span>{t.ctaBtn1}</span>
                    </a>
                    <a href={`/${lang}/${getSectionPath(lang)}`} class="cta-btn secondary">
                        <i class="fas fa-book-open"></i>
                        <span>{t.ctaBtn2}</span>
                    </a>
                </div>
            </div>
        </div>
    </section>
</MainLayout>
