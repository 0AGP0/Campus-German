import { isOverviewPage, getSectionPath, cleanSlug, getContactPath, getBookingPath } from '../../utils/pathHelpers';
import { getCoursePricingData, getWeeklyPricingCategory, extractCourseInfo, getCourseCardPerWeekPrice, LESSONS_UP_TO_200 } from '../../utils/coursePricingHelper';
import { buildBookingUrl } from '../../utils/bookingPrefillHelper';
import PromoPrice from '../../components/PromoPrice.astro';
import { getNavbarCourseSlugs, navbarCourseSlugsByLang } from '../../data/navbarCourseSlugs';

export async function getStaticPaths() {
    return [
        { params: { lang: 'tr' } },
        { params: { lang: 'de' } },
        { params: { lang: 'en' } },
        { params: { lang: 'es' } },
    ];
}

const { lang } = Astro.params;

// Kurslar sayfası path (dil bazlı)
const courseBase = getSectionPath(lang);
const courseBasePath = `/${lang}/${courseBase}`;
// Form/başvuru sayfası path (hero ve CTA butonları için)
const bookingPath = `/${lang}/${getBookingPath(lang as 'tr' | 'de' | 'en' | 'es')}`;
const contactPath = getContactPath(lang);

// Kursları çek (ana sayfa filtre bölümü) – sadece navbar'da olan kurslar, navbar sırasına göre
const allKurslar = await getCollection('kurslar');
const kurslarByLang = allKurslar.filter(kurs => kurs.data.lang === lang);
const allowedSlugs = getNavbarCourseSlugs(lang);
const orderList = navbarCourseSlugsByLang[lang] ?? navbarCourseSlugsByLang.de;
const filtered = kurslarByLang.filter(kurs => {
  if (isOverviewPage(kurs.slug)) return false;
  const urlSlug = kurs.data.customSlug || cleanSlug(kurs.slug);
  return allowedSlugs.has(urlSlug);
});
const anaKurslar = [...filtered].sort((a, b) => {
  const slugA = a.data.customSlug || cleanSlug(a.slug);
  const slugB = b.data.customSlug || cleanSlug(b.slug);
  const idxA = orderList.indexOf(slugA);
  const idxB = orderList.indexOf(slugB);
  return (idxA === -1 ? 9999 : idxA) - (idxB === -1 ? 9999 : idxB);
});

