                                <button type="button" class="filter-panel-trigger" id="indexPeriodFilterBtn">
                                    <span class="filter-panel-trigger-text">{translations.courseFilterAllPeriods}</span>
                                    <i class="fas fa-chevron-down"></i>
                                </button>
                                <div class="filter-menu" id="indexPeriodFilterDropdown">
                                    <a href="#" class="filter-item active" data-value="all">{translations.courseFilterAllPeriods}</a>
                                    <a href="#" class="filter-item" data-value="yaz-donemi">{translations.courseFilterSummer}</a>
                                    <a href="#" class="filter-item" data-value="yil-boyu">{translations.courseFilterYearRound}</a>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="filter-panel-clear-all" id="indexClearFiltersBtn" style="display: none;">
                            <i class="fas fa-times"></i>
                            {translations.courseFilterClear}
                        </button>
                        <p class="filter-panel-results" id="indexResultsInfo" data-results-label={translations.courseFilterResultsFound}>
                            <strong id="indexResultsCount">{anaKurslar.length}</strong> {translations.courseFilterResultsFound}
                        </p>
                        <a href={courseBasePath} class="index-courses-cta">{translations.courseFilterCta}</a>
                    </div>
                </aside>
                <div class="index-courses-main">
                    <div class="courses-grid" id="indexCoursesGrid">
                        {anaKurslar.map((kurs) => {
                            let courseType = 'yuz-yuze';
                            let courseLevel = 'all';
                            let coursePeriod = 'yil-boyu';
                            const cleanedSlug = cleanSlug(kurs.slug);
                            if (cleanedSlug.startsWith('online-')) courseType = 'online';
                            if (cleanedSlug.includes('-a1') || cleanedSlug.includes('a1-')) courseLevel = 'a1';
                            else if (cleanedSlug.includes('-a2') || cleanedSlug.includes('a2-')) courseLevel = 'a2';
                            else if (cleanedSlug.includes('-b1') || cleanedSlug.includes('b1-')) courseLevel = 'b1';
                            else if (cleanedSlug.includes('-b2') || cleanedSlug.includes('b2-')) courseLevel = 'b2';
                            else if (cleanedSlug.includes('-c1') || cleanedSlug.includes('c1-')) courseLevel = 'c1';
                            if (cleanedSlug.includes('yaz-okulu')) coursePeriod = 'yaz-donemi';
                            const slug = kurs.data.customSlug || cleanedSlug;
                            const href = `/${lang}/${courseBase}/${slug}`;
                            const registerHref = buildBookingUrl(lang as 'tr' | 'de' | 'en' | 'es', slug);
                            const levelLabel = courseLevel === 'all' ? '' : courseLevel.toUpperCase();
                            const typeLabel = courseType === 'online' ? translations.courseFilterTypeOnline : translations.courseFilterInPerson;
                            const periodLabel = coursePeriod === 'yaz-donemi' ? translations.courseFilterSummer : translations.courseFilterYearRound;
                            const features = (kurs.data.features || []).slice(0, 2);
                            const pricingData = getCoursePricingData(lang as 'tr' | 'de' | 'en' | 'es', kurs.slug);
                            const perWeekPrice = getCourseCardPerWeekPrice(lang as 'tr' | 'de' | 'en' | 'es', kurs.slug);
                            const hasPrice = !!perWeekPrice
                                || !!pricingData?.pricing?.fullCourse
                                || !!(pricingData?.isWeeklyOnly && pricingData?.weeklyPricing);
                            return (
                                <article class="course-card" data-level={`all ${courseLevel}`} data-type={courseType} data-period={coursePeriod}>
                                    <a href={href} class="course-card-link">
                                        <div class="course-card-media">
                                            <img src={kurs.data.image} alt={kurs.data.title} loading="lazy" />
                                        </div>
                                        <div class="course-card-body">
                                            <div class="course-card-tags">
                                                {levelLabel ? <span class="course-card-badge">{levelLabel}</span> : ''}
                                                <span class="course-card-period">{periodLabel}</span>
                                            </div>
                                            <h3 class="course-title">{kurs.data.title}</h3>
                                            <p class="course-description">{kurs.data.description}</p>
                                            <span class="course-card-lessons">{translations.courseCardLessons}</span>
                                            <span class="course-card-meta">{typeLabel}</span>
                                            {features.length > 0 ? (
                                                <ul class="course-card-features" aria-hidden="true">
                                                    {features.map((f) => <li key={f.title}>{f.title}</li>)}
                                                </ul>
                                            ) : null}
                                            {hasPrice
                                                ? <div class="course-card-price"><PromoPrice lang={lang} variant="card" /></div>
                                                : <p class="course-card-price">{translations.courseCardContactUs}</p>}
                                        </div>
                                    </a>
                                    <div class="course-card-footer">
                                        <a href={href} class="course-card-btn course-card-btn--detail">
                                            <span>{translations.courseDetailsButton}</span>
                                        </a>
                                        <a href={registerHref} class="course-card-btn course-card-btn--register">
                                            <span>{translations.courseRegisterButton}</span>
                                            <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                        </a>
                                    </div>
                                </article>
                            );
                        })}
                    </div>
                    <nav class="index-courses-pagination" id="indexPagination" aria-label="Sayfalama">
                        <button type="button" class="index-page-btn prev" id="indexPrevPage" aria-label={translations.courseFilterPrev} disabled>
                            <i class="fas fa-chevron-left"></i>
                        </button>
                        <span class="index-page-info">
                            {translations.courseFilterPage} <span id="indexCurrentPage">1</span> / <span id="indexTotalPages">1</span>
                        </span>
                        <button type="button" class="index-page-btn next" id="indexNextPage" aria-label={translations.courseFilterNext}>
                            <i class="fas fa-chevron-right"></i>
                        </button>
                    </nav>
                </div>
            </div>
        </div>
    </section>

