                                </button>
                                <div class="filter-menu" id="indexTypeFilterDropdown">
                                    <a href="#" class="filter-item active" data-value="all">{translations.courseFilterAllTypes}</a>
                                    <a href="#" class="filter-item" data-value="yuz-yuze">{translations.courseFilterInPerson}</a>
