</MainLayout>

<script>
    // Wait for DOM to be ready
    document.addEventListener('DOMContentLoaded', function() {

    document.getElementById('hero-free-lesson-btn')?.addEventListener('click', function () {
        if (typeof window.openVisitPopup === 'function') window.openVisitPopup();
    });

    document.getElementById('visit-popup-fab')?.addEventListener('click', function () {
        if (typeof window.openVisitPopup === 'function') window.openVisitPopup();
    });

    // Neden Campus German – mobilde carousel (önceki/sonraki)
    (function() {
        const carousel = document.getElementById('whyCampusGermanCarousel');
        const prevBtn = document.getElementById('whyCarouselPrev');
        const nextBtn = document.getElementById('whyCarouselNext');
        if (!carousel || !prevBtn || !nextBtn) return;
        const cardWidth = () => {
            const first = carousel.querySelector('.why-campusgerman-card');
            if (!first) return carousel.clientWidth * 0.85;
            return first.offsetWidth + 24;
        };
        prevBtn.addEventListener('click', function() {
            carousel.scrollBy({ left: -cardWidth(), behavior: 'smooth' });
        });
        nextBtn.addEventListener('click', function() {
            carousel.scrollBy({ left: cardWidth(), behavior: 'smooth' });
        });
    })();

    // Index kurs: sol filtre, sağda sayfa başı 6 kurs + sayfalama
    (function() {
        const ITEMS_PER_PAGE = 6;
        const grid = document.getElementById('indexCoursesGrid');
        const filterButtons = { level: document.getElementById('indexLevelFilterBtn'), type: document.getElementById('indexTypeFilterBtn'), period: document.getElementById('indexPeriodFilterBtn') };
        const filterMenus = { level: document.getElementById('indexLevelFilterDropdown'), type: document.getElementById('indexTypeFilterDropdown'), period: document.getElementById('indexPeriodFilterDropdown') };
        const clearBtn = document.getElementById('indexClearFiltersBtn');
        const resultsInfo = document.getElementById('indexResultsInfo');
        const prevBtn = document.getElementById('indexPrevPage');
        const nextBtn = document.getElementById('indexNextPage');
        const currentPageEl = document.getElementById('indexCurrentPage');
        const totalPagesEl = document.getElementById('indexTotalPages');
        if (!grid) return;
        const courseCards = Array.from(grid.querySelectorAll('.course-card'));
        let currentFilters = { level: 'all', type: 'all', period: 'all', search: '' };
        let currentPage = 1;
        let filteredCards = [];
        Object.keys(filterButtons).forEach(key => {
            const btn = filterButtons[key], menu = filterMenus[key];
            if (btn && menu) btn.addEventListener('click', (e) => { e.stopPropagation(); e.preventDefault(); Object.values(filterMenus).forEach(m => { if (m && m !== menu) m.classList.remove('active'); }); menu.classList.toggle('active'); });
        });
        document.addEventListener('click', () => Object.values(filterMenus).forEach(m => { if (m) m.classList.remove('active'); }));
        document.querySelectorAll('.index-courses-section .filter-item').forEach(item => {
            item.addEventListener('click', function(e) {
                e.preventDefault();
                const menu = this.closest('.filter-menu');
                if (!menu) return;
                let filterType = ''; if (menu.id === 'indexLevelFilterDropdown') filterType = 'level'; else if (menu.id === 'indexTypeFilterDropdown') filterType = 'type'; else if (menu.id === 'indexPeriodFilterDropdown') filterType = 'period';
                const value = this.getAttribute('data-value');
                menu.querySelectorAll('.filter-item').forEach(i => i.classList.remove('active')); this.classList.add('active');
                currentFilters[filterType] = value;
                const btn = filterButtons[filterType]; if (btn) { const s = btn.querySelector('span'); if (s) s.textContent = this.textContent.trim(); }
                menu.classList.remove('active'); currentPage = 1; applyFilters();
            });
        });
        if (clearBtn) clearBtn.addEventListener('click', () => {
            currentFilters = { level: 'all', type: 'all', period: 'all', search: '' };
            currentPage = 1;
            const searchInput = document.getElementById('indexCourseSearchInput'), searchClear = document.getElementById('indexSearchClearBtn');
            if (searchInput) { searchInput.value = ''; if (searchClear) searchClear.style.display = 'none'; }
            document.querySelectorAll('.index-courses-section .filter-item').forEach(item => { item.classList.remove('active'); if (item.getAttribute('data-value') === 'all') item.classList.add('active'); });
            ['level','type','period'].forEach(key => { const m = filterMenus[key], btn = filterButtons[key]; if (m && btn) { const allItem = m.querySelector('.filter-item[data-value="all"]'); if (allItem && btn.querySelector('span')) btn.querySelector('span').textContent = allItem.textContent.trim(); } });
            applyFilters();
        });
        const searchInput = document.getElementById('indexCourseSearchInput'), searchClear = document.getElementById('indexSearchClearBtn');
        if (searchInput) { let t; searchInput.addEventListener('input', (e) => { clearTimeout(t); t = setTimeout(() => { currentFilters.search = e.target.value.toLowerCase().trim(); currentPage = 1; applyFilters(); }, 300); }); searchInput.addEventListener('keyup', () => { if (searchClear) searchClear.style.display = searchInput.value.length > 0 ? 'flex' : 'none'; }); }
        if (searchClear) searchClear.addEventListener('click', () => { if (searchInput) { searchInput.value = ''; currentFilters.search = ''; searchClear.style.display = 'none'; currentPage = 1; applyFilters(); } });
        if (prevBtn) prevBtn.addEventListener('click', () => { if (currentPage > 1) { currentPage--; updatePagination(); } });
        if (nextBtn) nextBtn.addEventListener('click', () => { if (currentPage < Math.ceil(filteredCards.length / ITEMS_PER_PAGE)) { currentPage++; updatePagination(); } });
        function applyFilters() {
            filteredCards = courseCards.filter(card => {
                const level = card.getAttribute('data-level') || '', type = card.getAttribute('data-type') || '', period = card.getAttribute('data-period') || '';
                const title = (card.querySelector('.course-title')?.textContent || '').toLowerCase(), desc = (card.querySelector('.course-description')?.textContent || '').toLowerCase();
                const levelMatch = currentFilters.level === 'all' || level.includes(currentFilters.level);
                const typeMatch = currentFilters.type === 'all' || type === currentFilters.type;
                const periodMatch = currentFilters.period === 'all' || period === currentFilters.period;
                const searchMatch = !currentFilters.search || title.includes(currentFilters.search) || desc.includes(currentFilters.search);
                return levelMatch && typeMatch && periodMatch && searchMatch;
            });
            if (clearBtn) clearBtn.style.display = (currentFilters.level !== 'all' || currentFilters.type !== 'all' || currentFilters.period !== 'all' || currentFilters.search) ? 'flex' : 'none';
            const label = resultsInfo?.getAttribute('data-results-label') || 'kurs bulundu';
            const noResultsText = document.documentElement.lang === 'tr' ? 'Sonuç bulunamadı' : document.documentElement.lang === 'de' ? 'Keine Ergebnisse gefunden' : document.documentElement.lang === 'en' ? 'No results found' : 'No se encontraron resultados';
            if (resultsInfo) { if (filteredCards.length === 0) { resultsInfo.classList.add('no-results'); resultsInfo.innerHTML = '<i class="fas fa-search"></i> ' + noResultsText; } else { resultsInfo.classList.remove('no-results'); resultsInfo.innerHTML = '<span id="indexResultsCount">' + filteredCards.length + '</span> ' + label; } }
            updatePagination();
        }
        function updatePagination() {
            const totalPages = Math.max(1, Math.ceil(filteredCards.length / ITEMS_PER_PAGE));
            currentPage = Math.min(currentPage, totalPages);
            const start = (currentPage - 1) * ITEMS_PER_PAGE;
            const end = start + ITEMS_PER_PAGE;
            courseCards.forEach((c, i) => {
                const idx = filteredCards.indexOf(c);
                if (idx === -1) { c.style.display = 'none'; return; }
                c.style.display = (idx >= start && idx < end) ? '' : 'none';
            });
            if (currentPageEl) currentPageEl.textContent = currentPage;
            if (totalPagesEl) totalPagesEl.textContent = totalPages;
            if (prevBtn) prevBtn.disabled = currentPage <= 1;
            if (nextBtn) nextBtn.disabled = currentPage >= totalPages;
        }
        applyFilters();
    })();
    
    // Student Reviews Slider
    (function() {
        const slider = document.getElementById('reviewsSlider');
        const prevBtn = document.getElementById('reviewsPrev');
        const nextBtn = document.getElementById('reviewsNext');
        const indicators = document.getElementById('reviewsIndicators');
        
        if (!slider || !prevBtn || !nextBtn || !indicators) return;
        
        const cards = slider.querySelectorAll('.review-card');
        let currentIndex = 0;
        
        // Create indicators
        function createIndicators() {
            indicators.innerHTML = '';
            for (let i = 0; i < cards.length; i++) {
                const dot = document.createElement('button');
                if (i === 0) dot.classList.add('active');
                dot.addEventListener('click', () => goToSlide(i));
                indicators.appendChild(dot);
            }
        }
        
        // Update indicators
        function updateIndicators() {
            const dots = indicators.querySelectorAll('button');
            dots.forEach((dot, index) => {
                dot.classList.toggle('active', index === currentIndex);
            });
        }
        
        // Go to slide
        function goToSlide(index) {
            const maxIndex = cards.length - 1;
            currentIndex = Math.max(0, Math.min(index, maxIndex));
            
            const cardWidth = cards[0].offsetWidth + 15;
            slider.scrollTo({
                left: currentIndex * cardWidth,
                behavior: 'smooth'
            });
            
            updateIndicators();
            updateButtons();
        }
        
        // Update buttons
        function updateButtons() {
            const maxIndex = cards.length - 1;
            prevBtn.disabled = currentIndex === 0;
            nextBtn.disabled = currentIndex >= maxIndex;
        }
        
        // Next slide
        function nextSlide() {
            if (currentIndex < cards.length - 1) {
                goToSlide(currentIndex + 1);
            }
        }
        
        // Previous slide
        function prevSlide() {
            if (currentIndex > 0) {
                goToSlide(currentIndex - 1);
            }
        }
        
        // Handle scroll
        function handleScroll() {
            const cardWidth = cards[0].offsetWidth + 15;
            const scrollPosition = slider.scrollLeft;
            const newIndex = Math.round(scrollPosition / cardWidth);
            
            if (newIndex !== currentIndex && newIndex >= 0 && newIndex < cards.length) {
                currentIndex = newIndex;
                updateIndicators();
                updateButtons();
            }
        }
        
        // Event listeners
        nextBtn.addEventListener('click', nextSlide);
        prevBtn.addEventListener('click', prevSlide);
        slider.addEventListener('scroll', handleScroll);
        
        // Auto-play
        let autoPlayInterval;
        function startAutoPlay() {
            autoPlayInterval = setInterval(() => {
                if (currentIndex < cards.length - 1) {
                    nextSlide();
                } else {
                    goToSlide(0);
                }
            }, 5000);
        }
        
        function stopAutoPlay() {
            clearInterval(autoPlayInterval);
        }
        
        // Pause on hover
        const reviewsSection = slider.closest('.student-reviews');
        if (reviewsSection) {
            reviewsSection.addEventListener('mouseenter', stopAutoPlay);
            reviewsSection.addEventListener('mouseleave', startAutoPlay);
        }
        
        // Handle resize
        let resizeTimer;
        window.addEventListener('resize', () => {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(() => {
                currentIndex = 0;
                goToSlide(0);
            }, 250);
        });
        
        // Initialize
        createIndicators();
        updateButtons();
        startAutoPlay();
    })();
    
    // Video Carousel
    (function() {
        const track = document.getElementById('videoCarouselTrack');
        const prevBtn = document.getElementById('videoCarouselPrev');
        const nextBtn = document.getElementById('videoCarouselNext');
        
        if (!track || !prevBtn || !nextBtn) return;
        
        const cards = track.querySelectorAll('.vertical-video-card');
        let currentIndex = 0;
        
        // Calculate cards per view based on screen size
        function getCardsPerView() {
            if (window.innerWidth >= 1024) return 3;
            if (window.innerWidth >= 768) return 2;
            return 1;
        }
        
        // Go to slide
        function goToSlide(index) {
            const cardsPerView = getCardsPerView();
            const maxIndex = Math.max(0, cards.length - cardsPerView);
            currentIndex = Math.max(0, Math.min(index, maxIndex));
            
            const cardWidth = cards[0].offsetWidth + 20; // card width + gap
            const scrollPosition = currentIndex * cardWidth;
            
            track.style.transform = `translateX(-${scrollPosition}px)`;
            updateButtons();
        }
        
        // Update buttons
        function updateButtons() {
            const cardsPerView = getCardsPerView();
            const maxIndex = Math.max(0, cards.length - cardsPerView);
            
            prevBtn.disabled = currentIndex === 0;
            nextBtn.disabled = currentIndex >= maxIndex;
        }
        
        // Next slide
        function nextSlide() {
            const cardsPerView = getCardsPerView();
            const maxIndex = Math.max(0, cards.length - cardsPerView);
            if (currentIndex < maxIndex) {
                goToSlide(currentIndex + 1);
            }
        }
        
        // Previous slide
        function prevSlide() {
            if (currentIndex > 0) {
                goToSlide(currentIndex - 1);
            }
        }
        
        // Handle resize
        let resizeTimer;
        window.addEventListener('resize', () => {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(() => {
                currentIndex = 0;
                goToSlide(0);
            }, 250);
        });
        
        // Event listeners
        nextBtn.addEventListener('click', nextSlide);
        prevBtn.addEventListener('click', prevSlide);
        
        // Initialize
        updateButtons();
    })();
    
    }); // End DOMContentLoaded
</script>
