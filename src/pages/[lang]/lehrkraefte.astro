const L = t[lang as keyof typeof t] || t.en;
const bookingPath = getBookingPath(lang as 'tr' | 'de' | 'en' | 'es');
---

<MainLayout title={L.pageTitle} lang={lang}>
    <!-- Hero Section -->
    <section class="instructors-hero-section">
        <div class="container">
            <div class="instructors-hero-content">
                <div class="hero-badge">
                    <i class="fas fa-chalkboard-teacher"></i>
                    <span>{L.heroBadge}</span>
                </div>
                <h1 class="hero-main-title">{L.heroTitle}</h1>
                <p class="hero-description">{L.heroDesc}</p>
                <div class="hero-stats">
                    <div class="stat-item">
                        <div class="stat-number">15+</div>
                        <div class="stat-label">{L.stat1}</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-number">1000+</div>
                        <div class="stat-label">{L.stat2}</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-number">98%</div>
                        <div class="stat-label">{L.stat3}</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Instructors Section -->
    <section class="instructors-section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">{L.sectionTitle}</h2>
                <p class="section-subtitle">{L.sectionSubtitle}</p>
            </div>

            <div class="instructors-grid">
                <div class="instructor-card">
                    <div class="instructor-image-wrapper">
                        <div class="instructor-image">
                            <i class="fas fa-user-circle"></i>
                        </div>
                        <div class="instructor-badge">
                            <i class="fas fa-certificate"></i>
                            <span>{L.badgeGoethe}</span>
                        </div>
                    </div>
                    <div class="instructor-content">
                        <div class="instructor-header">
                            <h3 class="instructor-name">Prof. Dr. Anna Schmidt</h3>
                            <p class="instructor-title">{L.title1}</p>
                        </div>
                        <div class="instructor-info">
                            <div class="info-row">
                                <i class="fas fa-graduation-cap"></i>
                                <span>{L.edu1}</span>
                            </div>
                            <div class="info-row">
                                <i class="fas fa-briefcase"></i>
                                <span>15+ {L.exp}</span>
                            </div>
                            <div class="info-row">
                                <i class="fas fa-language"></i>
                                <span>{L.lang1}</span>
                            </div>
                        </div>
                        <div class="instructor-description">
                            <p>{L.bio1}</p>
                        </div>
                        <div class="instructor-specialties">
                            <h4>{L.specialtiesTitle}</h4>
                            <ul class="specialties-list">
                                <li><i class="fas fa-check"></i> {L.spec1a}</li>
                                <li><i class="fas fa-check"></i> {L.spec1b}</li>
                                <li><i class="fas fa-check"></i> {L.spec1c}</li>
                                <li><i class="fas fa-check"></i> {L.spec1d}</li>
                            </ul>
                        </div>
                        <div class="instructor-contact">
                            <a href="mailto:anna@campusgerman.com" class="contact-btn">
                                <i class="fas fa-envelope"></i>
                                {L.contactBtn}
                            </a>
                        </div>
                    </div>
                </div>

                <div class="instructor-card">
                    <div class="instructor-image-wrapper">
                        <div class="instructor-image">
                            <i class="fas fa-user-circle"></i>
                        </div>
                        <div class="instructor-badge">
                            <i class="fas fa-certificate"></i>
                            <span>{L.badgeDaf}</span>
                        </div>
                    </div>
                    <div class="instructor-content">
                        <div class="instructor-header">
                            <h3 class="instructor-name">Michael Weber</h3>
                            <p class="instructor-title">{L.title2}</p>
                        </div>
                        <div class="instructor-info">
                            <div class="info-row">
                                <i class="fas fa-graduation-cap"></i>
                                <span>{L.edu2}</span>
                            </div>
                            <div class="info-row">
                                <i class="fas fa-briefcase"></i>
                                <span>12+ {L.exp}</span>
                            </div>
                            <div class="info-row">
                                <i class="fas fa-language"></i>
                                <span>{L.lang2}</span>
                            </div>
                        </div>
                        <div class="instructor-description">
                            <p>{L.bio2}</p>
                        </div>
                        <div class="instructor-specialties">
                            <h4>{L.specialtiesTitle}</h4>
                            <ul class="specialties-list">
                                <li><i class="fas fa-check"></i> {L.spec2a}</li>
                                <li><i class="fas fa-check"></i> {L.spec2b}</li>
                                <li><i class="fas fa-check"></i> {L.spec2c}</li>
                                <li><i class="fas fa-check"></i> {L.spec2d}</li>
                            </ul>
                        </div>
                        <div class="instructor-contact">
                            <a href="mailto:michael@campusgerman.com" class="contact-btn">
                                <i class="fas fa-envelope"></i>
                                {L.contactBtn}
                            </a>
                        </div>
                    </div>
                </div>

                <div class="instructor-card">
                    <div class="instructor-image-wrapper">
                        <div class="instructor-image">
                            <i class="fas fa-user-circle"></i>
                        </div>
                        <div class="instructor-badge">
                            <i class="fas fa-certificate"></i>
                            <span>{L.badgeGoethe}</span>
                        </div>
                    </div>
                    <div class="instructor-content">
                        <div class="instructor-header">
                            <h3 class="instructor-name">Sarah Müller</h3>
                            <p class="instructor-title">{L.title3}</p>
                        </div>
                        <div class="instructor-info">
                            <div class="info-row">
                                <i class="fas fa-graduation-cap"></i>
                                <span>{L.edu3}</span>
                            </div>
                            <div class="info-row">
                                <i class="fas fa-briefcase"></i>
                                <span>8+ {L.exp}</span>
                            </div>
                            <div class="info-row">
                                <i class="fas fa-language"></i>
                                <span>{L.lang1}</span>
                            </div>
                        </div>
                        <div class="instructor-description">
                            <p>{L.bio3}</p>
                        </div>
                        <div class="instructor-specialties">
                            <h4>{L.specialtiesTitle}</h4>
                            <ul class="specialties-list">
                                <li><i class="fas fa-check"></i> {L.spec3a}</li>
                                <li><i class="fas fa-check"></i> {L.spec3b}</li>
                                <li><i class="fas fa-check"></i> {L.spec3c}</li>
                                <li><i class="fas fa-check"></i> {L.spec3d}</li>
                            </ul>
                        </div>
                        <div class="instructor-contact">
                            <a href="mailto:sarah@campusgerman.com" class="contact-btn">
                                <i class="fas fa-envelope"></i>
                                {L.contactBtn}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section instructors-cta">
        <div class="container">
            <div class="cta-content">
                <div class="cta-icon">
                    <i class="fas fa-chalkboard-teacher"></i>
                </div>
                <h2 class="cta-title">{L.ctaTitle}</h2>
                <p class="cta-description">{L.ctaDesc}</p>
                <div class="cta-actions">
                    <a href={`/${lang}/${bookingPath}`} class="cta-button">
                        <span>{L.ctaApply}</span>
                        <i class="fas fa-arrow-right"></i>
                    </a>
                    <a href={`/${lang}/${contactPath}`} class="cta-button-secondary">
                        <span>{L.ctaContact}</span>
                        <i class="fas fa-envelope"></i>
                    </a>
                </div>
            </div>
        </div>
    </section>
</MainLayout>
