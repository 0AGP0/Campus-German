---
import MainLayout from '../../layouts/MainLayout.astro';
import '../../styles/pages/lehrkraefte.css';
import { getContactPath, getBookingPath } from '../../utils/pathHelpers';

export async function getStaticPaths() {
    return [
        { params: { lang: 'tr' } },
        { params: { lang: 'de' } },
        { params: { lang: 'en' } },
        { params: { lang: 'es' } },
    ];
}

const { lang } = Astro.params;
const contactPath = getContactPath(lang as 'tr' | 'de' | 'en' | 'es');

