---
import MainLayout from '../../layouts/MainLayout.astro';
import AkademikAlmancaSarmal from '../../components/AkademikAlmancaSarmal.astro';
import '../../styles/pages/kurslar.css';
import { getCollection } from 'astro:content';
import { coursePricing } from '../../data/coursePricing';
import { cleanSlug, isOverviewPage, getSectionPath, getContactPath, isValidLang } from '../../utils/pathHelpers';
import { getFormattedStartDates } from '../../utils/coursePricingHelper';

export async function getStaticPaths() {
    return [
        { params: { lang: 'es' } },
    ];
}

const { lang } = Astro.params;

// Lang tip kontrolü
if (!isValidLang(lang)) {
    throw new Error(`Invalid language: ${lang}`);
}

// Path helper'ları
const sectionPath = getSectionPath(lang);
const contactPath = getContactPath(lang);

// Tüm kursları al ve kategorilere ayır
const allKurslar = await getCollection('kurslar');
const kurslarByLang = allKurslar.filter(kurs => kurs.data.lang === lang);

// Ana kurslar (genel bakış sayfaları hariç)
const anaKurslar = kurslarByLang.filter(kurs => {
    return !isOverviewPage(kurs.slug);
});

// Kategorilere göre ayır
const yogunKurslar = anaKurslar.filter(kurs => 
    (kurs.slug.startsWith('intensiv-') || kurs.slug.startsWith('yogun-')) && 
    !kurs.slug.includes('studentenvisum') && !kurs.slug.includes('ogrenci-vizesi')
);
const onlineKurslar = anaKurslar.filter(kurs => 
    kurs.slug.startsWith('online-')
);
const donemselKurslar = anaKurslar.filter(kurs => 
    kurs.slug.includes('woechentlich-') || 
    kurs.slug.includes('haftalik-') || 
    kurs.slug.includes('sommerschule') || 
    kurs.slug.includes('yaz-okulu') || 
    kurs.slug.includes('abend-') ||
    kurs.slug.includes('aksam-') ||
    kurs.slug.includes('saisonal-') ||
    kurs.slug.includes('donemsel-') ||
    kurs.slug.includes('weekly') ||
    kurs.slug.includes('semanal') ||
    kurs.slug.includes('nocturno') ||
    kurs.slug.includes('evening')
);
const sinavKurslar = anaKurslar.filter(kurs => 
    kurs.slug.includes('goethe-') || 
    kurs.slug.includes('telc-') || 
    kurs.slug.includes('testdaf-') || 
    kurs.slug.includes('dsh-') ||
    kurs.slug.includes('pruefungsvorbereitung-')
);
const kurumsalKurslar = anaKurslar.filter(kurs => 
    kurs.slug.includes('firmenkurs') ||
    kurs.slug.includes('firma-') || 
    kurs.slug.includes('bildungszeit') || 
    kurs.slug.includes('daad-') || 
    kurs.slug.includes('erasmus-') || 
    kurs.slug.includes('beruf-') ||
    kurs.slug.includes('meslek-') || 
    kurs.slug.includes('career-') || 
    kurs.slug.includes('medizin-') ||
    kurs.slug.includes('tip-') || 
    kurs.slug.includes('fsp-') || 
    kurs.slug.includes('ingenieurwesen-') ||
    kurs.slug.includes('muhendislik-') || 
    kurs.slug.includes('wirtschaft-') ||
    kurs.slug.includes('ekonomi-')
);

const pricingLang = 'de';
const startDates = getFormattedStartDates(pricingLang as 'tr' | 'de' | 'en' | 'es');
---

<MainLayout title="Cursos - CampusGerman" lang={lang}>
    <!-- Hero Section -->
    <section class="courses-hero-section">
        <div class="container">
            <!-- Main Hero Content -->
            <div class="courses-hero-content">
                <div class="hero-left">
                    <h1 class="hero-title">
                        ¡Cursos de alemán en CampusGerman!
                    </h1>
                    
                    <div class="hero-content">
                        <p class="hero-description">
                            ¿Quiere aprender alemán para estudiar en Alemania, trabajar en Alemania, comenzar una formación profesional o simplemente mejorar sus conocimientos de alemán? Cualquiera que sea su motivación, encontrará el curso de alemán adecuado en CampusGerman en las vibrantes ciudades universitarias de Alemania.
                        </p>
                        
                        <p class="hero-description">
                            Elegir nuestros cursos de alemán en CampusGerman le permitirá alcanzar su objetivo de manera eficiente y agradable en un ambiente de aprendizaje relajado y amigable.
                        </p>
                    </div>
                    
                    <div class="hero-actions">
                        <a href="#cursos-tarjetas" class="btn-primary">
                            <i class="fas fa-arrow-down"></i>
                            Explorar cursos
                        </a>
                        <button class="btn-secondary" id="contactBtn">
                            <i class="fas fa-envelope"></i>
                            Contactar
                        </button>
                    </div>
                </div>
                
                <div class="hero-right">
                    <div class="hero-cta-card">
                        <div class="cta-icon">
                            <i class="fas fa-graduation-cap"></i>
                        </div>
                        <h3 class="cta-title">Descubra nuestros cursos</h3>
                        <p class="cta-description">
                            Cursos especialmente diseñados para cada nivel, instructores experimentados y opciones de programa flexibles.
                        </p>
                        <div class="cta-stats">
                            <div class="cta-stat">
                                <div class="stat-number">6</div>
                                <div class="stat-label">Nivel</div>
                            </div>
                            <div class="cta-stat">
                                <div class="stat-number">50+</div>
                                <div class="stat-label">Cursos</div>
                            </div>
                            <div class="cta-stat">
                                <div class="stat-number">98%</div>
                                <div class="stat-label">Éxito</div>
                            </div>
                        </div>
                        <a href="#cursos-tarjetas" class="cta-button">
                            <i class="fas fa-arrow-down"></i>
                            Ver todos los cursos
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Campus German Akademik Almanca Sarmalı -->
    <AkademikAlmancaSarmal lang={lang} />
    
    <!-- Kurs Kartları Section -->
    <section class="courses-section" id="kurs-kartlari">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Nuestros cursos de alemán</h2>
                <p class="section-subtitle">Cursos especialmente diseñados para cada nivel y necesidad</p>
            </div>
            
            <!-- Filtreleme ve Arama -->
            <div class="courses-filter-section">
                <div class="filter-search-box">
                    <div class="search-wrapper">
                        <i class="fas fa-search"></i>
                        <input 
                            type="text" 
                            id="courseSearchInput" 
                            placeholder="Buscar curso..."
                        />
                        <button class="search-clear" id="searchClearBtn" style="display: none;">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
                
                <div class="filter-buttons-row">
                    <div class="filter-btn-wrapper">
                        <button class="filter-btn" id="levelFilterBtn">
                            <span>Nivel de idioma</span>
                            <i class="fas fa-chevron-down"></i>
                        </button>
                        <div class="filter-menu" id="levelFilterDropdown">
                            <a href="#" class="filter-item" data-value="all">Todos los niveles</a>
                            <a href="#" class="filter-item" data-value="a1">A1</a>
                            <a href="#" class="filter-item" data-value="a2">A2</a>
                            <a href="#" class="filter-item" data-value="b1">B1</a>
                            <a href="#" class="filter-item" data-value="b2">B2</a>
                            <a href="#" class="filter-item" data-value="c1">C1</a>
                            <a href="#" class="filter-item" data-value="c2">C2</a>
                        </div>
                    </div>
                    
                    <div class="filter-btn-wrapper">
                        <button class="filter-btn" id="typeFilterBtn">
                            <span>Tipo de curso</span>
                            <i class="fas fa-chevron-down"></i>
                        </button>
                        <div class="filter-menu" id="typeFilterDropdown">
                            <a href="#" class="filter-item" data-value="all">Todos los cursos</a>
                            <a href="#" class="filter-item" data-value="yuz-yuze">Presencial</a>
                            <a href="#" class="filter-item" data-value="online">Online</a>
                        </div>
                    </div>
                    
                    <div class="filter-btn-wrapper">
                        <button class="filter-btn" id="periodFilterBtn">
                            <span>Período</span>
                            <i class="fas fa-chevron-down"></i>
                        </button>
                        <div class="filter-menu" id="periodFilterDropdown">
                            <a href="#" class="filter-item" data-value="all">Todos los períodos</a>
                            <a href="#" class="filter-item" data-value="yaz-donemi">Verano</a>
                            <a href="#" class="filter-item" data-value="yil-boyu">Todo el año</a>
                        </div>
                    </div>
                    
                    <button class="clear-btn" id="clearFiltersBtn" style="display: none;">
                        <i class="fas fa-times"></i>
                        Restablecer
                    </button>
                </div>
                
                <div class="results-count" id="resultsInfo">
                    <span id="resultsCount">{anaKurslar.length}</span> cursos encontrados
                </div>
            </div>
            
            <div class="courses-grid" id="coursesGrid">
                {anaKurslar.map(kurs => {
                    // Kurs tipini belirle (filtreleme için)
                    let courseType = 'yuz-yuze';
                    let courseLevel = 'all';
                    let coursePeriod = 'yil-boyu';
                    
                    const cleanedSlug = cleanSlug(kurs.slug);
                    
                    if (cleanedSlug.startsWith('online-')) {
                        courseType = 'online';
                    }
                    
                    // Seviye belirleme
                    if (cleanedSlug.includes('-a1') || cleanedSlug.includes('a1-')) {
                        courseLevel = 'a1';
                    } else if (cleanedSlug.includes('-a2') || cleanedSlug.includes('a2-')) {
                        courseLevel = 'a2';
                    } else if (cleanedSlug.includes('-b1') || cleanedSlug.includes('b1-')) {
                        courseLevel = 'b1';
                    } else if (cleanedSlug.includes('-b2') || cleanedSlug.includes('b2-')) {
                        courseLevel = 'b2';
                    } else if (cleanedSlug.includes('-c1') || cleanedSlug.includes('c1-')) {
                        courseLevel = 'c1';
                    }
                    
                    // Dönem belirleme
                    if (cleanedSlug.includes('yaz-okulu')) {
                        coursePeriod = 'yaz-donemi';
                    }
                    
                    return (
                        <div class="course-card" data-level={`all ${courseLevel}`} data-type={courseType} data-period={coursePeriod}>
                            <div class="course-image">
                                <img src={kurs.data.image} alt={kurs.data.title}>
                            </div>
                            <div class="course-content">
                                <h3 class="course-title">{kurs.data.title}</h3>
                                <div class="course-details">
                                    {kurs.data.features.map(feature => (
                                        <div class="course-detail">
                                            <i class={feature.icon}></i>
                                            <span>{feature.description}</span>
                                        </div>
                                    ))}
                                </div>
                                <p class="course-description">
                                    {kurs.data.description}
                                </p>
                                <a href={`/${lang}/${sectionPath}/${kurs.data.customSlug || cleanSlug(kurs.slug)}`} class="course-btn">
                                    <span>Ver detalles</span>
                                    <i class="fas fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    );
                })}
            </div>
            
            <!-- Pagination -->
            <div class="pagination-wrapper" id="paginationContainer" style="display: none;">
                <div class="pagination">
                    <button class="page-btn prev" id="prevPageBtn" disabled>
                        <i class="fas fa-chevron-left"></i>
                    </button>
                    <div class="page-numbers" id="paginationNumbers"></div>
                    <button class="page-btn next" id="nextPageBtn">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </div>
                <div class="page-info" id="paginationInfo">
                    Página <span id="currentPageNum">1</span> / <span id="totalPagesNum">1</span>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Fiyatlar ve Tarihler Section -->
    <section class="pricing-dates-section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Precios y fechas</h2>
                <p class="section-subtitle">Precios y fechas de inicio de los cursos de alemán</p>
            </div>
            
            <div class="pricing-content">
                <!-- Akademik Almanca Kursları Fiyatları -->
                <div class="pricing-block">
                    <h3 class="pricing-block-title">Precios de cursos académicos de alemán</h3>
                    <div class="pricing-table-wrapper">
                        <table class="pricing-table">
                            <thead>
                                <tr>
                                    <th>Nivel</th>
                                    <th>Clases</th>
                                    <th>Duración</th>
                                    <th>Precio</th>
                                </tr>
                            </thead>
                            <tbody>
                                {(['a1', 'a2', 'b1', 'b2', 'c1'] as const).map(level => {
                                    const pricing = coursePricing[pricingLang as 'tr' | 'de'].intensive[level];
                                    return (
                                        <tr>
                                            <td><strong>{level.toUpperCase()}</strong></td>
                                            <td>{pricing.lessons}</td>
                                            <td>{pricing.duration}</td>
                                            <td><strong>{pricing.fullCourse}</strong></td>
                                        </tr>
                                    );
                                })}
                            </tbody>
                        </table>
                    </div>
                </div>
                
                <!-- Online Kurs Fiyatları -->
                <div class="pricing-block">
                    <h3 class="pricing-block-title">Precios de cursos de alemán online</h3>
                    <div class="pricing-table-wrapper">
                        <table class="pricing-table">
                            <thead>
                                <tr>
                                    <th>Nivel</th>
                                    <th>Clases</th>
                                    <th>Duración</th>
                                    <th>Precio</th>
                                </tr>
                            </thead>
                            <tbody>
                                {(['a1', 'a2', 'b1', 'b2', 'c1'] as const).map(level => {
                                    const pricing = coursePricing[pricingLang as 'tr' | 'de'].online[level];
                                    return (
                                        <tr>
                                            <td><strong>{level.toUpperCase()}</strong></td>
                                            <td>{pricing.lessons}</td>
                                            <td>{pricing.duration}</td>
                                            <td><strong>{pricing.fullCourse}</strong></td>
                                        </tr>
                                    );
                                })}
                            </tbody>
                        </table>
                    </div>
                </div>
                
                <!-- Sınav Hazırlık Kursları Fiyatları -->
                <div class="pricing-block">
                    <h3 class="pricing-block-title">Precios de cursos de preparación de exámenes</h3>
                    <div class="pricing-table-wrapper">
                        <table class="pricing-table">
                            <thead>
                                <tr>
                                    <th>Tipo de examen</th>
                                    <th>Clases</th>
                                    <th>Duración</th>
                                    <th>Precio</th>
                                </tr>
                            </thead>
                            <tbody>
                                {(['a1', 'a2', 'b1', 'b2', 'c1'] as const).map(level => {
                                    const pricing = coursePricing[pricingLang as 'tr' | 'de'].examPrep.goetheTelc[level];
                                    return (
                                        <tr>
                                            <td><strong>Goethe/TELC {level.toUpperCase()}</strong></td>
                                            <td>{pricing.lessons}</td>
                                            <td>{pricing.duration}</td>
                                            <td><strong>{pricing.fullCourse}</strong></td>
                                        </tr>
                                    );
                                })}
                                <tr>
                                    <td><strong>TestDaF/DSH</strong></td>
                                    <td>{coursePricing[pricingLang as 'tr' | 'de'].examPrep.testdafDsh.lessons}</td>
                                    <td>{coursePricing[pricingLang as 'tr' | 'de'].examPrep.testdafDsh.duration}</td>
                                    <td><strong>{coursePricing[pricingLang as 'tr' | 'de'].examPrep.testdafDsh.fullCourse}</strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                
                <!-- Kurs Zamanları -->
                <div class="pricing-block">
                    <h3 class="pricing-block-title">Horarios de los cursos</h3>
                    <div class="schedule-grid">
                        <div class="schedule-card">
                            <h4><i class="fas fa-sun"></i> Cursos de mañana</h4>
                            <div class="schedule-item">
                                <strong>A1-A2:</strong>
                                <p>{coursePricing[pricingLang as 'tr' | 'de'].schedule.morning.a1a2.time}</p>
                                <p class="schedule-break">{coursePricing[pricingLang as 'tr' | 'de'].schedule.morning.a1a2.break}</p>
                                <p class="schedule-lessons">{coursePricing[pricingLang as 'tr' | 'de'].schedule.morning.a1a2.lessons}</p>
                            </div>
                            <div class="schedule-item">
                                <strong>B1-C1:</strong>
                                <p>{coursePricing[pricingLang as 'tr' | 'de'].schedule.morning.b1c1.time}</p>
                                <p class="schedule-break">{coursePricing[pricingLang as 'tr' | 'de'].schedule.morning.b1c1.break}</p>
                                <p class="schedule-lessons">{coursePricing[pricingLang as 'tr' | 'de'].schedule.morning.b1c1.lessons}</p>
                            </div>
                        </div>
                        <div class="schedule-card">
                            <h4><i class="fas fa-moon"></i> Cursos de tarde</h4>
                            <div class="schedule-item">
                                <strong>A1-A2:</strong>
                                <p>{coursePricing[pricingLang as 'tr' | 'de'].schedule.afternoon.a1a2.time}</p>
                                <p class="schedule-break">{coursePricing[pricingLang as 'tr' | 'de'].schedule.afternoon.a1a2.break}</p>
                                <p class="schedule-lessons">{coursePricing[pricingLang as 'tr' | 'de'].schedule.afternoon.a1a2.lessons}</p>
                            </div>
                            <div class="schedule-item">
                                <strong>B1-C1:</strong>
                                <p>{coursePricing[pricingLang as 'tr' | 'de'].schedule.afternoon.b1c1.time}</p>
                                <p class="schedule-break">{coursePricing[pricingLang as 'tr' | 'de'].schedule.afternoon.b1c1.break}</p>
                                <p class="schedule-lessons">{coursePricing[pricingLang as 'tr' | 'de'].schedule.afternoon.b1c1.lessons}</p>
                            </div>
                        </div>
                        <div class="schedule-card">
                            <h4><i class="fas fa-cloud-moon"></i> Cursos nocturnos</h4>
                            <div class="schedule-item">
                                <strong>A1-A2:</strong>
                                <p>{coursePricing[pricingLang as 'tr' | 'de'].schedule.evening.a1a2.time}</p>
                                <p class="schedule-break">{coursePricing[pricingLang as 'tr' | 'de'].schedule.evening.a1a2.break}</p>
                                <p class="schedule-lessons">{coursePricing[pricingLang as 'tr' | 'de'].schedule.evening.a1a2.lessons}</p>
                            </div>
                            <div class="schedule-item">
                                <strong>B1-C1:</strong>
                                <p>{coursePricing[pricingLang as 'tr' | 'de'].schedule.evening.b1c1.time}</p>
                                <p class="schedule-break">{coursePricing[pricingLang as 'tr' | 'de'].schedule.evening.b1c1.break}</p>
                                <p class="schedule-lessons">{coursePricing[pricingLang as 'tr' | 'de'].schedule.evening.b1c1.lessons}</p>
                            </div>
                        </div>
                    </div>
                    <p class="schedule-days"><i class="fas fa-calendar-week"></i> {coursePricing[pricingLang as 'tr' | 'de'].schedule.days}</p>
                </div>
                
                <!-- Kurs Başlangıç Tarihleri -->
                <div class="pricing-block">
                    <h3 class="pricing-block-title">Nuestras fechas de curso</h3>
                    <p class="pricing-subtitle">Cursos intensivos académicos / Cursos de alemán online</p>
                    <div class="course-dates-table-wrapper">
                        <table class="course-dates-table">
                            <thead>
                                <tr>
                                    <th>A1.1</th>
                                    <th>A1.2</th>
                                    <th>A2.1</th>
                                    <th>A2.2</th>
                                    <th>B1.1</th>
                                    <th>B1.2</th>
                                    <th>B2.1</th>
                                    <th>B2.2</th>
                                    <th>C1.1</th>
                                    <th>C1.2</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>{startDates.a1.a1_1[0]}</td>
                                    <td>{startDates.a1.a1_2[0]}</td>
                                    <td>{startDates.a2.a2_1[0]}</td>
                                    <td>{startDates.a2.a2_2[0]}</td>
                                    <td>{startDates.b1.b1_1[0]}</td>
                                    <td>{startDates.b1.b1_2[0]}</td>
                                    <td>{startDates.b2.b2_1[0]}</td>
                                    <td>{startDates.b2.b2_2[0]}</td>
                                    <td>{startDates.c1.c1_1[0]}</td>
                                    <td>{startDates.c1.c1_2[0]}</td>
                                </tr>
                                <tr>
                                    <td>{startDates.a1.a1_1[1]}</td>
                                    <td>{startDates.a1.a1_2[1]}</td>
                                    <td>{startDates.a2.a2_1[1]}</td>
                                    <td>{startDates.a2.a2_2[1]}</td>
                                    <td>{startDates.b1.b1_1[1]}</td>
                                    <td>{startDates.b1.b1_2[1]}</td>
                                    <td>{startDates.b2.b2_1[1]}</td>
                                    <td>{startDates.b2.b2_2[1]}</td>
                                    <td>{startDates.c1.c1_1[1]}</td>
                                    <td>{startDates.c1.c1_2[1]}</td>
                                </tr>
                                <tr>
                                    <td>{startDates.a1.a1_1[2]}</td>
                                    <td>{startDates.a1.a1_2[2]}</td>
                                    <td>{startDates.a2.a2_1[2]}</td>
                                    <td>{startDates.a2.a2_2[2]}</td>
                                    <td>{startDates.b1.b1_1[2]}</td>
                                    <td>{startDates.b1.b1_2[2]}</td>
                                    <td>{startDates.b2.b2_1[2]}</td>
                                    <td>{startDates.b2.b2_2[2]}</td>
                                    <td>{startDates.c1.c1_1[2]}</td>
                                    <td>{startDates.c1.c1_2[2]}</td>
                                </tr>
                                <tr>
                                    <td>{startDates.a1.a1_1[3]}</td>
                                    <td>{startDates.a1.a1_2[3]}</td>
                                    <td>{startDates.a2.a2_1[3]}</td>
                                    <td>{startDates.a2.a2_2[3]}</td>
                                    <td>{startDates.b1.b1_1[3]}</td>
                                    <td>{startDates.b1.b1_2[3]}</td>
                                    <td>{startDates.b2.b2_1[3]}</td>
                                    <td>{startDates.b2.b2_2[3]}</td>
                                    <td>{startDates.c1.c1_1[3]}</td>
                                    <td>{startDates.c1.c1_2[3]}</td>
                                </tr>
                                <tr>
                                    <td>{startDates.a1.a1_1[4]}</td>
                                    <td>{startDates.a1.a1_2[4]}</td>
                                    <td>{startDates.a2.a2_1[4]}</td>
                                    <td>{startDates.a2.a2_2[4]}</td>
                                    <td>{startDates.b1.b1_1[4]}</td>
                                    <td>{startDates.b1.b1_2[4]}</td>
                                    <td>{startDates.b2.b2_1[4]}</td>
