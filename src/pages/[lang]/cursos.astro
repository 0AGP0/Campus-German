<script define:vars={{ lang }}>
    // Temiz Filtreleme ve Sayfalama Sistemi
    (function() {
        const coursesGrid = document.getElementById('coursesGrid');
        const courseCards = Array.from(coursesGrid.querySelectorAll('.course-card'));
        const itemsPerPage = 9;
        
        let currentFilters = {
            level: 'all',
            type: 'all',
            period: 'all',
            search: ''
        };
        
        let currentPage = 1;
        let filteredCourses = [...courseCards];
        
        // Filtre butonları ve menüleri
        const filterButtons = {
            level: document.getElementById('levelFilterBtn'),
            type: document.getElementById('typeFilterBtn'),
            period: document.getElementById('periodFilterBtn')
        };
        
        const filterMenus = {
            level: document.getElementById('levelFilterDropdown'),
            type: document.getElementById('typeFilterDropdown'),
            period: document.getElementById('periodFilterDropdown')
        };
        
        // Dropdown açma/kapama
        Object.keys(filterButtons).forEach(key => {
            const btn = filterButtons[key];
            const menu = filterMenus[key];
            
            if (btn && menu) {
                btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    Object.values(filterMenus).forEach(m => {
                        if (m && m !== menu) m.classList.remove('active');
                    });
                    menu.classList.toggle('active');
                });
            }
        });
        
        document.addEventListener('click', () => {
            Object.values(filterMenus).forEach(menu => {
                if (menu) menu.classList.remove('active');
            });
        });
        
        // Filtre seçimi
        document.querySelectorAll('.filter-item').forEach(item => {
            item.addEventListener('click', (e) => {
                e.preventDefault();
                const menu = item.closest('.filter-menu');
                const filterType = menu.id.replace('FilterDropdown', '');
                const value = item.getAttribute('data-value');
                
                menu.querySelectorAll('.filter-item').forEach(i => i.classList.remove('active'));
                item.classList.add('active');
                
                currentFilters[filterType] = value;
                
                const btn = filterButtons[filterType];
                if (btn) {
                    const span = btn.querySelector('span');
                    if (span) span.textContent = item.textContent.trim();
                }
                
                menu.classList.remove('active');
                currentPage = 1;
                applyFilters();
            });
        });
        
        // Filtreleri temizle
        const clearBtn = document.getElementById('clearFiltersBtn');
        if (clearBtn) {
            clearBtn.addEventListener('click', () => {
                currentFilters = { level: 'all', type: 'all', period: 'all', search: '' };
                currentPage = 1;
                
                const searchInput = document.getElementById('courseSearchInput');
                const searchClear = document.getElementById('searchClearBtn');
                if (searchInput) {
                    searchInput.value = '';
                    if (searchClear) searchClear.style.display = 'none';
                }
                
                document.querySelectorAll('.filter-item').forEach(item => {
                    item.classList.remove('active');
                    if (item.getAttribute('data-value') === 'all') item.classList.add('active');
                });
                
                Object.keys(filterButtons).forEach(key => {
                    const btn = filterButtons[key];
                    if (btn) {
                        const span = btn.querySelector('span');
                        if (span) {
                            if (key === 'level') span.textContent = 'Nivel de idioma';
                            else if (key === 'type') span.textContent = 'Tipo de curso';
                            else if (key === 'period') span.textContent = 'Período';
                        }
                    }
                });
                
                applyFilters();
            });
        }
        
        // Arama
        const searchInput = document.getElementById('courseSearchInput');
        const searchClear = document.getElementById('searchClearBtn');
        
        if (searchInput) {
            let timeout;
            searchInput.addEventListener('input', (e) => {
                clearTimeout(timeout);
                timeout = setTimeout(() => {
                    currentFilters.search = e.target.value.toLowerCase().trim();
                    currentPage = 1;
                    applyFilters();
                }, 300);
            });
            
            searchInput.addEventListener('keyup', () => {
                if (searchClear) {
                    searchClear.style.display = searchInput.value.length > 0 ? 'flex' : 'none';
                }
            });
        }
        
        if (searchClear) {
            searchClear.addEventListener('click', () => {
                if (searchInput) {
                    searchInput.value = '';
                    currentFilters.search = '';
                    searchClear.style.display = 'none';
                    currentPage = 1;
                    applyFilters();
                }
            });
        }
        
        // Filtreleme
        function applyFilters() {
            filteredCourses = courseCards.filter(card => {
                const level = card.getAttribute('data-level');
                const type = card.getAttribute('data-type');
                const period = card.getAttribute('data-period');
                const title = card.querySelector('.course-title')?.textContent.toLowerCase() || '';
                const description = card.querySelector('.course-description')?.textContent.toLowerCase() || '';
                
                const levelMatch = currentFilters.level === 'all' || level.includes(currentFilters.level);
                const typeMatch = currentFilters.type === 'all' || type === currentFilters.type;
                const periodMatch = currentFilters.period === 'all' || period === currentFilters.period;
                const searchMatch = !currentFilters.search || title.includes(currentFilters.search) || description.includes(currentFilters.search);
                
                return levelMatch && typeMatch && periodMatch && searchMatch;
            });
            
            courseCards.forEach(card => card.style.display = 'none');
            
            const activeCount = Object.values(currentFilters).filter(v => v !== 'all' && v !== '').length;
            if (clearBtn) clearBtn.style.display = activeCount > 0 ? 'flex' : 'none';
            
            updateResultsCount();
            updatePagination();
        }
        
        // Sonuç sayısı
        function updateResultsCount() {
            const resultsInfo = document.getElementById('resultsInfo');
            const resultsCount = document.getElementById('resultsCount');
            if (resultsInfo && resultsCount) {
                resultsCount.textContent = filteredCourses.length;
                if (filteredCourses.length === 0) {
                    resultsInfo.innerHTML = `<i class="fas fa-search"></i> No se encontraron resultados`;
                    resultsInfo.classList.add('no-results');
                } else {
                    resultsInfo.classList.remove('no-results');
                }
            }
        }
        
        // Sayfalama
        function updatePagination() {
            const totalPages = Math.ceil(filteredCourses.length / itemsPerPage);
            const startIndex = (currentPage - 1) * itemsPerPage;
            const endIndex = startIndex + itemsPerPage;
            const currentPageCourses = filteredCourses.slice(startIndex, endIndex);
            
            currentPageCourses.forEach(card => card.style.display = 'block');
            
            const paginationContainer = document.getElementById('paginationContainer');
            const prevBtn = document.getElementById('prevPageBtn');
            const nextBtn = document.getElementById('nextPageBtn');
            const pageNumbers = document.getElementById('paginationNumbers');
            const currentPageNum = document.getElementById('currentPageNum');
            const totalPagesNum = document.getElementById('totalPagesNum');
            
            if (totalPages > 1) {
                if (paginationContainer) paginationContainer.style.display = 'flex';
                if (currentPageNum) currentPageNum.textContent = currentPage;
                if (totalPagesNum) totalPagesNum.textContent = totalPages;
                if (prevBtn) prevBtn.disabled = currentPage === 1;
                if (nextBtn) nextBtn.disabled = currentPage === totalPages;
                
                if (pageNumbers) {
                    pageNumbers.innerHTML = '';
                    const maxVisible = 5;
                    let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
                    let endPage = Math.min(totalPages, startPage + maxVisible - 1);
                    
                    if (endPage - startPage < maxVisible - 1) {
                        startPage = Math.max(1, endPage - maxVisible + 1);
                    }
                    
                    if (startPage > 1) {
                        const btn = document.createElement('button');
                        btn.className = 'page-num';
                        btn.textContent = '1';
                        btn.onclick = () => goToPage(1);
                        pageNumbers.appendChild(btn);
                        if (startPage > 2) {
                            const ellipsis = document.createElement('span');
                            ellipsis.className = 'page-ellipsis';
                            ellipsis.textContent = '...';
                            pageNumbers.appendChild(ellipsis);
                        }
                    }
                    
                    for (let i = startPage; i <= endPage; i++) {
                        const btn = document.createElement('button');
                        btn.className = 'page-num' + (i === currentPage ? ' active' : '');
                        btn.textContent = i;
                        btn.onclick = () => goToPage(i);
                        pageNumbers.appendChild(btn);
                    }
                    
                    if (endPage < totalPages) {
                        if (endPage < totalPages - 1) {
                            const ellipsis = document.createElement('span');
                            ellipsis.className = 'page-ellipsis';
                            ellipsis.textContent = '...';
                            pageNumbers.appendChild(ellipsis);
                        }
                        const btn = document.createElement('button');
                        btn.className = 'page-num';
                        btn.textContent = totalPages;
                        btn.onclick = () => goToPage(totalPages);
                        pageNumbers.appendChild(btn);
                    }
                }
            } else {
                if (paginationContainer) paginationContainer.style.display = 'none';
            }
        }
        
        function goToPage(page) {
            currentPage = page;
            applyFilters();
        }
        
        const prevPageBtn = document.getElementById('prevPageBtn');
        const nextPageBtn = document.getElementById('nextPageBtn');
        
        if (prevPageBtn) {
            prevPageBtn.addEventListener('click', () => {
                if (currentPage > 1) goToPage(currentPage - 1);
            });
        }
        
        if (nextPageBtn) {
            nextPageBtn.addEventListener('click', () => {
                const totalPages = Math.ceil(filteredCourses.length / itemsPerPage);
                if (currentPage < totalPages) goToPage(currentPage + 1);
            });
        }
        
        // İlk yükleme
        document.querySelectorAll('.filter-item[data-value="all"]').forEach(item => {
            item.classList.add('active');
        });
        applyFilters();
    })();
</script>

