---
import MainLayout from '../../layouts/MainLayout.astro';
import '../../styles/pages/ueber-uns.css';
import { getContactPath, getSectionPath, isValidLang } from '../../utils/pathHelpers';

export async function getStaticPaths() {
    return [
        { params: { lang: 'tr' } },
    ];
}

const { lang } = Astro.params;

// Lang tip kontrolü
if (!isValidLang(lang)) {
    throw new Error(`Invalid language: ${lang}`);
}

// Path helper'ları
const contactPath = getContactPath(lang);
const coursesPath = getSectionPath(lang);
---

<MainLayout title="Hakkımızda - CampusGerman" lang={lang}>
    <!-- Mission Section -->
    <section class="mission-section">
        <div class="container">
            <div class="mission-content">
                <div class="mission-text">
                    <h2 class="section-title">Misyonumuz</h2>
                    <p class="mission-description">
                        CampusGerman olarak öğrencilerimizin karar verirken en çok önem verdiği noktaları merkeze alıyoruz: 
                        ücretleri 2 taksit ile ödeme kolaylığı, hızlandırılmış yoğun eğitim modeli, merkezi konum ve teknolojik sınıf altyapısı.
                        Bizim için başarı, öğrencinin hem akademik olarak hızlı ilerlemesi hem de günlük yaşamda zorlanmadan kursa ulaşabilmesidir.
                    </p>
                    <p class="mission-description">
                        Bremen HBF ve şehir merkezine çok yakın konumumuzla ders-ulaşım dengesini kolaylaştırıyoruz. 
                        Akıllı tahta destekli sınıflarımızda daha görsel, daha etkileşimli ve daha verimli bir öğrenme deneyimi sunuyoruz.
                        Kısacası, sadece Almanca öğretmiyor; süreci öğrenci için pratik, erişilebilir ve sürdürülebilir hale getiriyoruz.
                    </p>
                    <div class="mission-features">
                        <div class="feature-item">
                            <i class="fas fa-graduation-cap"></i>
                            <div>
                                <h4>2 Taksit ile Ödeme Kolaylığı</h4>
                                <p>Öğrencilerimizin bütçe planlamasını rahatlatmak için ödemeleri 2 taksit olarak yapılandırıyoruz.
                                Böylece eğitim sürecine daha rahat başlayıp devam edebiliyorsunuz.</p>
                            </div>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-users"></i>
                            <div>
                                <h4>Hızlandırılmış Yoğun Eğitim</h4>
                                <p>Standart kurslara göre daha yüksek tempolu ve hedef odaklı bir program uyguluyoruz.
                                Bu sayede öğrencilerimiz daha kısa sürede seviye atlayarak sınav ve akademik hedeflerine yaklaşabiliyor.</p>
                            </div>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-certificate"></i>
                            <div>
                                <h4>Merkezi Konum ve Akıllı Tahta Sınıflar</h4>
                                <p>Bremen HBF ve şehir merkezine yakın konumumuzla ulaşımı kolaylaştırıyor, akıllı tahta altyapısıyla ders verimini artırıyoruz.
                                Teknoloji destekli sınıflarda konular daha anlaşılır ve kalıcı hale geliyor.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mission-image">
                    <img src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=1200&q=80" alt="Öğrencilerin birlikte çalıştığı sınıf ortamı" class="mission-photo">
                </div>
            </div>
        </div>
    </section>

    <!-- Team Section -->
    <section class="team-section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Ekibimiz</h2>
                <p class="section-subtitle">
                    Deneyimli ve uzman eğitmenlerimizle Almanca öğrenme yolculuğunuzda yanınızdayız. 
                    Her biri kendi alanında uzmanlaşmış, öğrenci odaklı yaklaşımlarıyla fark yaratan profesyonellerden oluşan ekibimiz, 
                    sadece dil öğretmekle kalmıyor, aynı zamanda Almanya'da eğitim ve kariyer hedeflerinize ulaşmanız için rehberlik ediyor.
                </p>
            </div>
            <div class="team-grid">
                <div class="team-card">
                    <div class="team-avatar">
                        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=300&q=80" alt="Eğitim Koordinatörü" class="team-photo">
                    </div>
                    <h3 class="team-name">Eğitim Koordinatörleri</h3>
                    <p class="team-role">Kurs Programları</p>
                    <p class="team-description">
                        Kurs programlarımızı tasarlayan ve sürekli geliştiren uzman ekibimiz, her seviyeye uygun, etkili öğrenme deneyimi sunuyor. 
                        Modern eğitim metodlarını geleneksel yaklaşımlarla harmanlayarak, öğrencilerimizin hedeflerine en kısa sürede ulaşmalarını sağlıyoruz. 
                        Her program, öğrenci geri bildirimleri ve akademik araştırmalar doğrultusunda sürekli güncellenmektedir.
                    </p>
                    <div class="team-skills">
                        <span class="skill-tag">Program Geliştirme</span>
                        <span class="skill-tag">Eğitim Teknolojileri</span>
                        <span class="skill-tag">Kalite Kontrol</span>
                    </div>
                </div>
                <div class="team-card">
                    <div class="team-avatar">
                        <img src="https://images.unsplash.com/photo-1494790108755-2616b612b786?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=300&q=80" alt="Almanca Eğitmeni" class="team-photo">
                    </div>
                    <h3 class="team-name">Almanca Eğitmenleri</h3>
                    <p class="team-role">Dil Eğitimi</p>
                    <p class="team-description">
                        Ana dili Almanca olan ve Türkçe bilen deneyimli eğitmenlerimiz, hem gramer hem de konuşma becerilerinizi geliştiriyor. 
                        Her eğitmenimiz, Almanca öğretmenliği konusunda akademik eğitim almış ve yıllarca deneyim sahibi profesyonellerdir. 
                        Öğrencilerimizin kültürel farklılıkları anlayarak, hem dil hem de kültürel entegrasyon konusunda destek sağlıyoruz.
                    </p>
                    <div class="team-skills">
                        <span class="skill-tag">A1-C2 Seviyeleri</span>
                        <span class="skill-tag">Konuşma Pratiği</span>
                        <span class="skill-tag">Sınav Hazırlık</span>
                    </div>
                </div>
                <div class="team-card">
                    <div class="team-avatar">
                        <img src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=300&q=80" alt="Öğrenci Danışmanı" class="team-photo">
                    </div>
                    <h3 class="team-name">Öğrenci Danışmanları</h3>
                    <p class="team-role">Destek Hizmetleri</p>
                    <p class="team-description">
                        Kurs sürecinizde karşılaştığınız her türlü sorunda yanınızda olan danışman ekibimiz, başarılı olmanız için sürekli destek sağlıyor. 
                        Kişisel öğrenme planları hazırlayarak, motivasyonunuzu yüksek tutuyor ve hedeflerinize odaklanmanızı sağlıyoruz. 
                        Almanya'da eğitim ve kariyer fırsatları konusunda da rehberlik hizmeti sunuyoruz.
                    </p>
                    <div class="team-skills">
                        <span class="skill-tag">Kişisel Danışmanlık</span>
                        <span class="skill-tag">İlerleme Takibi</span>
                        <span class="skill-tag">Motivasyon</span>
                    </div>
                </div>
                <div class="team-card">
                    <div class="team-avatar">
                        <img src="https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=300&q=80" alt="Teknoloji Uzmanı" class="team-photo">
                    </div>
                    <h3 class="team-name">Teknoloji Ekibi</h3>
                    <p class="team-role">Online Platform</p>
                    <p class="team-description">
                        Online eğitim platformumuzu geliştiren ve sürekli iyileştiren teknoloji ekibimiz, modern araçlarla öğrenme deneyiminizi zenginleştiriyor. 
                        Yapay zeka destekli öğrenme araçları, interaktif ders materyalleri ve kişiselleştirilmiş öğrenme yolları ile 
                        teknolojinin gücünü eğitimle buluşturuyoruz.
                    </p>
                    <div class="team-skills">
                        <span class="skill-tag">Platform Geliştirme</span>
                        <span class="skill-tag">Teknik Destek</span>
                        <span class="skill-tag">İnovasyon</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Timeline Section -->
    <section class="timeline-section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Yolculuğumuz</h2>
                <p class="section-subtitle">
                    CampusGerman 'ın kuruluşundan bugüne kadar geçen süreç, sürekli gelişim ve öğrenci odaklı yaklaşımımızın hikayesidir. 
                    Her yıl, binlerce öğrencinin hayatına dokunarak, onların Almanya'da eğitim ve kariyer hedeflerine ulaşmalarına yardımcı oluyoruz.
                </p>
            </div>
            <div class="timeline">
                <div class="timeline-item">
                    <div class="timeline-marker">
                        <i class="fas fa-rocket"></i>
                    </div>
                    <div class="timeline-content">
                        <h3 class="timeline-title">2020 - Kuruluş</h3>
                        <p class="timeline-description">
                            CampusGerman , Almanca eğitiminde kalite ve güvenilirlik odaklı yaklaşımıyla kuruldu. 
                            İlk öğrencilerimizle birlikte başarı hikayelerimizi yazmaya başladık. Kuruluş amacımız, 
                            Türk öğrencilerin Almanya'da eğitim ve kariyer fırsatlarını değerlendirebilmesi için 
                            gerekli dil becerilerini kazandırmaktı.
                        </p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="timeline-content">
                        <h3 class="timeline-title">2021 - Ekip Genişlemesi</h3>
                        <p class="timeline-description">
                            Deneyimli eğitmenlerimizi ekibimize kattık. Farklı seviyelerde uzmanlaşmış öğretmenlerimizle 
                            daha kapsamlı eğitim programları sunmaya başladık. Bu yıl, öğrenci sayımızın hızla artmasıyla 
                            birlikte, daha kişiselleştirilmiş eğitim yaklaşımları geliştirdik.
                        </p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker">
                        <i class="fas fa-laptop"></i>
                    </div>
                    <div class="timeline-content">
                        <h3 class="timeline-title">2022 - Online Platform</h3>
                        <p class="timeline-description">
                            Modern online eğitim platformumuzu hayata geçirdik. Artık öğrencilerimiz hem yüz yüze hem de online olarak 
                            eğitim alabiliyorlar. Pandemi sürecinde geliştirdiğimiz bu platform, öğrencilerimizin evden de etkili şekilde 
                            Almanca öğrenebilmesini sağladı. Interaktif ders materyalleri ve sanal sınıf ortamları ile eğitim kalitemizi artırdık.
                        </p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker">
                        <i class="fas fa-trophy"></i>
                    </div>
                    <div class="timeline-content">
                        <h3 class="timeline-title">2023 - Başarılar</h3>
                        <p class="timeline-description">
                            Öğrencilerimizin %95'i hedefledikleri seviyeye ulaştı. TestDaF, Goethe ve diğer uluslararası sınavlarda 
                            yüksek başarı oranları elde ettik. Bu yıl, Almanya'da üniversite kabulü alan öğrenci sayımızda önemli artışlar kaydettik. 
                            Başarı hikayelerimiz, yeni öğrencilerimiz için ilham kaynağı oldu.
                        </p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker">
                        <i class="fas fa-star"></i>
                    </div>
                    <div class="timeline-content">
                        <h3 class="timeline-title">2024 - Sürekli Gelişim</h3>
                        <p class="timeline-description">
                            Eğitim metodlarımızı sürekli geliştiriyoruz. Yapay zeka destekli öğrenme araçları ve kişiselleştirilmiş 
                            eğitim programları ile öncü olmaya devam ediyoruz. Bu yıl, öğrenci memnuniyet oranımızı %98'e çıkardık ve 
                            Almanya'daki partner üniversitelerimizle işbirliğimizi güçlendirdik.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="stats-section">
        <div class="container">
            <div class="stats-grid">
                <div class="stat-item">
                    <div class="stat-icon">
                        <i class="fas fa-graduation-cap"></i>
                    </div>
                    <div class="stat-number">500+</div>
                    <div class="stat-label">Mezun Öğrenci</div>
                </div>
                <div class="stat-item">
                    <div class="stat-icon">
                        <i class="fas fa-chalkboard-teacher"></i>
                    </div>
                    <div class="stat-number">15+</div>
                    <div class="stat-label">Uzman Eğitmen</div>
                </div>
                <div class="stat-item">
                    <div class="stat-icon">
                        <i class="fas fa-certificate"></i>
                    </div>
                    <div class="stat-number">95%</div>
                    <div class="stat-label">Başarı Oranı</div>
                </div>
                <div class="stat-item">
                    <div class="stat-icon">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="stat-number">4</div>
                    <div class="stat-label">Yıllık Deneyim</div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
        <div class="container">
            <div class="cta-content">
                <h2 class="cta-title">Almanca Öğrenme Yolculuğunuza Başlayın</h2>
                <p class="cta-description">
                    Uzman ekibimizle birlikte dil hedeflerinize ulaşın. Ücretsiz seviye tespit sınavımıza katılın ve size özel programımızı keşfedin. 
                    Almanya'da eğitim ve kariyer fırsatlarınızı değerlendirmek için gerekli dil becerilerini kazanın. 
                    Her seviyeden öğrenci için uygun kurs programlarımızla, başarıya giden yolda yanınızdayız.
                </p>
                <div class="cta-buttons">
                    <a href={`/${lang}/${contactPath}`} class="cta-btn primary">
                        <i class="fas fa-phone"></i>
                        <span>Ücretsiz Danışmanlık</span>
                    </a>
                    <a href={`/${lang}/${coursesPath}`} class="cta-btn secondary">
                        <i class="fas fa-book-open"></i>
                        <span>Kurslarımızı İncele</span>
                    </a>
                </div>
            </div>
        </div>
    </section>
</MainLayout>

