---
import MainLayout from '../../layouts/MainLayout.astro';
import '../../styles/pages/fiyatlar-tarihler.css';
import { coursePricing } from '../../data/coursePricing';
import { isValidLang } from '../../utils/pathHelpers';

export async function getStaticPaths() {
    return [
        { params: { lang: 'tr' } },
        { params: { lang: 'de' } },
        { params: { lang: 'en' } },
        { params: { lang: 'es' } },
    ];
}

const { lang } = Astro.params;
if (!isValidLang(lang)) {
    throw new Error(`Invalid language: ${lang}`);
}

const pricingLang = lang === 'es' ? 'de' : lang;
const data = coursePricing[pricingLang as keyof typeof coursePricing];

const t = {
    tr: {
        title: 'Fiyatlar ve Tarihler',
        subtitle: 'Kurs fiyatları ve başlangıç tarihleri 2026. 1 ders = 45 dakika.',
        intensive: 'Yoğun Almanca Kursları (Yüz Yüze)',
        online: 'Online Almanca Kursları',
        weekly: 'Haftalık Kurs Fiyatları',
        weeklyNote: 'Hafta sayısına göre haftalık ücret. A1-A2 ve B1-C1 farklı fiyatlandırılır.',
        examPrep: 'Sınav Hazırlık Kursları',
        goetheTelc: 'Goethe / TELC Seviye Kursları',
        testdafDsh: 'TestDaF / DSH Hazırlık',
        schedule: 'Kurs Saatleri',
        scheduleNote: 'Pazartesi–Cuma. Sabah ve öğleden sonra grupları.',
        morning: 'Sabah',
        afternoon: 'Öğleden Sonra',
        startDates: 'Kurs Başlangıç Tarihleri 2026',
        mainStart: 'Ana başlangıç (A1.1, A2.1, B1.1, B2.1, C1.1)',
        midStart: 'Ara başlangıç (A1.2, A2.2, B1.2, B2.2, C1.2)',
        holidays: 'Tatil Günleri 2026',
        visaInfo: 'Vize bilgisi',
        lessonInfo: 'Ders bilgisi',
        bookCta: 'Kursa Kayıt Ol',
        level: 'Seviye',
        price: 'Fiyat',
        lessons: 'Ders',
        duration: 'Süre',
        weekly: 'Haftalık',
        weeks: 'Hafta',
        startNote: '(Tüm seviyeler A1–C1 aynı tarih setlerinde başlar.)',
    },
    de: {
        title: 'Preise & Termine',
        subtitle: 'Kursgebühren und Starttermine 2026. 1 Unterrichtsstunde = 45 Minuten.',
        intensive: 'Intensiv-Deutschkurse (Präsenz)',
        online: 'Online-Deutschkurse',
        weekly: 'Wöchentliche Kursgebühren',
        weeklyNote: 'Wochenpreis je nach Anzahl der Wochen. A1-A2 und B1-C1 unterschiedlich.',
        examPrep: 'Prüfungsvorbereitungskurse',
        goetheTelc: 'Goethe-/TELC-Niveaukurse',
        testdafDsh: 'TestDaF-/DSH-Vorbereitung',
        schedule: 'Kurszeiten',
        scheduleNote: 'Montag–Freitag. Vormittags- und Nachmittagsgruppen.',
        morning: 'Vormittag',
        afternoon: 'Nachmittag',
        startDates: 'Kursstarttermine 2026',
        mainStart: 'Hauptstart (A1.1, A2.1, B1.1, B2.1, C1.1)',
        midStart: 'Zwischenstart (A1.2, A2.2, B1.2, B2.2, C1.2)',
        holidays: 'Feiertage 2026',
        visaInfo: 'Visumshinweis',
        lessonInfo: 'Unterrichtsinfo',
        bookCta: 'Kurs buchen',
        level: 'Niveau',
        price: 'Preis',
        lessons: 'Unterricht',
        duration: 'Dauer',
        weekly: 'Wöchentlich',
        weeks: 'Wochen',
        startNote: '(Alle Niveaus A1–C1 starten zu denselben Terminblöcken.)',
    },
    en: {
        title: 'Prices & Dates',
        subtitle: 'Course fees and start dates 2026. 1 lesson = 45 minutes.',
        intensive: 'Intensive German Courses (On-site)',
        online: 'Online German Courses',
        weekly: 'Weekly Course Fees',
        weeklyNote: 'Weekly rate depending on number of weeks. A1-A2 and B1-C1 priced differently.',
        examPrep: 'Exam Preparation Courses',
        goetheTelc: 'Goethe / TELC Level Courses',
        testdafDsh: 'TestDaF / DSH Preparation',
        schedule: 'Course Schedule',
        scheduleNote: 'Monday–Friday. Morning and afternoon groups.',
        morning: 'Morning',
        afternoon: 'Afternoon',
        startDates: 'Course Start Dates 2026',
        mainStart: 'Main start (A1.1, A2.1, B1.1, B2.1, C1.1)',
        midStart: 'Mid-level start (A1.2, A2.2, B1.2, B2.2, C1.2)',
        holidays: 'Holidays 2026',
        visaInfo: 'Visa information',
        lessonInfo: 'Lesson information',
        bookCta: 'Book Course',
        level: 'Level',
        price: 'Price',
        lessons: 'Lessons',
        duration: 'Duration',
        weekly: 'Weekly',
        weeks: 'Weeks',
        startNote: '(All levels A1–C1 start on the same date sets.)',
    },
    es: {
        title: 'Precios y Fechas',
        subtitle: 'Tarifas de cursos y fechas de inicio 2026. 1 lección = 45 minutos.',
        intensive: 'Cursos Intensivos de Alemán (Presencial)',
        online: 'Cursos de Alemán Online',
        weekly: 'Tarifas Semanales',
        weeklyNote: 'Precio semanal según número de semanas. A1-A2 y B1-C1 con precios distintos.',
        examPrep: 'Cursos de Preparación de Exámenes',
        goetheTelc: 'Cursos Goethe / TELC por Nivel',
        testdafDsh: 'Preparación TestDaF / DSH',
        schedule: 'Horarios de Cursos',
        scheduleNote: 'Lunes–Viernes. Grupos de mañana y tarde.',
        morning: 'Mañana',
        afternoon: 'Tarde',
        startDates: 'Fechas de Inicio 2026',
        mainStart: 'Inicio principal (A1.1, A2.1, B1.1, B2.1, C1.1)',
        midStart: 'Inicio intermedio (A1.2, A2.2, B1.2, B2.2, C1.2)',
        holidays: 'Días Festivos 2026',
        visaInfo: 'Información de visado',
        lessonInfo: 'Información de lección',
        bookCta: 'Reservar Curso',
        level: 'Nivel',
        price: 'Precio',
        lessons: 'Lecciones',
        duration: 'Duración',
        weekly: 'Semanal',
        weeks: 'Semanas',
        startNote: '(Todos los niveles A1–C1 comienzan en los mismos bloques de fechas.)',
    },
}[lang];

const levels = ['a1', 'a2', 'b1', 'b2', 'c1'] as const;
const levelLabels = { a1: 'A1', a2: 'A2', b1: 'B1', b2: 'B2', c1: 'C1' };
const bookingSlug = lang === 'tr' || lang === 'de' ? 'buchung' : lang === 'en' ? 'booking' : 'reservar';
---

<MainLayout title={`${t.title} - CampusGerman`} lang={lang}>
    <section class="fiyatlar-hero">
        <div class="container">
            <h1 class="page-title">{t.title}</h1>
            <p class="page-subtitle">{t.subtitle} {data.lessonInfo}</p>
        </div>
    </section>

    <!-- Yoğun Kurslar -->
    <section class="fiyatlar-section">
        <div class="container">
            <h2 class="fiyatlar-section-title">{t.intensive}</h2>
            <div class="fiyatlar-table-wrap">
                <table class="fiyatlar-table">
                    <thead>
                        <tr>
                            <th>{t.level}</th>
                            <th>{t.price}</th>
                            <th>{t.lessons}</th>
                            <th>{t.duration}</th>
                            <th>{t.weekly}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {levels.map((level) => {
                            const row = data.intensive[level];
                            return (
                                <tr>
                                    <td><strong>{levelLabels[level]}</strong></td>
                                    <td class="price-cell">{row.fullCourse}</td>
                                    <td>{row.lessons}</td>
                                    <td>{row.duration}</td>
                                    <td>{row.weeklyLessons}</td>
                                </tr>
                            );
                        })}
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- Online Kurslar -->
    <section class="fiyatlar-section">
        <div class="container">
            <h2 class="fiyatlar-section-title">{t.online}</h2>
            <div class="fiyatlar-table-wrap">
                <table class="fiyatlar-table">
                    <thead>
                        <tr>
                            <th>{t.level}</th>
                            <th>{t.price}</th>
                            <th>{t.lessons}</th>
                            <th>{t.duration}</th>
                            <th>{t.weekly}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {levels.map((level) => {
                            const row = data.online[level];
                            return (
                                <tr>
                                    <td><strong>{levelLabels[level]}</strong></td>
                                    <td class="price-cell">{row.fullCourse}</td>
                                    <td>{row.lessons}</td>
                                    <td>{row.duration}</td>
                                    <td>{row.weeklyLessons}</td>
                                </tr>
                            );
                        })}
                    </tbody>
                </table>
            </div>
            <p class="fiyatlar-note">{data.onlineNote}</p>
        </div>
    </section>

    <!-- Haftalık Fiyatlar -->
    <section class="fiyatlar-section">
        <div class="container">
            <h2 class="fiyatlar-section-title">{t.weekly}</h2>
            <p class="fiyatlar-note">{t.weeklyNote}</p>
            <div class="fiyatlar-table-wrap">
                <table class="fiyatlar-table">
                    <thead>
                        <tr>
                            <th>{t.weeks}</th>
                            <th>A1–A2 ({t.weekly})</th>
                            <th>B1–C1 ({t.weekly})</th>
                        </tr>
                    </thead>
                    <tbody>
                        {['2', '4', '8', '16'].map((weeks) => (
                            <tr>
                                <td><strong>{weeks} {lang === 'tr' ? 'hafta' : lang === 'de' ? 'Wochen' : lang === 'en' ? 'weeks' : 'semanas'}</strong></td>
                                <td class="price-cell">{data.weeklyPricing.a1a2[weeks]}</td>
                                <td class="price-cell">{data.weeklyPricing.b1b2c1[weeks]}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- Sınav Hazırlık -->
    <section class="fiyatlar-section">
        <div class="container">
            <h2 class="fiyatlar-section-title">{t.examPrep}</h2>
            <h3 style="font-size: 1.1rem; margin-bottom: 12px;">{t.goetheTelc}</h3>
            <div class="fiyatlar-table-wrap">
                <table class="fiyatlar-table">
                    <thead>
                        <tr>
                            <th>{t.level}</th>
                            <th>{t.price}</th>
                            <th>{t.lessons}</th>
                            <th>{t.duration}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {levels.map((level) => {
                            const row = data.examPrep.goetheTelc[level];
                            return (
                                <tr>
                                    <td><strong>{levelLabels[level]}</strong></td>
                                    <td class="price-cell">{row.fullCourse}</td>
                                    <td>{row.lessons}</td>
                                    <td>{row.duration}</td>
                                </tr>
                            );
                        })}
                    </tbody>
                </table>
            </div>
            <h3 style="font-size: 1.1rem; margin: 24px 0 12px;">{t.testdafDsh}</h3>
            <div class="fiyatlar-table-wrap">
                <table class="fiyatlar-table">
                    <thead>
                        <tr>
                            <th>{t.price}</th>
                            <th>{t.lessons}</th>
                            <th>{t.duration}</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="price-cell">{data.examPrep.testdafDsh.fullCourse}</td>
                            <td>{data.examPrep.testdafDsh.lessons}</td>
                            <td>{data.examPrep.testdafDsh.duration}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- Kurs Saatleri -->
    <section class="fiyatlar-section">
        <div class="container">
            <h2 class="fiyatlar-section-title">{t.schedule}</h2>
            <p class="fiyatlar-note">{t.scheduleNote} {data.schedule.days}</p>
            <div class="fiyatlar-schedule-card">
                <h4>{t.morning} – A1/A2</h4>
                <p><strong>{data.schedule.morning.a1a2.time}</strong></p>
                <p>{data.schedule.morning.a1a2.lessons}</p>
                <p>{data.schedule.morning.a1a2.break}</p>
            </div>
            <div class="fiyatlar-schedule-card">
                <h4>{t.morning} – B1/C1</h4>
                <p><strong>{data.schedule.morning.b1c1.time}</strong></p>
                <p>{data.schedule.morning.b1c1.lessons}</p>
                <p>{data.schedule.morning.b1c1.break}</p>
            </div>
            <div class="fiyatlar-schedule-card">
                <h4>{t.afternoon} – A1/A2</h4>
                <p><strong>{data.schedule.afternoon.a1a2.time}</strong></p>
                <p>{data.schedule.afternoon.a1a2.lessons}</p>
                <p>{data.schedule.afternoon.a1a2.break}</p>
            </div>
            <div class="fiyatlar-schedule-card">
                <h4>{t.afternoon} – B1/C1</h4>
                <p><strong>{data.schedule.afternoon.b1c1.time}</strong></p>
                <p>{data.schedule.afternoon.b1c1.lessons}</p>
                <p>{data.schedule.afternoon.b1c1.break}</p>
            </div>
        </div>
    </section>

    <!-- Başlangıç Tarihleri -->
    <section class="fiyatlar-section">
        <div class="container">
            <h2 class="fiyatlar-section-title">{t.startDates}</h2>
            <p><strong>{t.mainStart}</strong>: {Object.values(data.startDates.a1)[0].map((d: string) => d + '.2026').join(', ')}</p>
            <p><strong>{t.midStart}</strong>: {Object.values(data.startDates.a1)[1].map((d: string) => d + '.2026').join(', ')}</p>
            <p class="fiyatlar-note">{t.startNote}</p>
        </div>
    </section>

    <!-- Tatiller -->
    <section class="fiyatlar-section">
        <div class="container">
            <h2 class="fiyatlar-section-title">{t.holidays}</h2>
            <ul class="fiyatlar-holidays-list">
                {data.holidays.map((h: { name: string; date: string }) => (
                    <li>
                        <span>{h.name}</span>
                        <span>{h.date}</span>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <!-- Vize Bilgisi -->
    <section class="fiyatlar-section">
        <div class="container">
            <h2 class="fiyatlar-section-title">{t.visaInfo}</h2>
            <div class="fiyatlar-info-box">
                {data.visaInfo}
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="fiyatlar-cta">
        <div class="container">
            <a href={`/${lang}/${bookingSlug}`} class="btn-buchung">
                <i class="fas fa-calendar-check"></i>
                {t.bookCta}
            </a>
        </div>
    </section>
</MainLayout>
