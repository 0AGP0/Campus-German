const t = copy[lang as keyof typeof copy] ?? copy.tr;

const presetIsos = startDateOptions.map((opt) => {
  const [d, m] = opt.value.split('.').map(Number);
  const iso = d && m ? `2026-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}` : '';
  return { iso, value: opt.value, label: opt.label };
}).filter((p) => p.iso);
---

<div class="form-step booking-lesson-time-step" data-step="2">
  <div class="booking-qx-wrap">
    <section class="qx-stage-shell qx-stage-shell--step3">
      <header class="qx-scene-head qx-scene-head--step3">
        <span class="qx-scene-kicker">1</span>
        <div class="qx-scene-head__copy">
          <h3 class="qx-question">{t.step3Title}</h3>
          <p class="qx-question-note" id="booking-lesson-time-subtitle">{t.step3Subtitle}</p>
        </div>
      </header>
      <input type="hidden" name="timezone-slot" id="booking-timezone-slot" value="" />
      <div class="qx-time-slots" id="booking-time-slots" role="group" aria-label={t.step3Title}>
        <button type="button" class="qx-time-slot qx-time-slot--morning" data-period="morning" data-timezone-value="morning" aria-pressed="false">
          <div class="qx-time-slot__period" aria-hidden="true">
            <span class="qx-time-slot__icon"><i class="fas fa-cloud-sun"></i></span>
            <div class="qx-time-slot__period-copy">
              <span class="qx-time-slot__period-label">{t.slotMorningTitle}</span>
              <span class="qx-time-slot__period-clock">{morningTime}</span>
            </div>
          </div>
          <div class="qx-time-slot__main">
            <div class="qx-time-slot__foot">
              <span class="qx-time-slot__meta"><strong>{t.hoursPerWeek}</strong> · {t.weekdaysShort}</span>
            </div>
          </div>
        </button>
        <button type="button" class="qx-time-slot qx-time-slot--afternoon" data-period="afternoon" data-timezone-value="afternoon" aria-pressed="false">
          <div class="qx-time-slot__period" aria-hidden="true">
            <span class="qx-time-slot__icon"><i class="fas fa-sun"></i></span>
            <div class="qx-time-slot__period-copy">
              <span class="qx-time-slot__period-label">{t.slotAfternoonTitle}</span>
              <span class="qx-time-slot__period-clock">{afternoonTime}</span>
            </div>
          </div>
          <div class="qx-time-slot__main">
            <div class="qx-time-slot__foot">
              <span class="qx-time-slot__meta"><strong>{t.hoursPerWeek}</strong> · {t.weekdaysShort}</span>
            </div>
          </div>
        </button>
        <button type="button" class="qx-time-slot qx-time-slot--evening" data-period="evening" data-timezone-value="evening" aria-pressed="false">
          <div class="qx-time-slot__period" aria-hidden="true">
            <span class="qx-time-slot__icon"><i class="fas fa-moon"></i></span>
            <div class="qx-time-slot__period-copy">
              <span class="qx-time-slot__period-label">{t.slotEveningTitle}</span>
              <span class="qx-time-slot__period-clock">{eveningTime}</span>
            </div>
          </div>
          <div class="qx-time-slot__main">
            <div class="qx-time-slot__foot">
              <span class="qx-time-slot__meta"><strong>{t.hoursPerWeekOnline}</strong> · {t.weekdaysShortOnline}</span>
            </div>
          </div>
        </button>
      </div>
      <input type="checkbox" name="timezone" value="morning" id="booking-tz-morning" class="booking-tz-hidden" hidden />
      <input type="checkbox" name="timezone" value="afternoon" id="booking-tz-afternoon" class="booking-tz-hidden" hidden />
      <input type="checkbox" name="timezone" value="evening" id="booking-tz-evening" class="booking-tz-hidden" hidden />
    </section>

    <section class="qx-stage-shell qx-stage-shell--step4">
      <header class="qx-scene-head qx-scene-head--step4">
        <span class="qx-scene-kicker">2</span>
        <div class="qx-scene-head__copy">
          <h3 class="qx-question">{t.step4Title}</h3>
          <p class="qx-question-note">{t.step4Subtitle}</p>
        </div>
      </header>
      <input type="hidden" id="start-date" name="start-date" value="" />
      <input type="hidden" id="booking-start-date-mode" name="start-date-mode" value="" />
      <div class="qx-step4-grid">
        <article class="qx-step4-card qx-step4-card--presets">
          <div class="qx-step4-card__head">
            <span class="qx-step4-card__icon qx-step4-card__icon--cal" aria-hidden="true"><i class="far fa-calendar-alt"></i></span>
            <h4 class="qx-step4-card__title">{t.step4PresetTitle}</h4>
          </div>
          <div class="qx-step4-presets" id="booking-step4-presets" role="radiogroup" aria-label={t.step4PresetTitle}>
            {presetIsos.map((p) => (
              <label class="qx-step4-preset-row">
                <input type="radio" name="booking-start-preset" value={p.iso} data-display-value={p.value} data-display-label={p.label} class="qx-step4-preset-radio" />
                <span class="qx-step4-preset-visual" aria-hidden="true"><i class="far fa-calendar-alt"></i></span>
                <span class="qx-step4-preset-text">
                  <strong class="qx-step4-preset-long">{p.label}</strong>
                </span>
              </label>
            ))}
          </div>
        </article>
        <article class="qx-step4-card qx-step4-card--custom" data-booking-step4-custom-card>
          <div class="qx-step4-card__head">
            <span class="qx-step4-card__icon qx-step4-card__icon--clock" aria-hidden="true"><i class="far fa-calendar-alt"></i></span>
            <h4 class="qx-step4-card__title">{t.step4CustomTitle}</h4>
          </div>
          <div class="qx-step4-custom-intro" data-booking-step4-custom-intro>
            <ul class="qx-step4-custom-list">
              <li><i class="fas fa-check" aria-hidden="true"></i> {t.step4CustomF1}</li>
              <li><i class="fas fa-check" aria-hidden="true"></i> {t.step4CustomF2}</li>
              <li><i class="fas fa-check" aria-hidden="true"></i> {t.step4CustomF3}</li>
            </ul>
            <button type="button" class="qx-step4-custom-cta" data-booking-step4-custom>
              {t.step4CustomCta} <i class="fas fa-arrow-right" aria-hidden="true"></i>
            </button>
          </div>
          <div class="qx-step4-custom-picker-panel" id="booking-step4-custom-picker" role="group" aria-label={t.step4PickDateLabel} hidden>
            <div class="qx-step4-cal-surface">
              <header class="qx-step4-cal-header">
                <span class="qx-step4-picker-lead" id="booking-custom-date-lead">{t.step4PickDateLabel}</span>
                <p class="qx-step4-inline-cal-summary" aria-live="polite">
                  <span data-booking-calendar-trigger-label>{t.step4CalendarTrigger}</span>
                </p>
              </header>
              <input type="hidden" id="booking-custom-date-input" />
              <div class="qx-inline-cal" data-booking-inline-cal aria-labelledby="booking-custom-date-lead">
                <div class="qx-inline-cal__nav">
                  <button type="button" class="qx-inline-cal__nav-btn" data-booking-cal-prev aria-label={t.step4CalPrevMonth}>
                    <i class="fas fa-chevron-left" aria-hidden="true"></i>
                  </button>
                  <span class="qx-inline-cal__monthyear" data-booking-cal-monthyear></span>
                  <button type="button" class="qx-inline-cal__nav-btn" data-booking-cal-next aria-label={t.step4CalNextMonth}>
                    <i class="fas fa-chevron-right" aria-hidden="true"></i>
                  </button>
                </div>
                <div class="qx-inline-cal__weekdays" data-booking-cal-weekdays></div>
                <div class="qx-inline-cal__grid" data-booking-cal-grid role="grid"></div>
              </div>
            </div>
            <p class="qx-step4-date-hint">{t.step4PickDateHint}</p>
            <button type="button" class="qx-step4-custom-back" data-booking-step4-custom-back>
              <i class="fas fa-arrow-left" aria-hidden="true"></i> {t.back}
            </button>
          </div>
        </article>
      </div>
      <p class="qx-step4-error" id="booking-step4-error" hidden role="alert"></p>
    </section>
  </div>

  <div class="form-navigation">
    <button type="button" class="btn-prev">{t.back}</button>
    <button type="button" class="btn-next">{t.continueBtn}</button>
  </div>
</div>

<script define:vars={{ lang, needTime: t.needTime, needDate: t.needDate, needCustomDate: t.needCustomDate, step3Subtitle: t.step3Subtitle, step3SubtitleOnline: t.step3SubtitleOnline }}>
  document.addEventListener('DOMContentLoaded', function () {
    const step = document.querySelector('.booking-lesson-time-step');
    if (!step) return;

    const timeSlots = step.querySelector('#booking-time-slots');
    const lessonTimeSubtitle = step.querySelector('#booking-lesson-time-subtitle');
    const tzMorning = step.querySelector('#booking-tz-morning');
    const tzAfternoon = step.querySelector('#booking-tz-afternoon');
    const tzEvening = step.querySelector('#booking-tz-evening');
    const tzSlotHidden = step.querySelector('#booking-timezone-slot');
    const startDateHidden = step.querySelector('#start-date');
    const startDateMode = step.querySelector('#booking-start-date-mode');
    const presetsWrap = step.querySelector('#booking-step4-presets');
    const customCard = step.querySelector('[data-booking-step4-custom-card]');
    const customCta = step.querySelector('[data-booking-step4-custom]');
    const customIntro = step.querySelector('[data-booking-step4-custom-intro]');
    const customPicker = step.querySelector('#booking-step4-custom-picker');
    const customDateInput = step.querySelector('#booking-custom-date-input');
    const errorEl = step.querySelector('#booking-step4-error');
    const calRoot = step.querySelector('[data-booking-inline-cal]');
    const calMonthYearEl = step.querySelector('[data-booking-cal-monthyear]');
    const calWeekdaysEl = step.querySelector('[data-booking-cal-weekdays]');
    const calGridEl = step.querySelector('[data-booking-cal-grid]');
    const calPrevBtn = step.querySelector('[data-booking-cal-prev]');
    const calNextBtn = step.querySelector('[data-booking-cal-next]');
    const calTriggerLabel = step.querySelector('[data-booking-calendar-trigger-label]');

    let calViewYear = new Date().getFullYear();
    let calViewMonth = new Date().getMonth() + 1;

    function localeForLang(lc) {
      if (lc === 'de') return 'de-DE';
      if (lc === 'en') return 'en-GB';
      if (lc === 'es') return 'es-ES';
      return 'tr-TR';
    }

    function pad2(n) { return String(n).padStart(2, '0'); }

    function isoToDisplayValue(iso) {
      const [y, m, d] = iso.split('-');
      if (!d || !m) return '';
      return `${parseInt(d, 10)}.${parseInt(m, 10)}`;
    }

    function hideError() {
      if (!errorEl) return;
      errorEl.hidden = true;
      errorEl.textContent = '';
    }

    function showError(msg) {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.hidden = false;
    }

    timeSlots?.querySelectorAll('.qx-time-slot').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (btn.hidden) return;
        timeSlots.querySelectorAll('.qx-time-slot').forEach(function (el) {
          el.classList.remove('is-selected');
          el.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('is-selected');
        btn.setAttribute('aria-pressed', 'true');
        const val = btn.getAttribute('data-timezone-value') || '';
        if (tzSlotHidden) tzSlotHidden.value = val;
        if (tzMorning) tzMorning.checked = val === 'morning';
        if (tzAfternoon) tzAfternoon.checked = val === 'afternoon';
        if (tzEvening) tzEvening.checked = val === 'evening';
        hideError();
      });
    });

    function clearTimeSlotSelection() {
      timeSlots?.querySelectorAll('.qx-time-slot').forEach(function (el) {
        el.classList.remove('is-selected');
        el.setAttribute('aria-pressed', 'false');
      });
      if (tzSlotHidden) tzSlotHidden.value = '';
      if (tzMorning) tzMorning.checked = false;
      if (tzAfternoon) tzAfternoon.checked = false;
      if (tzEvening) tzEvening.checked = false;
    }

    function selectTimeSlot(value) {
      const btn = timeSlots?.querySelector('.qx-time-slot[data-timezone-value="' + value + '"]');
      if (!btn) return;
      timeSlots?.querySelectorAll('.qx-time-slot').forEach(function (el) {
        el.classList.remove('is-selected');
        el.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('is-selected');
      btn.setAttribute('aria-pressed', 'true');
      const val = btn.getAttribute('data-timezone-value') || '';
      if (tzSlotHidden) tzSlotHidden.value = val;
      if (tzMorning) tzMorning.checked = val === 'morning';
      if (tzAfternoon) tzAfternoon.checked = val === 'afternoon';
      if (tzEvening) tzEvening.checked = val === 'evening';
      hideError();
    }

    window.syncBookingLessonTimeForProgram = function (program) {
      const isOnline = program === 'online';
      if (timeSlots) timeSlots.classList.toggle('qx-time-slots--online', isOnline);
      if (lessonTimeSubtitle) {
        lessonTimeSubtitle.textContent = isOnline ? step3SubtitleOnline : step3Subtitle;
      }
      clearTimeSlotSelection();
      if (isOnline) {
        selectTimeSlot('evening');
      }
    };

    function syncStep4DateCardStates() {
      const hasPreset = !!presetsWrap?.querySelector('input[type="radio"]:checked');
      const customActive = customCard?.classList.contains('is-picking-custom');
      if (hasPreset) {
        customCard?.classList.add('is-locked');
        customCard?.setAttribute('aria-disabled', 'true');
        if (customCta) {
          customCta.disabled = true;
          customCta.setAttribute('aria-disabled', 'true');
        }
      } else if (!customActive) {
        customCard?.classList.remove('is-locked');
        customCard?.removeAttribute('aria-disabled');
        if (customCta) {
          customCta.disabled = false;
          customCta.removeAttribute('aria-disabled');
        }
      }
    }

    function clearStartDateSelection() {
      if (startDateHidden) startDateHidden.value = '';
      if (startDateMode) startDateMode.value = '';
      presetsWrap?.querySelectorAll('input[type="radio"]').forEach(function (r) { r.checked = false; });
      customCard?.classList.remove('is-selected', 'is-picking-custom', 'is-locked');
      customCard?.removeAttribute('aria-disabled');
      if (customPicker) customPicker.hidden = true;
      if (customIntro) customIntro.hidden = false;
      if (customDateInput) customDateInput.value = '';
      if (customCta) {
        customCta.disabled = false;
        customCta.removeAttribute('aria-disabled');
      }
      updateCalendarTriggerLabel();
      syncStep4DateCardStates();
    }

    presetsWrap?.addEventListener('mousedown', function (ev) {
      const row = ev.target.closest('.qx-step4-preset-row');
      if (!row) return;
      const radio = row.querySelector('input[type="radio"]');
      if (!(radio instanceof HTMLInputElement)) return;
      if (radio.checked) {
        radio.dataset.presetWasChecked = '1';
      } else {
        delete radio.dataset.presetWasChecked;
      }
    });

    presetsWrap?.addEventListener('click', function (ev) {
      const row = ev.target.closest('.qx-step4-preset-row');
      if (!row) return;
      const radio = row.querySelector('input[type="radio"]');
      if (!(radio instanceof HTMLInputElement)) return;
      if (radio.dataset.presetWasChecked === '1') {
        ev.preventDefault();
        ev.stopPropagation();
        radio.checked = false;
        delete radio.dataset.presetWasChecked;
        if (startDateHidden) startDateHidden.value = '';
        if (startDateMode) startDateMode.value = '';
        hideError();
        syncStep4DateCardStates();
      }
    });

    presetsWrap?.addEventListener('change', function (ev) {
      const target = ev.target;
      if (!(target instanceof HTMLInputElement) || target.type !== 'radio' || !target.checked) return;
      customCard?.classList.remove('is-selected', 'is-picking-custom');
      if (customPicker) customPicker.hidden = true;
      if (customIntro) customIntro.hidden = false;
      if (customDateInput) customDateInput.value = '';
      if (startDateMode) startDateMode.value = 'preset';
      if (startDateHidden) startDateHidden.value = target.getAttribute('data-display-value') || isoToDisplayValue(target.value);
      hideError();
      syncStep4DateCardStates();
    });

    customCta?.addEventListener('click', function () {
      if (customCard?.classList.contains('is-locked')) return;
      presetsWrap?.querySelectorAll('input[type="radio"]').forEach(function (r) { r.checked = false; });
      customCard?.classList.add('is-selected', 'is-picking-custom');
      if (customIntro) customIntro.hidden = true;
      if (customPicker) customPicker.hidden = false;
      if (startDateMode) startDateMode.value = 'custom';
      if (startDateHidden) startDateHidden.value = '';
      syncCalViewToMin();
      renderInlineCalendar();
      hideError();
      syncStep4DateCardStates();
    });

    step.querySelector('[data-booking-step4-custom-back]')?.addEventListener('click', function () {
      customCard?.classList.remove('is-selected', 'is-picking-custom');
      if (customPicker) customPicker.hidden = true;
      if (customIntro) customIntro.hidden = false;
      if (customDateInput) customDateInput.value = '';
      if (startDateMode) startDateMode.value = '';
      if (startDateHidden) startDateHidden.value = '';
      hideError();
      syncStep4DateCardStates();
    });

    function calBounds() {
      const min = new Date();
      min.setHours(0, 0, 0, 0);
      const max = new Date(2030, 11, 31);
      max.setHours(0, 0, 0, 0);
      return { min, max };
    }

    function syncCalViewToMin() {
      const { min } = calBounds();
      calViewYear = min.getFullYear();
      calViewMonth = min.getMonth() + 1;
    }

    function formatFullCustomStartLabel(iso) {
      const d = new Date(`${iso}T12:00:00`);
      return new Intl.DateTimeFormat(localeForLang(lang), { weekday: 'short', day: 'numeric', month: 'long', year: 'numeric' }).format(d);
    }

    function updateCalendarTriggerLabel() {
      if (!calTriggerLabel) return;
      const iso = customDateInput?.value?.trim() || '';
      calTriggerLabel.textContent = iso ? formatFullCustomStartLabel(iso) : calTriggerLabel.getAttribute('data-fallback') || '';
    }

    if (calTriggerLabel) calTriggerLabel.setAttribute('data-fallback', calTriggerLabel.textContent || '');

    function fillCalWeekdayHeaders() {
      if (!calWeekdaysEl) return;
      calWeekdaysEl.innerHTML = '';
      const loc = localeForLang(lang);
      for (let i = 0; i < 7; i++) {
        const dd = new Date(2024, 0, 1 + i);
        const el = document.createElement('div');
        el.className = 'qx-inline-cal__weekday';
        el.textContent = new Intl.DateTimeFormat(loc, { weekday: 'narrow' }).format(dd);
        calWeekdaysEl.appendChild(el);
      }
    }

    function renderInlineCalendar() {
      if (!calGridEl || !calMonthYearEl) return;
      const { min, max } = calBounds();
      const loc = localeForLang(lang);
      calMonthYearEl.textContent = new Intl.DateTimeFormat(loc, { month: 'long', year: 'numeric' }).format(new Date(calViewYear, calViewMonth - 1, 1));
      if (calWeekdaysEl && calWeekdaysEl.childElementCount === 0) fillCalWeekdayHeaders();

      const first = new Date(calViewYear, calViewMonth - 1, 1);
      const startPad = (first.getDay() + 6) % 7;
      const daysInMonth = new Date(calViewYear, calViewMonth, 0).getDate();
      const selectedIso = customDateInput?.value?.trim() || '';

      calGridEl.innerHTML = '';
      let dayNum = 1;
      for (let i = 0; i < 42; i++) {
        const cell = document.createElement('div');
        cell.className = 'qx-inline-cal__cell';
        if (i < startPad || dayNum > daysInMonth) {
          const pad = document.createElement('span');
          pad.className = 'qx-inline-cal__pad';
          pad.setAttribute('aria-hidden', 'true');
          cell.appendChild(pad);
        } else {
          const iso = `${calViewYear}-${pad2(calViewMonth)}-${pad2(dayNum)}`;
          const cellDate = new Date(calViewYear, calViewMonth - 1, dayNum);
          cellDate.setHours(0, 0, 0, 0);
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'qx-inline-cal__day';
          btn.textContent = String(dayNum);
          btn.dataset.calDay = iso;
          if (cellDate < min || cellDate > max) {
            btn.disabled = true;
            btn.classList.add('is-out');
          }
          if (iso === selectedIso) btn.classList.add('is-selected');
          cell.appendChild(btn);
          dayNum++;
        }
        calGridEl.appendChild(cell);
      }
    }

    calGridEl?.addEventListener('click', function (ev) {
      const hit = ev.target.closest('button[data-cal-day]');
      if (!hit || hit.disabled) return;
      const iso = hit.dataset.calDay;
      if (!iso || !customDateInput) return;
      customDateInput.value = iso;
      if (startDateHidden) startDateHidden.value = isoToDisplayValue(iso);
      if (startDateMode) startDateMode.value = 'custom';
      updateCalendarTriggerLabel();
      hideError();
      renderInlineCalendar();
    });

    calPrevBtn?.addEventListener('click', function () {
      calViewMonth--;
      if (calViewMonth < 1) { calViewMonth = 12; calViewYear--; }
      renderInlineCalendar();
    });

    calNextBtn?.addEventListener('click', function () {
      calViewMonth++;
      if (calViewMonth > 12) { calViewMonth = 1; calViewYear++; }
      renderInlineCalendar();
    });

    window.validateBookingLessonTimeStep = function () {
      hideError();
      const slot = tzSlotHidden?.value?.trim();
      if (!slot) {
        showError(needTime);
        return false;
      }
      const mode = startDateMode?.value?.trim();
      const dateVal = startDateHidden?.value?.trim();
      if (!mode || !dateVal) {
        showError(needDate);
        return false;
      }
      if (mode === 'custom' && !customDateInput?.value?.trim()) {
        showError(needCustomDate);
        return false;
      }
      return true;
    };

    window.resetBookingLessonTimeStep = clearStartDateSelection;

    window.animateBookingLessonTimeSlots = function () {
      if (!timeSlots) return;
      timeSlots.querySelectorAll('.qx-time-slot').forEach(function (btn) {
        if (btn.offsetParent === null) return;
        btn.classList.remove('qx-time-slot--shake');
        void btn.offsetWidth;
        btn.classList.add('qx-time-slot--shake');
        btn.addEventListener('animationend', function onEnd() {
          btn.classList.remove('qx-time-slot--shake');
          btn.removeEventListener('animationend', onEnd);
        });
      });
    };

    const initialProgram = document.querySelector('[name="program"]:checked')?.value || '';
    if (initialProgram) window.syncBookingLessonTimeForProgram(initialProgram);
  });
</script>

