    min-height: 1.1rem;
    font-size: 0.9rem;
    margin: 0.1rem 0 0;
    color: #334155;
    font-weight: 500;
  }
  @media (max-width: 560px) {
    .pricing-popup {
      padding: 1.1rem 0.9rem 0.95rem;
      border-radius: 14px;
    }
    .pricing-popup-close {
      right: 0.6rem;
      top: 0.6rem;
      width: 32px;
      height: 32px;
    }
    .pricing-popup-icon { width: 50px; height: 50px; font-size: 1.15rem; }
  }
  @keyframes pricingPopupIn {
    from { opacity: 0; transform: translateY(8px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
</style>

<script>
  const backdrop = document.getElementById('pricing-popup-backdrop');
  const closeBtn = document.getElementById('pricing-popup-close');
  const form = document.getElementById('pricing-popup-form');
  const submitBtn = document.getElementById('pricing-popup-submit');
  const productInput = document.getElementById('popup-product');
  const productReadonly = document.getElementById('popup-product-readonly');
  const statusEl = document.getElementById('popup-status');
  const msgSending = backdrop?.getAttribute('data-msg-sending') || 'Sending...';
  const msgSuccess = backdrop?.getAttribute('data-msg-success') || 'Request received.';
  const msgError = backdrop?.getAttribute('data-msg-error') || 'Submission failed.';

  // Move modal root to <body> to escape section/header stacking contexts.
  if (backdrop && backdrop.parentElement !== document.body) {
    document.body.appendChild(backdrop);
  }

  document.querySelectorAll('.intensive-pricing-section .pricing-item > summary').forEach((summary) => {
    summary.addEventListener('mousedown', () => {
      const details = summary.parentElement;
      if (details instanceof HTMLDetailsElement && details.open) {
        summary.dataset.pricingWasOpen = '1';
      } else {
        delete summary.dataset.pricingWasOpen;
      }
    });
    summary.addEventListener('click', (e) => {
      const details = summary.parentElement;
      if (!(details instanceof HTMLDetailsElement)) return;
      if (summary.dataset.pricingWasOpen === '1') {
        e.preventDefault();
        details.open = false;
        delete summary.dataset.pricingWasOpen;
      }
    });
  });

  document.querySelectorAll('[data-popup-product]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const product = btn.getAttribute('data-popup-product') || '';
      if (productInput) productInput.value = product;
      if (productReadonly) productReadonly.value = product;
      if (statusEl) statusEl.textContent = '';
      if (backdrop) backdrop.hidden = false;
      document.body.style.overflow = 'hidden';
    });
  });

  function closePopup() {
    if (backdrop) backdrop.hidden = true;
    document.body.style.overflow = '';
  }
  closeBtn?.addEventListener('click', closePopup);
  backdrop?.addEventListener('click', (e) => {
    if (e.target === backdrop) closePopup();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && backdrop && !backdrop.hidden) closePopup();
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (submitBtn) submitBtn.setAttribute('disabled', 'true');
    if (statusEl) statusEl.textContent = msgSending;
    const fd = new FormData(form);
    const popupLang = backdrop?.getAttribute('data-lang') || 'tr';
    const product = String(fd.get('popupProduct') || '').trim();
    const userMsg = String(fd.get('message') || '').trim();
    const combinedMessage = product
      ? (userMsg ? '[' + product + ']\n' + userMsg : '[' + product + ']')
      : userMsg;
    const payload = {
      formType: 'pricing-popup-request',
      sourcePage: window.location.pathname,
      lang: popupLang,
      name: fd.get('name') || '',
      email: fd.get('email') || '',
      tel: String(fd.get('phone') || '').trim(),
      city: '',
      country: '',
      startDate: '',
      message: combinedMessage,
      timestamp: new Date().toISOString(),
    };
    try {
      const res = await fetch('https://hook.eu2.make.com/40s1h4a3wra21aszpa9y9erfsfooso47', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error('Request failed');
      if (statusEl) statusEl.textContent = msgSuccess;
      form.reset();
      window.setTimeout(closePopup, 1100);
    } catch (_err) {
      if (statusEl) statusEl.textContent = msgError;
    } finally {
      if (submitBtn) submitBtn.removeAttribute('disabled');
    }
  });
</script>
