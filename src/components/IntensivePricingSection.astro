  { perWeek: 230, exampleWeeks: 2 },
  { perWeek: 180, exampleWeeks: 8 },
  { perWeek: 160, exampleWeeks: 12 },
  { perWeek: 150, exampleWeeks: 16 },
  { perWeek: 135, exampleWeeks: 25 },
];

const rng = tierRanges[L] ?? tierRanges.en;
const base20: Tier[] = base20n.map((r, i) => ({ ...r, range: rng[i] ?? '' }));
const base25: Tier[] = base25n.map((r, i) => ({ ...r, range: rng[i] ?? '' }));

const evening = base20.map((r) => ({ ...r, perWeek: r.perWeek + 10 }));

const numLocale = L === 'de' ? 'de-DE' : L === 'tr' ? 'tr-TR' : L === 'es' ? 'es-ES' : 'en-US';

function fmtMoney(n: number) {
  if (L === 'de') return `${n.toLocaleString(numLocale)}\u00a0€`;
  return `${n.toLocaleString(numLocale)} €`;
}

function total(row: Tier) {
  return row.perWeek * row.exampleWeeks;
}

