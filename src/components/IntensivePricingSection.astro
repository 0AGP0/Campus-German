  { perWeek: 190, exampleWeeks: 2 },
  { perWeek: 150, exampleWeeks: 8 },
  { perWeek: 130, exampleWeeks: 12 },
  { perWeek: 120, exampleWeeks: 16 },
  { perWeek: 110, exampleWeeks: 25 },
];

