---

<section class="intensive-pricing-section">
  <div class="container">
    {showSectionTitle && (
      <div class="intensive-pricing-header">
        <h2 class="intensive-pricing-title">{m.sectionTitle}</h2>
        <p class="intensive-pricing-subtitle">{m.sectionSubtitle}</p>
      </div>
    )}

    <div class="pricing-accordion">
      <details class="pricing-item pricing-item--intensive" open>
        <summary>{pst.intensive}</summary>
        <div class="pricing-content">
          <p class="pricing-panel-lead">{lc.weeks} · {lc.inPerson}</p>
          <div class="intensive-level-cards">
            {intensiveLevelCards.map((card) => (
              <article class={`intensive-level-card intensive-level-card--${card.mod}`}>
                <div class="intensive-level-card__head">
                  <span class="intensive-level-card__icon" aria-hidden="true">
                    <i class={`fas fa-${card.icon}`}></i>
                  </span>
                  <div class="intensive-level-card__head-copy">
                    <span class="intensive-level-card__level">{card.level}</span>
                    <span class="intensive-level-card__weeks">{lc.weeks}</span>
                  </div>
                </div>
                <ul class="intensive-level-card__features">
                  <li><i class="fas fa-check" aria-hidden="true"></i><span>{lc.club}</span></li>
                  <li><i class="fas fa-check" aria-hidden="true"></i><span>{lc.native}</span></li>
                  <li><i class="fas fa-check" aria-hidden="true"></i><span>{lc.visa}</span></li>
                  <li><i class="fas fa-check" aria-hidden="true"></i><span>{lc.lessons}</span></li>
                  <li><i class="fas fa-check" aria-hidden="true"></i><span>{lc.inPerson}</span></li>
                </ul>
                <div class="intensive-level-card__price">
                  <PromoPrice lang={lang} variant="card" />
                </div>
              </article>
            ))}
          </div>
        </div>
      </details>

      <details class="pricing-item pricing-item--online">
        <summary>{pst.online}</summary>
        <div class="pricing-content">
          <p class="pricing-panel-lead">{oc.subtitle}</p>
          <div class="intensive-level-cards intensive-level-cards--online">
            {onlineLevelCards.map((card) => (
              <article class={`intensive-level-card intensive-level-card--${card.mod}`}>
                <div class="intensive-level-card__head">
                  <span class="intensive-level-card__icon" aria-hidden="true">
                    <i class={`fas fa-${card.icon}`}></i>
                  </span>
                  <div class="intensive-level-card__head-copy">
                    <span class="intensive-level-card__level">{card.level}</span>
                    <span class="intensive-level-card__weeks">{oc.weeks}</span>
                  </div>
                </div>
                <div class="intensive-level-card__badges">
                  <span class="intensive-level-card__badge intensive-level-card__badge--lessons">{oc.lessons}</span>
                  <span class="intensive-level-card__badge intensive-level-card__badge--online">{oc.online}</span>
                </div>
                <ul class="intensive-level-card__features">
                  <li><i class="fas fa-check" aria-hidden="true"></i><span>{oc.noNative}</span></li>
                  <li><i class="fas fa-check" aria-hidden="true"></i><span>{oc.noVisa}</span></li>
                  <li><i class="fas fa-check" aria-hidden="true"></i><span>{oc.evening}</span></li>
                </ul>
                <div class="intensive-level-card__price intensive-level-card__price--online">
                  <span class="intensive-level-card__price-amount">{fmtMoney(card.price)}</span>
                  <span class="intensive-level-card__price-note">{oc.weeks}</span>
                </div>
              </article>
            ))}
          </div>
          <button class="pricing-cta-btn" type="button" data-popup-product={a.onlineProduct}>{pc.cta}</button>
        </div>
      </details>

      <details class="pricing-item pricing-item--short">
        <summary>{pst.shortTerm}</summary>
        <div class="pricing-content">
          <p class="pricing-panel-lead">{stc.subtitle}</p>
          <ul class="intensive-short-term-features">
            <li><i class="fas fa-check" aria-hidden="true"></i><span>{stc.hours}</span></li>
            <li><i class="fas fa-check" aria-hidden="true"></i><span>{lc.club}</span></li>
            <li><i class="fas fa-check" aria-hidden="true"></i><span>{lc.native}</span></li>
            <li><i class="fas fa-check" aria-hidden="true"></i><span>{lc.inPerson}</span></li>
            <li><i class="fas fa-check" aria-hidden="true"></i><span>{stc.flexible}</span></li>
          </ul>
          <table class="pricing-table pricing-table--short-term">
            <thead>
              <tr>
                <th>{tbl.duration}</th>
                <th>{tbl.perWeek}</th>
                <th>{tbl.example}</th>
              </tr>
            </thead>
            <tbody>
              {base20.map((row) => (
                <tr>
                  <td>{row.range}</td>
                  <td>{fmtMoney(row.perWeek)} / {tbl.perWeekUnit}</td>
                  <td>{fmtMoney(total(row))} ({row.exampleWeeks} {weekLabel})</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="intensive-short-term-note">{stc.note}</p>
          <button class="pricing-cta-btn" type="button" data-popup-product={a.shortTermProduct}>{pc.cta}</button>
        </div>
      </details>

      <details class="pricing-item">
        <summary>{a.workStudyTitle}</summary>
        <div class="pricing-content">
          <p>{a.workStudyIntro}</p>
          <ul>
            {a.workStudyBullets.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
          <button class="pricing-cta-btn" type="button" data-popup-product={a.workStudyProduct}>{pc.cta}</button>
        </div>
      </details>

      <details class="pricing-item">
        <summary>{a.demiTitle}</summary>
        <div class="pricing-content">
          <p>{a.demiIntro}</p>
          <ul>
            {a.demiBullets.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
          <button class="pricing-cta-btn" type="button" data-popup-product={a.demiProduct}>{pc.cta}</button>
        </div>
      </details>

      <details class="pricing-item">
        <summary>{a.campTitle}</summary>
        <div class="pricing-content">
          <ul>
            {a.campBullets.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
          <button class="pricing-cta-btn" type="button" data-popup-product={a.campProduct}>{pc.cta}</button>
        </div>
      </details>

      <details class="pricing-item">
        <summary>{a.erasmusTitle}</summary>
        <div class="pricing-content">
          <p>{a.erasmusIntro}</p>
          <ul>
            {a.erasmusBullets.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
          <button class="pricing-cta-btn" type="button" data-popup-product={a.erasProduct}>{pc.cta}</button>
        </div>
      </details>

      <details class="pricing-item">
        <summary>{a.accTitle}</summary>
        <div class="pricing-content">
          <p>{a.accIntro}</p>
          <table class="pricing-table">
            <thead><tr><th>{tbl.duration}</th><th>{tbl.single}</th><th>{tbl.twin}</th><th>{tbl.studio}</th><th>{tbl.homestay}</th></tr></thead>
            <tbody>
              <tr><td>1–7 {weekLabel}</td><td>{fmtMoney(300)} / {tbl.perWeekUnit}</td><td>{fmtMoney(250)} / {tbl.perWeekUnit}</td><td>{tbl.na}</td><td>{tbl.na}</td></tr>
              <tr><td>8–23 {weekLabel}</td><td>{fmtMoney(180)} / {tbl.perWeekUnit}</td><td>{fmtMoney(150)} / {tbl.perWeekUnit}</td><td>{tbl.na}</td><td>{tbl.na}</td></tr>
              <tr><td>24+ {weekLabel}</td><td>{fmtMoney(160)} / {tbl.perWeekUnit}</td><td>{fmtMoney(130)} / {tbl.perWeekUnit}</td><td>{fmtMoney(230)} / {tbl.perWeekUnit}</td><td>{fmtMoney(220)} / {tbl.perWeekUnit}</td></tr>
            </tbody>
          </table>
          <h4>{a.accLogisticsTitle}</h4>
          <ul>
            {a.accLogistics.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
          <button class="pricing-cta-btn" type="button" data-popup-product={a.accProduct}>{pc.cta}</button>
        </div>
      </details>

      <details class="pricing-item">
        <summary>{a.examTitle}</summary>
        <div class="pricing-content">
          <h4>{a.examHdates}</h4>
          <table class="pricing-table">
            <thead><tr><th>{tbl.exam}</th><th>{tbl.dates}</th></tr></thead>
            <tbody>
              {examDateRows.map(([exam, dates]) => (
                <tr><td>{exam}</td><td>{dates}</td></tr>
              ))}
            </tbody>
          </table>
          <h4>{a.examHfees}</h4>
          <table class="pricing-table">
            <thead><tr><th>{tbl.exam}</th><th>{tbl.fee}</th></tr></thead>
            <tbody>
              {examFeeRows.map(([exam, fee]) => (
                <tr><td>{exam}</td><td>{fee}</td></tr>
              ))}
            </tbody>
          </table>
          <button class="pricing-cta-btn" type="button" data-popup-product={a.examProduct}>{pc.cta}</button>
        </div>
      </details>
    </div>
  </div>

  <div
    class="pricing-popup-backdrop"
    id="pricing-popup-backdrop"
    data-lang={lang}
    data-msg-sending={pc.sending}
    data-msg-success={pc.success}
    data-msg-error={pc.error}
    onclick="if(event.target===this){this.hidden=true;document.body.style.overflow='';}"
    hidden
  >
    <div class="pricing-popup" role="dialog" aria-modal="true" aria-labelledby="pricing-popup-title">
      <button class="pricing-popup-close" type="button" id="pricing-popup-close" aria-label={pc.close} onclick="document.getElementById('pricing-popup-backdrop').hidden=true;document.body.style.overflow='';">x</button>
      <div class="pricing-popup-icon"><i class="fas fa-comments"></i></div>
      <h3 id="pricing-popup-title">{pc.title}</h3>
      <p class="pricing-popup-subtitle">{pc.subtitle}</p>
      <form id="pricing-popup-form" class="pricing-popup-form">
        <input type="hidden" id="popup-product" name="popupProduct" value="" />
        <label>{pc.product}</label>
        <input id="popup-product-readonly" type="text" readonly />
        <label>{pc.name}</label>
        <input name="name" required />
        <label>{pc.email}</label>
        <input name="email" type="email" required />
        <label>{pc.phone}</label>
        <input name="phone" />
        <label>{pc.message}</label>
        <textarea name="message" rows="4" placeholder={pc.placeholder}></textarea>
        <button class="pricing-cta-btn pricing-cta-btn--submit" type="submit" id="pricing-popup-submit">{pc.submit}</button>
        <p id="popup-status" class="popup-status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<style>
  .intensive-pricing-section {
    padding: 2.25rem 0;
    background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 55%, #f8fafc 100%);
  }
  .intensive-pricing-header { margin-bottom: 1.25rem; }
  .intensive-pricing-title {
    font-size: 1.5rem;
    margin: 0 0 0.45rem;
    color: #0b1220;
    letter-spacing: -0.02em;
  }
  .intensive-pricing-subtitle { margin: 0; color: #64748b; font-size: 0.95rem; max-width: 52ch; }
  .pricing-panel-lead {
    margin: 0 0 0.85rem;
    color: #64748b;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .pricing-content__subhead {
    margin: 1rem 0 0.45rem;
    font-size: 0.88rem;
    font-weight: 700;
    color: #0b1220;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .pricing-item--intensive[open] > summary {
    border-left-color: #059669;
  }
  .pricing-item--online[open] > summary {
    border-left-color: #7c3aed;
  }
  .pricing-item--short[open] > summary {
    border-left-color: #0ea5e9;
  }
  .intensive-level-cards--online {
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    max-width: 560px;
  }
  .intensive-level-card__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .intensive-level-card__badge {
    display: inline-block;
    padding: 0.32rem 0.62rem;
    font-size: 0.68rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-radius: 8px;
    white-space: nowrap;
  }
  .intensive-level-card__badge--lessons {
    color: #fff;
    background: linear-gradient(135deg, #7c3aed, #0cc0df);
    box-shadow: 0 2px 8px rgba(124, 58, 237, 0.25);
  }
  .intensive-level-card__badge--online {
    color: #5b21b6;
    background: #f3e8ff;
    font-weight: 700;
  }
  .intensive-short-term-features {
    list-style: none;
    margin: 0 0 0.85rem;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }
  .intensive-short-term-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: #334155;
  }
  .intensive-short-term-features i {
    color: #0ea5e9;
    margin-top: 0.15rem;
    font-size: 0.7rem;
  }
  .pricing-table--short-term {
    margin-bottom: 0.5rem;
  }
  .intensive-short-term-note {
    margin: 0.5rem 0 0;
    font-size: 0.82rem;
    color: #64748b;
    font-style: italic;
  }
  .intensive-level-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.85rem;
  }
  .intensive-level-card {
    border: 1px solid rgba(15, 23, 42, 0.1);
    border-radius: 14px;
    padding: 0.9rem 0.95rem;
    background: #fff;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    box-shadow: 0 4px 18px rgba(15, 23, 42, 0.05);
  }
  .intensive-level-card__head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .intensive-level-card__icon {
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 10px;
    display: grid;
    place-items: center;
    font-size: 1rem;
    flex-shrink: 0;
  }
  .intensive-level-card--a1 .intensive-level-card__icon { background: #ecfdf5; color: #059669; }
  .intensive-level-card--a2 .intensive-level-card__icon { background: #eff6ff; color: #2563eb; }
  .intensive-level-card--b1 .intensive-level-card__icon { background: #f5f3ff; color: #7c3aed; }
  .intensive-level-card--b2 .intensive-level-card__icon { background: #fff7ed; color: #ea580c; }
  .intensive-level-card--c1 .intensive-level-card__icon { background: #fef2f2; color: #dc2626; }
  .intensive-level-card__level {
    display: block;
    font-size: 1.15rem;
    font-weight: 800;
    color: #0b1220;
    line-height: 1.1;
  }
  .intensive-level-card__weeks {
    display: block;
    font-size: 0.78rem;
    font-weight: 600;
    color: #64748b;
    margin-top: 0.1rem;
  }
  .intensive-level-card__features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
    flex: 1;
  }
  .intensive-level-card__features li {
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    font-size: 0.8rem;
    line-height: 1.35;
    color: #334155;
  }
  .intensive-level-card__features i {
    color: #059669;
    margin-top: 0.15rem;
    font-size: 0.7rem;
    flex-shrink: 0;
  }
  .intensive-level-card__price {
    margin-top: auto;
    padding-top: 0.35rem;
    border-top: 1px solid #eef2f7;
  }
  .intensive-level-card__price :global(.promo-price-new) {
    font-size: 1.15rem;
  }
  .intensive-level-card__price--online {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .intensive-level-card__price-amount {
    color: #7c3aed;
    font-weight: 800;
    font-size: 1.15rem;
    line-height: 1.2;
  }
  .intensive-level-card__price-note {
    color: #64748b;
    font-size: 0.78rem;
    font-weight: 500;
  }
  .pricing-accordion { display: grid; gap: 0.85rem; }
  .pricing-item {
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 16px;
    background: #fff;
    overflow: hidden;
    box-shadow: 0 4px 22px rgba(15, 23, 42, 0.06);
    transition: box-shadow 0.22s ease, border-color 0.22s ease;
  }
  .pricing-item:hover {
    border-color: rgba(12, 192, 223, 0.28);
    box-shadow: 0 8px 32px rgba(12, 192, 223, 0.1);
  }
  .pricing-item[open] {
    border-color: rgba(12, 192, 223, 0.38);
    box-shadow: 0 12px 40px rgba(12, 192, 223, 0.14);
  }
  .pricing-item > summary {
    cursor: pointer;
    list-style: none;
    padding: 1rem 1.15rem 1rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-weight: 700;
    font-size: 1.02rem;
    line-height: 1.35;
    color: #0f172a;
    background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
    border-left: 4px solid transparent;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .pricing-item[open] > summary {
    border-left-color: #0cc0df;
    background: linear-gradient(135deg, #f0f9ff 0%, #ffffff 55%);
    border-bottom: 1px solid rgba(14, 165, 233, 0.12);
  }
  .pricing-item > summary::-webkit-details-marker { display: none; }
