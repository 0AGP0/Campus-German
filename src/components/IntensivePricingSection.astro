  }
  .pricing-table tbody tr:hover td { background: #f8fafc; }
  .pricing-table tbody tr:last-child td { border-bottom: none; }
  .pricing-cta-btn {
    margin-top: 0.5rem;
    background: linear-gradient(135deg, #059669 0%, #047857 100%);
    color: #fff;
    border: 0;
    border-radius: 999px;
    padding: 0.58rem 1rem;
    cursor: pointer;
    font-weight: 600;
    box-shadow: 0 6px 18px rgba(5, 150, 105, 0.25);
    transition: transform 0.16s ease, box-shadow 0.16s ease;
  }
  .pricing-cta-btn:hover { transform: translateY(-1px); box-shadow: 0 10px 24px rgba(5, 150, 105, 0.3); }
  .pricing-cta-btn:disabled { opacity: 0.7; cursor: not-allowed; }
  .pricing-popup-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(2, 6, 23, 0.62);
    display: grid;
    place-items: center;
    z-index: 2147483647;
    padding: 1rem;
    backdrop-filter: blur(3px);
  }
  .pricing-popup-backdrop[hidden] {
    display: none !important;
  }
  .pricing-popup {
    width: min(560px, 100%);
    background: #ffffff;
    border: 1px solid rgba(148, 163, 184, 0.22);
