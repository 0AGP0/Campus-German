---
export interface Props {
    lang?: string;
}

const { lang = 'de' } = Astro.props;

const stages = [
    { id: 1, text: 'A1 Intensiv+' },
    { id: 2, text: 'A2 Intensiv+' },
    { id: 3, text: 'B1 Intensiv+' },
    { id: 4, text: 'B2 Intensiv+' },
    { id: 5, text: 'C1 Intensiv+' },
    { id: 6, text: 'Akademisches Schreiben' },
    { id: 7, text: 'Konversation Training' },
    { id: 8, text: 'Tetris Grammatik' },
    { id: 9, text: 'Bremen Life Lab' },
    { id: 10, text: 'Ausprache-Training' },
];

const title = lang === 'tr'
    ? 'Campus German Yoğun Almanca Sarmalı'
    : lang === 'de'
        ? 'Campus German Intensiv Deutsch Spiral'
        : lang === 'en'
            ? 'Campus German Intensive German Spiral'
            : 'Campus German Espiral de Alemán Intensivo';

const subtitle = lang === 'tr'
    ? 'A1\'den C1\'e ve ek modüllerle tam yoğun Almanca yolu'
    : lang === 'de'
        ? 'Der vollständige Intensiv-Deutsch-Weg von A1 bis C1 plus Zusatzmodule'
        : lang === 'en'
            ? 'The complete intensive German path from A1 to C1 plus additional modules'
            : 'El camino intensivo de alemán completo de A1 a C1 más módulos adicionales';
---

<section class="campusgerman-about-section akademik-sarmal-section">
    <div class="container">
        <div class="section-header akademik-sarmal-header">
            <h2 class="section-title">{title}</h2>
            <p class="section-subtitle">{subtitle}</p>
        </div>

        <!-- Masaüstü: stadyum + merkez + liste -->
        <div class="akademik-sarmal-wrapper">
            <div class="sarmal-ring">
                <svg class="sarmal-ring-svg" viewBox="0 0 400 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <defs>
                        <linearGradient id="sarmal-stroke-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="rgba(5, 150, 105, 0.5)" />
                            <stop offset="50%" stop-color="rgba(255, 255, 255, 0.6)" />
                            <stop offset="100%" stop-color="rgba(5, 150, 105, 0.5)" />
                        </linearGradient>
                        <filter id="sarmal-glow" x="-20%" y="-20%" width="140%" height="140%">
                            <feGaussianBlur stdDeviation="3" result="blur" />
                            <feMerge>
                                <feMergeNode in="blur" />
                                <feMergeNode in="SourceGraphic" />
                            </feMerge>
                        </filter>
                        <filter id="sarmal-arrow-shadow" x="-50%" y="-50%" width="200%" height="200%">
                            <feDropShadow dx="0" dy="1" stdDeviation="1.5" flood-color="rgba(5,150,105,0.4)" />
                        </filter>
                    </defs>
                    <path id="sarmal-motion-path" d="M 100 0 L 300 0 A 100 100 0 0 1 300 200 L 100 200 A 100 100 0 0 1 100 0" fill="none" stroke="none" />
                    <path class="sarmal-ring-glow" d="M 100 0 L 300 0 A 100 100 0 0 1 300 200 L 100 200 A 100 100 0 0 1 100 0" fill="none" stroke="url(#sarmal-stroke-gradient)" stroke-width="6" stroke-linecap="round" filter="url(#sarmal-glow)" />
                    <path class="sarmal-ring-path" d="M 100 0 L 300 0 A 100 100 0 0 1 300 200 L 100 200 A 100 100 0 0 1 100 0" fill="none" stroke="url(#sarmal-stroke-gradient)" stroke-width="2.5" stroke-dasharray="12 8" stroke-linecap="round" />
                    <g class="sarmal-arrow" filter="url(#sarmal-arrow-shadow)">
                        <animateMotion dur="6s" repeatCount="indefinite" rotate="auto">
                            <mpath href="#sarmal-motion-path" />
                        </animateMotion>
                        <path class="sarmal-arrow-shape" d="M 8 0 L -6 -5 L -6 5 Z" fill="rgba(5, 150, 105, 0.95)" stroke="rgba(255,255,255,0.8)" stroke-width="1" stroke-linejoin="round" />
                    </g>
                </svg>
            </div>
            <div class="sarmal-center">
                <span class="sarmal-center-text">A1 → C1</span>
            </div>
            <ul class="sarmal-stages" role="list">
                {stages.map((stage) => (
                    <li class="sarmal-stage">
                        <div class="sarmal-stage-circle">
                            <span class="sarmal-stage-text">{stage.text}</span>
                        </div>
                    </li>
                ))}
            </ul>
        </div>

        <!-- Mobil: sadece zigzag çizgi + liste (ayrı blok, masaüstünde gizli) -->
        <div class="akademik-sarmal-mobil">
            <div class="sarmal-mobil-zigzag-bg" aria-hidden="true">
                <svg class="sarmal-mobil-zigzag-svg" viewBox="0 0 100 1000" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="sarmal-mobil-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
                            <stop offset="0%" stop-color="rgba(5, 150, 105, 0.45)" />
                            <stop offset="100%" stop-color="rgba(5, 150, 105, 0.45)" />
                        </linearGradient>
                    </defs>
                    <path fill="none" stroke="url(#sarmal-mobil-gradient)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                        d="M 18 50 L 82 50 L 82 150 L 18 150 L 18 250 L 82 250 L 82 350 L 18 350 L 18 450 L 82 450 L 82 550 L 18 550 L 18 650 L 82 650 L 82 750 L 18 750 L 18 850 L 82 850 L 82 950 L 18 950" />
                </svg>
            </div>
            <ul class="sarmal-mobil-list" role="list">
                {stages.map((stage) => (
                    <li class="sarmal-mobil-item">
                        <div class="sarmal-mobil-card">
                            <span class="sarmal-mobil-text">{stage.text}</span>
                        </div>
                    </li>
                ))}
            </ul>
        </div>
    </div>
</section>
