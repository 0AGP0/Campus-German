      'https://images.unsplash.com/photo-1572120360610-d971baca4fba?auto=format&fit=crop&w=1200&q=80',
      'https://images.unsplash.com/photo-1600585154912-087dd8d3cbf4?auto=format&fit=crop&w=1200&q=80'
    ]
  }
];

function chipClass(kind: GenderVariant): string {
  const map: Record<GenderVariant, string> = {
    female: 'housing-pill housing-pill--female',
    male: 'housing-pill housing-pill--male',
    mixed: 'housing-pill housing-pill--mixed',
    info: 'housing-pill housing-pill--info'
  };
  return map[kind];
}

const titlePage = pageTitles[lang];

const accentByType: Record<HomeType, string> = {
  studio: 'housing-card--accent-studio',
  wg: 'housing-card--accent-wg',
  hostel: 'housing-card--accent-hostel',
  yurt: 'housing-card--accent-yurt'
};
---

<MainLayout title={titlePage} lang={lang}>
  <main class="housing-page">
    <section class="housing-hero-plain">
      <div class="container">
        <h1>Konaklama seçenekleri</h1>
        <p>
          Bremen için studio, WG (oda için kadın/erkek ev arkadaşı bilgileri kartlarda), hostel ve öğrenci yurtlarından seçenekleri süzün; güncelliği ve uygunluğu doğrudan görüşerek teyit edin.
        </p>
      </div>
    </section>

    <section class="housing-list-section">
      <div class="container">
        <div class="housing-filters" id="housing-filters" role="group" aria-label="Konaklama türü filtreleri">
          <button class="housing-filter-btn is-active" data-type="all" type="button">Tümü</button>
          <button class="housing-filter-btn" data-type="studio" type="button">Studio</button>
          <button class="housing-filter-btn" data-type="wg" type="button">WG</button>
          <button class="housing-filter-btn" data-type="hostel" type="button">Hostel</button>
          <button class="housing-filter-btn" data-type="yurt" type="button">Yurt</button>
        </div>

        <div class="housing-cards" id="housing-cards">
          {homes.map((home) => (
            <article class:list={['housing-card', accentByType[home.type]]} data-type={home.type}>
              <div class="housing-gallery-shell">
                <span class:list={['housing-type-badge', `housing-type-badge--${home.type}`]}>{typeLabels[home.type]}</span>
                {home.available && <span class="housing-status-pill">{home.available}</span>}
                <div class="housing-gallery">
                  <div class="housing-main-shot">
                    <img class="housing-main-image" src={home.images[0]} alt={home.title} loading="lazy" />
                  </div>
                  <p class="housing-gallery-hint">{home.images.length} fotoğraf — ön izlemeye tıklayın</p>
                  <div class="housing-thumbs">
                    {home.images.map((img, idx) => (
                      <button
                        class:list={['housing-thumb', idx === 0 ? 'is-active' : undefined]}
                        type="button"
                        data-image={img}
                        aria-label={`${home.title} görsel ${idx + 1}`}
                      >
                        <img src={img} alt="" loading="lazy" />
                      </button>
                    ))}
                  </div>
                </div>
                <div class="housing-gallery-spacer">
                  <div class="housing-gallery-spacer-inner">
                    <i class="fas fa-circle-info housing-gallery-spacer-ic" aria-hidden="true"></i>
                    <p class="housing-gallery-spacer-text">
                      Örnek ilan görselidir. Güncel uygunluk, fiyat ve sözleşme için iletişime geçin.
                    </p>
                  </div>
                </div>
              </div>

              <div class="housing-details">
                <header class="housing-detail-head">
                  <div>
                    <h2>{home.title}</h2>
                    {home.subtitle && <p class="housing-subtitle">{home.subtitle}</p>}
                  </div>
                </header>

                <div class="housing-location-block">
                  <p class="housing-location-main">
                    <i class="fas fa-location-dot housing-inline-ic" aria-hidden="true"></i>
                    {home.location}
                  </p>
                  {home.locationExtra && <p class="housing-location-extra">{home.locationExtra}</p>}
                  {home.commute && (
                    <p class="housing-commute">
                      <i class="fas fa-person-walking housing-inline-ic" aria-hidden="true"></i>
                      {home.commute}
                    </p>
                  )}
                </div>

                {home.wg && (
                  <section class="housing-wg-banner" aria-label="WG ev arkadaşlığı özeti">
                    <div class="housing-wg-title">
                      <i class="fas fa-venus-mars housing-inline-ic" aria-hidden="true"></i>
                      Ev arkadaşları · cinsiyet bilgisi
                    </div>
                    <div class="housing-wg-rows">
                      <div class="housing-wg-block">
                        <span class="housing-wg-label">Şu an kimlerle yaşanıyor?</span>
                        <ul class="housing-pill-list">
                          {home.wg.residents.map((r) => (
                            <li>
                              <span class={chipClass(r.variant)}>{r.text}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                      <div class="housing-wg-block housing-wg-block--accent">
                        <span class="housing-wg-label">Aranan profil</span>
                        <ul class="housing-pill-list">
                          {home.wg.seeking.map((s) => (
                            <li>
                              <span class={chipClass(s.variant)}>{s.text}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>
                    {home.wg.note && <p class="housing-wg-note">{home.wg.note}</p>}
                  </section>
                )}

                <dl class="housing-spec-strip">
                  {home.roomSize && (
                    <div class="housing-spec-chip">
                      <dt><i class="fas fa-expand" aria-hidden="true"></i> Alan</dt>
                      <dd>{home.roomSize}</dd>
                    </div>
                  )}
                  {home.floor && (
                    <div class="housing-spec-chip">
                      <dt><i class="fas fa-stairs" aria-hidden="true"></i> Kat / erişim</dt>
                      <dd>{home.floor}</dd>
                    </div>
                  )}
                  {home.furnished && (
                    <div class="housing-spec-chip">
                      <dt><i class="fas fa-couch" aria-hidden="true"></i> Eşya</dt>
                      <dd>{home.furnished}</dd>
                    </div>
                  )}
                  {home.utilities && (
                    <div class="housing-spec-chip housing-spec-chip--wide">
                      <dt><i class="fas fa-plug-circle-bolt" aria-hidden="true"></i> Faturalar</dt>
                      <dd>{home.utilities}</dd>
                    </div>
                  )}
                  <div class="housing-spec-chip">
                    <dt><i class="fas fa-file-signature" aria-hidden="true"></i> Süre</dt>
                    <dd>{home.contract}</dd>
                  </div>
                </dl>

                <div class="housing-money-row">
                  <div class="housing-price-box">
                    <span class="housing-money-label">Aylık kira</span>
                    <strong class="housing-price-main">{home.price}</strong>
                  </div>
                  <div class="housing-price-box housing-price-box--muted">
                    <span class="housing-money-label">Depozito</span>
                    <strong>{home.deposit}</strong>
                  </div>
                </div>

                {home.extraTags && home.extraTags.length > 0 && (
                  <div class="housing-tag-row">
                    {home.extraTags.map((tag) => (
                      <span class="housing-mini-tag">{tag}</span>
                    ))}
                  </div>
                )}

                {home.perks.length > 0 && (
                  <ul class="housing-perks" aria-label="Öne çıkanlar">
                    {home.perks.map((perk) => (
                      <li>
                        <span class="housing-perk-ic" aria-hidden="true">
                          <i class:list={['fas', perk.icon]} />
                        </span>
                        <span>{perk.text}</span>
                      </li>
                    ))}
                  </ul>
                )}

                <details class="housing-details-expand">
                  <summary>Detaylı açıklama ve kurallar</summary>
                  <ul class="housing-features">
                    {home.details.map((detail) => (
                      <li>{detail}</li>
                    ))}
                  </ul>
                </details>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const filterWrap = document.getElementById('housing-filters');
      const cardsWrap = document.getElementById('housing-cards');
      if (!filterWrap || !cardsWrap) return;

      const buttons = Array.from(filterWrap.querySelectorAll('.housing-filter-btn'));
      const cards = Array.from(cardsWrap.querySelectorAll('.housing-card'));

      function applyFilter(type) {
        cards.forEach((card) => {
          const match = type === 'all' || card.getAttribute('data-type') === type;
          card.style.display = match ? '' : 'none';
        });
      }

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          buttons.forEach((b) => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          applyFilter(btn.getAttribute('data-type') || 'all');
        });
      });

      cards.forEach((card) => {
        const main = card.querySelector('.housing-main-image');
        const thumbs = Array.from(card.querySelectorAll('.housing-thumb'));
        thumbs.forEach((thumb) => {
          thumb.addEventListener('click', () => {
            thumbs.forEach((t) => t.classList.remove('is-active'));
            thumb.classList.add('is-active');
            const image = thumb.getAttribute('data-image');
            if (main && image) main.setAttribute('src', image);
          });
        });
      });
    })();
  </script>
</MainLayout>

<style is:global>
  .housing-page {
    padding-bottom: 3rem;
    background: var(--color-bg-light);
  }

  /* Sunduklarımız / site diline yakın düz hero */
  .housing-hero-plain {
    padding: 3rem 0 2rem;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border-light);
    margin-bottom: 0.75rem;
  }

  .housing-hero-plain::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 320px;
    height: 320px;
    background: var(--gradient-primary);
    border-radius: 50%;
    opacity: 0.08;
    transform: translate(28%, -40%);
    pointer-events: none;
  }

  .housing-hero-plain .container {
    position: relative;
    z-index: 1;
    max-width: 720px;
  }

  .housing-hero-plain h1 {
    margin: 0 0 1rem;
    font-size: clamp(1.85rem, 3.8vw, 2.55rem);
    font-weight: 700;
    line-height: 1.22;
    color: var(--color-text-primary);
  }

  .housing-hero-plain p {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.72;
    color: var(--color-text-secondary);
    font-weight: 500;
    text-align: left;
    max-width: 56ch;
  }

  .housing-list-section {
    padding-top: 0;
  }

  .housing-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .housing-filter-btn {
    padding: 0.5rem 1rem;
    border-radius: 8px;
    border: 1px solid var(--color-border-medium);
    background: var(--color-bg-white);
    color: var(--color-text-secondary);
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
  }

  .housing-filter-btn:hover {
    border-color: var(--color-primary);
    background: var(--color-bg-white);
    color: var(--color-secondary);
  }

  .housing-filter-btn.is-active {
    background: var(--color-primary-light);
    border-color: var(--color-primary);
    color: var(--color-secondary);
  }

  .housing-cards {
    display: grid;
    gap: 1.25rem;
  }

  .housing-card {
    --gallery-fill-a: rgba(12, 192, 223, 0.1);
    --gallery-fill-b: rgba(12, 192, 223, 0.22);
    --card-accent: var(--color-primary);
    display: grid;
    grid-template-columns: minmax(260px, 38%) minmax(0, 1fr);
    align-items: stretch;
    gap: 0;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--color-border-light);
    border-left: 4px solid var(--card-accent);
    background: var(--color-bg-white);
    box-shadow: 0 4px 24px rgba(44, 54, 63, 0.07);
    transition: box-shadow 0.22s ease;
  }

  .housing-card:hover {
    box-shadow: 0 10px 36px rgba(44, 54, 63, 0.12), 0 0 0 1px color-mix(in srgb, var(--card-accent) 18%, transparent);
  }

  .housing-card--accent-studio {
    --card-accent: #0ea5e9;
    --gallery-fill-a: rgba(14, 165, 233, 0.14);
    --gallery-fill-b: rgba(14, 165, 233, 0.32);
  }

  .housing-card--accent-wg {
    --card-accent: #a855f7;
    --gallery-fill-a: rgba(168, 85, 247, 0.13);
    --gallery-fill-b: rgba(168, 85, 247, 0.32);
  }

  .housing-card--accent-hostel {
    --card-accent: #ea580c;
    --gallery-fill-a: rgba(234, 88, 12, 0.12);
    --gallery-fill-b: rgba(234, 88, 12, 0.28);
  }

  .housing-card--accent-yurt {
    --card-accent: #059669;
    --gallery-fill-a: rgba(5, 150, 105, 0.12);
    --gallery-fill-b: rgba(5, 150, 105, 0.3);
  }

  /*
   * Sol sütun grid satırıyla aynı yükseklikte uzar; kalan alan .housing-gallery-spacer (flex-grow) ile dolar.
   * Boş div + flex:1 bazı tarayıcılarda 0px kalabildiği için içerik + flex: 1 1 0 kullanılıyor.
   */
  .housing-gallery-shell {
    position: relative;
    display: flex;
    flex-direction: column;
    align-self: stretch;
    min-height: 0;
    width: 100%;
    border-right: 1px solid color-mix(in srgb, var(--card-accent) 22%, var(--color-border-light));
    background: linear-gradient(
      165deg,
      var(--gallery-fill-a) 0%,
      color-mix(in srgb, var(--color-bg-white) 82%, var(--gallery-fill-b)) 52%,
      var(--gallery-fill-b) 100%
    );
  }

  .housing-gallery-spacer {
    flex: 1 1 0;
    min-height: 5.5rem;
    width: 100%;
    padding: 0.55rem 0.65rem 0.75rem;
    border-radius: 0 0 0 11px;
    border-top: 1px solid color-mix(in srgb, var(--card-accent) 35%, var(--color-border-light));
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-bg-white) 55%, var(--gallery-fill-b)) 0%,
      color-mix(in srgb, var(--card-accent) 22%, #f1f5f9) 100%
    );
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .housing-gallery-spacer-inner {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
    padding: 0.45rem 0.5rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.88);
    border: 1px solid var(--color-border-light);
    box-shadow: 0 2px 10px rgba(44, 54, 63, 0.06);
  }

  .housing-gallery-spacer-ic {
    flex-shrink: 0;
    margin-top: 0.12rem;
    font-size: 1.05rem;
    color: var(--card-accent);
  }

  .housing-gallery-spacer-text {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.5;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .housing-type-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 2;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.38rem 0.65rem;
    border-radius: 8px;
    color: #fff;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.35);
    box-shadow: 0 4px 14px rgba(44, 54, 63, 0.12);
  }

  .housing-type-badge--studio {
    background: linear-gradient(135deg, #38bdf8 0%, #0284c7 100%);
  }

  .housing-type-badge--wg {
    background: linear-gradient(135deg, #c084fc 0%, #9333ea 100%);
  }

  .housing-type-badge--hostel {
    background: linear-gradient(135deg, #fb923c 0%, #ea580c 100%);
  }

  .housing-type-badge--yurt {
    background: linear-gradient(135deg, #34d399 0%, #047857 100%);
  }

  .housing-status-pill {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 2;
    max-width: 56%;
    text-align: right;
    padding: 0.32rem 0.62rem;
    border-radius: 6px;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--color-secondary);
    background: var(--color-bg-yellow-soft);
    border: 1px solid rgba(255, 210, 31, 0.45);
  }

  .housing-gallery {
    position: relative;
    z-index: 1;
    flex: 0 0 auto;
    display: grid;
    gap: 0.55rem;
    padding: 0.65rem 0.65rem 0.6rem;
  }

  .housing-main-shot {
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--color-border-light);
    background: var(--color-bg-white);
    box-shadow: 0 2px 8px rgba(44, 54, 63, 0.06);
  }

  .housing-main-image {
    width: 100%;
    aspect-ratio: 4 / 5;
    height: auto;
    min-height: 0;
    max-height: 420px;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .housing-gallery-hint {
    margin: 0;
    padding: 0 0 0.1rem;
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  /* 8 küçük resim = 4×2 — sol kolon yüksekliği sağdaki içerikle daha iyi dengelenir */
  .housing-thumbs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.38rem;
  }

  .housing-thumb {
    border: 2px solid transparent;
    background: var(--color-bg-white);
    padding: 0;
    border-radius: 6px;
    cursor: pointer;
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  .housing-thumb:hover {
    border-color: var(--color-border-medium);
  }

  .housing-thumb img {
    width: 100%;
    height: 58px;
    object-fit: cover;
    display: block;
  }

  .housing-thumb.is-active {
    border-color: var(--card-accent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--card-accent) 35%, transparent);
  }

  .housing-details {
    display: grid;
    gap: 0.85rem;
    align-content: start;
    padding: 1rem 1.1rem 1.15rem;
    background: linear-gradient(180deg, color-mix(in srgb, var(--card-accent) 5%, #fff) 0%, #fff 72%);
  }

  .housing-detail-head h2 {
    margin: 0 0 0.35rem;
    font-size: 1.32rem;
    line-height: 1.26;
    color: #0f172a;
  }

  .housing-subtitle {
    margin: 0;
    font-size: 0.95rem;
    color: #64748b;
    font-weight: 600;
  }

  .housing-location-block {
    padding: 0.65rem 0.82rem;
    border-radius: 10px;
    background: linear-gradient(135deg, color-mix(in srgb, var(--card-accent) 9%, #fff) 0%, var(--color-bg-blue-soft) 100%);
    border: 1px solid color-mix(in srgb, var(--card-accent) 18%, var(--color-border-light));
  }

  .housing-location-main {
    margin: 0 0 0.28rem;
    font-weight: 800;
    color: #1e293b;
    font-size: 0.95rem;
    display: flex;
    gap: 0.45rem;
    align-items: flex-start;
  }

  .housing-location-extra,
  .housing-commute {
    margin: 0;
    font-size: 0.86rem;
    color: #64748b;
    line-height: 1.5;
    padding-left: 1.5rem;
  }

  .housing-commute {
    padding-top: 0.35rem;
    border-top: 1px dashed rgba(148, 163, 184, 0.45);
    margin-top: 0.45rem;
  }

  .housing-inline-ic {
    color: var(--card-accent, #6366f1);
    margin-top: 0.08rem;
    flex-shrink: 0;
  }

  .housing-wg-banner {
    border-radius: 10px;
    padding: 0.82rem 0.92rem;
    background: var(--color-bg-yellow-soft);
    border: 1px dashed rgba(203, 213, 225, 0.95);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
  }

  .housing-wg-title {
    font-weight: 800;
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-secondary);
    margin-bottom: 0.65rem;
    display: flex;
    gap: 0.45rem;
    align-items: center;
  }

  .housing-wg-rows {
    display: grid;
    gap: 0.72rem;
  }

  @media (min-width: 620px) {
    .housing-wg-rows {
      grid-template-columns: 1fr 1fr;
    }
  }

  .housing-wg-block {
    display: grid;
    gap: 0.4rem;
  }

  .housing-wg-block--accent .housing-wg-label {
    color: #b45309;
  }

  .housing-wg-block--accent .housing-wg-banner,
  .housing-wg-block--accent {
    background: transparent;
  }

  .housing-wg-label {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #6b7280;
  }

  .housing-pill-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .housing-pill-list li {
    margin: 0;
  }

  .housing-pill {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 800;
    padding: 0.36rem 0.72rem;
    border-radius: 999px;
    line-height: 1.35;
    box-shadow: 0 4px 10px rgba(15, 23, 42, 0.08);
  }

  .housing-pill--female {
    background: linear-gradient(135deg, #fce7f3, #fbcfe8);
    color: #9d174d;
    border: 1px solid #f472b6;
  }

  .housing-pill--male {
    background: linear-gradient(135deg, #dbeafe, #bfdbfe);
    color: #1e3a8a;
    border: 1px solid #60a5fa;
