const bookingSlug = getBookingPath(lang as SupportedLang);
---

<section class="bundle-offers-section" aria-labelledby="bundle-offers-heading">
  <div class="container">
    <div class="bundle-offers-header">
      <h2 id="bundle-offers-heading" class="bundle-offers-title">{m.sectionTitle}</h2>
    </div>

    <div class="bundle-offers-grid">
      <article class="bundle-card bundle-card--mint">
        <div class="bundle-card-badges">
          <span class="bundle-card-badge">{m.badge}</span>
          <span class="bundle-card-badge bundle-card-badge--popular">{m.popularBadge}</span>
        </div>
        <h3 class="bundle-card-heading">{m.card1Title}</h3>
        <p class="bundle-card-tagline">{m.card1Subtitle}</p>
        <p class="bundle-card-text bundle-card-text--compact">{m.card1Desc}</p>

        <div class="bundle-simple-prices">
          <p><span>{m.normalLabel}</span><s>{m.card1ListStrikeTotal}</s></p>
          <p><span>{m.bundleLabel}</span><strong>{m.card1DiscountedTotal}</strong></p>
          <p class="bundle-simple-save">{m.perKurPromoLabel}: {m.card1PerKurPromoValue}</p>
        </div>

        <a href={`/${lang}/${bookingSlug}?bundle=a2c1`} class="bundle-card-cta bundle-card-cta--buy">{m.ctaBuyNow}</a>
      </article>

      <article class="bundle-card bundle-card--ocean">
        <span class="bundle-card-badge">{m.badge}</span>
        <h3 class="bundle-card-heading">{m.card2Title}</h3>
        <p class="bundle-card-tagline">{m.card2Subtitle}</p>
        <p class="bundle-card-text bundle-card-text--compact">{m.card2Desc}</p>

        <div class="bundle-simple-prices">
          <p><span>{m.normalLabel}</span><s>{m.card2ListStrikeTotal}</s></p>
          <p><span>{m.bundleLabel}</span><strong>{m.card2DiscountedTotal}</strong></p>
          <p class="bundle-simple-save">{m.perKurPromoLabel}: {m.card2PerKurPromoValue}</p>
        </div>

        <a href={`/${lang}/${bookingSlug}?bundle=b1c1`} class="bundle-card-cta bundle-card-cta--buy">{m.ctaBuyNow}</a>
      </article>

      <article class="bundle-card bundle-card--pathway">
        <span class="bundle-card-badge bundle-card-badge--light">{m.badge}</span>
        <h3 class="bundle-card-heading">{m.card3Title}</h3>
        <p class="bundle-card-tagline">{m.card3Subtitle}</p>
        <p class="bundle-card-text bundle-card-text--compact">{m.card3Intro}</p>

        <div class="bundle-simple-prices">
          <p><span>{m.normalLabel}</span><s>760 €</s></p>
          <p><span>{m.bundleLabel}</span><strong>440 €</strong></p>
        </div>

        <a href={`/${lang}/${bookingSlug}?bundle=bremen`} class="bundle-card-cta bundle-card-cta--light bundle-card-cta--buy">{m.ctaBuyNow}</a>
      </article>
    </div>
  </div>
</section>

<style>
  .bundle-offers-section {
    padding: 2.75rem 0 1.5rem;
    background: linear-gradient(180deg, #f8fafc 0%, #fff 100%);
  }
  .bundle-offers-header {
    margin-bottom: 1.25rem;
    max-width: 720px;
  }
  .bundle-offers-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-primary, #0b1220);
    margin: 0;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-primary, #059669);
  }
  .bundle-ref-caption {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    opacity: 0.9;
    margin: 0 0 0.35rem;
  }
  .bundle-card .bundle-ref-caption {
    color: rgba(255, 255, 255, 0.95);
  }
  .bundle-simple-prices {
    margin: 0.35rem 0 0.9rem;
    padding: 0.65rem 0.75rem;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  .bundle-simple-prices p {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: 0;
    gap: 0.75rem;
    padding: 0.25rem 0;
    font-size: 0.86rem;
  }
  .bundle-simple-prices p span {
    font-weight: 600;
    opacity: 0.95;
  }
  .bundle-simple-prices p s {
    font-weight: 600;
    opacity: 0.9;
  }
  .bundle-simple-prices p strong {
    font-size: 1.08rem;
  }
  .bundle-simple-save {
    margin-top: 0.25rem !important;
    border-top: 1px dashed rgba(255, 255, 255, 0.28);
    padding-top: 0.42rem !important;
    font-weight: 800;
    color: #fde68a;
  }
  .bundle-offers-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    align-items: stretch;
  }
  @media (max-width: 1024px) {
    .bundle-offers-grid {
      grid-template-columns: 1fr;
      max-width: 520px;
      margin-inline: auto;
    }
  }
  .bundle-card {
    position: relative;
    height: 100%;
    min-height: 100%;
    border-radius: 16px;
    padding: 1.35rem 1.35rem 1.5rem;
    color: #fff;
    display: flex;
    flex-direction: column;
    box-shadow: 0 8px 28px rgba(15, 23, 42, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  .bundle-card--mint {
    background: linear-gradient(145deg, #0d9488 0%, #0f766e 55%, #115e59 100%);
  }
  .bundle-card--ocean {
    background: linear-gradient(145deg, #2563eb 0%, #1d4ed8 50%, #1e3a8a 100%);
  }
  .bundle-card--pathway {
    background: linear-gradient(145deg, #5b21b6 0%, #6d28d9 40%, #4c1d95 100%);
  }
  .bundle-card-badge {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.2);
    margin-bottom: 0.75rem;
  }
  .bundle-card-badges {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }
  .bundle-card-badges .bundle-card-badge {
    margin-bottom: 0;
  }
  .bundle-card-badge--popular {
    background: #facc15;
    color: #1f2937;
    font-weight: 800;
  }
  .bundle-card-badge--light {
    background: rgba(255, 255, 255, 0.25);
  }
  .bundle-card-heading {
    font-size: 1.35rem;
    font-weight: 800;
    margin: 0 0 0.5rem;
    line-height: 1.2;
  }
  .bundle-card-tagline {
    font-size: 0.95rem;
    font-weight: 600;
    opacity: 0.95;
    margin: 0 0 0.5rem;
  }
  .bundle-card-text {
    font-size: 0.9rem;
    line-height: 1.5;
    opacity: 0.95;
    margin: 0 0 1rem;
    flex: 1;
  }
  .bundle-card-text--compact {
    font-size: 0.82rem;
    margin-bottom: 0.85rem;
  }
  .bundle-card-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: auto;
    padding: 0.65rem 1rem;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    color: #0f766e;
    background: #fff;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .bundle-card-cta--buy {
    width: 100%;
    align-self: stretch;
    justify-content: center;
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    padding: 0.75rem 1rem;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.12);
  }
  .bundle-card-cta--buy:hover {
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.18);
  }
  .bundle-card--ocean .bundle-card-cta {
    color: #1d4ed8;
  }
  .bundle-card-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
  }
  .bundle-card-cta--light {
    color: #4c1d95;
  }
  .bundle-pathway-table-wrap {
    margin: 0 -0.25rem 0.75rem;
    overflow-x: auto;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.12);
  }
  .bundle-pathway-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.72rem;
    line-height: 1.35;
  }
  @media (min-width: 480px) {
    .bundle-pathway-table {
      font-size: 0.78rem;
    }
  }
  .bundle-pathway-table th,
  .bundle-pathway-table td {
    padding: 0.45rem 0.5rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }
  .bundle-pathway-table th {
    font-weight: 700;
    width: 32%;
    color: #fff;
  }
  .bundle-pathway-table td {
    color: rgba(255, 255, 255, 0.95);
  }
  .bundle-pathway-num {
    text-align: right;
    white-space: nowrap;
    font-weight: 700;
  }
  .bundle-pathway-sub th,
  .bundle-pathway-sub td {
    font-size: 0.68rem;
    opacity: 0.92;
  }
  .bundle-pathway-totals {
    margin-top: 0.25rem;
    margin-bottom: 0.75rem;
    font-size: 0.85rem;
  }
  .bundle-pathway-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.35rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }
  .bundle-pathway-row--highlight {
    margin-top: 0.25rem;
    padding: 0.55rem 0.65rem;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.25);
    flex-wrap: wrap;
    align-items: flex-start;
  }
  .bundle-highlight-main {
    flex: 1 1 11rem;
    min-width: 0;
  }
  .bundle-highlight-total,
  .bundle-pathway-row--highlight > strong {
    font-size: 1.15rem;
  }
  .bundle-highlight-total {
    align-self: center;
    white-space: nowrap;
  }
  .bundle-perkur-stack {
    margin-top: 0.45rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.78rem;
    line-height: 1.35;
  }
  .bundle-perkur-line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    max-width: 18rem;
  }
  .bundle-perkur-label {
    font-weight: 500;
    opacity: 0.92;
  }
  .bundle-perkur-num,
  .bundle-perkur-promo-num {
    font-size: 0.92rem;
  }
  .bundle-perkur-line .bundle-price-strike {
    font-weight: 700;
    text-decoration: line-through;
    text-decoration-thickness: 2px;
    opacity: 0.88;
  }
  .bundle-pathway-row--strike-row .bundle-price-strike {
    font-weight: 700;
    text-decoration: line-through;
    text-decoration-thickness: 2px;
    opacity: 0.88;
  }
  .bundle-promo-line {
    display: block;
    font-weight: 600;
    line-height: 1.35;
    font-size: 0.8rem;
  }
  .bundle-promo-pack-name {
    font-weight: 500;
    opacity: 0.92;
  }
</style>
