---
/**
 * CHECK24 consultant card: one advisor at a time, horizontal layout,
 * carousel arrows, callback modal. Call/WhatsApp CTAs removed.
 */
import {
  PERSONAL_ADVISORS,
  defaultAdvisorIdForLang,
  type AdvisorLang,
} from '../data/personalAdvisors';

interface Props {
  lang: string;
  class?: string;
}

const { lang, class: className = '' } = Astro.props;
const pageLang: AdvisorLang =
  lang === 'de' || lang === 'en' || lang === 'es' || lang === 'tr' ? lang : 'en';
const startId = defaultAdvisorIdForLang(pageLang);
const startIndex = Math.max(
  0,
  PERSONAL_ADVISORS.findIndex((a) => a.id === startId)
);

const ui = {
  tr: {
    request: 'Beni ara',
    prev: 'Önceki danışman',
    next: 'Sonraki danışman',
    modalTitle: 'Danışmanlık talebi',
    firstName: 'Ad',
    lastName: 'Soyad',
    phone: 'Cep telefonu',
    phoneHint: 'Danışmanımız sizi bu numaradan arar.',
    email: 'E-posta',
    emailHint: 'Onayı bu adrese göndeririz.',
    send: 'Gönder',
    close: 'Kapat',
    sending: 'Gönderiliyor…',
    ok: 'Talebiniz alındı. Kısa sürede dönüş yapacağız.',
    err: 'Gönderilemedi. Lütfen tekrar deneyin.',
    benefit1: 'Ücretsiz ve bağlayıcı olmayan danışmanlık',
    benefit2: 'Kurs ve kayıt konusunda kişisel destek',
    legal:
      'Göndererek Campus German’ın sizinle danışmanlık için iletişime geçmesine izin vermiş olursunuz. İstediğiniz zaman vazgeçebilirsiniz.',
  },
  de: {
    request: 'Rückruf',
    prev: 'Vorheriger Berater',
    next: 'Nächster Berater',
    modalTitle: 'Beratungsanfrage',
    firstName: 'Vorname',
    lastName: 'Nachname',
    phone: 'Mobilnummer',
    phoneHint: 'Für unsere persönliche Beratung.',
    email: 'E-Mail-Adresse',
    emailHint: 'Wir senden die Bestätigung an diese Adresse.',
    send: 'Absenden',
    close: 'Schließen',
    sending: 'Wird gesendet…',
    ok: 'Anfrage eingegangen. Wir melden uns bald.',
    err: 'Senden fehlgeschlagen. Bitte erneut versuchen.',
    benefit1: 'Kostenlos und unverbindlich',
    benefit2: 'Persönliche Hilfe zu Kurs und Anmeldung',
    legal:
      'Mit dem Absenden willigen Sie ein, dass Campus German Sie zur Beratung kontaktieren darf. Widerruf jederzeit möglich.',
  },
  en: {
    request: 'Call me back',
    prev: 'Previous advisor',
    next: 'Next advisor',
    modalTitle: 'Request a callback',
    firstName: 'First name',
    lastName: 'Last name',
    phone: 'Mobile number',
    phoneHint: 'For our personal Campus German advice.',
    email: 'Email address',
    emailHint: 'We will send the confirmation to this address.',
    send: 'Send request',
    close: 'Close',
    sending: 'Sending…',
    ok: 'Request received. We will get back to you soon.',
    err: 'Could not send. Please try again.',
    benefit1: 'Free and non-binding advice',
    benefit2: 'Personal support for course and enrolment',
    legal:
      'By submitting you agree that Campus German may contact you for advice. You can withdraw consent at any time.',
  },
  es: {
    request: 'Que me llamen',
    prev: 'Asesor anterior',
    next: 'Siguiente asesor',
    modalTitle: 'Solicitar llamada',
    firstName: 'Nombre',
    lastName: 'Apellido',
    phone: 'Móvil',
    phoneHint: 'Para nuestra asesoría personal.',
    email: 'Correo electrónico',
    emailHint: 'Enviaremos la confirmación a esta dirección.',
    send: 'Enviar',
    close: 'Cerrar',
    sending: 'Enviando…',
    ok: 'Solicitud recibida. Nos pondremos en contacto pronto.',
    err: 'No se pudo enviar. Inténtelo de nuevo.',
    benefit1: 'Asesoría gratuita y sin compromiso',
    benefit2: 'Apoyo personal con el curso y la inscripción',
    legal:
      'Al enviar acepta que Campus German le contacte para asesorarle. Puede retirar el consentimiento en cualquier momento.',
  },
}[pageLang];

const uid = `phc-${Math.random().toString(36).slice(2, 9)}`;
const startAdvisor = PERSONAL_ADVISORS[startIndex];
---

<section class={`phc ${className}`.trim()} data-phc data-start={startIndex} data-lang={pageLang} id={uid}>
  {
    PERSONAL_ADVISORS.map((a, i) => (
      <article
        class={`phc__card${i === startIndex ? ' is-on' : ''}`}
        data-phc-card
        data-id={a.id}
        data-advisor={a.name}
        hidden={i !== startIndex}
      >
        {/* 1 — Left: profile (unchanged content) */}
        <div class="phc__profile">
          <img
            class="phc__photo"
            src={a.photo}
            alt=""
            width="72"
            height="72"
            loading="lazy"
            decoding="async"
          />
          <strong class="phc__name">{a.name}</strong>
          <div class="phc__stars" aria-hidden="true">
            <i class="fas fa-star"></i>
            <i class="fas fa-star"></i>
            <i class="fas fa-star"></i>
            <i class="fas fa-star"></i>
            <i class="fas fa-star"></i>
          </div>
          <p class="phc__phone">
            <i class="fas fa-phone-alt" aria-hidden="true"></i>
            <span>{a.phoneDisplay}</span>
          </p>
          <p class="phc__personal">{a.personalLine[pageLang]}</p>
        </div>

        {/* 2 — Main: [‹ bubble ›][Call me back] one row; meta under bubble */}
        <div class="phc__main">
          <div class="phc__main-row">
            <button type="button" class="phc__nav phc__nav--prev" data-phc-prev aria-label={ui.prev}>
              <i class="fas fa-chevron-left" aria-hidden="true"></i>
            </button>
            <div class="phc__bubble-wrap">
              <blockquote class="phc__bubble">
                <p>{a.bubble[pageLang]}</p>
              </blockquote>
              <div class="phc__meta">
                <span class="phc__role">{a.role[pageLang]}</span>
                <span class="phc__langs">{a.spoken.join(', ')}</span>
              </div>
            </div>
            <button type="button" class="phc__nav phc__nav--next" data-phc-next aria-label={ui.next}>
              <i class="fas fa-chevron-right" aria-hidden="true"></i>
            </button>
            <button
              type="button"
              class="phc__btn"
              data-phc-request
              data-advisor={a.name}
            >
              {ui.request}
            </button>
          </div>
        </div>
      </article>
    ))
  }
</section>

<div class="phc-modal" data-phc-modal hidden>
  <div class="phc-modal__backdrop" data-phc-close></div>
  <div class="phc-modal__panel" role="dialog" aria-modal="true" aria-labelledby={`${uid}-title`}>
    <button type="button" class="phc-modal__x" data-phc-close aria-label={ui.close}>
      <i class="fas fa-times" aria-hidden="true"></i>
    </button>

    <form class="phc-modal__shell" data-phc-form>
      <div class="phc-modal__body">
        <div class="phc-modal__main">
          <h3 id={`${uid}-title`}>{ui.modalTitle}</h3>
          <input type="hidden" name="advisor" value="" data-phc-advisor-field />
          <input type="text" name="website" class="phc-modal__honey" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <label class="phc-field">
            <span class="phc-field__label">{ui.phone}</span>
            <input type="tel" name="phone" required autocomplete="tel" placeholder={ui.phone} />
            <span class="phc-field__hint">{ui.phoneHint}</span>
          </label>

          <div class="phc-field-row">
            <label class="phc-field">
              <span class="phc-field__label">{ui.firstName}</span>
              <input type="text" name="firstName" required autocomplete="given-name" placeholder={ui.firstName} />
            </label>
            <label class="phc-field">
              <span class="phc-field__label">{ui.lastName}</span>
              <input type="text" name="lastName" required autocomplete="family-name" placeholder={ui.lastName} />
            </label>
          </div>

          <label class="phc-field">
            <span class="phc-field__label">{ui.email}</span>
            <input type="email" name="email" required autocomplete="email" placeholder={ui.email} />
            <span class="phc-field__hint">{ui.emailHint}</span>
          </label>

          <p class="phc-modal__msg" data-phc-msg hidden></p>
        </div>

        <aside class="phc-modal__aside" data-phc-aside>
          <div class="phc-modal__avatar">
            <img src={startAdvisor.photo} alt="" width="112" height="112" data-phc-aside-photo />
          </div>
          <strong class="phc-modal__advisor-name" data-phc-aside-name>{startAdvisor.name}</strong>
          <p class="phc-modal__bubble" data-phc-aside-bubble>{startAdvisor.bubble[pageLang]}</p>
          <ul class="phc-modal__benefits">
            <li><i class="fas fa-check" aria-hidden="true"></i> {ui.benefit1}</li>
            <li><i class="fas fa-check" aria-hidden="true"></i> {ui.benefit2}</li>
          </ul>
        </aside>
      </div>

      <div class="phc-modal__footer">
        <p class="phc-modal__legal">{ui.legal}</p>
        <div class="phc-modal__footer-actions">
          <button type="submit" class="phc-modal__submit" data-phc-submit>{ui.send}</button>
        </div>
      </div>
    </form>
  </div>
</div>

<style is:global>
  .phc {
    --phc-cyan: #0cc0df;
    --phc-navy: #0a2959;
    --phc-line: #e2e8f0;
    --phc-muted: #64748b;
    --phc-quote: #ecf7fd;
    --phc-btn: #1e6bb8;
    margin: 18px 0 6px;
    padding: 0;
    border: none;
    background: transparent;
    box-sizing: border-box;
  }

  /* Dense Check24-style card: profile | [‹ bubble ›][CTA] + meta under bubble */
  .phc__card {
    display: none;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 8px 12px;
    align-items: center;
    margin: 0;
    padding: 10px 12px;
    border: 1px solid var(--phc-line);
    border-radius: 10px;
    background: #fff;
    box-sizing: border-box;
    height: auto;
    min-height: 0;
  }
  .phc__card.is-on {
    display: grid;
  }
  .phc__card[hidden] {
    display: none !important;
  }

  /* —— Left: profile —— */
  .phc__profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-width: 0;
    max-width: 118px;
  }
  .phc__photo {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    margin: 0 0 6px;
    flex: 0 0 auto;
  }
  .phc__name {
    display: block;
    color: #1a1a1a;
    font-size: 0.95rem;
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 4px;
  }
  .phc__stars {
    display: flex;
    gap: 2px;
    justify-content: center;
    margin: 0 0 5px;
    color: #f5a623;
    font-size: 0.62rem;
    line-height: 1;
  }
  .phc__phone {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin: 0 0 4px;
    color: #475569;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
  }
  .phc__phone i {
    font-size: 0.65rem;
    color: #94a3b8;
  }
  .phc__personal {
    margin: 0;
    color: #94a3b8;
    font-size: 0.65rem;
    line-height: 1.25;
    font-weight: 500;
  }

  /* —— Main: one horizontal action row —— */
  .phc__main {
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .phc__main-row {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }
  .phc__bubble-wrap {
    flex: 1 1 auto;
    min-width: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .phc__bubble {
    position: relative;
    margin: 0;
    width: 100%;
    padding: 14px 18px;
    border-radius: 8px;
    background: var(--phc-quote);
    box-sizing: border-box;
    min-height: 64px;
    display: flex;
    align-items: center;
  }
  .phc__bubble::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 50%;
    transform: translateY(-50%);
    border: 7px solid transparent;
    border-right-color: var(--phc-quote);
    border-left: 0;
  }
  .phc__bubble p {
    margin: 0;
    color: #334155;
    font-size: 0.95rem;
    line-height: 1.45;
    font-weight: 500;
  }
  .phc__nav {
    flex: 0 0 auto;
    width: 24px;
    height: 32px;
    padding: 0;
    border: 0;
    background: transparent;
    color: #94a3b8;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
  }
  .phc__nav:hover { color: var(--phc-cyan); }
  .phc__meta {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .phc__role {
    color: #334155;
    font-size: 0.7rem;
    font-weight: 650;
    line-height: 1.2;
  }
  .phc__langs {
    color: #94a3b8;
    font-size: 0.68rem;
    font-weight: 500;
    line-height: 1.2;
  }
  .phc__btn {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 132px;
    height: 34px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1.5px solid var(--phc-btn);
    background: #fff;
    color: var(--phc-btn);
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    box-sizing: border-box;
    white-space: nowrap;
  }
  .phc__btn:hover {
    background: #f0f7fc;
  }

  /* ===== Modal — body'ye taşınır, viewport fixed ===== */
  .phc-modal[hidden] { display: none !important; }
  .phc-modal {
    position: fixed !important;
    inset: 0 !important;
    z-index: 2147483000 !important;
    display: flex !important;
    align-items: center;
    justify-content: center;
    padding: max(12px, env(safe-area-inset-top)) 12px max(12px, env(safe-area-inset-bottom));
    box-sizing: border-box;
  }
  .phc-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
  }
  .phc-modal__panel {
    position: relative;
    z-index: 1;
    width: min(740px, 100%);
    max-height: min(92dvh, 880px);
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 18px;
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.28);
    overflow: hidden;
  }
  .phc-modal__shell {
    display: flex;
    flex-direction: column;
    min-height: 0;
    flex: 1 1 auto;
    margin: 0;
  }
  .phc-modal__x {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 3;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 50%;
    background: #f1f5f9;
    color: #475569;
    cursor: pointer;
  }
  .phc-modal__x:hover { background: #e2e8f0; }

  .phc-modal__body {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 28px;
    padding: 28px 28px 16px;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    flex: 1 1 auto;
    min-height: 0;
    box-sizing: border-box;
  }
  .phc-modal__main {
    flex: 1 1 0;
    min-width: 0;
  }
  .phc-modal__aside {
    flex: 0 0 220px;
    width: 220px;
    text-align: center;
    padding-top: 4px;
  }

  .phc-modal__main h3 {
    margin: 0 0 16px;
    padding-right: 40px;
    color: var(--phc-navy);
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .phc-field {
    display: block;
    margin: 0 0 12px;
  }
  .phc-field__label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .phc-field input {
    display: block;
    width: 100%;
    height: 48px;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 0 14px;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--phc-navy);
    background: #fff;
    box-sizing: border-box;
  }
  .phc-field input:focus {
    outline: none;
    border-color: var(--phc-cyan);
    box-shadow: 0 0 0 3px rgba(12, 192, 223, 0.16);
  }
  .phc-field__hint {
    display: block;
    margin-top: 5px;
    color: var(--phc-muted);
    font-size: 0.78rem;
    line-height: 1.35;
  }
  .phc-field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .phc-modal__honey {
    position: absolute !important;
    left: -9999px !important;
    opacity: 0 !important;
    height: 0 !important;
    width: 0 !important;
    pointer-events: none !important;
  }
  .phc-modal__msg {
    margin: 4px 0 0;
    font-size: 0.88rem;
    font-weight: 650;
  }
  .phc-modal__msg.is-ok { color: #0f766e; }
  .phc-modal__msg.is-bad { color: #b91c1c; }

  .phc-modal__avatar {
    width: 112px;
    height: 112px;
    margin: 0 auto 10px;
    border-radius: 50%;
    padding: 3px;
    background: conic-gradient(from 210deg, #e31c23, #ffd21f, #0cc0df, #e31c23);
    box-sizing: border-box;
  }
  .phc-modal__avatar img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    border: 3px solid #fff;
    box-sizing: border-box;
  }
  .phc-modal__advisor-name {
    display: block;
    margin: 0 0 10px;
    color: var(--phc-navy);
    font-size: 1.05rem;
    font-weight: 800;
  }
  .phc-modal__bubble {
    margin: 0 auto;
    padding: 12px 14px;
    border-radius: 14px;
    background: #e8f8fc;
    color: var(--phc-navy);
    font-size: 0.88rem;
    line-height: 1.4;
    font-weight: 600;
    text-align: left;
  }
  .phc-modal__benefits {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    text-align: left;
    display: grid;
    gap: 8px;
  }
  .phc-modal__benefits li {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    color: #334155;
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .phc-modal__benefits li i {
    color: #16a34a;
    margin-top: 2px;
    flex: 0 0 auto;
  }

  .phc-modal__footer {
    flex: 0 0 auto;
    border-top: 1px solid var(--phc-line);
    padding: 14px 28px 18px;
    background: #fafbfc;
  }
  .phc-modal__legal {
    margin: 0 0 12px;
    color: var(--phc-muted);
    font-size: 0.72rem;
    line-height: 1.45;
  }
  .phc-modal__footer-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
  }
  .phc-modal__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 168px;
    height: 48px;
    padding: 0 22px;
    border: 0 !important;
    border-radius: 999px;
    background: #0cc0df !important;
    background-image: none !important;
    color: #0a2959 !important;
    -webkit-text-fill-color: #0a2959 !important;
    font-family: inherit;
    font-size: 0.95rem !important;
    font-weight: 800 !important;
    line-height: 1.2 !important;
    letter-spacing: 0.01em;
    cursor: pointer;
    box-shadow: 0 8px 18px rgba(12, 192, 223, 0.28);
    -webkit-appearance: none;
    appearance: none;
    text-shadow: none;
    opacity: 1;
  }
  .phc-modal__submit:hover {
    filter: brightness(0.97);
    color: #0a2959 !important;
    -webkit-text-fill-color: #0a2959 !important;
  }
  .phc-modal__submit:disabled {
    opacity: 0.55;
    cursor: not-allowed;
    color: #0a2959 !important;
    -webkit-text-fill-color: #0a2959 !important;
  }

  /* Compact / booking column (~760px) */
  @media (max-width: 820px) {
    .phc__card {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 6px 10px;
      padding: 8px 10px;
    }
    .phc__profile { max-width: 100px; }
    .phc__photo { width: 64px; height: 64px; }
    .phc__name { font-size: 0.88rem; }
    .phc__phone { font-size: 0.66rem; white-space: normal; }
    .phc__bubble { padding: 12px 14px; min-height: 56px; }
    .phc__bubble p { font-size: 0.88rem; }
    .phc__btn { min-width: 118px; height: 32px; font-size: 0.76rem; padding: 0 12px; }
  }

  @media (max-width: 640px) {
    .phc__card {
      grid-template-columns: 88px minmax(0, 1fr);
      gap: 6px 8px;
      padding: 8px;
    }
    .phc__main-row {
      flex-wrap: wrap;
      row-gap: 6px;
    }
    .phc__bubble-wrap {
      flex: 1 1 calc(100% - 56px);
    }
    .phc__btn {
      flex: 1 1 100%;
      width: 100%;
      min-width: 0;
      order: 5;
    }
    .phc__nav--prev { order: 1; }
    .phc__bubble-wrap { order: 2; }
    .phc__nav--next { order: 3; }
    .phc__nav--prev { display: none; }
  }

  @media (max-width: 900px) {
    .phc-modal__body {
      flex-direction: column;
      gap: 16px;
      padding: 22px 18px 12px;
    }
    .phc-modal__aside {
      flex: none;
      width: 100%;
      order: -1;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .phc-modal__bubble { width: 100%; max-width: 420px; }
    .phc-modal__benefits { width: 100%; max-width: 420px; }
    .phc-field-row { grid-template-columns: 1fr; }
    .phc-modal__main h3 { font-size: 1.2rem; }
    .phc-modal__footer { padding: 12px 18px 16px; }
    .phc-modal__footer-actions { align-items: stretch; }
    .phc-modal__submit { width: 100%; min-width: 0; }
  }

  @media (max-width: 480px) {
    .phc-modal { padding: 0; align-items: stretch; }
    .phc-modal__panel {
      width: 100%;
      max-height: 100dvh;
      height: 100dvh;
      border-radius: 0;
    }
    .phc-modal__avatar { width: 96px; height: 96px; }
  }

  html.phc-modal-open,
  body.phc-modal-open {
    overflow: hidden !important;
  }
</style>

<script define:vars={{ ui, advisors: PERSONAL_ADVISORS, pageLang }}>
  (function () {
    const roots = document.querySelectorAll('[data-phc]');
    roots.forEach((root) => {
      if (root.dataset.bound === '1') return;
      root.dataset.bound = '1';
      const cards = Array.from(root.querySelectorAll('[data-phc-card]'));
      let idx = Number(root.dataset.start || 0) || 0;

      let modalEl = root.nextElementSibling;
      while (modalEl && !(modalEl.matches && modalEl.matches('[data-phc-modal]'))) {
        modalEl = modalEl.nextElementSibling;
      }
      if (!modalEl && root.parentElement) {
        modalEl = root.parentElement.querySelector(':scope > [data-phc-modal]');
      }
      if (modalEl && modalEl.parentElement !== document.body) {
        document.body.appendChild(modalEl);
      }

      const form = modalEl?.querySelector('[data-phc-form]');

      function showCard(i) {
        idx = (i + cards.length) % cards.length;
        cards.forEach((c, n) => {
          const on = n === idx;
          c.classList.toggle('is-on', on);
          c.hidden = !on;
        });
      }

      showCard(idx);

      root.addEventListener('click', (e) => {
        const t = e.target;
        if (!(t instanceof Element)) return;
        if (t.closest('[data-phc-prev]')) {
          e.preventDefault();
          showCard(idx - 1);
          return;
        }
        if (t.closest('[data-phc-next]')) {
          e.preventDefault();
          showCard(idx + 1);
          return;
        }
        const req = t.closest('[data-phc-request]');
        if (req) {
          openModal(req.getAttribute('data-advisor') || cards[idx]?.getAttribute('data-advisor') || '');
        }
      });

      function openModal(advisorName) {
        if (!modalEl) return;
        const field = modalEl.querySelector('[data-phc-advisor-field]');
        if (field) field.value = advisorName || '';
        const a = advisors.find((x) => x.name === advisorName) || advisors[idx];
        const photo = modalEl.querySelector('[data-phc-aside-photo]');
        const bubble = modalEl.querySelector('[data-phc-aside-bubble]');
        const nameEl = modalEl.querySelector('[data-phc-aside-name]');
        if (a && photo) photo.src = a.photo;
        if (a && bubble) bubble.textContent = a.bubble[pageLang] || a.bubble.en;
        if (a && nameEl) nameEl.textContent = a.name;
        const msg = modalEl.querySelector('[data-phc-msg]');
        if (msg) { msg.hidden = true; msg.textContent = ''; }
        document.documentElement.classList.add('phc-modal-open');
        document.body.classList.add('phc-modal-open');
        modalEl.hidden = false;
      }
      function closeModal() {
        if (modalEl) modalEl.hidden = true;
        document.documentElement.classList.remove('phc-modal-open');
        document.body.classList.remove('phc-modal-open');
      }
      modalEl?.querySelectorAll('[data-phc-close]').forEach((el) => el.addEventListener('click', closeModal));

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        if (String(fd.get('website') || '').trim()) return;
        const msg = modalEl.querySelector('[data-phc-msg]');
        const submit = modalEl.querySelector('[data-phc-submit]');
        const first = String(fd.get('firstName') || '').trim();
        const last = String(fd.get('lastName') || '').trim();
        const fullName = [first, last].filter(Boolean).join(' ');
        if (submit) {
          submit.disabled = true;
          submit.textContent = ui.sending;
        }
        try {
          const res = await fetch('https://hook.eu2.make.com/40s1h4a3wra21aszpa9y9erfsfooso47', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              formType: 'personal-help-callback',
              lang: pageLang,
              advisor: String(fd.get('advisor') || ''),
              name: fullName,
              firstName: first,
              lastName: last,
              phone: String(fd.get('phone') || ''),
              email: String(fd.get('email') || ''),
              sourcePage: window.location.pathname,
              submittedAt: new Date().toISOString(),
            }),
          });
          if (!res.ok) throw new Error('fail');
          if (msg) {
            msg.hidden = false;
            msg.className = 'phc-modal__msg is-ok';
            msg.textContent = ui.ok;
          }
          form.reset();
          setTimeout(closeModal, 1400);
        } catch (_) {
          if (msg) {
            msg.hidden = false;
            msg.className = 'phc-modal__msg is-bad';
            msg.textContent = ui.err;
          }
        } finally {
          if (submit) {
            submit.disabled = false;
            submit.textContent = ui.send;
          }
        }
      });
    });
  })();
</script>
