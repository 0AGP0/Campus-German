---
/**
 * Tek ofis iletişim kartı — mockup’taki bayrak düzeni.
 */
interface Props {
  lang: string;
  mapLinkUrl: string;
}

const { lang, mapLinkUrl } = Astro.props;

const OFFICE = {
  company: 'Campus German Sprachschule GmbH',
  address: 'Bürgermeister Smidt Str. 80, 28195 Bremen, Germany',
  email: 'info@campusgerman.com',
  waBremen: '+49 163 692 7842',
  waBremenHref: 'https://wa.me/491636927842',
  waIntl: '+49 1520 3823792',
  waIntlHref: 'https://wa.me/4915203823792',
};

const BREMEN_FLAGS = ['de', 'gb'] as const;
const INTL_FLAGS = ['gb', 'fr', 'es', 'pt', 'tr', 'uz', 'cn', 'kr'] as const;

const copy = {
  tr: {
    officeBadge: 'Ofis',
    city: 'Bremen, Almanya',
    locationLabel: 'Okul konumu',
    mapLinkText: 'Haritada aç',
    emailLabel: 'E-Mail',
    whatsappLabel: 'WhatsApp',
    waBremenLabel: 'Bremen Office',
    waIntlLabel: 'International Admissions',
    workingHoursTitle: 'Çalışma saatleri',
    workingHours: {
      weekdays: 'Hafta içi: 09:00 – 21:00',
      saturday: 'Cumartesi: 09:00 – 18:00',
      sunday: 'Pazar: Kapalı',
    },
  },
  de: {
    officeBadge: 'Büro',
    city: 'Bremen, Deutschland',
    locationLabel: 'Schulstandort',
    mapLinkText: 'In Karte öffnen',
    emailLabel: 'E-Mail',
    whatsappLabel: 'WhatsApp',
    waBremenLabel: 'Bremen Office',
    waIntlLabel: 'International Admissions',
    workingHoursTitle: 'Öffnungszeiten',
    workingHours: {
      weekdays: 'Mo–Fr: 09:00 – 21:00',
      saturday: 'Sa: 09:00 – 18:00',
      sunday: 'So: Geschlossen',
    },
  },
  en: {
    officeBadge: 'Office',
    city: 'Bremen, Germany',
    locationLabel: 'School location',
    mapLinkText: 'Open in map',
    emailLabel: 'E-Mail',
    whatsappLabel: 'WhatsApp',
    waBremenLabel: 'Bremen Office',
    waIntlLabel: 'International Admissions',
    workingHoursTitle: 'Opening hours',
    workingHours: {
      weekdays: 'Weekdays: 09:00 – 21:00',
      saturday: 'Saturday: 09:00 – 18:00',
      sunday: 'Sunday: Closed',
    },
  },
  es: {
    officeBadge: 'Oficina',
    city: 'Bremen, Alemania',
    locationLabel: 'Ubicación de la escuela',
    mapLinkText: 'Abrir en mapa',
    emailLabel: 'E-Mail',
    whatsappLabel: 'WhatsApp',
    waBremenLabel: 'Bremen Office',
    waIntlLabel: 'International Admissions',
    workingHoursTitle: 'Horario',
    workingHours: {
      weekdays: 'Entre semana: 09:00 – 21:00',
      saturday: 'Sábado: 09:00 – 18:00',
      sunday: 'Domingo: Cerrado',
    },
  },
} as const;

const t = copy[(lang as keyof typeof copy) || 'en'] || copy.en;

const FLAG = (iso: string) => `https://flagcdn.com/w40/${iso}.png`;
---

<div class="contact-card contact-card--office">
  <header class="office-head">
    <div class="office-head__flag" aria-hidden="true">
      <img src={FLAG('de')} alt="" width="40" height="28" loading="lazy" decoding="async" />
    </div>
    <div class="office-head__copy">
      <span class="office-head__badge">{t.officeBadge}</span>
      <h2 class="office-head__company">{OFFICE.company}</h2>
      <p class="office-head__city">
        <img class="office-head__pin-flag" src={FLAG('de')} alt="" width="18" height="12" loading="lazy" decoding="async" aria-hidden="true" />
        {t.city}
      </p>
    </div>
  </header>

  <div class="office-block office-block--location">
    <div class="office-block__label">
      <span class="office-icon" aria-hidden="true"><i class="fas fa-map-marker-alt"></i></span>
      <span>{t.locationLabel}</span>
    </div>
    <p class="office-block__text">{OFFICE.address}</p>
    <a href={mapLinkUrl} target="_blank" rel="noopener noreferrer" class="office-map-link">
      <i class="fas fa-external-link-alt" aria-hidden="true"></i>
      {t.mapLinkText}
    </a>
  </div>

  <div class="office-simple">
    <div class="office-simple__row">
      <p class="office-simple__label">{t.emailLabel}:</p>
      <a class="office-simple__value" href={`mailto:${OFFICE.email}`}>{OFFICE.email}</a>
    </div>

    <div class="office-simple__row office-simple__row--wa">
      <p class="office-simple__label office-simple__label--wa">
        <i class="fab fa-whatsapp" aria-hidden="true"></i>
        {t.whatsappLabel}
      </p>

      <div class="office-wa-list">
        <a class="office-wa office-wa--de" href={OFFICE.waBremenHref} target="_blank" rel="noopener noreferrer">
          <div class="office-wa__head">
            <span class="office-wa__title">{t.waBremenLabel}</span>
            <span class="office-wa__flags" aria-hidden="true">
              {BREMEN_FLAGS.map((iso) => (
                <img src={FLAG(iso)} alt="" width="24" height="16" loading="lazy" decoding="async" />
              ))}
            </span>
          </div>
          <span class="office-wa__link">
            <i class="fab fa-whatsapp" aria-hidden="true"></i>
            <span class="office-wa__num">{OFFICE.waBremen}</span>
          </span>
        </a>

        <a class="office-wa office-wa--intl" href={OFFICE.waIntlHref} target="_blank" rel="noopener noreferrer">
          <div class="office-wa__head office-wa__head--stack">
            <span class="office-wa__title">{t.waIntlLabel}</span>
            <span class="office-wa__flags office-wa__flags--row" aria-hidden="true">
              {INTL_FLAGS.map((iso) => (
                <img src={FLAG(iso)} alt="" width="24" height="16" loading="lazy" decoding="async" />
              ))}
            </span>
          </div>
          <span class="office-wa__link">
            <i class="fab fa-whatsapp" aria-hidden="true"></i>
            <span class="office-wa__num">{OFFICE.waIntl}</span>
          </span>
        </a>
      </div>
    </div>

    <div class="office-simple__row office-simple__row--hours">
      <p class="office-simple__label">{t.workingHoursTitle}:</p>
      <p class="office-simple__hours">{t.workingHours.weekdays}</p>
      <p class="office-simple__hours">{t.workingHours.saturday}</p>
      <p class="office-simple__hours">{t.workingHours.sunday}</p>
    </div>
  </div>
</div>
