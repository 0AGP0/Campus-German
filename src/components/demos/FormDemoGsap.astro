<div class="fd-shell fd-gsap" id="form-demo-gsap">
  <h3>3 — GSAP</h3>
  <p class="fd-meta">Timeline / profesyonel sahne kontrolü (CDN, lisans: gsap.com).</p>
  <div class="fd-progress"><i data-progress></i></div>
  <div class="fd-panel">
    <div class="fd-panel-inner" data-step-content></div>
  </div>
</div>

<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
<script is:inline>
  (function () {
    function run() {
      var root = document.getElementById('form-demo-gsap');
      if (!root || typeof gsap === 'undefined') {
        setTimeout(run, 50);
        return;
      }
      var progress = root.querySelector('[data-progress]');
      var wrap = root.querySelector('[data-step-content]');
      var step = 1;

      function bind() {
        wrap.querySelectorAll('[data-pick]').forEach(function (b) {
          b.addEventListener('click', function () {
            wrap.querySelectorAll('[data-pick]').forEach(function (x) {
              x.classList.remove('picked');
            });
            b.classList.add('picked');
            gsap.fromTo(b, { scale: 1 }, { scale: 0.95, duration: 0.1, yoyo: true, repeat: 1 });
            step = 2;
            render();
          });
        });
        wrap.querySelectorAll('[data-next]').forEach(function (b) {
          b.addEventListener('click', function () {
            step = 3;
            render();
          });
        });
        var send = wrap.querySelector('[data-send]');
        if (send)
          send.addEventListener('click', function () {
            alert('Demo bitti (GSAP).');
            step = 1;
            render();
          });
      }

      function render() {
        progress.style.width = ((step - 1) / 2) * 100 + '%';
        if (step === 1) {
          wrap.innerHTML =
            '<h4>Hangi program?</h4><div class="fd-options"><button type="button" data-pick>A</button><button type="button" data-pick>B</button></div>';
        } else if (step === 2) {
          wrap.innerHTML =
            '<h4>Deneme: süre</h4><div class="fd-options"><button type="button" data-next>2 ay</button><button type="button" data-next>4 ay</button></div>';
        } else {
          wrap.innerHTML =
            '<h4>İletişim (demo)</h4><div class="fd-field"><label>Email</label><input type="email" placeholder="ornek@mail.com" /></div><button type="button" class="fd-submit" data-send>Tamam</button>';
        }
        bind();
        gsap.fromTo(wrap, { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.35, ease: 'power2.out' });
      }

      render();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
    else run();
  })();
</script>
