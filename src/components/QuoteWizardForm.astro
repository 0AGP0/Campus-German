  homePath: homePathProp,
  embedded = false,
  modalMode = false,
  /** Aynı sayfada modal + gömülü için benzersiz id: modal='m', sayfa gövdesi='e' */
  instanceSuffix = 'm',
} = Astro.props;
const homePath = homePathProp ?? `/${lang}`;
const quoteMode = embedded ? 'embedded' : 'standalone';
const pw = (base: string) => `${base}-${instanceSuffix}`;
const BOOKING_FREE_WEBHOOK = 'https://hook.eu2.make.com/40s1h4a3wra21aszpa9y9erfsfooso47';
