const t = copy[langKey];
const monthNames: Record<string, string[]> = {
  tr: ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'],
  de: ['Januar', 'Februar', 'März', 'April', 'Mai', 'Juni', 'Juli', 'August', 'September', 'Oktober', 'November', 'Dezember'],
  en: ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'],
  es: ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'],
};
const couponMonthLabel = (monthNames[langKey] || monthNames.en)[new Date().getMonth()];
const doneText = t.doneText.replace('{month}', couponMonthLabel);
const bookingWithCoupon = `${bookingPath}${bookingPath.includes('?') ? '&' : '?'}coupon=${encodeURIComponent(monthCoupon.code)}`;

const chipGroups: { name: string; label: string; options: ChipOption[] }[] = [
  { name: 'ageRange', label: t.ageRange, options: t.chips.ageRange },
  { name: 'occupation', label: t.occupation, options: t.chips.occupation },
  { name: 'startTimeline', label: t.startTimeline, options: t.chips.startTimeline },
  { name: 'germanLevel', label: t.germanLevel, options: t.chips.germanLevel },
  { name: 'interestedCourse', label: t.interestedCourse, options: t.chips.interestedCourse },
];

const chipHiddenId = (name: string) => {
  const cap = name.charAt(0).toUpperCase() + name.slice(1);
  return pw(`pw${cap}`);
};
---

<div
  class="quote-wizard-instance"
  data-quote-instance={instanceSuffix}
  data-coupon-code={monthCoupon.code}
  data-coupon-month={monthCoupon.monthKey}
  data-booking-path={bookingWithCoupon}
>
<div class={`qx-page-bg ${quoteMode === 'standalone' ? 'qx-page-bg--standalone' : 'qx-page-bg--embedded'} ${modalMode ? 'qx-page-bg--modal' : ''}`}>
<section class="qx qx-layout-flow qx-layout-flow--vertical" id={pw('pwRoot')} data-qx-mode={quoteMode}>
  <header class="qx-compact-header">
    <div class="qx-compact-header__logo" aria-hidden={modalMode || embedded ? 'true' : 'false'}>
      <img src="/German_logo.webp" alt="" class="qx-compact-logo" width="40" height="40" loading="lazy" decoding="async" />
    </div>
    <div class="qx-compact-header__copy">
      <h2 class="qx-compact-title">{t.title}</h2>
      <p class="qx-compact-subtitle">{t.subtitle}</p>
    </div>
  </header>

  <div class="qx-compact-body">
    <p class="qx-submit-feedback" id={pw('pwSubmitFeedback')} aria-live="polite"></p>

    <form
      id={pw('pwForm')}
      class="qx-form qx-form--compact"
      data-webhook={quoteWebhook}
      data-error={t.error}
      data-modal-mode={modalMode ? 'true' : 'false'}
      data-sending={t.sending}
      data-success={t.success}
      data-val-contact={t.validation.contactRequired}
      data-val-email={t.validation.emailInvalid}
      data-val-required={t.validation.required}
      data-val-phone={t.validation.phoneRequired}
      novalidate
    >
      <input type="hidden" name="formType" value="price-quote" />
      <input type="hidden" name="sourcePage" value={Astro.url.pathname} />
      <input type="hidden" name="lang" value={lang} />
      <input type="hidden" name="couponCode" value={monthCoupon.code} />
      <input type="hidden" name="couponMonth" value={monthCoupon.monthKey} />

      <div class="qx-block qx-block--contact" id={pw('qxPanelInfo')} data-qx-tab-panel="info">
        <label class="qx-field">
          <span class="qx-field-label">{t.fullName}</span>
          <input type="text" name="fullName" required autocomplete="name" class="qx-input" placeholder={t.fullNamePlaceholder} />
        </label>

        <div class="qx-row qx-row--2">
          <label class="qx-field">
            <span class="qx-field-label">{t.email}</span>
            <input type="email" name="email" autocomplete="email" class="qx-input" placeholder={t.emailPlaceholder} />
          </label>

          <div class="qx-field qx-field--phone">
            <span class="qx-field-label">{t.phone}</span>
            <div class="qx-phone" data-qx-phone>
              <button type="button" class="qx-phone__dial" id={pw('pwDialBtn')} aria-haspopup="listbox" aria-expanded="false">
                <span class="qx-phone__flag" data-qx-flag>{defaultCountry.flag}</span>
                <span class="qx-phone__code" data-qx-code>+{defaultCountry.dial}</span>
                <i class="fas fa-chevron-down" aria-hidden="true"></i>
              </button>
              <input
                type="tel"
                name="phoneNational"
                id={pw('pwPhoneNational')}
                class="qx-input qx-phone__input"
                autocomplete="tel-national"
                placeholder={t.phonePlaceholder}
                inputmode="tel"
              />
              <input type="hidden" name="phone" id={pw('pwPhone')} value="" />
              <input type="hidden" name="country" id={pw('pwCountry')} value={defaultCountry.name[langKey]} />
              <input type="hidden" name="countryCode" id={pw('pwCountryCode')} value={defaultCountry.iso} />
              <input type="hidden" name="dialCode" id={pw('pwDialCode')} value={defaultCountry.dial} />
              <div class="qx-phone__menu" id={pw('pwDialMenu')} hidden role="listbox">
                <input type="search" class="qx-phone__search" id={pw('pwDialSearch')} placeholder={t.dialSearch} autocomplete="off" />
                <div class="qx-phone__list">
                  {PHONE_COUNTRIES.map((c) => (
                    <button
                      type="button"
                      class="qx-phone__option"
                      role="option"
                      data-iso={c.iso}
                      data-dial={c.dial}
                      data-flag={c.flag}
                      data-name={c.name[langKey]}
                    >
                      <span class="qx-phone__option-flag">{c.flag}</span>
                      <span class="qx-phone__option-name">{c.name[langKey]}</span>
                      <span class="qx-phone__option-dial">+{c.dial}</span>
                    </button>
                  ))}
                </div>
              </div>
            </div>
            <p class="qx-field-error" id={pw('pwPhoneError')} hidden role="alert"></p>
          </div>
        </div>
        <p class="qx-field-error qx-field-error--contact" id={pw('pwContactError')} hidden role="alert"></p>
      </div>

      <div class="qx-block qx-block--prefs" id={pw('qxPanelPrefs')} data-qx-tab-panel="prefs">
        <div class="qx-pref-list qx-pref-list--vertical">
          {chipGroups.map((group, i) => (
            <div class={`qx-choice qx-choice--n${group.options.length}`} data-qx-chip-group={group.name}>
              <div class="qx-choice__label">
                <span class="qx-choice__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="qx-choice__q">{group.label}</span>
              </div>
              <div class="qx-choice__options" role="radiogroup" aria-label={group.label}>
                {group.options.map((opt) => (
                  <button
                    type="button"
                    class="qx-choice-btn"
                    data-chip-field={group.name}
                    data-chip-value={opt.value}
                    data-chip-label={opt.label}
                    aria-pressed="false"
                  >{opt.label}</button>
                ))}
              </div>
              <input type="hidden" name={group.name} id={chipHiddenId(group.name)} value="" />
              <p class="qx-field-error" hidden role="alert"></p>
              {group.name === 'occupation' && (
                <div class="qx-occupation-other qx-field-group--collapsible" id={pw('occupationOtherGroup')} hidden aria-hidden="true">
                  <label class="qx-field">
                    <span class="qx-field-label">{t.occupationOther}</span>
                    <input type="text" name="occupationOther" id={pw('pwOccupationOther')} class="qx-input" placeholder={t.occupationOtherPlaceholder} />
                  </label>
                </div>
              )}
            </div>
          ))}

          <div class="qx-agency-flow qx-field-group--collapsible" id={pw('agencyFlowGroup')} hidden aria-hidden="true">
            <div class="qx-choice qx-choice--n2" data-qx-chip-group="withAgency">
              <div class="qx-choice__label">
                <span class="qx-choice__num" aria-hidden="true">06</span>
                <span class="qx-choice__q">{t.withAgency}</span>
              </div>
              <div class="qx-choice__options" role="radiogroup" aria-label={t.withAgency}>
                {t.chips.withAgency.map((opt) => (
                  <button
                    type="button"
                    class="qx-choice-btn"
                    data-chip-field="withAgency"
                    data-chip-value={opt.value}
                    data-chip-label={opt.label}
                    aria-pressed="false"
                  >{opt.label}</button>
                ))}
              </div>
              <input type="hidden" name="withAgency" id={chipHiddenId('withAgency')} value="" />
              <p class="qx-field-error" hidden role="alert"></p>
            </div>

            <div class="qx-agency-details qx-field-group--collapsible" id={pw('agencyDetailsGroup')} hidden aria-hidden="true">
              <label class="qx-field">
                <span class="qx-field-label">{t.agencyName}</span>
                <input type="text" name="agencyName" id={pw('pwAgencyName')} class="qx-input" placeholder={t.agencyNamePlaceholder} />
              </label>
              <label class="qx-field">
                <span class="qx-field-label">{t.agencyPhone}</span>
                <input type="tel" name="agencyPhone" id={pw('pwAgencyPhone')} class="qx-input" placeholder={t.agencyPhonePlaceholder} />
              </label>
            </div>
          </div>
        </div>
      </div>

      <footer class="qx-footer">
        <button type="submit" class="qx-send" id={pw('pwSubmitBtn')}>{t.submit}</button>
      </footer>
    </form>
  </div>
</section>
</div>

<div class="pw-overlay" id={pw('pwOverlay')} data-home={homePath} aria-hidden="true">
  <div class="pw-dialog pw-dialog--done pw-dialog--coupon" data-pw-dialog role="dialog" aria-modal="true" aria-labelledby={pw('pwDoneTitle')}>
    <button type="button" class="pw-dialog-dismiss" data-pw-close aria-label={t.doneClose}><i class="fas fa-times" aria-hidden="true"></i></button>
    <div class="pw-dialog-icon" aria-hidden="true"><i class="fas fa-ticket-alt"></i></div>
    <h3 id={pw('pwDoneTitle')} class="pw-dialog-title">{t.doneTitle}</h3>
    <p class="pw-coupon-label">{t.doneCouponLabel}</p>
    <p class="pw-coupon-code" id={pw('pwCouponCode')}>{monthCoupon.code}</p>
    <p class="pw-dialog-text">{doneText}</p>
    <div class="pw-dialog-cta-wrap">
      <a class="pw-dialog-home pw-dialog-book" id={pw('pwBookLink')} href={bookingWithCoupon}>{t.doneBook}</a>
      <button type="button" class="pw-dialog-close-text" data-pw-close>{t.doneClose}</button>
    </div>
  </div>
</div>
</div>

<script>
  function initQuoteMount(mount: HTMLElement) {
    const S = mount.dataset.quoteInstance || 'm';
    const q = <T extends HTMLElement = HTMLElement>(stem: string) => mount.querySelector<T>(`#${stem}-${S}`);
    const form = mount.querySelector<HTMLFormElement>('form.qx-form');
    if (!form) return;

    const submitFeedback = q('pwSubmitFeedback');
    const contactError = q('pwContactError');
    const phoneError = q('pwPhoneError');
    const agencyFlowGroup = q('agencyFlowGroup');
    const agencyDetailsGroup = q('agencyDetailsGroup');
    const occupationOtherGroup = q('occupationOtherGroup');
    const occupationOtherInput = q<HTMLInputElement>('pwOccupationOther');
    const agencyNameInput = q<HTMLInputElement>('pwAgencyName');
    const agencyPhoneInput = q<HTMLInputElement>('pwAgencyPhone');
    const submitBtn = q<HTMLButtonElement>('pwSubmitBtn');
    const phoneNational = q<HTMLInputElement>('pwPhoneNational');
    const phoneFull = q<HTMLInputElement>('pwPhone');
    const countryInput = q<HTMLInputElement>('pwCountry');
    const countryCodeInput = q<HTMLInputElement>('pwCountryCode');
    const dialCodeInput = q<HTMLInputElement>('pwDialCode');
    const dialBtn = q<HTMLButtonElement>('pwDialBtn');
    const dialMenu = q('pwDialMenu');
    const dialSearch = q<HTMLInputElement>('pwDialSearch');
    const flagEl = mount.querySelector<HTMLElement>('[data-qx-flag]');
    const codeEl = mount.querySelector<HTMLElement>('[data-qx-code]');

    const chipFields = ['ageRange', 'occupation', 'startTimeline', 'germanLevel', 'interestedCourse'];

    function getHiddenInput(field: string): HTMLInputElement | null {
      return form!.querySelector<HTMLInputElement>(`input[name="${field}"]`);
    }

    function getChipLabel(field: string, value: string): string {
      const btn = form!.querySelector<HTMLButtonElement>(`[data-chip-field="${field}"][data-chip-value="${value}"]`);
      return btn?.dataset.chipLabel || value;
    }

    function syncPhoneFull() {
      if (!phoneFull || !dialCodeInput || !phoneNational) return;
      const national = phoneNational.value.replace(/[^\d]/g, '');
      const dial = (dialCodeInput.value || '').replace(/[^\d]/g, '');
      phoneFull.value = national ? `+${dial}${national}` : '';
    }

    function setCountry(iso: string, dial: string, flag: string, name: string) {
      if (countryCodeInput) countryCodeInput.value = iso;
      if (dialCodeInput) dialCodeInput.value = dial;
      if (countryInput) countryInput.value = name;
      if (flagEl) flagEl.textContent = flag;
      if (codeEl) codeEl.textContent = `+${dial}`;
      syncPhoneFull();
    }

    function closeDialMenu() {
      if (!dialMenu || !dialBtn) return;
      dialMenu.hidden = true;
      dialBtn.setAttribute('aria-expanded', 'false');
    }

    function openDialMenu() {
      if (!dialMenu || !dialBtn) return;
      dialMenu.hidden = false;
      dialBtn.setAttribute('aria-expanded', 'true');
      dialSearch?.focus();
    }

    dialBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      if (dialMenu?.hidden) openDialMenu();
      else closeDialMenu();
    });

    mount.querySelectorAll<HTMLButtonElement>('.qx-phone__option').forEach((opt) => {
      opt.addEventListener('click', () => {
        setCountry(opt.dataset.iso || '', opt.dataset.dial || '', opt.dataset.flag || '', opt.dataset.name || '');
        closeDialMenu();
        phoneNational?.focus();
      });
    });

    dialSearch?.addEventListener('input', () => {
      const term = dialSearch.value.trim().toLowerCase();
      mount.querySelectorAll<HTMLButtonElement>('.qx-phone__option').forEach((opt) => {
        const hay = `${opt.dataset.name || ''} ${opt.dataset.iso || ''} ${opt.dataset.dial || ''}`.toLowerCase();
        opt.hidden = term !== '' && !hay.includes(term);
      });
    });

    document.addEventListener('click', (e) => {
      const phoneWrap = mount.querySelector('[data-qx-phone]');
      if (!phoneWrap || !(e.target instanceof Node) || phoneWrap.contains(e.target)) return;
      closeDialMenu();
    });

    phoneNational?.addEventListener('input', syncPhoneFull);

    // IP → otomatik bayrak (başarısız olursa varsayılan kalır)
    const geoCtrl = typeof AbortController !== 'undefined' ? new AbortController() : null;
    const geoTimer = window.setTimeout(() => geoCtrl?.abort(), 3500);
    fetch('https://ipapi.co/json/', geoCtrl ? { signal: geoCtrl.signal } : undefined)
      .then((r) => (r.ok ? r.json() : null))
      .then((data) => {
        const iso = String(data?.country_code || '').toUpperCase();
        if (!iso) return;
        const opt = mount.querySelector<HTMLButtonElement>(`.qx-phone__option[data-iso="${iso}"]`);
        if (!opt) return;
        setCountry(opt.dataset.iso || '', opt.dataset.dial || '', opt.dataset.flag || '', opt.dataset.name || '');
      })
      .catch(() => {})
      .finally(() => window.clearTimeout(geoTimer));

    function switchToFirstInvalid() {
      const invalid = form!.querySelector('.is-invalid, .qx-field-error:not([hidden])');
      if (invalid instanceof HTMLElement) invalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    form!.querySelectorAll<HTMLElement>('[data-qx-tab-panel]').forEach((panel) => {
      panel.removeAttribute('hidden');
      panel.setAttribute('aria-hidden', 'false');
      panel.classList.add('is-active');
    });

    function clearFieldErrors() {
      form!.querySelectorAll('.qx-field-error').forEach((el) => {
        const err = el as HTMLElement;
        err.textContent = '';
        err.hidden = true;
      });
      form!.querySelectorAll('.qx-choice.is-invalid, .qx-field.is-invalid').forEach((el) => el.classList.remove('is-invalid'));
    }

    function showGroupError(field: string, msg: string) {
      const group = form!.querySelector(`[data-qx-chip-group="${field}"]`);
      if (!group) return;
      group.classList.add('is-invalid');
      const err = group.querySelector('.qx-field-error');
      if (err instanceof HTMLElement) {
        err.textContent = msg;
        err.hidden = false;
      }
    }

    function markTextFieldInvalid(name: string) {
      const input = form!.querySelector<HTMLInputElement>(`input[name="${name}"]`);
      input?.closest('.qx-field')?.classList.add('is-invalid');
    }

    function setExpanded(el: HTMLElement | null, show: boolean) {
      if (!el) return;
      if (show) {
        el.removeAttribute('hidden');
        el.setAttribute('aria-hidden', 'false');
        el.classList.add('is-expanded');
      } else {
        el.setAttribute('hidden', '');
        el.setAttribute('aria-hidden', 'true');
        el.classList.remove('is-expanded', 'is-invalid');
      }
    }

    function clearChipField(field: string) {
      const hidden = getHiddenInput(field);
      if (hidden) hidden.value = '';
      form!.querySelectorAll(`[data-chip-field="${field}"]`).forEach((b) => {
        b.classList.remove('is-active');
        b.setAttribute('aria-pressed', 'false');
      });
    }

    function toggleOccupationOther(show: boolean) {
      setExpanded(occupationOtherGroup, show);
      if (occupationOtherInput) {
        occupationOtherInput.required = show;
        if (!show) occupationOtherInput.value = '';
      }
    }

    function toggleAgencyDetails(show: boolean) {
      setExpanded(agencyDetailsGroup, show);
      if (agencyNameInput) {
        agencyNameInput.required = show;
        if (!show) agencyNameInput.value = '';
      }
      if (agencyPhoneInput) {
        agencyPhoneInput.required = show;
        if (!show) agencyPhoneInput.value = '';
      }
    }

    function toggleAgencyFlow(show: boolean) {
      setExpanded(agencyFlowGroup, show);
      if (!show) {
        clearChipField('withAgency');
        toggleAgencyDetails(false);
      }
    }

    form.querySelectorAll<HTMLButtonElement>('[data-chip-field]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const field = btn.dataset.chipField || '';
        const value = btn.dataset.chipValue || '';
        const hidden = getHiddenInput(field);
        if (!hidden) return;

        form!.querySelectorAll(`[data-chip-field="${field}"]`).forEach((b) => {
          b.classList.remove('is-active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-pressed', 'true');
        hidden.value = value;

        const group = btn.closest('[data-qx-chip-group]');
        group?.classList.remove('is-invalid');
        const err = group?.querySelector('.qx-field-error');
        if (err instanceof HTMLElement) {
          err.hidden = true;
          err.textContent = '';
        }

        if (field === 'occupation') toggleOccupationOther(value === 'other');
        if (field === 'startTimeline') toggleAgencyFlow(value === 'after-visa');
        if (field === 'withAgency') toggleAgencyDetails(value === 'yes');
      });
    });

    function resetForm() {
      form!.reset();
      [...chipFields, 'withAgency'].forEach(clearChipField);
      toggleOccupationOther(false);
      toggleAgencyFlow(false);
      syncPhoneFull();
      clearFieldErrors();
      if (submitFeedback) {
        submitFeedback.textContent = '';
        submitFeedback.classList.remove('is-success', 'is-error');
      }
    }

    if (form.dataset.modalMode === 'true') {
      window.addEventListener('campus-quote-modal-close', () => resetForm());
    }

    const overlay = q('pwOverlay');
    const dialog = mount.querySelector<HTMLElement>('[data-pw-dialog]');

    function openOverlay() {
      if (!overlay || !dialog) return;
      overlay.classList.add('is-open');
      overlay.setAttribute('aria-hidden', 'false');
    }

    function dismissOverlay() {
      if (form!.dataset.modalMode === 'true') {
        (window as Window & { closeCampusQuoteModal?: () => void }).closeCampusQuoteModal?.();
        return;
      }
      overlay?.classList.remove('is-open');
      overlay?.setAttribute('aria-hidden', 'true');
    }

    mount.querySelectorAll<HTMLElement>('[data-pw-close]').forEach((btn) =>
      btn.addEventListener('click', dismissOverlay),
    );
    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) dismissOverlay();
    });

    const DEFAULT_MAKE_WEBHOOK = 'https://hook.eu2.make.com/40s1h4a3wra21aszpa9y9erfsfooso47';

    function validateForm(): boolean {
      clearFieldErrors();
      const valRequired = form!.dataset.valRequired || 'Required';
      const valContact = form!.dataset.valContact || 'Contact required';
      const valEmail = form!.dataset.valEmail || 'Invalid email';
      const valPhone = form!.dataset.valPhone || 'Phone required';
      let valid = true;

      const fullName = (form!.querySelector<HTMLInputElement>('input[name="fullName"]')?.value || '').trim();
      const email = (form!.querySelector<HTMLInputElement>('input[name="email"]')?.value || '').trim();
      syncPhoneFull();
      const phone = (phoneFull?.value || '').trim();
      const startTimeline = getHiddenInput('startTimeline')?.value || '';
      const withAgency = getHiddenInput('withAgency')?.value || '';
      const occupation = getHiddenInput('occupation')?.value || '';

      if (!fullName) { markTextFieldInvalid('fullName'); valid = false; }

      // Tercih chip'leri opsiyonel; seçildiyse "Diğer" / ajans akışı şartları geçerli
      if (occupation === 'other' && !(occupationOtherInput?.value || '').trim()) {
        markTextFieldInvalid('occupationOther');
        valid = false;
      }

      if (startTimeline === 'after-visa') {
        if (!withAgency) {
          showGroupError('withAgency', valRequired);
          valid = false;
        } else if (withAgency === 'yes') {
          if (!(agencyNameInput?.value || '').trim()) { markTextFieldInvalid('agencyName'); valid = false; }
          if (!(agencyPhoneInput?.value || '').trim()) { markTextFieldInvalid('agencyPhone'); valid = false; }
        }
      }

      if (!email && !phone) {
        valid = false;
        if (contactError) {
          contactError.textContent = valContact;
          contactError.hidden = false;
        }
      } else {
        if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          valid = false;
          if (contactError) {
            contactError.textContent = valEmail;
            contactError.hidden = false;
          }
        }
        if (!phone) {
          valid = false;
          if (phoneError) {
            phoneError.textContent = valPhone;
            phoneError.hidden = false;
          }
          phoneNational?.closest('.qx-field')?.classList.add('is-invalid');
        }
      }

      if (!valid) switchToFirstInvalid();
      return valid;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validateForm()) {
        const msg = form!.dataset.valRequired || form!.dataset.error || 'Error';
        (window as unknown as { showSuccessModal?: (t: string, m: string) => void }).showSuccessModal?.('error', msg);
        return;
      }

      const originalBtnText = submitBtn?.textContent || '';
      if (submitFeedback) {
        submitFeedback.textContent = '';
        submitFeedback.classList.remove('is-success', 'is-error');
      }
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = form!.dataset.sending || 'Sending...';
      }

      syncPhoneFull();
      const fd = new FormData(form!);
      const data = Object.fromEntries(fd.entries()) as Record<string, string>;

      const ageRange = String(data.ageRange || '').trim();
      const occupation = String(data.occupation || '').trim();
      const startTimeline = String(data.startTimeline || '').trim();
      const germanLevel = String(data.germanLevel || '').trim();
      const interestedCourse = String(data.interestedCourse || '').trim();
      const withAgency = String(data.withAgency || '').trim();
      const agencyYes = startTimeline === 'after-visa' && withAgency === 'yes';
      const occupationLabel =
        occupation === 'other'
          ? String(data.occupationOther || '').trim() || getChipLabel('occupation', occupation)
          : getChipLabel('occupation', occupation);

      const payload = {
        formType: 'price-quote',
        formVersion: 'vertical-v3',
        lang: String(data.lang || '').trim(),
        sourcePage: String(data.sourcePage || '').trim() || window.location.pathname,
        submittedAt: new Date().toISOString(),
        coupon: {
          code: String(data.couponCode || mount.dataset.couponCode || '').trim(),
          monthKey: String(data.couponMonth || mount.dataset.couponMonth || '').trim(),
        },
        customer: {
          fullName: String(data.fullName || '').trim(),
          email: String(data.email || '').trim(),
          phone: String(data.phone || '').trim(),
          dialCode: String(data.dialCode || '').trim(),
          countryCode: String(data.countryCode || '').trim(),
          country: String(data.country || '').trim(),
          ageRange,
          ageRangeLabel: getChipLabel('ageRange', ageRange),
          occupation,
          occupationLabel,
          occupationOther: occupation === 'other' ? String(data.occupationOther || '').trim() : '',
          startTimeline,
          startTimelineLabel: getChipLabel('startTimeline', startTimeline),
          germanLevel,
          germanLevelLabel: getChipLabel('germanLevel', germanLevel),
          interestedCourse,
          interestedCourseLabel: getChipLabel('interestedCourse', interestedCourse),
          withAgency: startTimeline === 'after-visa' ? withAgency : '',
          withAgencyLabel:
            startTimeline === 'after-visa' && withAgency ? getChipLabel('withAgency', withAgency) : '',
          agencyName: agencyYes ? String(data.agencyName || '').trim() : '',
          agencyPhone: agencyYes ? String(data.agencyPhone || '').trim() : '',
          hasFriend: '',
          friendName: '',
          visaSupportNeeded: '',
        },
      };

      try {
        const wh = (form!.dataset.webhook || '').trim() || DEFAULT_MAKE_WEBHOOK;
        const res = await fetch(wh, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error('webhook');
        if (submitFeedback) {
          submitFeedback.textContent = form!.dataset.success || 'Success';
          submitFeedback.classList.add('is-success');
        }
        resetForm();
        openOverlay();
      } catch {
        const msg = form!.dataset.error || 'Error';
        if (submitFeedback) {
          submitFeedback.textContent = msg;
          submitFeedback.classList.add('is-error');
        }
        (window as unknown as { showSuccessModal?: (t: string, m: string) => void }).showSuccessModal?.('error', msg);
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalBtnText;
        }
      }
    });
  }

  function initAllQuoteWizards() {
    document.querySelectorAll<HTMLElement>('.quote-wizard-instance').forEach((mount) => {
      if (mount.dataset.pwInit === '1') return;
      mount.dataset.pwInit = '1';
      initQuoteMount(mount);
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initAllQuoteWizards);
  else initAllQuoteWizards();
</script>
