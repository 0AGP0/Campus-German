---

<div class={`qx-page-bg ${quoteMode === 'standalone' ? 'qx-page-bg--standalone' : 'qx-page-bg--embedded'}`}>
<section class="qx" id="pwRoot" data-qx-mode={quoteMode}>
  <aside class="qx-aside" aria-hidden="true">
    <div class="qx-aside-ornament" aria-hidden="true"></div>
    <p class="qx-aside-title">{t.asideMark}</p>
    <p class="qx-aside-meta">{t.asideSteps}</p>
    <div class="qx-aside-progress">
      <div class="qx-aside-connector">
        <div class="qx-aside-track">
          <span class="qx-aside-track-line" aria-hidden="true"></span>
          <div class="qx-dots">
            {[1, 2, 3, 4, 5].map((n) => <span class="qx-dot" data-qx-dot={n}></span>)}
          </div>
        </div>
      </div>
      <div class="qx-aside-counter">
        <p class="qx-aside-step" data-pw-eyebrow>01 / 05</p>
        <span class="qx-aside-stephint">{t.asideStepHint}</span>
      </div>
    </div>
    <div class="qx-aside-brand" aria-hidden="true">
      <img src="/Campusgerman.png" alt="" width="80" height="80" loading="lazy" decoding="async" />
    </div>
  </aside>

  <div class="qx-body">
    <div class="qx-lead">
      <p class="qx-lead-kicker">{t.subtitleEm}</p>
      <p class="qx-lead-body">{t.subtitle}</p>
    </div>
    <div class="qx-line" aria-hidden="true"><span class="qx-line-fill" data-pw-bar></span></div>
    <p class="qx-submit-feedback" id="pwSubmitFeedback" aria-live="polite"></p>

    <form id="pwForm" class="qx-form" data-webhook={quoteWebhook} data-error={t.error} data-levels={t.levels.join('|')} data-months={t.months.join('|')} data-free-lesson-label={t.freeLesson}>
      <input type="hidden" name="formType" value="price-quote" />
      <input type="hidden" name="sourcePage" value={Astro.url.pathname} />
      <input type="hidden" name="lang" value={lang} />
      <input type="hidden" name="program" id="pwProgram" value="" />
      <input type="hidden" name="quote-program-label" id="pwProgramLabel" value="" />
      <input type="hidden" name="quote-intensive-type" id="pwIntensiveType" value="" />
      <input type="hidden" name="quote-level-start" id="pwLevelA" value="" />
      <input type="hidden" name="quote-level-end" id="pwLevelB" value="" />
      <input type="hidden" name="quote-month-start" id="pwMonthA" value="" />
      <input type="hidden" name="quote-month-end" id="pwMonthB" value="" />
      <input type="hidden" name="quote-course-type" id="pwCourseType" value="" />
      <input type="hidden" name="quote-selected-course-id" id="pwCourseId" value="" />
      <input type="hidden" name="quote-selected-course-title" id="pwCourseTitle" value="" />
      <input type="hidden" name="quote-duration-months" id="pwDurationMonths" value="" />
      <input type="hidden" name="quote-is-free-lesson" id="pwFreeLesson" value="no" />
      <input type="hidden" name="quote-plan-key" id="pwPlanKey" value="" />
      <input type="hidden" name="totalPrice" id="pwTotalPrice" value="" />

      <div class="pw-viewport">
        <div class="pw-panel is-current qx-scene qx-scene--pick" data-panel="1">
          <div class="qx-stage-shell">
            <header class="qx-scene-head"><span class="qx-scene-kicker">1</span><h2 class="qx-question">{t.programQ}</h2></header>
            <div class="qx-strip">
              {t.programs.map((p, i) => (
                <button type="button" class={`qx-card qx-card--${i + 1}`} data-program={p.program} data-program-label={p.label} data-intensive-type={p.intensiveType}>
                  <span class="qx-card-num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="qx-card-bg" style={`--qx-img:url('${p.image}')`} />
                  <strong>{p.label}</strong>
                </button>
              ))}
            </div>
          </div>
        </div>

        <div class="pw-panel qx-scene qx-scene--plan" data-panel="2">
          <div class="qx-stage-shell qx-stage-shell--with-nav">
            <header class="qx-scene-head"><span class="qx-scene-kicker">2</span><h2 class="qx-question">{t.levelQ}</h2></header>
            <div class="qx-select-wrap">
              <label for="pwLevelSelect">{t.levelQ}</label>
              <select id="pwLevelSelect">
                <option value="" selected>{t.levelPlaceholder}</option>
                {t.levels.map((lv) => <option value={lv}>{lv}</option>)}
              </select>
            </div>
            <h3 class="qx-subq">{t.monthQ}</h3>
            <div class="qx-select-wrap">
              <label for="pwMonthSelect">{t.monthQ}</label>
              <select id="pwMonthSelect">
                <option value="" selected>{t.monthPlaceholder}</option>
              </select>
            </div>
            <h3 class="qx-subq">{t.courseTypeQ}</h3>
            <div class="qx-choice-grid qx-choice-grid--type" id="pwCourseTypeButtons">
              {t.courseTypes.map((c) => <button type="button" class="qx-choice-btn" data-course-type={c.value}>{c.label}</button>)}
            </div>
            <div class="qx-stage-nav">
              <button type="button" class="qx-nav-arrow qx-nav-arrow--back" data-pw-nav-back aria-label={t.planBack}><i class="fas fa-arrow-left" aria-hidden="true"></i></button>
              <button type="button" class="qx-nav-arrow qx-nav-arrow--next" data-pw-nav-next aria-label={t.planContinue}><i class="fas fa-arrow-right" aria-hidden="true"></i></button>
            </div>
          </div>
        </div>

        <div class="pw-panel qx-scene qx-scene--stay" data-panel="3">
          <div class="qx-stage-shell qx-stage-shell--with-nav">
            <header class="qx-scene-head"><span class="qx-scene-kicker">3</span><h2 class="qx-question">{t.step3lead}</h2></header>
            <p class="qx-hint">{t.cardSelectHint}</p>
            <div class="qx-course-cards" id="pwCourseCards"></div>
            <div class="qx-stage-nav">
              <button type="button" class="qx-nav-arrow qx-nav-arrow--back" data-pw-nav-back aria-label={t.planBack}><i class="fas fa-arrow-left" aria-hidden="true"></i></button>
              <button type="button" class="qx-nav-arrow qx-nav-arrow--next" data-pw-nav-next aria-label={t.planContinue}><i class="fas fa-arrow-right" aria-hidden="true"></i></button>
            </div>
          </div>
        </div>

        <div class="pw-panel qx-scene qx-scene--pricing" data-panel="4">
          <div class="qx-stage-shell qx-stage-shell--with-nav">
            <header class="qx-scene-head"><span class="qx-scene-kicker">4</span><h2 class="qx-question">{t.step4lead}</h2></header>
            <div class="qx-pricing-table-wrap" id="pwPricingTable">
              <div class="qx-pricing-head" role="row">
                <div>Süre</div>
                <div>Haftalık</div>
                <div>Aylık</div>
                <div>Toplam</div>
              </div>
              <div class="qx-pricing-rows" id="pwPricingRows"></div>
            </div>
            <div class="qx-stage-nav">
              <button type="button" class="qx-nav-arrow qx-nav-arrow--back" data-pw-nav-back aria-label={t.planBack}><i class="fas fa-arrow-left" aria-hidden="true"></i></button>
            </div>
          </div>
        </div>

        <div class="pw-panel qx-scene qx-scene--send" data-panel="5">
          <div class="qx-stage-shell qx-stage-shell--with-nav">
            <header class="qx-scene-head"><span class="qx-scene-kicker">5</span><h2 class="qx-question">{t.step5lead}</h2></header>
            <div class="qx-fields qx-fields--grid">
              <label><span>{t.name}</span><input type="text" name="full-name" required autocomplete="name" /></label>
              <label><span>{t.email}</span><input type="email" name="email" required autocomplete="email" /></label>
              <label><span>{t.phone}</span><input type="tel" name="phone" required autocomplete="tel" /></label>
              <label><span>{t.country}</span><input type="text" name="country" autocomplete="country-name" /></label>
              <label class="qx-field-full"><span>{t.message}</span><textarea name="message" rows="4"></textarea></label>
            </div>
            <div class="qx-stage-nav">
              <button type="button" class="qx-nav-arrow qx-nav-arrow--back" data-pw-nav-back aria-label={t.planBack}><i class="fas fa-arrow-left" aria-hidden="true"></i></button>
            </div>
            <button class="qx-send" type="submit">{t.submit}</button>
          </div>
        </div>
      </div>
    </form>
  </div>
</section>
</div>

<div class="pw-overlay" id="pwOverlay" data-home={homePath} aria-hidden="true">
  <div class="pw-dialog pw-dialog--done" data-pw-dialog role="dialog" aria-modal="true" aria-labelledby="pwDoneTitle">
    <button type="button" class="pw-dialog-dismiss" data-pw-close aria-label={t.doneClose}><i class="fas fa-times" aria-hidden="true"></i></button>
    <div class="pw-dialog-icon" aria-hidden="true"><i class="fas fa-check"></i></div>
    <h3 id="pwDoneTitle" class="pw-dialog-title">{t.doneTitle}</h3>
    <p class="pw-dialog-text">{t.doneText}</p>
    <div class="pw-dialog-cta-wrap">
      <button type="button" class="pw-dialog-home" data-pw-close>{t.doneClose}</button>
    </div>
  </div>
</div>

<script>
  function pad2(n: number) { return String(n).padStart(2, '0'); }
  function monthlyPrice(perWeek: number) { return perWeek * 4; }
  const TIERS_20H = [
    { min: 1, max: 4, perWeek: 190 },
    { min: 5, max: 8, perWeek: 150 },
    { min: 9, max: 16, perWeek: 130 },
    { min: 17, max: 24, perWeek: 120 },
    { min: 25, max: 999, perWeek: 110 }
  ];
  const TIERS_25H = [
    { min: 1, max: 4, perWeek: 230 },
    { min: 5, max: 8, perWeek: 180 },
    { min: 9, max: 16, perWeek: 160 },
    { min: 17, max: 24, perWeek: 150 },
    { min: 25, max: 999, perWeek: 135 }
  ];
  function getTierPerWeek(weeks: number, plus: boolean) {
    const tiers = plus ? TIERS_25H : TIERS_20H;
    const tier = tiers.find((t) => weeks >= t.min && weeks <= t.max);
    return tier ? tier.perWeek : 190;
  }

  function buildCourseCards(level: string, startMonth: number, courseType: string, intensiveType: string) {
    const plus = intensiveType === 'intensive-plus';
    const perWeekStart = getTierPerWeek(4, plus);
    const perWeekEnd = getTierPerWeek(24, plus);
    const priceText = `EUR ${monthlyPrice(perWeekEnd)} - ${monthlyPrice(perWeekStart)} / month`;
    const startDate = `31.${String(startMonth).padStart(2, '0')}.2026`;
    const teachers = ['Anna Keller', 'Murat Yildiz', 'Sofia Becker', 'Deniz Acar', 'Lukas Weber', 'Elif Demir'];
    const pickTeacher = (seed: string) => {
      const sum = seed.split('').reduce((acc, ch) => acc + ch.charCodeAt(0), 0);
      return teachers[sum % teachers.length];
    };
    const all = [
      { id: 'phy-morning', type: 'physical', title: `${level} (PHYSICAL)`, time: '09:00 - 11:45', days: 'Mon, Tue, Wed, Thu', teacher: pickTeacher('phy-morning-' + level), start: startDate, places: 'Places available', extra: '' },
      { id: 'phy-afternoon', type: 'physical', title: `${level} (PHYSICAL)`, time: '15:00 - 17:45', days: 'Mon, Tue, Wed, Thu', teacher: pickTeacher('phy-afternoon-' + level), start: startDate, places: 'Places available', extra: '' },
      { id: 'phy-evening', type: 'physical', title: `${level} (PHYSICAL)`, time: '18:00 - 20:45', days: 'Mon, Tue, Wed, Thu', teacher: pickTeacher('phy-evening-' + level), start: startDate, places: 'Places available', extra: '' },
      { id: 'online-morning', type: 'online', title: `${level} (ONLINE)`, time: '09:00 - 11:45', days: 'Mon, Tue, Wed, Thu', teacher: pickTeacher('online-morning-' + level), start: startDate, places: 'Places available', extra: `Two months to complete ${level}` },
      { id: 'online-evening', type: 'online', title: `${level} (ONLINE)`, time: '18:00 - 20:45', days: 'Mon, Tue, Wed, Thu', teacher: pickTeacher('online-evening-' + level), start: startDate, places: 'Places available', extra: '' },
      { id: 'phy-weekend', type: 'physical', title: `${level} (PHYSICAL)`, time: '10:00 - 13:00', days: 'Sat, Sun', teacher: pickTeacher('phy-weekend-' + level), start: startDate, places: 'Places available', extra: '' }
    ];
    const filtered = courseType === 'all' ? all : courseType === 'evening' ? all.filter((x) => x.id === 'phy-evening') : all.filter((x) => x.type === courseType);
    return filtered.map((x) => ({ ...x, priceText }));
  }

  function start() {
    const form = document.getElementById('pwForm') as HTMLFormElement | null;
    const root = document.getElementById('pwRoot');
    if (!form || !root) return;

    const total = 5;
    let step = 1;
    const panels = [...form.querySelectorAll<HTMLElement>('.pw-panel')];
    const eyebrow = document.querySelector<HTMLElement>('[data-pw-eyebrow]');
    const bar = document.querySelector<HTMLElement>('[data-pw-bar]');
    const dots = [...document.querySelectorAll<HTMLElement>('[data-qx-dot]')];

    const hProgram = document.getElementById('pwProgram') as HTMLInputElement;
    const hProgramLabel = document.getElementById('pwProgramLabel') as HTMLInputElement;
    const hIntensive = document.getElementById('pwIntensiveType') as HTMLInputElement;
    const hLevelA = document.getElementById('pwLevelA') as HTMLInputElement;
    const hLevelB = document.getElementById('pwLevelB') as HTMLInputElement;
    const hMonthA = document.getElementById('pwMonthA') as HTMLInputElement;
    const hMonthB = document.getElementById('pwMonthB') as HTMLInputElement;
    const hCourseType = document.getElementById('pwCourseType') as HTMLInputElement;
    const hCourseId = document.getElementById('pwCourseId') as HTMLInputElement;
    const hCourseTitle = document.getElementById('pwCourseTitle') as HTMLInputElement;
    const hDuration = document.getElementById('pwDurationMonths') as HTMLInputElement;
    const hFreeLesson = document.getElementById('pwFreeLesson') as HTMLInputElement;
    const hTotalPrice = document.getElementById('pwTotalPrice') as HTMLInputElement;
    const hPlanKey = document.getElementById('pwPlanKey') as HTMLInputElement;

    const courseCardsWrap = document.getElementById('pwCourseCards') as HTMLElement;
    const levelSelect = document.getElementById('pwLevelSelect') as HTMLSelectElement;
    const monthSelect = document.getElementById('pwMonthSelect') as HTMLSelectElement;
    const pricingRows = document.getElementById('pwPricingRows') as HTMLElement | null;
    const submitFeedback = document.getElementById('pwSubmitFeedback') as HTMLElement | null;

    function syncDots(n: number) {
      dots.forEach((d, i) => {
        const idx = i + 1;
        d.classList.toggle('is-on', idx === n);
        d.classList.toggle('is-past', idx < n);
      });
    }
    function setStepChrome(n: number) {
      if (eyebrow) eyebrow.textContent = `${pad2(n)} / ${pad2(total)}`;
      syncDots(n);
      if (bar) bar.style.transform = `scaleX(${(n - 1) / (total - 1)})`;
    }
    function goTo(next: number) {
      if (next < 1 || next > total || next === step) return;
      panels[step - 1].classList.remove('is-current');
      panels[next - 1].classList.add('is-current');
      step = next;
      setStepChrome(step);
    }

    function resetWizardState() {
      form.reset();
      [hProgram, hProgramLabel, hIntensive, hLevelA, hLevelB, hMonthA, hMonthB, hCourseType, hCourseId, hCourseTitle, hDuration, hPlanKey, hTotalPrice].forEach((el) => { el.value = ''; });
      hFreeLesson.value = 'no';
      form.querySelectorAll('.is-picked, .is-selected, .is-active').forEach((el) => el.classList.remove('is-picked', 'is-selected', 'is-active'));
      if (courseCardsWrap) courseCardsWrap.innerHTML = '';
      if (pricingRows) pricingRows.innerHTML = '';
      if (levelSelect) levelSelect.value = '';
      if (monthSelect) monthSelect.value = '';
      panels.forEach((p, idx) => p.classList.toggle('is-current', idx === 0));
      step = 1;
      setStepChrome(1);
    }

    function renderPricingTable() {
      if (!pricingRows) return;
      const rows = [1, 2, 3, 4, 5, 6].map((m) => {
        const perWeek = getTierPerWeek(m * 4, hIntensive.value === 'intensive-plus');
        const monthPrice = monthlyPrice(perWeek);
        const total = monthPrice * m;
        return { key: `${m}-month`, label: `${m} ay`, perWeek, monthPrice, total, months: m, free: false };
      });
      const freeLessonLabel = form.dataset.freeLessonLabel || 'Free lesson';
      rows.push({ key: 'free-lesson', label: freeLessonLabel, perWeek: 0, monthPrice: 0, total: 0, months: 0, free: true });
      pricingRows.innerHTML = rows.map((r) => `
        <button type="button" class="qx-pricing-row" data-plan-key="${r.key}" data-total="${r.total}" data-months="${r.months}" data-free="${r.free ? 'yes' : 'no'}">
          <span>${r.label}</span>
          <span>${r.free ? '-' : `${r.perWeek} EUR`}</span>
          <span>${r.free ? 'Ucretsiz' : `${r.monthPrice} EUR`}</span>
          <span>${r.free ? '0 EUR' : `${r.total} EUR`}</span>
        </button>
      `).join('');
      pricingRows.querySelectorAll<HTMLElement>('.qx-pricing-row').forEach((rowEl) => {
        rowEl.addEventListener('click', () => {
          pricingRows.querySelectorAll('.qx-pricing-row').forEach((x) => x.classList.remove('is-selected'));
          rowEl.classList.add('is-selected');
          hPlanKey.value = rowEl.dataset.planKey || '';
          hTotalPrice.value = rowEl.dataset.total || '';
          hDuration.value = rowEl.dataset.months || '';
          hFreeLesson.value = rowEl.dataset.free || 'no';
          goTo(5);
        });
      });
    }

    function renderCards() {
      const level = hLevelA.value;
      const month = Number(hMonthA.value || '8');
      const type = hCourseType.value || 'all';
      if (!level || !month || !type) return;
      const cards = buildCourseCards(level, month, type, hIntensive.value);
      if (!cards.length) {
        courseCardsWrap.innerHTML = `<p class="qx-card-empty">Bu filtrelerle su an acik sinif bulunamadi.</p>`;
        return;
      }
      courseCardsWrap.innerHTML = cards.map((card) => `
        <button type="button" class="qx-course-card" data-course-id="${card.id}" data-course-title="${card.title}" data-course-price="${card.priceText}">
          <div class="qx-course-card-rail" aria-hidden="true"></div>
          <div class="qx-course-main">
            <div class="qx-course-topline">
              <h4>${card.title}</h4>
              <span class="qx-course-availability">${card.places}</span>
            </div>
            <p class="qx-course-startline"><strong>Start:</strong> ${card.start}</p>
            ${card.extra ? `<p class="qx-course-extra">${card.extra}</p>` : ''}
          </div>
          <div class="qx-course-facts">
            <div class="qx-course-fact">
              <span class="qx-fact-key">Time</span>
              <strong class="qx-fact-val">${card.time}</strong>
            </div>
            <div class="qx-course-fact">
              <span class="qx-fact-key">Teacher</span>
              <strong class="qx-fact-val">${card.teacher}</strong>
            </div>
            <div class="qx-course-fact">
              <span class="qx-fact-key">Days</span>
              <strong class="qx-fact-val">${card.days}</strong>
            </div>
          </div>
          <div class="qx-course-card-foot">
            <p class="qx-course-price">${card.priceText}</p><span class="qx-course-cta">Book now</span>
          </div>
        </button>
      `).join('');
      courseCardsWrap.querySelectorAll<HTMLButtonElement>('.qx-course-card').forEach((btn) => {
        btn.addEventListener('click', () => {
          courseCardsWrap.querySelectorAll('.qx-course-card').forEach((el) => el.classList.remove('is-selected'));
          btn.classList.add('is-selected');
          hCourseId.value = btn.dataset.courseId || '';
          hCourseTitle.value = btn.dataset.courseTitle || '';
        });
      });
    }

    form.querySelectorAll<HTMLButtonElement>('.qx-card').forEach((btn) => {
      btn.addEventListener('click', () => {
        form.querySelectorAll('.qx-card').forEach((b) => b.classList.remove('is-picked'));
        btn.classList.add('is-picked');
        hProgram.value = btn.dataset.program || '';
        hProgramLabel.value = btn.dataset.programLabel || '';
        hIntensive.value = btn.dataset.intensiveType || '';
        goTo(2);
      });
    });

    function setupSingleSelection(containerId: string, dataAttr: string, onPick: (value: string) => void) {
      const wrap = document.getElementById(containerId);
      if (!wrap) return;
      wrap.querySelectorAll<HTMLButtonElement>(`[${dataAttr}]`).forEach((btn) => {
        btn.addEventListener('click', () => {
          wrap.querySelectorAll('.qx-choice-btn').forEach((x) => x.classList.remove('is-active'));
          btn.classList.add('is-active');
          const value = btn.getAttribute(dataAttr) || '';
          onPick(value);
        });
      });
    }

    setupSingleSelection('pwCourseTypeButtons', 'data-course-type', (v) => { hCourseType.value = v; renderCards(); });
    levelSelect?.addEventListener('change', () => { hLevelA.value = levelSelect.value; hLevelB.value = levelSelect.value; renderCards(); });
    monthSelect?.addEventListener('change', () => { hMonthA.value = monthSelect.value; hMonthB.value = monthSelect.value; renderCards(); });

    form.querySelectorAll<HTMLButtonElement>('[data-pw-nav-next]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (step === 2) {
          if (!hLevelA.value || !hMonthA.value || !hCourseType.value) return;
          renderCards();
          goTo(3);
          return;
        }
        if (step === 3) {
          if (!hCourseId.value) return;
          goTo(4);
          renderPricingTable();
          return;
        }
        if (step === 4) {
          if (!hPlanKey.value) return;
          goTo(5);
        }
      });
    });
    form.querySelectorAll<HTMLButtonElement>('[data-pw-nav-back]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (step === 2) goTo(1);
        else if (step === 3) goTo(2);
        else if (step === 4) goTo(3);
        else if (step === 5) goTo(4);
      });
    });

    const monthNames = (form.dataset.months || '').split('|');
    const now = new Date();
    const currentMonth = now.getMonth() + 1;
    monthNames.forEach((name, idx) => {
      const monthNum = idx + 1;
      if (monthNum < currentMonth) return;
      const opt = document.createElement('option');
      opt.value = String(monthNum);
      opt.textContent = name;
      monthSelect?.appendChild(opt);
    });

    const overlay = document.getElementById('pwOverlay') as HTMLElement | null;
    const dialog = document.querySelector<HTMLElement>('[data-pw-dialog]');
    function openOverlay() {
      if (!overlay || !dialog) return;
      overlay.classList.add('is-open');
      overlay.setAttribute('aria-hidden', 'false');
    }
    function dismissToHome() {
      let target = (overlay?.dataset.home || '/').trim();
      if (!target.startsWith('/')) target = `/${target}`;
      if (target.length > 1 && target.endsWith('/')) target = target.slice(0, -1);
      window.location.href = target;
    }
    document.querySelectorAll<HTMLButtonElement>('[data-pw-close]').forEach((btn) => btn.addEventListener('click', dismissToHome));
    overlay?.addEventListener('click', (e) => { if (e.target === overlay) dismissToHome(); });

    const DEFAULT_MAKE_WEBHOOK = 'https://hook.eu2.make.com/40s1h4a3wra21aszpa9y9erfsfooso47';
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector<HTMLButtonElement>('.qx-send');
      const originalBtnText = btn?.textContent || '';
      if (submitFeedback) {
        submitFeedback.textContent = '';
        submitFeedback.classList.remove('is-success', 'is-error');
      }
      if (btn) btn.disabled = true;
      const fd = new FormData(form);
      const data = Object.fromEntries(fd.entries()) as Record<string, string>;
      const requiredName = String(data['full-name'] || '').trim();
      const requiredEmail = String(data.email || '').trim();
      const requiredPhone = String(data.phone || '').trim();
      const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(requiredEmail);
      if (!requiredName || !requiredEmail || !requiredPhone || !emailOk) {
        const msg = form.dataset.error || 'Lutfen zorunlu alanlari kontrol edin.';
        if ((window as unknown as { showSuccessModal?: (t: string, m: string) => void }).showSuccessModal)
          (window as unknown as { showSuccessModal: (t: string, m: string) => void }).showSuccessModal('error', msg);
        else alert(msg);
        if (btn) btn.disabled = false;
        return;
      }
      const payload = {
        formType: 'price-quote',
        sourcePage: data.sourcePage || '',
        lang: data.lang || '',
        name: data['full-name'] || '',
        country: data.country || '',
        tel: data.phone || '',
        email: data.email || '',
        program: data.program || '',
        intensiveType: data['quote-intensive-type'] || '',
        level: data['quote-level-start'] || '',
        courseSelection: [data['quote-selected-course-title'] || ''],
        startDate: data['quote-month-start'] || '',
        weeks: data['quote-duration-months'] || '',
        message: data.message || '',
        totalPrice: data.totalPrice || '',
        timestamp: new Date().toISOString(),
        quoteProgramLabel: data['quote-program-label'] || '',
        quoteLevelStart: data['quote-level-start'] || '',
        quoteMonthStart: data['quote-month-start'] || '',
        quoteCourseType: data['quote-course-type'] || '',
        quoteCourseId: data['quote-selected-course-id'] || '',
        quoteDurationMonths: data['quote-duration-months'] || '',
        quoteIsFreeLesson: data['quote-is-free-lesson'] || 'no'
      };
      try {
        if (btn) btn.textContent = 'Gonderiliyor...';
        const wh = (form.dataset.webhook || '').trim() || DEFAULT_MAKE_WEBHOOK;
        const res = await fetch(wh, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        if (!res.ok) throw new Error('webhook');
        if (submitFeedback) {
          submitFeedback.textContent = 'Formunuz basariyla gonderildi.';
          submitFeedback.classList.add('is-success');
        }
        resetWizardState();
        openOverlay();
      } catch {
        const msg = form.dataset.error || 'Error';
        if (submitFeedback) {
          submitFeedback.textContent = msg;
          submitFeedback.classList.add('is-error');
        }
        if ((window as unknown as { showSuccessModal?: (t: string, m: string) => void }).showSuccessModal)
          (window as unknown as { showSuccessModal: (t: string, m: string) => void }).showSuccessModal('error', msg);
        else alert(msg);
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.textContent = originalBtnText;
        }
      }
    });

    setStepChrome(1);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
  else start();
</script>
