const t = copy[lang as keyof typeof copy] ?? copy.tr;
---

<div class="quote-wizard-instance" data-quote-instance={instanceSuffix}>
<div class={`qx-page-bg ${quoteMode === 'standalone' ? 'qx-page-bg--standalone' : 'qx-page-bg--embedded'} ${modalMode ? 'qx-page-bg--modal' : ''}`}>
<section class="qx qx-layout-flow" id={pw('pwRoot')} data-qx-mode={quoteMode}>
  <header class="qx-wiz-header">
    <div class="qx-wiz-header__top">
      <div class="qx-wiz-brand">
        <img src="/German_logo.webp" alt="" class="qx-wiz-logo" width="48" height="48" loading="lazy" decoding="async" />
        <div class="qx-wiz-brand__text">
          <span class="qx-wiz-brand__mark">{t.asideMark}</span>
          <span class="qx-wiz-brand__sub">{t.asideSteps}</span>
        </div>
      </div>
      <div class="qx-wiz-status">
        <p class="qx-wiz-status__step" data-pw-eyebrow>01 / 05</p>
        <span class="qx-wiz-status__hint">{t.asideStepHint}</span>
      </div>
    </div>

    <div class="qx-step-track" aria-hidden="true">
      {[1, 2, 3, 4, 5].map((n) => (
        <div class="qx-step-pill">
          <span class="qx-dot" data-qx-dot={n}></span>
          <span class="qx-step-pill__n">{n}</span>
        </div>
      ))}
    </div>

    <div class="qx-wiz-meter" aria-hidden="true">
      <div class="qx-wiz-meter__track">
        <span class="qx-wiz-meter__fill" data-pw-bar></span>
      </div>
    </div>
  </header>

  <div class="qx-body">
    <div class="qx-lead">
      <p class="qx-lead-kicker">{t.subtitleEm}</p>
      <p class="qx-lead-body">{t.subtitle}</p>
    </div>
    <p class="qx-submit-feedback" id={pw('pwSubmitFeedback')} aria-live="polite"></p>

    <form
      id={pw('pwForm')}
      class="qx-form"
      data-webhook={quoteWebhook}
      data-error={t.error}
      data-modal-mode={modalMode ? 'true' : 'false'}
      data-months={t.months.join('|')}
      data-free-lesson-label={t.freeLesson}
      data-pricing-duration={t.pricingDuration}
      data-pricing-weekly={t.pricingWeekly}
      data-pricing-monthly={t.pricingMonthly}
      data-pricing-total={t.pricingTotal}
      data-month-unit={t.monthUnit}
      data-free-price-label={t.freePriceLabel}
      data-empty-courses={t.emptyCourses}
      data-start-label={t.startLabel}
      data-time-label={t.timeLabel}
      data-teacher-label={t.teacherLabel}
      data-days-label={t.daysLabel}
      data-book-now={t.bookNow}
      data-places-available={t.placesAvailable}
      data-two-months-to-complete={t.twoMonthsToComplete}
      data-sending={t.sending}
      data-success={t.success}
      data-per-month-suffix={t.perMonthSuffix}
      data-mode-physical={t.modePhysical}
      data-mode-online={t.modeOnline}
      data-weekdays-short={t.weekdaysShort}
      data-weekend-short={t.weekendShort}
      data-need-level-hint={t.needLevelHint}
    >
      <input type="hidden" name="formType" value="price-quote" />
      <input type="hidden" name="sourcePage" value={Astro.url.pathname} />
      <input type="hidden" name="lang" value={lang} />
      <input type="hidden" name="program" id={pw('pwProgram')} value="" />
      <input type="hidden" name="quote-program-label" id={pw('pwProgramLabel')} value="" />
      <input type="hidden" name="quote-intensive-type" id={pw('pwIntensiveType')} value="" />
      <input type="hidden" name="quote-level-start" id={pw('pwLevelA')} value="" />
      <input type="hidden" name="quote-level-end" id={pw('pwLevelB')} value="" />
      <input type="hidden" name="quote-month-start" id={pw('pwMonthA')} value="" />
      <input type="hidden" name="quote-month-end" id={pw('pwMonthB')} value="" />
      <input type="hidden" name="quote-course-type" id={pw('pwCourseType')} value="" />
      <input type="hidden" name="quote-selected-course-id" id={pw('pwCourseId')} value="" />
      <input type="hidden" name="quote-selected-course-title" id={pw('pwCourseTitle')} value="" />
      <input type="hidden" name="quote-duration-months" id={pw('pwDurationMonths')} value="" />
      <input type="hidden" name="quote-is-free-lesson" id={pw('pwFreeLesson')} value="no" />
      <input type="hidden" name="quote-plan-key" id={pw('pwPlanKey')} value="" />
      <input type="hidden" name="totalPrice" id={pw('pwTotalPrice')} value="" />

      <div class="pw-viewport">
        <div class="pw-panel is-current qx-scene qx-scene--pick" data-panel="1">
          <div class="qx-stage-shell">
            <header class="qx-scene-head"><span class="qx-scene-kicker">1</span><h2 class="qx-question">{t.programQ}</h2></header>
            <div class="qx-program-grid qx-strip qx-strip--programs">
              {t.programs.map((p, i) => (
                <button type="button" class={`qx-card qx-card--${i + 1}`} data-program={p.program} data-program-label={p.label} data-intensive-type={p.intensiveType} data-quote-track={p.quoteTrack}>
                  <span class="qx-card-bg" style={`--qx-img:url('${p.image}')`} aria-hidden="true" />
                  <span class="qx-card-body">
                    <span class="qx-card-num">{String(i + 1).padStart(2, '0')}</span>
                    <strong class="qx-card-title">{p.label}</strong>
                  </span>
                </button>
              ))}
            </div>
          </div>
        </div>

        <div class="pw-panel qx-scene qx-scene--plan" data-panel="2">
          <div class="qx-stage-shell qx-stage-shell--with-nav">
            <header class="qx-scene-head"><span class="qx-scene-kicker">2</span><h2 class="qx-question">{t.levelQ}</h2></header>
            <div class="qx-choice-grid qx-choice-grid--levels" id={pw('pwLevelButtons')} role="group" aria-label={t.levelQ}></div>
            <h3 class="qx-subq">{t.monthQ}</h3>
            <div class="qx-choice-grid qx-choice-grid--months" id={pw('pwMonthButtons')} role="group" aria-label={t.monthQ}></div>
            <div class="qx-stage-nav">
              <button type="button" class="qx-nav-arrow qx-nav-arrow--back" data-pw-nav-back aria-label={t.planBack}><i class="fas fa-arrow-left" aria-hidden="true"></i></button>
              <button type="button" class="qx-nav-arrow qx-nav-arrow--next" data-pw-nav-next aria-label={t.planContinue}><i class="fas fa-arrow-right" aria-hidden="true"></i></button>
            </div>
          </div>
        </div>

        <div class="pw-panel qx-scene qx-scene--stay" data-panel="3">
          <div class="qx-stage-shell qx-stage-shell--with-nav">
            <header class="qx-scene-head"><span class="qx-scene-kicker">3</span><h2 class="qx-question">{t.step3lead}</h2></header>
            <p class="qx-hint">{t.cardSelectHint}</p>
            <div class="qx-course-cards" id={pw('pwCourseCards')}></div>
            <div class="qx-stage-nav">
              <button type="button" class="qx-nav-arrow qx-nav-arrow--back" data-pw-nav-back aria-label={t.planBack}><i class="fas fa-arrow-left" aria-hidden="true"></i></button>
              <button type="button" class="qx-nav-arrow qx-nav-arrow--next" data-pw-nav-next aria-label={t.planContinue}><i class="fas fa-arrow-right" aria-hidden="true"></i></button>
            </div>
          </div>
        </div>

        <div class="pw-panel qx-scene qx-scene--pricing" data-panel="4">
          <div class="qx-stage-shell qx-stage-shell--with-nav">
            <header class="qx-scene-head"><span class="qx-scene-kicker">4</span><h2 class="qx-question">{t.step4lead}</h2></header>
            <div class="qx-pricing-table-wrap" id={pw('pwPricingTable')}>
              <div class="qx-pricing-head" role="row">
                <div>{t.pricingDuration}</div>
                <div>{t.pricingWeekly}</div>
                <div>{t.pricingMonthly}</div>
                <div>{t.pricingTotal}</div>
              </div>
              <div class="qx-pricing-rows" id={pw('pwPricingRows')}></div>
            </div>
            <div class="qx-stage-nav">
              <button type="button" class="qx-nav-arrow qx-nav-arrow--back" data-pw-nav-back aria-label={t.planBack}><i class="fas fa-arrow-left" aria-hidden="true"></i></button>
            </div>
          </div>
        </div>

        <div class="pw-panel qx-scene qx-scene--send" data-panel="5">
          <div class="qx-stage-shell qx-stage-shell--with-nav">
            <header class="qx-scene-head"><span class="qx-scene-kicker">5</span><h2 class="qx-question">{t.step5lead}</h2></header>
            <div class="qx-fields qx-fields--grid">
              <label><span>{t.name}</span><input type="text" name="full-name" required autocomplete="name" /></label>
              <label><span>{t.email}</span><input type="email" name="email" required autocomplete="email" /></label>
              <label><span>{t.phone}</span><input type="tel" name="phone" required autocomplete="tel" /></label>
              <label><span>{t.country}</span><input type="text" name="country" autocomplete="country-name" /></label>
              <label class="qx-field-full"><span>{t.message}</span><textarea name="message" rows="4"></textarea></label>
            </div>
            <div class="qx-stage-nav">
              <button type="button" class="qx-nav-arrow qx-nav-arrow--back" data-pw-nav-back aria-label={t.planBack}><i class="fas fa-arrow-left" aria-hidden="true"></i></button>
            </div>
            <button class="qx-send" type="submit">{t.submit}</button>
          </div>
        </div>
      </div>
    </form>
  </div>
</section>
</div>

<div class="pw-overlay" id={pw('pwOverlay')} data-home={homePath} aria-hidden="true">
  <div class="pw-dialog pw-dialog--done" data-pw-dialog role="dialog" aria-modal="true" aria-labelledby={pw('pwDoneTitle')}>
    <button type="button" class="pw-dialog-dismiss" data-pw-close aria-label={t.doneClose}><i class="fas fa-times" aria-hidden="true"></i></button>
    <div class="pw-dialog-icon" aria-hidden="true"><i class="fas fa-check"></i></div>
    <h3 id={pw('pwDoneTitle')} class="pw-dialog-title">{t.doneTitle}</h3>
    <p class="pw-dialog-text">{t.doneText}</p>
    <div class="pw-dialog-cta-wrap">
      <button type="button" class="pw-dialog-home" data-pw-close>{t.doneClose}</button>
    </div>
  </div>
</div>
</div>

<script>
  function pad2(n: number) { return String(n).padStart(2, '0'); }
  function monthlyPrice(perWeek: number) { return perWeek * 4; }
  /* Haftalık € — Fiyatlar ve Tarihler ile aynı (20h): 1–4:190, 5–8:150, 9–15:130, 16–24:120, 25+:110 */
  const TIERS_20H = [
    { min: 1, max: 4, perWeek: 190 },
    { min: 5, max: 8, perWeek: 150 },
    { min: 9, max: 15, perWeek: 130 },
    { min: 16, max: 24, perWeek: 120 },
    { min: 25, max: 999, perWeek: 110 }
  ];
  /* 25h (Telc / intensive-plus): 20h + 40 €/hafta aynı kademelerde */
  const TIERS_25H = [
    { min: 1, max: 4, perWeek: 230 },
    { min: 5, max: 8, perWeek: 190 },
    { min: 9, max: 15, perWeek: 170 },
    { min: 16, max: 24, perWeek: 160 },
    { min: 25, max: 999, perWeek: 150 }
  ];
  function getTierPerWeek(weeks: number, plus: boolean) {
    const tiers = plus ? TIERS_25H : TIERS_20H;
    const tier = tiers.find((t) => weeks >= t.min && weeks <= t.max);
    return tier ? tier.perWeek : (plus ? 230 : 190);
  }

  const TIME_SLOTS = ['9:00 – 12:30', '13:30 – 17:00', '18:00 – 21:30'];

  function buildCourseCards(formEl: HTMLFormElement, level: string, startMonth: number, _courseType: string, intensiveType: string) {
    const plus = intensiveType === 'intensive-plus';
    const perWeekStart = getTierPerWeek(4, plus);
    const perWeekEnd = getTierPerWeek(32, plus);
    const perMonthSuffix = formEl.dataset.perMonthSuffix || '/ month';
    const modePhysical = formEl.dataset.modePhysical || 'PHYSICAL';
    const modeOnline = formEl.dataset.modeOnline || 'ONLINE';
    const weekdaysShort = formEl.dataset.weekdaysShort || 'Mon, Tue, Wed, Thu';
    const weekendShort = formEl.dataset.weekendShort || 'Sat, Sun';
    const priceText = `EUR ${monthlyPrice(perWeekEnd)} - ${monthlyPrice(perWeekStart)} ${perMonthSuffix}`;
    const startDate = `31.${String(startMonth).padStart(2, '0')}.2026`;
    const teachers = ['Anna Keller', 'Murat Yildiz', 'Sofia Becker', 'Deniz Acar', 'Lukas Weber', 'Elif Demir'];
    const pickTeacher = (seed: string) => {
      const sum = seed.split('').reduce((acc, ch) => acc + ch.charCodeAt(0), 0);
      return teachers[sum % teachers.length];
    };
    const placesAvailable = formEl.dataset.placesAvailable || 'Places available';
    const twoMonthsToComplete = formEl.dataset.twoMonthsToComplete || 'Two months to complete';
    const base = [
      { id: 'phy-morning', type: 'physical', title: `${level} (${modePhysical})`, days: weekdaysShort, teacher: pickTeacher('phy-morning-' + level), start: startDate, places: placesAvailable, extra: '' },
      { id: 'phy-afternoon', type: 'physical', title: `${level} (${modePhysical})`, days: weekdaysShort, teacher: pickTeacher('phy-afternoon-' + level), start: startDate, places: placesAvailable, extra: '' },
      { id: 'phy-evening', type: 'physical', title: `${level} (${modePhysical})`, days: weekdaysShort, teacher: pickTeacher('phy-evening-' + level), start: startDate, places: placesAvailable, extra: '' },
      { id: 'online-morning', type: 'online', title: `${level} (${modeOnline})`, days: weekdaysShort, teacher: pickTeacher('online-morning-' + level), start: startDate, places: placesAvailable, extra: `${twoMonthsToComplete} ${level}` },
      { id: 'online-evening', type: 'online', title: `${level} (${modeOnline})`, days: weekdaysShort, teacher: pickTeacher('online-evening-' + level), start: startDate, places: placesAvailable, extra: '' },
      { id: 'phy-weekend', type: 'physical', title: `${level} (${modePhysical})`, days: weekendShort, teacher: pickTeacher('phy-weekend-' + level), start: startDate, places: placesAvailable, extra: '' }
    ];
    return base.map((x, i) => ({ ...x, time: TIME_SLOTS[i % TIME_SLOTS.length], priceText }));
  }

  function initQuoteMount(mount: HTMLElement) {
    const S = mount.dataset.quoteInstance || 'm';
    const q = <T extends HTMLElement = HTMLElement>(stem: string) => mount.querySelector<T>(`#${stem}-${S}`);
    const form = mount.querySelector<HTMLFormElement>('form.qx-form');
    const root = q<HTMLElement>('pwRoot');
    if (!form || !root) return;

    const total = 5;
    let step = 1;
    const panels = [...form.querySelectorAll<HTMLElement>('.pw-panel')];
    const eyebrow = root.querySelector<HTMLElement>('[data-pw-eyebrow]');
    const bar = root.querySelector<HTMLElement>('[data-pw-bar]');
    const dots = [...root.querySelectorAll<HTMLElement>('[data-qx-dot]')];

    const hProgram = q('pwProgram') as HTMLInputElement;
    const hProgramLabel = q('pwProgramLabel') as HTMLInputElement;
    const hIntensive = q('pwIntensiveType') as HTMLInputElement;
    const hLevelA = q('pwLevelA') as HTMLInputElement;
    const hLevelB = q('pwLevelB') as HTMLInputElement;
    const hMonthA = q('pwMonthA') as HTMLInputElement;
    const hMonthB = q('pwMonthB') as HTMLInputElement;
    const hCourseType = q('pwCourseType') as HTMLInputElement;
    const hCourseId = q('pwCourseId') as HTMLInputElement;
    const hCourseTitle = q('pwCourseTitle') as HTMLInputElement;
    const hDuration = q('pwDurationMonths') as HTMLInputElement;
    const hFreeLesson = q('pwFreeLesson') as HTMLInputElement;
    const hTotalPrice = q('pwTotalPrice') as HTMLInputElement;
    const hPlanKey = q('pwPlanKey') as HTMLInputElement;

    const courseCardsWrap = q('pwCourseCards') as HTMLElement;
    const pricingRows = q('pwPricingRows') as HTMLElement | null;
    const submitFeedback = q('pwSubmitFeedback') as HTMLElement | null;

    const LEVELS_FULL = ['A1', 'A2', 'B1', 'B2', 'C1'];
    const LEVELS_SHORT = ['A1', 'A2'];
    function levelsForTrack(track: string) {
      if (track === 'summer-camp' || track === 'online') return LEVELS_SHORT;
      return LEVELS_FULL;
    }
    function populateLevelButtons(track: string) {
      const wrap = q('pwLevelButtons');
      if (!wrap) return;
      wrap.innerHTML = '';
      hLevelA.value = '';
      hLevelB.value = '';
      levelsForTrack(track).forEach((lv) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'qx-choice-btn qx-level-btn';
        b.dataset.levelValue = lv;
        b.textContent = lv;
        b.addEventListener('click', () => {
          wrap.querySelectorAll('.qx-level-btn').forEach((x) => x.classList.remove('is-active'));
          b.classList.add('is-active');
          hLevelA.value = lv;
          hLevelB.value = lv;
          renderCards();
        });
        wrap.appendChild(b);
      });
    }
    function populateMonthButtons() {
      const monthWrap = q('pwMonthButtons');
      if (!monthWrap) return;
      monthWrap.innerHTML = '';
      hMonthA.value = '';
      hMonthB.value = '';
      const rawMonthTokens = (form.getAttribute('data-months') ?? '')
        .split('|')
        .map((s) => s.trim())
        .filter((s) => s.length > 0);
      const monthNames = rawMonthTokens.length === 12 ? rawMonthTokens : Array.from({ length: 12 }, (_, i) => String(i + 1));
      const now = new Date();
      const currentMonth = now.getMonth() + 1;
      monthNames.forEach((name, idx) => {
        const monthNum = idx + 1;
        if (monthNum < currentMonth) return;
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'qx-choice-btn qx-month-btn';
        b.dataset.monthValue = String(monthNum);
        b.textContent = name;
        b.addEventListener('click', () => {
          monthWrap.querySelectorAll('.qx-month-btn').forEach((x) => x.classList.remove('is-active'));
          b.classList.add('is-active');
          hMonthA.value = String(monthNum);
          hMonthB.value = String(monthNum);
          renderCards();
        });
        monthWrap.appendChild(b);
      });
    }

    function syncDots(n: number) {
      dots.forEach((d, i) => {
        const idx = i + 1;
        d.classList.toggle('is-on', idx === n);
        d.classList.toggle('is-past', idx < n);
      });
    }
    function setStepChrome(n: number) {
      if (eyebrow) eyebrow.textContent = `${pad2(n)} / ${pad2(total)}`;
      syncDots(n);
      if (bar) bar.style.transform = `scaleX(${(n - 1) / (total - 1)})`;
    }
    function goTo(next: number) {
      if (next < 1 || next > total || next === step) return;
      const from = panels[step - 1];
      const to = panels[next - 1];
      if (!from || !to) return;
      from.classList.remove('is-current');
      to.classList.add('is-current');
      step = next;
      setStepChrome(step);
    }

    /** Ay bos birakilirsa varsayilan: ilk uygun ay */
    function applyStep2Defaults() {
      hCourseType.value = 'all';
      const monthWrap = q('pwMonthButtons');
      if (monthWrap && !hMonthA.value) {
        const firstBtn = monthWrap.querySelector<HTMLButtonElement>('.qx-month-btn');
        if (firstBtn) {
          firstBtn.click();
        }
      }
    }

    function resetWizardState() {
      form.reset();
      [hProgram, hProgramLabel, hIntensive, hLevelA, hLevelB, hMonthA, hMonthB, hCourseType, hCourseId, hCourseTitle, hDuration, hPlanKey, hTotalPrice].forEach((el) => { el.value = ''; });
      hFreeLesson.value = 'no';
      form.querySelectorAll('.is-picked, .is-selected, .is-active').forEach((el) => el.classList.remove('is-picked', 'is-selected', 'is-active'));
      if (courseCardsWrap) courseCardsWrap.innerHTML = '';
      if (pricingRows) pricingRows.innerHTML = '';
      q('pwLevelButtons')?.querySelectorAll('.qx-level-btn').forEach((b) => b.classList.remove('is-active'));
      q('pwMonthButtons')?.querySelectorAll('.qx-month-btn').forEach((b) => b.classList.remove('is-active'));
      panels.forEach((p, idx) => p.classList.toggle('is-current', idx === 0));
      step = 1;
      setStepChrome(1);
    }

    function renderPricingTable() {
      if (!pricingRows) return;
      const rows = [1, 2, 3, 4, 5, 6, 7, 8].map((m) => {
        const perWeek = getTierPerWeek(m * 4, hIntensive.value === 'intensive-plus');
        const monthPrice = monthlyPrice(perWeek);
        const total = monthPrice * m;
        const monthUnit = form.dataset.monthUnit || 'month';
        return { key: `${m}-month`, label: `${m} ${monthUnit}`, perWeek, monthPrice, total, months: m, free: false };
      });
      const freeLessonLabel = form.dataset.freeLessonLabel || 'Free lesson';
      rows.push({ key: 'free-lesson', label: freeLessonLabel, perWeek: 0, monthPrice: 0, total: 0, months: 0, free: true });
      pricingRows.innerHTML = rows.map((r) => `
        <button type="button" class="qx-pricing-row" data-plan-key="${r.key}" data-total="${r.total}" data-months="${r.months}" data-free="${r.free ? 'yes' : 'no'}">
          <span>${r.label}</span>
          <span>${r.free ? '-' : `${r.perWeek} EUR`}</span>
          <span>${r.free ? (form.dataset.freePriceLabel || 'Free') : `${r.monthPrice} EUR`}</span>
          <span>${r.free ? '0 EUR' : `${r.total} EUR`}</span>
        </button>
      `).join('');
      pricingRows.querySelectorAll<HTMLElement>('.qx-pricing-row').forEach((rowEl) => {
        rowEl.addEventListener('click', () => {
          pricingRows.querySelectorAll('.qx-pricing-row').forEach((x) => x.classList.remove('is-selected'));
          rowEl.classList.add('is-selected');
          hPlanKey.value = rowEl.dataset.planKey || '';
          hTotalPrice.value = rowEl.dataset.total || '';
          hDuration.value = rowEl.dataset.months || '';
          hFreeLesson.value = rowEl.dataset.free || 'no';
          goTo(5);
        });
      });
    }

    function renderCards() {
      if (!courseCardsWrap) return;
      const level = hLevelA.value;
      const month = Number(hMonthA.value || '0');
      if (!level || !month) return;
      const cards = buildCourseCards(form, level, month, 'all', hIntensive.value);
      if (!cards.length) {
        courseCardsWrap.innerHTML = `<p class="qx-card-empty">${form.dataset.emptyCourses || 'No open class matches these filters right now.'}</p>`;
        return;
      }
      courseCardsWrap.innerHTML = cards.map((card) => `
        <button type="button" class="qx-course-card" data-course-id="${card.id}" data-course-title="${card.title}" data-course-price="${card.priceText}">
          <div class="qx-course-main">
            <div class="qx-course-topline">
              <h4>${card.title}</h4>
              <span class="qx-course-availability">${card.places}</span>
            </div>
            <p class="qx-course-startline"><strong>${form.dataset.startLabel || 'Start'}:</strong> ${card.start}</p>
            ${card.extra ? `<p class="qx-course-extra">${card.extra}</p>` : ''}
          </div>
          <div class="qx-course-facts">
            <div class="qx-course-fact">
              <span class="qx-fact-key">${form.dataset.timeLabel || 'Time'}</span>
              <strong class="qx-fact-val">${card.time}</strong>
            </div>
            <div class="qx-course-fact">
              <span class="qx-fact-key">${form.dataset.teacherLabel || 'Teacher'}</span>
              <strong class="qx-fact-val">${card.teacher}</strong>
            </div>
            <div class="qx-course-fact">
              <span class="qx-fact-key">${form.dataset.daysLabel || 'Days'}</span>
              <strong class="qx-fact-val">${card.days}</strong>
            </div>
          </div>
          <div class="qx-course-card-foot">
            <p class="qx-course-price">${card.priceText}</p><span class="qx-course-cta">${form.dataset.bookNow || 'Book now'}</span>
          </div>
        </button>
      `).join('');
      courseCardsWrap.querySelectorAll<HTMLButtonElement>('.qx-course-card').forEach((btn) => {
        btn.addEventListener('click', () => {
          courseCardsWrap.querySelectorAll('.qx-course-card').forEach((el) => el.classList.remove('is-selected'));
          btn.classList.add('is-selected');
          hCourseId.value = btn.dataset.courseId || '';
          hCourseTitle.value = btn.dataset.courseTitle || '';
        });
      });
    }

    form.querySelectorAll<HTMLButtonElement>('.qx-card').forEach((btn) => {
      btn.addEventListener('click', () => {
        form.querySelectorAll('.qx-card').forEach((b) => b.classList.remove('is-picked'));
        btn.classList.add('is-picked');
        hProgram.value = btn.dataset.program || '';
        hProgramLabel.value = btn.dataset.programLabel || '';
        hIntensive.value = btn.dataset.intensiveType || '';
        const track = btn.dataset.quoteTrack || 'intensive-de';
        populateLevelButtons(track);
        populateMonthButtons();
        goTo(2);
        applyStep2Defaults();
      });
    });

    form.querySelectorAll<HTMLButtonElement>('[data-pw-nav-next]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (step === 2) {
          applyStep2Defaults();
          if (!hLevelA.value) {
            if (submitFeedback) {
              submitFeedback.textContent = form.dataset.needLevelHint || '';
              submitFeedback.classList.remove('is-success');
              submitFeedback.classList.add('is-error');
            }
            return;
          }
          if (!hMonthA.value) return;
          if (submitFeedback) {
            submitFeedback.textContent = '';
            submitFeedback.classList.remove('is-error');
          }
          try {
            renderCards();
          } catch (e) {
            console.error('QuoteWizard renderCards:', e);
            if (submitFeedback) {
              submitFeedback.textContent = form.dataset.error || '';
              submitFeedback.classList.add('is-error');
            }
            return;
          }
          goTo(3);
          return;
        }
        if (step === 3) {
          if (!hCourseId.value) return;
          goTo(4);
          renderPricingTable();
          return;
        }
        if (step === 4) {
          if (!hPlanKey.value) return;
          goTo(5);
        }
      });
    });
    form.querySelectorAll<HTMLButtonElement>('[data-pw-nav-back]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (step === 2) goTo(1);
        else if (step === 3) goTo(2);
        else if (step === 4) goTo(3);
        else if (step === 5) goTo(4);
      });
    });

    if (form.dataset.modalMode === 'true') {
      window.addEventListener('campus-quote-modal-close', () => {
        resetWizardState();
      });
    }

    const overlay = q('pwOverlay') as HTMLElement | null;
    const dialog = mount.querySelector<HTMLElement>('[data-pw-dialog]');
    function openOverlay() {
      if (!overlay || !dialog) return;
      overlay.classList.add('is-open');
      overlay.setAttribute('aria-hidden', 'false');
    }
    function dismissToHome() {
      if (form.dataset.modalMode === 'true') {
        window.closeCampusQuoteModal?.();
        return;
      }
      let target = (overlay?.dataset.home || '/').trim();
      if (!target.startsWith('/')) target = `/${target}`;
      if (target.length > 1 && target.endsWith('/')) target = target.slice(0, -1);
      window.location.href = target;
    }
    mount.querySelectorAll<HTMLButtonElement>('[data-pw-close]').forEach((btn) => btn.addEventListener('click', dismissToHome));
    overlay?.addEventListener('click', (e) => { if (e.target === overlay) dismissToHome(); });

    const DEFAULT_MAKE_WEBHOOK = 'https://hook.eu2.make.com/40s1h4a3wra21aszpa9y9erfsfooso47';
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector<HTMLButtonElement>('.qx-send');
      const originalBtnText = btn?.textContent || '';
      if (submitFeedback) {
        submitFeedback.textContent = '';
        submitFeedback.classList.remove('is-success', 'is-error');
      }
      if (btn) btn.disabled = true;
      const fd = new FormData(form);
      const data = Object.fromEntries(fd.entries()) as Record<string, string>;
      const requiredName = String(data['full-name'] || '').trim();
      const requiredEmail = String(data.email || '').trim();
      const requiredPhone = String(data.phone || '').trim();
      const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(requiredEmail);
      if (!requiredName || !requiredEmail || !requiredPhone || !emailOk) {
        const msg = form.dataset.error || 'Lutfen zorunlu alanlari kontrol edin.';
        if ((window as unknown as { showSuccessModal?: (t: string, m: string) => void }).showSuccessModal)
          (window as unknown as { showSuccessModal: (t: string, m: string) => void }).showSuccessModal('error', msg);
        else alert(msg);
        if (btn) btn.disabled = false;
        return;
      }
      const payload = {
        formType: 'price-quote',
        sourcePage: data.sourcePage || '',
        lang: data.lang || '',
        name: data['full-name'] || '',
        country: data.country || '',
        tel: data.phone || '',
        email: data.email || '',
        program: data.program || '',
        intensiveType: data['quote-intensive-type'] || '',
        level: data['quote-level-start'] || '',
        courseSelection: [data['quote-selected-course-title'] || ''],
        startDate: data['quote-month-start'] || '',
        weeks: data['quote-duration-months'] || '',
        message: data.message || '',
        totalPrice: data.totalPrice || '',
        timestamp: new Date().toISOString(),
        quoteProgramLabel: data['quote-program-label'] || '',
        quoteLevelStart: data['quote-level-start'] || '',
        quoteMonthStart: data['quote-month-start'] || '',
        quoteCourseType: data['quote-course-type'] || '',
        quoteCourseId: data['quote-selected-course-id'] || '',
        quoteDurationMonths: data['quote-duration-months'] || '',
        quoteIsFreeLesson: data['quote-is-free-lesson'] || 'no'
      };
      try {
        if (btn) btn.textContent = form.dataset.sending || 'Sending...';
        const wh = (form.dataset.webhook || '').trim() || DEFAULT_MAKE_WEBHOOK;
        const res = await fetch(wh, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        if (!res.ok) throw new Error('webhook');
        if (submitFeedback) {
          submitFeedback.textContent = form.dataset.success || 'Your form was submitted successfully.';
          submitFeedback.classList.add('is-success');
        }
        resetWizardState();
        openOverlay();
      } catch {
        const msg = form.dataset.error || 'Error';
        if (submitFeedback) {
          submitFeedback.textContent = msg;
          submitFeedback.classList.add('is-error');
        }
        if ((window as unknown as { showSuccessModal?: (t: string, m: string) => void }).showSuccessModal)
          (window as unknown as { showSuccessModal: (t: string, m: string) => void }).showSuccessModal('error', msg);
        else alert(msg);
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.textContent = originalBtnText;
        }
      }
    });

    setStepChrome(1);
  }

  function initAllQuoteWizards() {
    document.querySelectorAll<HTMLElement>('.quote-wizard-instance').forEach((mount) => {
      if (mount.dataset.pwInit === '1') return;
      mount.dataset.pwInit = '1';
      initQuoteMount(mount);
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initAllQuoteWizards);
  else initAllQuoteWizards();
</script>
