const t = copy[lang as keyof typeof copy] ?? copy.tr;
const programHint = programHintByLang[lang as keyof typeof programHintByLang] ?? programHintByLang.tr;
type QuoteCardLang = keyof typeof programCardMetaByLang;
const quoteCardLang: QuoteCardLang =
  lang === 'de' || lang === 'en' || lang === 'es' ? lang : 'tr';
const programCardMeta = programCardMetaByLang[quoteCardLang];
const step3Json = JSON.stringify({
  teachersInGroup: t.teachersInGroup,
  slotMorningTitle: t.slotMorningTitle,
  slotAfternoonTitle: t.slotAfternoonTitle,
  slotEveningTitle: t.slotEveningTitle,
  slotMorningTime: t.slotMorningTime,
  slotAfternoonTime: t.slotAfternoonTime,
  slotEveningTime: t.slotEveningTime,
  slotMorningF1: t.slotMorningF1,
  slotMorningF2: t.slotMorningF2,
  slotMorningF3: t.slotMorningF3,
  slotAfternoonF1: t.slotAfternoonF1,
  slotAfternoonF2: t.slotAfternoonF2,
  slotAfternoonF3: t.slotAfternoonF3,
  slotEveningF1: t.slotEveningF1,
  slotEveningF2: t.slotEveningF2,
  slotEveningF3: t.slotEveningF3
});
const step4Json = JSON.stringify({
  step4NeedPick: t.step4NeedPick,
  step4NeedCustomDate: t.step4NeedCustomDate,
  step4CustomSummary: t.step4CustomSummary
});
---

<div class="quote-wizard-instance" data-quote-instance={instanceSuffix}>
  <script type="application/json" id={pw('pwStep3Json')} set:html={step3Json} />
  <script type="application/json" id={pw('pwStep4Json')} set:html={step4Json} />
<div class={`qx-page-bg ${quoteMode === 'standalone' ? 'qx-page-bg--standalone' : 'qx-page-bg--embedded'} ${modalMode ? 'qx-page-bg--modal' : ''}`}>
<section class="qx qx-layout-flow" id={pw('pwRoot')} data-qx-mode={quoteMode} data-qx-active-step="1">
  <header class="qx-wiz-header">
    <div class="qx-wiz-header__top">
      <div class="qx-wiz-brand qx-wiz-brand--logo">
        <img src="/German_logo.webp" alt="" class="qx-wiz-logo" width="48" height="48" loading="lazy" decoding="async" />
      </div>

      <div class="qx-step-track-wrap">
        <button
          type="button"
          class="qx-wiz-header-back"
          data-pw-header-back
          hidden
          aria-label={t.planBack}
        >
          <i class="fas fa-arrow-left" aria-hidden="true"></i>
        </button>
        <div class="qx-step-track" aria-hidden="true">
          {[1, 2, 3, 4, 5].map((n) => (
            <div class="qx-step-pill">
              <span class="qx-dot" data-qx-dot={n}>{n}</span>
              <span class="qx-step-pill__label">{t.stepLabels[n - 1]}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="qx-wiz-status qx-wiz-status--box">
        <p class="qx-wiz-status__step" data-pw-eyebrow>01 / 05</p>
        <span class="qx-wiz-status__hint">{t.asideStepHint}</span>
      </div>
    </div>

    <div class="qx-wiz-meter" aria-hidden="true">
      <div class="qx-wiz-meter__track">
        <span class="qx-wiz-meter__fill" data-pw-bar></span>
      </div>
    </div>
  </header>

  <div class="qx-body">
    <div class="qx-lead qx-lead--hero">
      <p class="qx-lead-kicker">{t.subtitleEm}</p>
      <p class="qx-lead-body">{t.subtitle}</p>
    </div>
    <p class="qx-submit-feedback" id={pw('pwSubmitFeedback')} aria-live="polite"></p>

    <form
      id={pw('pwForm')}
      class="qx-form"
      data-webhook={quoteWebhook}
      data-error={t.error}
      data-modal-mode={modalMode ? 'true' : 'false'}
      data-months={t.months.join('|')}
      data-free-lesson-label={t.freeLesson}
      data-pricing-duration={t.pricingDuration}
      data-pricing-weekly={t.pricingWeekly}
      data-pricing-monthly={t.pricingMonthly}
      data-pricing-total={t.pricingTotal}
      data-month-unit={t.monthUnit}
      data-free-price-label={t.freePriceLabel}
      data-empty-courses={t.emptyCourses}
      data-start-label={t.startLabel}
      data-time-label={t.timeLabel}
      data-teacher-label={t.teacherLabel}
      data-days-label={t.daysLabel}
      data-book-now={t.bookNow}
      data-places-available={t.placesAvailable}
      data-two-months-to-complete={t.twoMonthsToComplete}
      data-sending={t.sending}
      data-success={t.success}
      data-per-month-suffix={t.perMonthSuffix}
      data-mode-physical={t.modePhysical}
      data-mode-online={t.modeOnline}
      data-weekdays-short={t.weekdaysShort}
      data-weekend-short={t.weekendShort}
      data-need-level-hint={t.needLevelHint}
      data-calendar-trigger-label={t.step4CalendarTrigger}
    >
      <input type="hidden" name="formType" value="price-quote" />
      <input type="hidden" name="sourcePage" value={Astro.url.pathname} />
      <input type="hidden" name="lang" value={lang} />
      <input type="hidden" name="quoteSubmitIntent" id={pw('pwSubmitIntent')} value="quote" />
      <input type="hidden" name="demoLessonRequested" id={pw('pwDemoLessonRequested')} value="false" />
      <input type="hidden" name="program" id={pw('pwProgram')} value="" />
      <input type="hidden" name="programLabel" id={pw('pwProgramLabel')} value="" />
      <input type="hidden" name="level" id={pw('pwLevelA')} value="" />
      <input type="hidden" name="courseId" id={pw('pwCourseId')} value="" />
      <input type="hidden" name="courseTitle" id={pw('pwCourseTitle')} value="" />
      <input type="hidden" name="startDateMode" id={pw('pwStartDateMode')} value="" />
      <input type="hidden" name="startDateIso" id={pw('pwStartDateIso')} value="" />
      <input type="hidden" name="startDateLabel" id={pw('pwStartDateLabel')} value="" />

      <div class="pw-viewport">
        <div class="pw-panel is-current qx-scene qx-scene--pick" data-panel="1">
          <div class="qx-stage-shell">
            <header class="qx-scene-head qx-scene-head--program">
              <span class="qx-scene-kicker">1</span>
              <div class="qx-scene-head__copy">
                <h2 class="qx-question">{t.programQ}</h2>
                <p class="qx-question-note">{programHint}</p>
              </div>
            </header>
            <div class="qx-program-grid qx-strip qx-strip--programs">
              {t.programs.map((p, i) => {
                const meta =
                  programCardMeta[p.quoteTrack as keyof typeof programCardMeta] ?? programCardMeta['intensive-de'];
                return (
                  <button type="button" class={`qx-card qx-card--program qx-card--${i + 1}`} data-program={p.program} data-program-label={p.label} data-intensive-type={p.intensiveType} data-quote-track={p.quoteTrack}>
                    <span class="qx-card-bg" style={`--qx-img:url('${p.image}')`} aria-hidden="true" />
                    <span class="qx-card-body">
                      <span class="qx-card-title-row">
                        <strong class="qx-card-title">{p.label}</strong>
                        <span class="qx-card-go" aria-hidden="true"><i class="fas fa-chevron-right"></i></span>
                      </span>
                      <div class="qx-card-program-badges">
                        <div class="qx-card-badges qx-card-badges--highlights" role="list">
                          {meta.highlights.map((h) => (
                            <span class="qx-card-badge qx-card-badge--hi" role="listitem">{h}</span>
                          ))}
                        </div>
                        <div class="qx-card-badges qx-card-badges--meta" role="list">
                          {meta.levels.map((lv) => (
                            <span class="qx-card-badge qx-card-badge--meta" role="listitem">{lv}</span>
                          ))}
                          {meta.infos.map((info) => (
                            <span class="qx-card-badge qx-card-badge--meta" role="listitem">{info}</span>
                          ))}
                        </div>
                      </div>
                    </span>
                  </button>
                );
              })}
            </div>
          </div>
        </div>

        <div class="pw-panel qx-scene qx-scene--plan" data-panel="2">
          <div class="qx-stage-shell qx-stage-shell--with-nav qx-stage-shell--level-v2">
            <header class="qx-scene-head qx-scene-head--level">
              <span class="qx-scene-kicker">2</span>
              <div class="qx-scene-head__copy">
                <h2 class="qx-question">{t.levelHeroTitle}</h2>
                <p class="qx-question-note">{t.levelHeroSubtitle}</p>
              </div>
            </header>
            <section class="qx-level-banner" aria-label={t.levelBannerTitle}>
              <span class="qx-level-banner__icon" aria-hidden="true"><i class="far fa-star"></i></span>
              <div class="qx-level-banner__copy">
                <strong>{t.levelBannerTitle}</strong>
                <p>{t.levelBannerText}</p>
              </div>
            </section>
            <div class="qx-choice-grid qx-choice-grid--levels qx-choice-grid--levels-v2" id={pw('pwLevelButtons')} role="group" aria-label={t.levelQ}></div>
            <div class="qx-level-help">
              <div class="qx-level-help__copy">
                <strong>{t.levelHelpTitle}</strong>
                <p>{t.levelHelpText}</p>
              </div>
              <div class="qx-level-help__actions">
                <button type="button" class="qx-level-help__btn qx-level-help__btn--primary" data-pw-level-assessment>{t.levelHelpCtaPrimary} <i class="fas fa-arrow-right" aria-hidden="true"></i></button>
                <button type="button" class="qx-level-help__btn qx-level-help__btn--ghost" data-pw-level-a1>{t.levelHelpCtaSecondary} <i class="fas fa-arrow-right" aria-hidden="true"></i></button>
              </div>
            </div>
            <div class="qx-choice-grid qx-choice-grid--months" id={pw('pwMonthButtons')} role="group" aria-label={t.monthQ}></div>
          </div>
        </div>

        <div class="pw-panel qx-scene qx-scene--stay" data-panel="3">
          <div class="qx-stage-shell qx-stage-shell--step3">
            <header class="qx-scene-head qx-scene-head--step3">
              <span class="qx-scene-kicker">3</span>
              <div class="qx-scene-head__copy">
                <h2 class="qx-question">{t.step3Title}</h2>
                <p class="qx-question-note">{t.step3Subtitle}</p>
              </div>
            </header>
            <p class="qx-hint qx-hint--step3">{t.cardSelectHint}</p>
            <div class="qx-step3-scroll">
              <div class="qx-course-cards qx-course-cards--time-slots" id={pw('pwCourseCards')} role="group" aria-label={t.step3Title}></div>
            </div>
            <aside class="qx-speaking-banner" aria-label={t.speakingClubAria}>
              <div class="qx-speaking-banner__icon" aria-hidden="true"><i class="fas fa-comments"></i></div>
              <div class="qx-speaking-banner__text">
                <strong>{t.speakingClubTitle}</strong>
                <p>{t.speakingClubBody}</p>
              </div>
              <ul class="qx-speaking-banner__ticks">
                <li><i class="fas fa-check" aria-hidden="true"></i> {t.speakingClubF1}</li>
                <li><i class="fas fa-check" aria-hidden="true"></i> {t.speakingClubF2}</li>
                <li><i class="fas fa-check" aria-hidden="true"></i> {t.speakingClubF3}</li>
              </ul>
            </aside>
          </div>
        </div>

        <div class="pw-panel qx-scene qx-scene--step4" data-panel="4">
          <div class="qx-stage-shell qx-stage-shell--step4">
            <header class="qx-scene-head qx-scene-head--step4">
              <span class="qx-scene-kicker">4</span>
              <div class="qx-scene-head__copy">
                <h2 class="qx-question">{t.step4Title}</h2>
                <p class="qx-question-note">{t.step4Subtitle}</p>
              </div>
            </header>
            <footer class="qx-step4-footer qx-step4-footer--top">
              <p class="qx-step4-trust"><i class="fas fa-shield-alt" aria-hidden="true"></i> {t.step4Trust}</p>
              <button type="button" class="qx-step4-continue" data-pw-step4-continue>
                {t.step4Continue} <i class="fas fa-arrow-right" aria-hidden="true"></i>
              </button>
            </footer>
            <div class="qx-step4-grid">
              <article class="qx-step4-card qx-step4-card--presets">
                <div class="qx-step4-card__head">
                  <span class="qx-step4-card__icon qx-step4-card__icon--cal" aria-hidden="true"><i class="far fa-calendar-alt"></i></span>
                  <h3 class="qx-step4-card__title">{t.step4PresetTitle}</h3>
                </div>
                <div class="qx-step4-presets" id={pw('pwStep4Presets')} role="radiogroup" aria-label={t.step4PresetTitle}></div>
              </article>
              <article class="qx-step4-card qx-step4-card--custom" data-pw-step4-custom-card>
                <div class="qx-step4-card__head">
                  <span class="qx-step4-card__icon qx-step4-card__icon--clock" aria-hidden="true"><i class="far fa-calendar-alt"></i></span>
                  <h3 class="qx-step4-card__title">{t.step4CustomTitle}</h3>
                </div>
                <div class="qx-step4-custom-intro" data-pw-step4-custom-intro>
                  <div class="qx-cal-art" aria-hidden="true">
                    <div class="qx-cal-art__binder">
                      <span class="qx-cal-art__ring"></span>
                      <span class="qx-cal-art__ring"></span>
                    </div>
                    <div class="qx-cal-art__sheet">
                      <div class="qx-cal-art__strip"></div>
                      <div class="qx-cal-art__face">
                        <div class="qx-cal-art__weekday">Mon</div>
                        <div class="qx-cal-art__daynum">12</div>
                        <div class="qx-cal-art__mini">
                          <span class="qx-cal-art__cell"></span>
                          <span class="qx-cal-art__cell"></span>
                          <span class="qx-cal-art__cell qx-cal-art__cell--on"></span>
                          <span class="qx-cal-art__cell"></span>
                          <span class="qx-cal-art__cell"></span>
                          <span class="qx-cal-art__cell qx-cal-art__cell--on"></span>
                          <span class="qx-cal-art__cell"></span>
                          <span class="qx-cal-art__cell"></span>
                          <span class="qx-cal-art__cell"></span>
                          <span class="qx-cal-art__cell"></span>
                          <span class="qx-cal-art__cell"></span>
                          <span class="qx-cal-art__cell qx-cal-art__cell--accent"></span>
                        </div>
                        <div class="qx-cal-art__plant" aria-hidden="true">
                          <span class="qx-cal-art__pot"></span>
                          <span class="qx-cal-art__leaf qx-cal-art__leaf--l"></span>
                          <span class="qx-cal-art__leaf qx-cal-art__leaf--r"></span>
