    levelHelpCtaSecondary: 'Quiero empezar desde A1'
  }
};
const t = copy[lang as keyof typeof copy] ?? copy.tr;
const programHint = programHintByLang[lang as keyof typeof programHintByLang] ?? programHintByLang.tr;
const step3Json = JSON.stringify({
  teachersInGroup: t.teachersInGroup,
  slotMorningTitle: t.slotMorningTitle,
  slotAfternoonTitle: t.slotAfternoonTitle,
  slotEveningTitle: t.slotEveningTitle,
  slotMorningTime: t.slotMorningTime,
  slotAfternoonTime: t.slotAfternoonTime,
  slotEveningTime: t.slotEveningTime,
  slotMorningF1: t.slotMorningF1,
  slotMorningF2: t.slotMorningF2,
  slotMorningF3: t.slotMorningF3,
  slotAfternoonF1: t.slotAfternoonF1,
  slotAfternoonF2: t.slotAfternoonF2,
  slotAfternoonF3: t.slotAfternoonF3,
  slotEveningF1: t.slotEveningF1,
  slotEveningF2: t.slotEveningF2,
  slotEveningF3: t.slotEveningF3
});
const step4Json = JSON.stringify({
  step4NeedPick: t.step4NeedPick,
  step4NeedCustomDate: t.step4NeedCustomDate,
  step4CustomSummary: t.step4CustomSummary
});
---

<div class="quote-wizard-instance" data-quote-instance={instanceSuffix}>
  <script type="application/json" id={pw('pwStep3Json')} set:html={step3Json} />
  <script type="application/json" id={pw('pwStep4Json')} set:html={step4Json} />
<div class={`qx-page-bg ${quoteMode === 'standalone' ? 'qx-page-bg--standalone' : 'qx-page-bg--embedded'} ${modalMode ? 'qx-page-bg--modal' : ''}`}>
<section class="qx qx-layout-flow" id={pw('pwRoot')} data-qx-mode={quoteMode}>
  <header class="qx-wiz-header">
    <div class="qx-wiz-header__top">
      <div class="qx-wiz-brand qx-wiz-brand--logo">
        <img src="/German_logo.webp" alt="" class="qx-wiz-logo" width="48" height="48" loading="lazy" decoding="async" />
      </div>

      <div class="qx-step-track" aria-hidden="true">
        {[1, 2, 3, 4, 5].map((n) => (
          <div class="qx-step-pill">
            <span class="qx-dot" data-qx-dot={n}>{n}</span>
            <span class="qx-step-pill__label">{t.stepLabels[n - 1]}</span>
          </div>
        ))}
      </div>

      <div class="qx-wiz-status qx-wiz-status--box">
        <p class="qx-wiz-status__step" data-pw-eyebrow>01 / 05</p>
        <span class="qx-wiz-status__hint">{t.asideStepHint}</span>
      </div>
    </div>

    <div class="qx-wiz-meter" aria-hidden="true">
      <div class="qx-wiz-meter__track">
        <span class="qx-wiz-meter__fill" data-pw-bar></span>
      </div>
    </div>
  </header>

  <div class="qx-body">
    <div class="qx-lead qx-lead--hero">
      <p class="qx-lead-kicker">{t.subtitleEm}</p>
      <p class="qx-lead-body">{t.subtitle}</p>
    </div>
    <p class="qx-submit-feedback" id={pw('pwSubmitFeedback')} aria-live="polite"></p>

    <form
      id={pw('pwForm')}
      class="qx-form"
      data-webhook={quoteWebhook}
      data-error={t.error}
      data-modal-mode={modalMode ? 'true' : 'false'}
      data-months={t.months.join('|')}
      data-free-lesson-label={t.freeLesson}
      data-pricing-duration={t.pricingDuration}
      data-pricing-weekly={t.pricingWeekly}
      data-pricing-monthly={t.pricingMonthly}
      data-pricing-total={t.pricingTotal}
      data-month-unit={t.monthUnit}
      data-free-price-label={t.freePriceLabel}
      data-empty-courses={t.emptyCourses}
      data-start-label={t.startLabel}
      data-time-label={t.timeLabel}
      data-teacher-label={t.teacherLabel}
      data-days-label={t.daysLabel}
      data-book-now={t.bookNow}
      data-places-available={t.placesAvailable}
      data-two-months-to-complete={t.twoMonthsToComplete}
      data-sending={t.sending}
      data-success={t.success}
      data-per-month-suffix={t.perMonthSuffix}
      data-mode-physical={t.modePhysical}
      data-mode-online={t.modeOnline}
      data-weekdays-short={t.weekdaysShort}
      data-weekend-short={t.weekendShort}
      data-need-level-hint={t.needLevelHint}
    >
      <input type="hidden" name="sourcePage" value={Astro.url.pathname} />
      <input type="hidden" name="lang" value={lang} />
      <input type="hidden" name="program" id={pw('pwProgram')} value="" />
      <input type="hidden" name="quote-program-label" id={pw('pwProgramLabel')} value="" />
      <input type="hidden" name="quote-intensive-type" id={pw('pwIntensiveType')} value="" />
      <input type="hidden" name="quote-level-start" id={pw('pwLevelA')} value="" />
      <input type="hidden" name="quote-month-start" id={pw('pwMonthA')} value="" />
      <input type="hidden" name="quote-course-type" id={pw('pwCourseType')} value="" />
      <input type="hidden" name="quote-selected-course-id" id={pw('pwCourseId')} value="" />
      <input type="hidden" name="quote-selected-course-title" id={pw('pwCourseTitle')} value="" />
      <input type="hidden" name="quote-duration-months" id={pw('pwDurationMonths')} value="" />
      <input type="hidden" name="totalPrice" id={pw('pwTotalPrice')} value="" />
      <input type="hidden" name="quote-start-date-mode" id={pw('pwStartDateMode')} value="" />
      <input type="hidden" name="quote-start-date-iso" id={pw('pwStartDateIso')} value="" />
      <input type="hidden" name="quote-start-date-label" id={pw('pwStartDateLabel')} value="" />

      <div class="pw-viewport">
        <div class="pw-panel is-current qx-scene qx-scene--pick" data-panel="1">
          <div class="qx-stage-shell">
            <header class="qx-scene-head qx-scene-head--program">
              <span class="qx-scene-kicker">1</span>
              <div class="qx-scene-head__copy">
                <h2 class="qx-question">{t.programQ}</h2>
                <p class="qx-question-note">{programHint}</p>
              </div>
            </header>
            <div class="qx-program-grid qx-strip qx-strip--programs">
              {t.programs.map((p, i) => {
                const meta = programCardMeta[p.quoteTrack as keyof typeof programCardMeta] ?? programCardMeta.intensive;
                return (
                  <button type="button" class={`qx-card qx-card--program qx-card--${i + 1}`} data-program={p.program} data-program-label={p.label} data-intensive-type={p.intensiveType} data-quote-track={p.quoteTrack}>
                    <span class="qx-card-bg" style={`--qx-img:url('${p.image}')`} aria-hidden="true" />
                    <span class="qx-card-body">
                      <span class="qx-card-title-row">
                        <strong class="qx-card-title">{p.label}</strong>
                        <span class="qx-card-go" aria-hidden="true"><i class="fas fa-chevron-right"></i></span>
                      </span>
                      <span class="qx-card-badges">
                        {meta.badges.map((badge) => <span class="qx-card-badge">{badge}</span>)}
                      </span>
                      <span class="qx-card-meta">
                        <span class="qx-card-meta-block">
                          <span class="qx-card-chip-row">
                            {meta.levels.map((lv) => <span class="qx-card-chip">{lv}</span>)}
                          </span>
                        </span>
                        <span class="qx-card-meta-block">
                          <span class="qx-card-chip-row">
                            {meta.infos.map((info) => <span class="qx-card-chip">{info}</span>)}
                          </span>
                        </span>
                      </span>
                    </span>
                  </button>
                );
              })}
            </div>
          </div>
        </div>

        <div class="pw-panel qx-scene qx-scene--plan" data-panel="2">
          <div class="qx-stage-shell qx-stage-shell--with-nav qx-stage-shell--level-v2">
            <header class="qx-scene-head qx-scene-head--level">
              <span class="qx-scene-kicker">2</span>
              <div class="qx-scene-head__copy">
                <h2 class="qx-question">{t.levelHeroTitle}</h2>
                <p class="qx-question-note">{t.levelHeroSubtitle}</p>
              </div>
            </header>
            <section class="qx-level-banner" aria-label={t.levelBannerTitle}>
              <span class="qx-level-banner__icon" aria-hidden="true"><i class="far fa-star"></i></span>
              <div class="qx-level-banner__copy">
                <strong>{t.levelBannerTitle}</strong>
                <p>{t.levelBannerText}</p>
              </div>
            </section>
            <div class="qx-choice-grid qx-choice-grid--levels qx-choice-grid--levels-v2" id={pw('pwLevelButtons')} role="group" aria-label={t.levelQ}></div>
            <div class="qx-level-help">
              <div class="qx-level-help__copy">
                <strong>{t.levelHelpTitle}</strong>
                <p>{t.levelHelpText}</p>
              </div>
              <div class="qx-level-help__actions">
                <button type="button" class="qx-level-help__btn qx-level-help__btn--primary" data-pw-level-assessment>{t.levelHelpCtaPrimary} <i class="fas fa-arrow-right" aria-hidden="true"></i></button>
                <button type="button" class="qx-level-help__btn qx-level-help__btn--ghost" data-pw-level-a1>{t.levelHelpCtaSecondary} <i class="fas fa-arrow-right" aria-hidden="true"></i></button>
              </div>
            </div>
            <div class="qx-choice-grid qx-choice-grid--months" id={pw('pwMonthButtons')} role="group" aria-label={t.monthQ}></div>
          </div>
        </div>

        <div class="pw-panel qx-scene qx-scene--stay" data-panel="3">
          <div class="qx-stage-shell qx-stage-shell--step3">
            <header class="qx-scene-head qx-scene-head--step3">
              <span class="qx-scene-kicker">3</span>
              <div class="qx-scene-head__copy">
                <h2 class="qx-question">{t.step3Title}</h2>
                <p class="qx-question-note">{t.step3Subtitle}</p>
              </div>
            </header>
            <p class="qx-hint qx-hint--step3">{t.cardSelectHint}</p>
            <div class="qx-step3-scroll">
              <div class="qx-course-cards qx-course-cards--time-slots" id={pw('pwCourseCards')} role="group" aria-label={t.step3Title}></div>
            </div>
            <aside class="qx-speaking-banner" aria-label={t.speakingClubAria}>
              <div class="qx-speaking-banner__icon" aria-hidden="true"><i class="fas fa-comments"></i></div>
              <div class="qx-speaking-banner__text">
                <strong>{t.speakingClubTitle}</strong>
                <p>{t.speakingClubBody}</p>
              </div>
              <ul class="qx-speaking-banner__ticks">
                <li><i class="fas fa-check" aria-hidden="true"></i> {t.speakingClubF1}</li>
                <li><i class="fas fa-check" aria-hidden="true"></i> {t.speakingClubF2}</li>
                <li><i class="fas fa-check" aria-hidden="true"></i> {t.speakingClubF3}</li>
              </ul>
            </aside>
          </div>
        </div>

        <div class="pw-panel qx-scene qx-scene--step4" data-panel="4">
          <div class="qx-stage-shell qx-stage-shell--step4">
            <header class="qx-scene-head qx-scene-head--step4">
              <span class="qx-scene-kicker">4</span>
              <div class="qx-scene-head__copy">
                <h2 class="qx-question">{t.step4Title}</h2>
                <p class="qx-question-note">{t.step4Subtitle}</p>
              </div>
            </header>
            <div class="qx-step4-grid">
              <article class="qx-step4-card qx-step4-card--presets">
                <div class="qx-step4-card__head">
                  <span class="qx-step4-card__icon qx-step4-card__icon--cal" aria-hidden="true"><i class="far fa-calendar-alt"></i></span>
                  <h3 class="qx-step4-card__title">{t.step4PresetTitle}</h3>
                </div>
                <div class="qx-step4-presets" id={pw('pwStep4Presets')} role="radiogroup" aria-label={t.step4PresetTitle}></div>
              </article>
              <article class="qx-step4-card qx-step4-card--custom" data-pw-step4-custom-card>
                <div class="qx-step4-card__head">
                  <span class="qx-step4-card__icon qx-step4-card__icon--clock" aria-hidden="true"><i class="far fa-calendar-alt"></i></span>
                  <h3 class="qx-step4-card__title">{t.step4CustomTitle}</h3>
                </div>
                <div class="qx-step4-custom-intro" data-pw-step4-custom-intro>
                  <div class="qx-cal-art" aria-hidden="true">
                    <div class="qx-cal-art__binder">
                      <span class="qx-cal-art__ring"></span>
                      <span class="qx-cal-art__ring"></span>
                    </div>
                    <div class="qx-cal-art__sheet">
                      <div class="qx-cal-art__strip"></div>
                      <div class="qx-cal-art__face">
                        <div class="qx-cal-art__weekday">Mon</div>
                        <div class="qx-cal-art__daynum">12</div>
                        <div class="qx-cal-art__mini">
                          <span class="qx-cal-art__cell"></span>
                          <span class="qx-cal-art__cell"></span>
                          <span class="qx-cal-art__cell qx-cal-art__cell--on"></span>
                          <span class="qx-cal-art__cell"></span>
                          <span class="qx-cal-art__cell"></span>
                          <span class="qx-cal-art__cell qx-cal-art__cell--on"></span>
                          <span class="qx-cal-art__cell"></span>
                          <span class="qx-cal-art__cell"></span>
                          <span class="qx-cal-art__cell"></span>
                          <span class="qx-cal-art__cell"></span>
                          <span class="qx-cal-art__cell"></span>
                          <span class="qx-cal-art__cell qx-cal-art__cell--accent"></span>
                        </div>
                        <div class="qx-cal-art__plant" aria-hidden="true">
                          <span class="qx-cal-art__pot"></span>
                          <span class="qx-cal-art__leaf qx-cal-art__leaf--l"></span>
                          <span class="qx-cal-art__leaf qx-cal-art__leaf--r"></span>
                        </div>
                      </div>
                    </div>
                  </div>
                  <ul class="qx-step4-custom-list">
                    <li><i class="fas fa-check" aria-hidden="true"></i> {t.step4CustomF1}</li>
                    <li><i class="fas fa-check" aria-hidden="true"></i> {t.step4CustomF2}</li>
                    <li><i class="fas fa-check" aria-hidden="true"></i> {t.step4CustomF3}</li>
                  </ul>
                  <button type="button" class="qx-step4-custom-cta" data-pw-step4-custom>
                    {t.step4CustomCta} <i class="fas fa-arrow-right" aria-hidden="true"></i>
                  </button>
                </div>
                <div class="qx-step4-custom-picker-panel" id={pw('pwStep4CustomPicker')} role="group" aria-label={t.step4PickDateLabel}>
                  <label class="qx-step4-picker-label-block" for={pw('pwCustomDateInput')}>
                    <span class="qx-step4-picker-lead">{t.step4PickDateLabel}</span>
                    <input
                      type="date"
                      id={pw('pwCustomDateInput')}
                      class="qx-step4-date-input qx-step4-date-input--panel"
                      autocomplete="off"
                      max="2030-12-31"
                    />
                  </label>
                  <p class="qx-step4-date-hint">{t.step4PickDateHint}</p>
                  <button type="button" class="qx-step4-custom-back" data-pw-step4-custom-back>
                    <i class="fas fa-arrow-left" aria-hidden="true"></i> {t.planBack}
                  </button>
                </div>
              </article>
            </div>
            <p class="qx-step4-error" id={pw('pwStep4Error')} hidden role="alert"></p>
            <footer class="qx-step4-footer">
              <p class="qx-step4-trust"><i class="fas fa-shield-alt" aria-hidden="true"></i> {t.step4Trust}</p>
              <button type="button" class="qx-step4-continue" data-pw-step4-continue>
                {t.step4Continue} <i class="fas fa-arrow-right" aria-hidden="true"></i>
              </button>
            </footer>
          </div>
        </div>

        <div class="pw-panel qx-scene qx-scene--send" data-panel="5">
          <div class="qx-stage-shell qx-stage-shell--contact">
            <header class="qx-scene-head qx-scene-head--contact">
              <span class="qx-scene-kicker">5</span>
              <div class="qx-scene-head__copy">
                <h2 class="qx-question">{t.step5Title}</h2>
                <p class="qx-question-note">{t.step5Subtitle}</p>
              </div>
            </header>

            <section class="qx-contact-card" aria-labelledby={pw('pwContactPersonalTitle')}>
              <div class="qx-contact-card__head">
                <span class="qx-contact-card__icon" aria-hidden="true"><i class="fas fa-user"></i></span>
                <h3 class="qx-contact-card__title" id={pw('pwContactPersonalTitle')}>{t.step5SectionPersonal}</h3>
              </div>
              <div class="qx-contact-grid">
                <label class="qx-contact-field">
                  <span class="qx-contact-label">{t.firstName}</span>
                  <input type="text" name="first-name" autocomplete="given-name" required class="qx-contact-input" placeholder={t.firstNamePlaceholder} />
                </label>
                <label class="qx-contact-field">
                  <span class="qx-contact-label">{t.lastName}</span>
                  <input type="text" name="last-name" autocomplete="family-name" required class="qx-contact-input" placeholder={t.lastNamePlaceholder} />
                </label>
                <label class="qx-contact-field">
                  <span class="qx-contact-label">{t.email}</span>
                  <span class="qx-contact-input-wrap">
                    <i class="fas fa-envelope qx-contact-input-icon" aria-hidden="true"></i>
                    <input type="email" name="email" autocomplete="email" required class="qx-contact-input qx-contact-input--pad-icon" placeholder={t.emailPlaceholder} />
                  </span>
                </label>
                <label class="qx-contact-field">
                  <span class="qx-contact-label">{t.phone}</span>
                  <span class="qx-contact-input-wrap">
                    <i class="fas fa-phone qx-contact-input-icon" aria-hidden="true"></i>
                    <input type="tel" name="phone" autocomplete="tel" required class="qx-contact-input qx-contact-input--pad-icon" placeholder={t.phonePlaceholder} />
                  </span>
                </label>
                <label class="qx-contact-field">
                  <span class="qx-contact-label">{t.birthDate}</span>
                  <span class="qx-contact-input-wrap">
                    <i class="far fa-calendar-alt qx-contact-input-icon" aria-hidden="true"></i>
                    <input type="date" name="birth-date" class="qx-contact-input qx-contact-input--pad-icon qx-contact-input--date" min="1920-01-01" />
                  </span>
                </label>
                <label class="qx-contact-field">
                  <span class="qx-contact-label">{t.nationality}</span>
                  <span class="qx-contact-input-wrap">
                    <i class="fas fa-globe qx-contact-input-icon" aria-hidden="true"></i>
                    <input type="text" name="nationality" autocomplete="country-name" class="qx-contact-input qx-contact-input--pad-icon" placeholder={t.nationalityPlaceholder} />
                  </span>
                </label>
              </div>
            </section>

            <section class="qx-contact-card qx-contact-card--extra" aria-labelledby={pw('pwContactExtraTitle')}>
              <div class="qx-contact-card__head">
                <span class="qx-contact-card__icon qx-contact-card__icon--chat" aria-hidden="true"><i class="fas fa-comment-dots"></i></span>
                <h3 class="qx-contact-card__title" id={pw('pwContactExtraTitle')}>{t.step5SectionExtra}</h3>
              </div>
              <textarea
                name="message"
                rows="5"
                class="qx-contact-textarea"
                placeholder={t.extraPlaceholder}
                aria-label={t.step5SectionExtra}
              ></textarea>
            </section>

            <div class="qx-contact-actions">
              <button type="submit" class="qx-contact-btn qx-contact-btn--outline qx-contact-submit" data-pw-submit-intent="demo-lesson">
                <i class="fas fa-graduation-cap" aria-hidden="true"></i>
                <span>{t.step5CtaDemoLesson}</span>
              </button>
              <button type="submit" class="qx-contact-btn qx-contact-btn--solid qx-send qx-contact-submit" data-pw-submit-intent="quote">
                <i class="far fa-calendar-alt" aria-hidden="true"></i>
                <span>{t.submit}</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>
</section>
</div>

<div class="pw-overlay" id={pw('pwOverlay')} data-home={homePath} aria-hidden="true">
  <div class="pw-dialog pw-dialog--done" data-pw-dialog role="dialog" aria-modal="true" aria-labelledby={pw('pwDoneTitle')}>
    <button type="button" class="pw-dialog-dismiss" data-pw-close aria-label={t.doneClose}><i class="fas fa-times" aria-hidden="true"></i></button>
    <div class="pw-dialog-icon" aria-hidden="true"><i class="fas fa-check"></i></div>
    <h3 id={pw('pwDoneTitle')} class="pw-dialog-title">{t.doneTitle}</h3>
    <p class="pw-dialog-text">{t.doneText}</p>
    <div class="pw-dialog-cta-wrap">
      <button type="button" class="pw-dialog-home" data-pw-close>{t.doneClose}</button>
    </div>
  </div>
</div>
</div>

<script>
  function pad2(n: number) { return String(n).padStart(2, '0'); }

  /** Sabit kur başlangıç tarihleri (Mart–Aralık 2026) — fiyat gösterilmez */
  const PRESET_COURSE_START_ISOS = [
    '2026-03-02',
    '2026-04-07',
    '2026-05-05',
    '2026-06-02',
    '2026-07-07',
    '2026-08-04',
    '2026-09-01',
    '2026-10-06',
    '2026-11-03',
    '2026-12-01'
  ];

  type Step3Copy = Record<string, string>;
  type Step4Copy = { step4NeedPick?: string; step4NeedCustomDate?: string; step4CustomSummary?: string };

  function parseStep3Copy(mount: HTMLElement, S: string): Step3Copy {
    try {
      const raw = mount.querySelector(`#pwStep3Json-${S}`)?.textContent;
      if (!raw) return {};
      return JSON.parse(raw.trim()) as Step3Copy;
    } catch {
      return {};
    }
  }

  function parseStep4Copy(mount: HTMLElement, S: string): Step4Copy {
    try {
      const raw = mount.querySelector(`#pwStep4Json-${S}`)?.textContent;
      if (!raw) return {};
      return JSON.parse(raw.trim()) as Step4Copy;
    } catch {
      return {};
    }
  }

  function localeForLang(lang: string) {
    const lc = lang.toLowerCase();
    if (lc === 'de') return 'de-DE';
    if (lc === 'en') return 'en-GB';
    if (lc === 'es') return 'es-ES';
    return 'tr-TR';
  }

  function formatPresetStartLabels(iso: string, lang: string) {
    const d = new Date(`${iso}T12:00:00`);
    const loc = localeForLang(lang);
    const long = new Intl.DateTimeFormat(loc, { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
    const short = new Intl.DateTimeFormat(loc, { day: '2-digit', month: '2-digit', year: '2-digit' }).format(d);
    return { long, short };
  }

  function escAttr(s: string) {
    return s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
  }

  function escHtml(s: string) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
  }

  function initials(name: string) {
    const p = name.trim().split(/\s+/).filter(Boolean);
    if (p.length >= 2) return (p[0][0] + p[p.length - 1][0]).toUpperCase();
    return name.slice(0, 2).toUpperCase();
  }

  function buildTimeSlots(formEl: HTMLFormElement, level: string, startMonth: number, _intensiveType: string, s3: Step3Copy) {
    const weekdaysShort = formEl.dataset.weekdaysShort || 'Mon, Tue, Wed, Thu';
    const startDate = `31.${String(startMonth).padStart(2, '0')}.2026`;
    const teacherPool = ['Anna Keller', 'Murat Yildiz', 'Sofia Becker', 'Deniz Acar', 'Lukas Weber', 'Elif Demir'];
    const teachersInGroup = s3.teachersInGroup || 'Teachers';
    const slotConfigs = [
      { id: 'phy-morning', theme: 'morning' as const, icon: 'fa-sun', titleKey: 'slotMorningTitle', timeKey: 'slotMorningTime', f1: 'slotMorningF1', f2: 'slotMorningF2', f3: 'slotMorningF3' },
      { id: 'phy-afternoon', theme: 'afternoon' as const, icon: 'fa-cloud-sun', titleKey: 'slotAfternoonTitle', timeKey: 'slotAfternoonTime', f1: 'slotAfternoonF1', f2: 'slotAfternoonF2', f3: 'slotAfternoonF3' },
      { id: 'phy-evening', theme: 'evening' as const, icon: 'fa-moon', titleKey: 'slotEveningTitle', timeKey: 'slotEveningTime', f1: 'slotEveningF1', f2: 'slotEveningF2', f3: 'slotEveningF3' }
    ];
    return slotConfigs.map((slot, slotIdx) => {
      const title = s3[slot.titleKey] || slot.id;
      const time = s3[slot.timeKey] || '';
      const bullets = [s3[slot.f1], s3[slot.f2], s3[slot.f3]].filter(Boolean) as string[];
      const base = (slotIdx * 2 + level.charCodeAt(0)) % teacherPool.length;
      const teacherNames = [0, 1, 2, 3].map((i) => teacherPool[(base + i) % teacherPool.length]);
      const teachers = teacherNames.map((name) => ({ name }));
      const displayTitle = `${level} · ${title}`;
      return { ...slot, title, time, bullets, teachers, teachersInGroup, weekdaysShort, startDate, displayTitle };
    });
  }

  function initQuoteMount(mount: HTMLElement) {
    const S = mount.dataset.quoteInstance || 'm';
    const q = <T extends HTMLElement = HTMLElement>(stem: string) => mount.querySelector<T>(`#${stem}-${S}`);
    const form = mount.querySelector<HTMLFormElement>('form.qx-form');
    const root = q<HTMLElement>('pwRoot');
    if (!form || !root) return;

    const total = 5;
    let step = 1;
    const panels = [...form.querySelectorAll<HTMLElement>('.pw-panel')];
    const eyebrow = root.querySelector<HTMLElement>('[data-pw-eyebrow]');
    const bar = root.querySelector<HTMLElement>('[data-pw-bar]');
    const dots = [...root.querySelectorAll<HTMLElement>('[data-qx-dot]')];

    const hProgram = q('pwProgram') as HTMLInputElement;
    const hProgramLabel = q('pwProgramLabel') as HTMLInputElement;
    const hIntensive = q('pwIntensiveType') as HTMLInputElement;
    const hLevelA = q('pwLevelA') as HTMLInputElement;
    const hMonthA = q('pwMonthA') as HTMLInputElement;
    const hCourseType = q('pwCourseType') as HTMLInputElement;
    const hCourseId = q('pwCourseId') as HTMLInputElement;
    const hCourseTitle = q('pwCourseTitle') as HTMLInputElement;
    const hDuration = q('pwDurationMonths') as HTMLInputElement;
    const hTotalPrice = q('pwTotalPrice') as HTMLInputElement;
    const hStartDateMode = q('pwStartDateMode') as HTMLInputElement;
    const hStartDateIso = q('pwStartDateIso') as HTMLInputElement;
    const hStartDateLabel = q('pwStartDateLabel') as HTMLInputElement;

    const courseCardsWrap = q('pwCourseCards') as HTMLElement;
    const step4PresetsWrap = q('pwStep4Presets') as HTMLElement | null;
    const step4ErrorEl = q('pwStep4Error') as HTMLElement | null;
    const step4CustomCard = form.querySelector<HTMLElement>('[data-pw-step4-custom-card]');
    const customDateInput = q('pwCustomDateInput') as HTMLInputElement | null;
    const step4Copy = parseStep4Copy(mount, S);
    const submitFeedback = q('pwSubmitFeedback') as HTMLElement | null;

    const LEVELS_FULL = ['A1', 'A2', 'B1', 'B2', 'C1'];
    const LEVELS_SHORT = ['A1', 'A2'];
    const langCode = (form.querySelector<HTMLInputElement>('input[name="lang"]')?.value || 'tr').toLowerCase();
    const LEVEL_META_BY_LANG: Record<string, Record<string, { title: string; desc: string; icon: string }>> = {
      tr: {
        A1: { title: 'Baslangic', desc: 'Kendini tanit, temel ifadeleri kullan.', icon: 'far fa-comments' },
        A2: { title: 'Temel Iletisim', desc: 'Gunluk konularda daha rahat iletisim kur.', icon: 'far fa-comment-dots' },
        B1: { title: 'Gunluk Hayat', desc: 'Gunluk yasamda bagimsizca ilerle.', icon: 'fas fa-bicycle' },
        B2: { title: 'Akademik & Profesyonel', desc: 'Egitim ve is icin daha guclu ifade kur.', icon: 'fas fa-laptop' },
        C1: { title: 'Ileri Seviye', desc: 'Universite ve ileri seviye hedeflere hazirlan.', icon: 'fas fa-graduation-cap' }
      },
      de: {
        A1: { title: 'Einstieg', desc: 'Stelle dich vor und nutze einfache Ausdruecke.', icon: 'far fa-comments' },
        A2: { title: 'Basis Kommunikation', desc: 'Kommuniziere sicherer im Alltag.', icon: 'far fa-comment-dots' },
        B1: { title: 'Alltag', desc: 'Bewege dich selbststaendig im Alltag.', icon: 'fas fa-bicycle' },
        B2: { title: 'Akademisch & Beruf', desc: 'Druecke dich klarer in Studium und Beruf aus.', icon: 'fas fa-laptop' },
        C1: { title: 'Fortgeschritten', desc: 'Bereite dich auf Hochschule und Karriere vor.', icon: 'fas fa-graduation-cap' }
      },
      en: {
        A1: { title: 'Starter', desc: 'Introduce yourself and use basic expressions.', icon: 'far fa-comments' },
        A2: { title: 'Basic Communication', desc: 'Communicate more comfortably in daily topics.', icon: 'far fa-comment-dots' },
        B1: { title: 'Daily Life', desc: 'Progress independently in everyday situations.', icon: 'fas fa-bicycle' },
        B2: { title: 'Academic & Professional', desc: 'Use stronger language for study and work.', icon: 'fas fa-laptop' },
        C1: { title: 'Advanced', desc: 'Prepare for university and higher-level goals.', icon: 'fas fa-graduation-cap' }
      },
      es: {
        A1: { title: 'Inicio', desc: 'Presentate y usa expresiones basicas.', icon: 'far fa-comments' },
        A2: { title: 'Comunicacion Basica', desc: 'Comunicacion mas comoda en temas diarios.', icon: 'far fa-comment-dots' },
        B1: { title: 'Vida Diaria', desc: 'Avanza de forma independiente en la vida diaria.', icon: 'fas fa-bicycle' },
        B2: { title: 'Academico y Profesional', desc: 'Expresate mejor para estudios y trabajo.', icon: 'fas fa-laptop' },
        C1: { title: 'Avanzado', desc: 'Preparate para universidad y metas superiores.', icon: 'fas fa-graduation-cap' }
      }
    };
    function getLevelMeta(level: string) {
      const dict = LEVEL_META_BY_LANG[langCode] || LEVEL_META_BY_LANG.tr;
      return dict[level] || LEVEL_META_BY_LANG.tr[level] || { title: level, desc: '', icon: 'far fa-star' };
    }
    function levelsForTrack(track: string) {
      if (track === 'summer-camp' || track === 'online') return LEVELS_SHORT;
      return LEVELS_FULL;
    }
    function populateLevelButtons(track: string) {
      const wrap = q('pwLevelButtons');
      if (!wrap) return;
      wrap.innerHTML = '';
      hLevelA.value = '';
      levelsForTrack(track).forEach((lv) => {
        const meta = getLevelMeta(lv);
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'qx-choice-btn qx-level-btn qx-level-card';
        b.dataset.levelValue = lv;
        b.innerHTML = `
          <span class="qx-level-card__badge">${lv}</span>
          <strong class="qx-level-card__title">${meta.title}</strong>
          <span class="qx-level-card__desc">${meta.desc}</span>
          <span class="qx-level-card__icon" aria-hidden="true"><i class="${meta.icon}"></i></span>
        `;
        b.addEventListener('click', () => {
          wrap.querySelectorAll('.qx-level-btn').forEach((x) => x.classList.remove('is-active'));
          b.classList.add('is-active');
          hLevelA.value = lv;
          applyStep2Defaults();
          renderCards();
          goTo(3);
        });
        wrap.appendChild(b);
      });
    }
    function populateMonthButtons() {
      const monthWrap = q('pwMonthButtons');
      if (!monthWrap) return;
      monthWrap.innerHTML = '';
      hMonthA.value = '';
      const rawMonthTokens = (form.getAttribute('data-months') ?? '')
        .split('|')
        .map((s) => s.trim())
        .filter((s) => s.length > 0);
      const monthNames = rawMonthTokens.length === 12 ? rawMonthTokens : Array.from({ length: 12 }, (_, i) => String(i + 1));
      const now = new Date();
      const currentMonth = now.getMonth() + 1;
      monthNames.forEach((name, idx) => {
        const monthNum = idx + 1;
        if (monthNum < currentMonth) return;
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'qx-choice-btn qx-month-btn';
        b.dataset.monthValue = String(monthNum);
        b.textContent = name;
        b.addEventListener('click', () => {
          monthWrap.querySelectorAll('.qx-month-btn').forEach((x) => x.classList.remove('is-active'));
          b.classList.add('is-active');
          hMonthA.value = String(monthNum);
          renderCards();
        });
        monthWrap.appendChild(b);
      });
    }

    function syncDots(n: number) {
      dots.forEach((d, i) => {
        const idx = i + 1;
        d.classList.toggle('is-on', idx === n);
        d.classList.toggle('is-past', idx < n);
      });
    }
    function setStepChrome(n: number) {
      if (eyebrow) eyebrow.textContent = `${pad2(n)} / ${pad2(total)}`;
      syncDots(n);
      if (bar) bar.style.transform = `scaleX(${(n - 1) / (total - 1)})`;
    }
    function goTo(next: number) {
      if (next < 1 || next > total || next === step) return;
      const from = panels[step - 1];
      const to = panels[next - 1];
      if (!from || !to) return;
      from.classList.remove('is-current');
      to.classList.add('is-current');
      step = next;
      setStepChrome(step);
    }

    /** Ay bos birakilirsa varsayilan: ilk uygun ay */
    function applyStep2Defaults() {
      hCourseType.value = 'all';
      const monthWrap = q('pwMonthButtons');
      if (monthWrap && !hMonthA.value) {
        const firstBtn = monthWrap.querySelector<HTMLButtonElement>('.qx-month-btn');
        if (firstBtn) {
          firstBtn.click();
        }
      } else if (!hMonthA.value) {
        const now = new Date();
        const monthNum = String(now.getMonth() + 1);
        hMonthA.value = monthNum;
      }
    }

    function hideStep4Error() {
      if (!step4ErrorEl) return;
      step4ErrorEl.hidden = true;
      step4ErrorEl.textContent = '';
    }

    function showStep4Error(msg: string) {
      if (!step4ErrorEl) return;
      step4ErrorEl.textContent = msg;
      step4ErrorEl.hidden = false;
    }

    function applyStep4DateMin() {
      if (!customDateInput) return;
      const d = new Date();
      d.setHours(0, 0, 0, 0);
      customDateInput.min = `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`;
    }

    function hideCustomDatePicker() {
      step4CustomCard?.classList.remove('is-picking-custom');
      if (customDateInput) customDateInput.value = '';
    }

    function syncCustomDateHiddenFromInput() {
      if (hStartDateMode.value !== 'custom' || !customDateInput) return;
      const iso = customDateInput.value.trim();
      if (!iso) {
        hStartDateIso.value = '';
        hStartDateLabel.value = '';
        return;
      }
      hStartDateIso.value = iso;
      hStartDateLabel.value = formatPresetStartLabels(iso, langCode).long;
    }

    function clearStep4Fields() {
      hStartDateMode.value = '';
      hStartDateIso.value = '';
      hStartDateLabel.value = '';
      step4CustomCard?.classList.remove('is-selected');
      hideCustomDatePicker();
      hideStep4Error();
    }

    function renderStep4Presets() {
      if (!step4PresetsWrap) return;
      applyStep4DateMin();
      const groupName = `qx-preset-${S}`;
      step4PresetsWrap.innerHTML = PRESET_COURSE_START_ISOS.map((iso) => {
        const { long, short } = formatPresetStartLabels(iso, langCode);
        const safeLong = escHtml(long);
        const safeShort = escHtml(short);
        const safeIso = escAttr(iso);
        const disp = escAttr(long);
        return `
          <label class="qx-step4-preset-row">
            <input type="radio" name="${groupName}" value="${safeIso}" data-display-label="${disp}" class="qx-step4-preset-radio" />
            <span class="qx-step4-preset-visual" aria-hidden="true"><i class="far fa-calendar-alt"></i></span>
            <span class="qx-step4-preset-text">
              <strong class="qx-step4-preset-long">${safeLong}</strong>
              <span class="qx-step4-preset-short">${safeShort}</span>
            </span>
          </label>`;
      }).join('');
    }

    function resetWizardState() {
      form.reset();
      [hProgram, hProgramLabel, hIntensive, hLevelA, hMonthA, hCourseType, hCourseId, hCourseTitle, hDuration, hTotalPrice, hStartDateMode, hStartDateIso, hStartDateLabel].forEach((el) => { el.value = ''; });
      form.querySelectorAll('.is-picked, .is-selected, .is-active').forEach((el) => el.classList.remove('is-picked', 'is-selected', 'is-active'));
      if (courseCardsWrap) courseCardsWrap.innerHTML = '';
      if (step4PresetsWrap) step4PresetsWrap.innerHTML = '';
      step4CustomCard?.classList.remove('is-selected');
      hideCustomDatePicker();
      hideStep4Error();
      q('pwLevelButtons')?.querySelectorAll('.qx-level-btn').forEach((b) => b.classList.remove('is-active'));
      q('pwMonthButtons')?.querySelectorAll('.qx-month-btn').forEach((b) => b.classList.remove('is-active'));
      panels.forEach((p, idx) => p.classList.toggle('is-current', idx === 0));
      step = 1;
      setStepChrome(1);
    }

    const step4PresetGroupName = `qx-preset-${S}`;
    step4PresetsWrap?.addEventListener('change', (ev) => {
      const target = ev.target as HTMLInputElement;
      if (target.name !== step4PresetGroupName || target.type !== 'radio' || !target.checked) return;
      hideCustomDatePicker();
      step4CustomCard?.classList.remove('is-selected');
      hStartDateMode.value = 'preset';
      hStartDateIso.value = target.value;
      hStartDateLabel.value = target.dataset.displayLabel || '';
      hideStep4Error();
    });

    customDateInput?.addEventListener('input', () => {
      syncCustomDateHiddenFromInput();
      hideStep4Error();
    });

    form.addEventListener('click', (ev) => {
      const root = ev.target as HTMLElement;
      if (root.closest('[data-pw-step4-custom-back]')) {
        step4CustomCard?.classList.remove('is-selected');
        hideCustomDatePicker();
        hStartDateMode.value = '';
        hStartDateIso.value = '';
        hStartDateLabel.value = '';
        hideStep4Error();
        return;
      }
      if (root.closest('[data-pw-step4-custom]')) {
        form.querySelectorAll<HTMLInputElement>(`input[name="${step4PresetGroupName}"]`).forEach((r) => { r.checked = false; });
        step4CustomCard?.classList.add('is-selected', 'is-picking-custom');
        hStartDateMode.value = 'custom';
        hStartDateIso.value = '';
        hStartDateLabel.value = '';
        applyStep4DateMin();
        if (customDateInput) customDateInput.value = '';
        hideStep4Error();
        customDateInput?.focus();
        return;
      }
      const go = root.closest('[data-pw-step4-continue]');
      if (go) {
        ev.preventDefault();
        const mode = hStartDateMode.value.trim();
        if (!mode) {
          showStep4Error(step4Copy.step4NeedPick || '');
          return;
        }
        if (mode === 'preset') {
          if (!hStartDateIso.value.trim()) {
            showStep4Error(step4Copy.step4NeedPick || '');
            return;
          }
        } else if (mode === 'custom') {
          syncCustomDateHiddenFromInput();
          if (!hStartDateIso.value.trim()) {
            showStep4Error(step4Copy.step4NeedCustomDate || '');
            step4CustomCard?.classList.add('is-picking-custom');
            customDateInput?.focus();
            return;
          }
        }
        goTo(5);
      }
    });

    function renderCards() {
      if (!courseCardsWrap) return;
      const level = hLevelA.value;
      const month = Number(hMonthA.value || '0');
      if (!level || !month) return;
      const s3 = parseStep3Copy(mount, S);
      const slots = buildTimeSlots(form, level, month, hIntensive.value, s3);
      if (!slots.length) {
        courseCardsWrap.innerHTML = `<p class="qx-card-empty">${form.dataset.emptyCourses || 'No open class matches these filters right now.'}</p>`;
        return;
      }
      const startLab = escHtml(form.dataset.startLabel || 'Start');
      const bookNow = escHtml(form.dataset.bookNow || 'Book now');
      const teachersK = escHtml(s3.teachersInGroup || '');
      courseCardsWrap.innerHTML = `
        <div class="qx-time-slots">
          ${slots
            .map(
              (slot) => `
          <button type="button" class="qx-time-slot qx-time-slot--${slot.theme}" data-course-id="${escAttr(slot.id)}" data-course-title="${escAttr(slot.displayTitle)}">
            <div class="qx-time-slot__accent" aria-hidden="true"></div>
            <div class="qx-time-slot__head">
              <span class="qx-time-slot__icon"><i class="fas ${slot.icon}" aria-hidden="true"></i></span>
              <div class="qx-time-slot__head-text">
                <strong class="qx-time-slot__title">${escHtml(slot.title)}</strong>
                <span class="qx-time-slot__time">${escHtml(slot.time)}</span>
              </div>
            </div>
            <ul class="qx-time-slot__features">
              ${slot.bullets.map((b) => `<li><i class="fas fa-check" aria-hidden="true"></i> ${escHtml(b)}</li>`).join('')}
            </ul>
            <div class="qx-time-slot__teachers">
              <p class="qx-time-slot__teachers-kicker">${teachersK}</p>
              <ul class="qx-time-slot__teacher-list">
                ${slot.teachers
                  .map((row) => {
                    const chips = `<span class="qx-slot-level-chip">${escHtml(level)}</span>`;
                    return `<li class="qx-slot-teacher">
                    <span class="qx-slot-teacher__avatar" aria-hidden="true">${escHtml(initials(row.name))}</span>
                    <div class="qx-slot-teacher__body">
                      <span class="qx-slot-teacher__name">${escHtml(row.name)}</span>
                      <div class="qx-slot-teacher__levels">${chips}</div>
                    </div>
                  </li>`;
                  })
                  .join('')}
              </ul>
            </div>
            <div class="qx-time-slot__foot">
              <span class="qx-time-slot__meta"><strong>${startLab}:</strong> ${escHtml(slot.startDate)} · ${escHtml(slot.weekdaysShort)}</span>
              <span class="qx-time-slot__cta">${bookNow}</span>
            </div>
          </button>`
            )
            .join('')}
        </div>`;
      courseCardsWrap.querySelectorAll<HTMLButtonElement>('.qx-time-slot').forEach((btn) => {
        btn.addEventListener('click', () => {
          courseCardsWrap.querySelectorAll('.qx-time-slot').forEach((el) => el.classList.remove('is-selected'));
          btn.classList.add('is-selected');
          hCourseId.value = btn.dataset.courseId || '';
          hCourseTitle.value = btn.dataset.courseTitle || '';
          clearStep4Fields();
          renderStep4Presets();
          goTo(4);
        });
      });
    }

    form.querySelectorAll<HTMLButtonElement>('.qx-card').forEach((btn) => {
      btn.addEventListener('click', () => {
        form.querySelectorAll('.qx-card').forEach((b) => b.classList.remove('is-picked'));
        btn.classList.add('is-picked');
        hProgram.value = btn.dataset.program || '';
        hProgramLabel.value = btn.dataset.programLabel || '';
        hIntensive.value = btn.dataset.intensiveType || '';
        const track = btn.dataset.quoteTrack || 'intensive-de';
        populateLevelButtons(track);
        populateMonthButtons();
        goTo(2);
        applyStep2Defaults();
      });
    });

    const levelAssessmentBtn = form.querySelector<HTMLButtonElement>('[data-pw-level-assessment]');
    levelAssessmentBtn?.addEventListener('click', () => {
      applyStep2Defaults();
      if (!hLevelA.value) {
        const first = q('pwLevelButtons')?.querySelector<HTMLButtonElement>('.qx-level-btn');
        first?.click();
      }
      if (!hLevelA.value || !hMonthA.value) return;
      renderCards();
      goTo(3);
    });

    const levelA1Btn = form.querySelector<HTMLButtonElement>('[data-pw-level-a1]');
    levelA1Btn?.addEventListener('click', () => {
      const a1Btn = q('pwLevelButtons')?.querySelector<HTMLButtonElement>('.qx-level-btn[data-level-value="A1"]');
      if (a1Btn) a1Btn.click();
      applyStep2Defaults();
      if (!hLevelA.value || !hMonthA.value) return;
      renderCards();
      goTo(3);
    });

    if (form.dataset.modalMode === 'true') {
      window.addEventListener('campus-quote-modal-close', () => {
        resetWizardState();
      });
    }

    const overlay = q('pwOverlay') as HTMLElement | null;
    const dialog = mount.querySelector<HTMLElement>('[data-pw-dialog]');
    function openOverlay() {
      if (!overlay || !dialog) return;
      overlay.classList.add('is-open');
      overlay.setAttribute('aria-hidden', 'false');
    }
    function dismissToHome() {
      if (form.dataset.modalMode === 'true') {
        window.closeCampusQuoteModal?.();
        return;
      }
      let target = (overlay?.dataset.home || '/').trim();
      if (!target.startsWith('/')) target = `/${target}`;
      if (target.length > 1 && target.endsWith('/')) target = target.slice(0, -1);
      window.location.href = target;
    }
    mount.querySelectorAll<HTMLButtonElement>('[data-pw-close]').forEach((btn) => btn.addEventListener('click', dismissToHome));
    overlay?.addEventListener('click', (e) => { if (e.target === overlay) dismissToHome(); });

    const DEFAULT_MAKE_WEBHOOK = 'https://hook.eu2.make.com/40s1h4a3wra21aszpa9y9erfsfooso47';
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitEv = e as SubmitEvent;
      const submitter = submitEv.submitter as HTMLButtonElement | null;
      const intentRaw = submitter?.dataset.pwSubmitIntent || '';
      const submitIntent = intentRaw === 'demo-lesson' ? 'demo-lesson' : 'quote';
      const demoLessonRequested = submitIntent === 'demo-lesson';
      const submitBtns = form.querySelectorAll<HTMLButtonElement>('.qx-contact-submit');
      const activeBtn =
        submitter?.classList.contains('qx-contact-submit')
          ? submitter
          : form.querySelector<HTMLButtonElement>('.qx-contact-submit[data-pw-submit-intent="quote"]');
      const originalBtnHtml = activeBtn?.innerHTML || '';
      if (submitFeedback) {
        submitFeedback.textContent = '';
        submitFeedback.classList.remove('is-success', 'is-error');
      }
      submitBtns.forEach((b) => { b.disabled = true; });
      const fd = new FormData(form);
      const data = Object.fromEntries(fd.entries()) as Record<string, string>;
      const firstNm = String(data['first-name'] || '').trim();
      const lastNm = String(data['last-name'] || '').trim();
      const requiredName = `${firstNm} ${lastNm}`.trim();
      const requiredEmail = String(data.email || '').trim();
      const requiredPhone = String(data.phone || '').trim();
      const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(requiredEmail);
      if (!firstNm || !lastNm || !requiredEmail || !requiredPhone || !emailOk) {
        const msg = form.dataset.error || 'Lutfen zorunlu alanlari kontrol edin.';
        if ((window as unknown as { showSuccessModal?: (t: string, m: string) => void }).showSuccessModal)
          (window as unknown as { showSuccessModal: (t: string, m: string) => void }).showSuccessModal('error', msg);
        else alert(msg);
        submitBtns.forEach((b) => { b.disabled = false; });
        return;
      }
      const payload = {
        formType: 'price-quote',
        quoteSubmitIntent: submitIntent,
        demoLessonRequested,
        sourcePage: data.sourcePage || '',
        lang: data.lang || '',
        firstName: firstNm,
        lastName: lastNm,
        name: requiredName,
        birthDate: data['birth-date'] || '',
        nationality: data.nationality || '',
        tel: data.phone || '',
        email: data.email || '',
        program: data.program || '',
        intensiveType: data['quote-intensive-type'] || '',
        level: data['quote-level-start'] || '',
        courseSelection: [data['quote-selected-course-title'] || ''],
        startDate: data['quote-month-start'] || '',
        weeks: data['quote-duration-months'] || '',
        message: data.message || '',
        totalPrice: data.totalPrice || '',
        timestamp: new Date().toISOString(),
        quoteProgramLabel: data['quote-program-label'] || '',
        quoteLevelStart: data['quote-level-start'] || '',
        quoteMonthStart: data['quote-month-start'] || '',
        quoteCourseType: data['quote-course-type'] || '',
        quoteCourseId: data['quote-selected-course-id'] || '',
        quoteDurationMonths: data['quote-duration-months'] || '',
        quoteStartDateMode: data['quote-start-date-mode'] || '',
        quoteStartDateIso: data['quote-start-date-iso'] || '',
        quoteStartDateLabel: data['quote-start-date-label'] || ''
      };
      try {
        const sending = form.dataset.sending || 'Sending...';
        if (activeBtn) activeBtn.textContent = sending;
        const wh = (form.dataset.webhook || '').trim() || DEFAULT_MAKE_WEBHOOK;
        const res = await fetch(wh, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        if (!res.ok) throw new Error('webhook');
        if (submitFeedback) {
          submitFeedback.textContent = form.dataset.success || 'Your form was submitted successfully.';
          submitFeedback.classList.add('is-success');
        }
        resetWizardState();
        openOverlay();
      } catch {
        const msg = form.dataset.error || 'Error';
        if (submitFeedback) {
          submitFeedback.textContent = msg;
          submitFeedback.classList.add('is-error');
        }
        if ((window as unknown as { showSuccessModal?: (t: string, m: string) => void }).showSuccessModal)
          (window as unknown as { showSuccessModal: (t: string, m: string) => void }).showSuccessModal('error', msg);
        else alert(msg);
      } finally {
        submitBtns.forEach((b) => { b.disabled = false; });
        if (activeBtn) activeBtn.innerHTML = originalBtnHtml;
      }
    });

    setStepChrome(1);
  }

  function initAllQuoteWizards() {
    document.querySelectorAll<HTMLElement>('.quote-wizard-instance').forEach((mount) => {
      if (mount.dataset.pwInit === '1') return;
      mount.dataset.pwInit = '1';
      initQuoteMount(mount);
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initAllQuoteWizards);
  else initAllQuoteWizards();
</script>
