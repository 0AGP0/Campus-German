---
// Ana Layout - Tüm sayfalar için kullanılacak
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SuccessModal from '../components/SuccessModal.astro';
import CookieConsent from '../components/CookieConsent.astro';
import MetaPixel from '../components/MetaPixel.astro';
import GoogleTagManager from '../components/GoogleTagManager.astro';
import QuoteWizardModal from '../components/QuoteWizardModal.astro';
import '../styles/global.css';
import '../styles/header.css';
import '../styles/footer.css';
import '../styles/sticky-sidebar.css';

const {
  title = 'Campus German - Almanca Dil Kursu',
  lang = 'tr',
  includeHizmetCSS = false,
  hideHeader = false,
  hideFooter = false,
  robots = '',
  /** Yalnızca ana sayfa: footer öncesi (main sonu) görününce otomatik aç; diğer sayfalarda otomatik açılmaz */
  visitPopupHomeScroll = false,
} = Astro.props;

const popupLang = (lang as 'tr' | 'de' | 'en' | 'es') || 'tr';

function getNextMonthDeadlineLabel(lang: 'tr' | 'de' | 'en' | 'es'): string {
  const now = new Date();
  const nextMonth = new Date(now.getFullYear(), now.getMonth() + 1, 1);
  const localeMap: Record<'tr' | 'de' | 'en' | 'es', string> = {
    tr: 'tr-TR',
    de: 'de-DE',
    en: 'en-GB',
    es: 'es-ES',
  };
  const monthYear = nextMonth.toLocaleDateString(localeMap[lang], { month: 'long', year: 'numeric' });
  const prefix: Record<'tr' | 'de' | 'en' | 'es', string> = {
    tr: 'Son tarih:',
    de: 'Anmeldeschluss:',
    en: 'Deadline:',
    es: 'Fecha límite:',
  };
  return `${prefix[lang]} ${monthYear}`;
}

type PopupCopy = {
  title: string;
  subtitle: string;
  nameLabel: string;
  phoneLabel: string;
  emailLabel: string;
  levelLabel: string;
  levelPlaceholder: string;
  levelUnknown: string;
  cityLabel: string;
  cityPlaceholder: string;
  visitLabel: string;
  visitPlaceholder: string;
  submitLabel: string;
  secondaryLabel: string;
  closeAria: string;
  sending: string;
  required: string;
  emailInvalid: string;
  success: string;
  error: string;
};

const popupCopyMap: Record<'tr' | 'de' | 'en' | 'es', PopupCopy> = {
  tr: {
    title: 'Yeni kurslarımız başlıyor fırsatlardan yararlanın',
    subtitle: '',
    nameLabel: 'Ad Soyad',
    phoneLabel: 'Telefon',
    emailLabel: 'E-posta',
    levelLabel: 'Almanca seviyeniz',
    levelPlaceholder: 'Seçiniz',
    levelUnknown: 'Bilmiyorum / henüz test olmadı',
    cityLabel: 'Yaşadığınız şehir',
    cityPlaceholder: 'Örn. İstanbul',
    visitLabel: 'Kursu ne zaman ziyaret edebilirsiniz?',
    visitPlaceholder: 'Örn. Mart 2026, hafta içi öğleden sonra',
    submitLabel: 'Gönder',
    secondaryLabel: 'Daha sonra',
    closeAria: 'Kapat',
    sending: 'Gönderiliyor...',
    required: 'Lütfen zorunlu alanları doldurun.',
    emailInvalid: 'Geçerli bir e-posta girin.',
    success: 'Talebiniz alındı. En kısa sürede sizinle iletişime geçeceğiz.',
    error: 'Gönderimde hata oluştu. Lütfen tekrar deneyin.',
  },
  de: {
    title: 'Neue Kurse starten – nutzen Sie die Vorteile',
    subtitle: '',
    nameLabel: 'Vor- und Nachname',
    phoneLabel: 'Telefon',
    emailLabel: 'E-Mail',
    levelLabel: 'Deutschniveau',
    levelPlaceholder: 'Bitte wählen',
    levelUnknown: 'Weiß ich noch nicht',
    cityLabel: 'Wohnort / Stadt',
    cityPlaceholder: 'z. B. Berlin',
    visitLabel: 'Wann können Sie den Kurs besuchen?',
    visitPlaceholder: 'z. B. März 2026, unter der Woche nachmittags',
    submitLabel: 'Absenden',
    secondaryLabel: 'Später',
    closeAria: 'Schließen',
    sending: 'Wird gesendet...',
    required: 'Bitte alle Pflichtfelder ausfüllen.',
    emailInvalid: 'Bitte eine gültige E-Mail eingeben.',
    success: 'Anfrage eingegangen. Wir melden uns bald bei Ihnen.',
    error: 'Senden fehlgeschlagen. Bitte erneut versuchen.',
  },
  en: {
    title: 'New courses are starting – seize the opportunities',
    subtitle: '',
    nameLabel: 'Full name',
    phoneLabel: 'Phone',
    emailLabel: 'Email',
    levelLabel: 'German level',
    levelPlaceholder: 'Select',
    levelUnknown: 'Not sure yet',
    cityLabel: 'City you live in',
    cityPlaceholder: 'e.g. London',
    visitLabel: 'When can you visit the course?',
    visitPlaceholder: 'e.g. March 2026, weekday afternoons',
    submitLabel: 'Send',
    secondaryLabel: 'Later',
    closeAria: 'Close',
    sending: 'Sending...',
    required: 'Please fill in all required fields.',
    emailInvalid: 'Please enter a valid email address.',
    error: 'Something went wrong. Please try again.',
    success: 'Request received. We will contact you shortly.',
  },
  es: {
    title: 'Empiezan nuestros nuevos cursos – aproveche las oportunidades',
    subtitle: '',
    nameLabel: 'Nombre completo',
    phoneLabel: 'Teléfono',
    emailLabel: 'Correo electrónico',
    levelLabel: 'Nivel de alemán',
    levelPlaceholder: 'Seleccione',
    levelUnknown: 'Aún no lo sé',
    cityLabel: 'Ciudad donde vive',
    cityPlaceholder: 'p. ej. Madrid',
    visitLabel: '¿Cuándo puede visitar el curso?',
    visitPlaceholder: 'p. ej. marzo 2026, entre semana por la tarde',
    submitLabel: 'Enviar',
    secondaryLabel: 'Más tarde',
    closeAria: 'Cerrar',
    sending: 'Enviando...',
    required: 'Complete todos los campos obligatorios.',
    emailInvalid: 'Introduzca un correo válido.',
    success: 'Solicitud recibida. Nos pondremos en contacto pronto.',
    error: 'Error al enviar. Inténtelo de nuevo.',
  },
};

const popupCopy = {
  ...(popupCopyMap[popupLang] || popupCopyMap.tr),
  subtitle: getNextMonthDeadlineLabel(popupLang),
};

const popupLevelOptions: { value: string; label: string }[] = [
  { value: 'a1', label: 'A1' },
  { value: 'a2', label: 'A2' },
  { value: 'b1', label: 'B1' },
  { value: 'b2', label: 'B2' },
  { value: 'c1', label: 'C1' },
  { value: 'c2', label: 'C2' },
  { value: 'unknown', label: popupCopy.levelUnknown },
];
---

<!DOCTYPE html>
<html lang={lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta property="og:title" content={title}>
    {robots ? <meta name="robots" content={robots} /> : null}
    
    <!-- Favicon / Google site icon (Campus German logo) – mutlak URL Google aramada simge için gerekli -->
    <link rel="icon" href="https://campusgerman.com/favicon.ico" sizes="48x48">
    <link rel="icon" type="image/png" href="https://campusgerman.com/Campusgerman.png" sizes="48x48">
    <link rel="shortcut icon" href="https://campusgerman.com/favicon.ico">
    <link rel="apple-touch-icon" href="https://campusgerman.com/Campusgerman.png">
    <meta property="og:image" content="https://campusgerman.com/Campusgerman.png">

    <GoogleTagManager part="head" />
    
    <!-- CSS: hizmet.css (koşullu) - global.css ve header.css import ediliyor -->
    {includeHizmetCSS ? (
        <link rel="stylesheet" href="/hizmet.css" />
    ) : ''}
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <!-- Google Fonts: Outfit (Europa benzeri geometrik sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Header height: top bar + nav (~112px); gömülü / tam ekran sayfalarda 0 -->
    <script is:inline define:vars={{ hideHeader }}>
      document.documentElement.style.setProperty('--header-height', hideHeader ? '0px' : '112px');
    </script>
    <!-- Script early so header dropdown works as soon as DOM is ready (defer = after parse, before paint) -->
    <script src="/script.js?v=8" defer></script>

    <MetaPixel />
</head>
<body>
    <GoogleTagManager part="body" />
    {hideHeader ? null : <Header lang={lang} />}
    {hideHeader ? null : <div class="header-spacer" aria-hidden="true"></div>}

    <main>
        <slot />
        {visitPopupHomeScroll ? (
            <div
                id="visit-popup-scroll-trigger"
                class="visit-popup-scroll-trigger"
                aria-hidden="true"
            />
        ) : null}
    </main>

    {!hideFooter ? <Footer lang={lang} /> : null}
    
    <!-- Success Modal -->
    <SuccessModal lang={lang} />

    <!-- GDPR Cookie Consent Banner (first visit) -->
    <CookieConsent lang={lang} />

    <QuoteWizardModal lang={popupLang} />
    <script is:inline>
      document.addEventListener('click', function (e) {
        var el = e.target.closest('[data-open-quote-modal]');
        if (!el) return;
        e.preventDefault();
        if (typeof window.openCampusQuoteModal === 'function') window.openCampusQuoteModal();
      });
    </script>

    <!-- Ücretsiz ders / indirim — ana sayfada main sonuna gelince (scroll) veya openVisitPopup() -->
    <div id="visit-popup" class="visit-popup" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="visit-popup-title">
        <div class="visit-popup-backdrop"></div>
        <div class="visit-popup-card visit-popup-card--form">
            <div class="visit-popup-inner">
                <div class="visit-popup-image-wrap visit-popup-image-wrap--flyer">
                    <img
                        src="/PopUp_Whatsapp.jpeg"
                        alt=""
                        class="visit-popup-image visit-popup-image--flyer"
                        width="900"
                        height="1200"
                        loading="lazy"
                        decoding="async"
                    />
                </div>
                <div class="visit-popup-content visit-popup-content--form">
                    <button class="visit-popup-close" type="button" aria-label={popupCopy.closeAria}>
                        <i class="fas fa-times"></i>
                    </button>
                    <h1 id="visit-popup-title" class="visit-popup-title">
                        {popupCopy.title}
                    </h1>
                    <p class="visit-popup-description visit-popup-description--compact visit-popup-deadline">
                        {popupCopy.subtitle}
                    </p>
                    <form
                        id="visit-popup-form"
                        class="visit-popup-form"
                        data-lang={lang}
                        data-msg-sending={popupCopy.sending}
                        data-msg-required={popupCopy.required}
                        data-msg-email={popupCopy.emailInvalid}
                        data-msg-success={popupCopy.success}
                        data-msg-error={popupCopy.error}
                    >
                        <input type="text" name="website" class="visit-popup-honey" tabindex="-1" autocomplete="off" aria-hidden="true" />
                        <div class="visit-popup-form-grid">
                            <label class="visit-popup-field">
                                <span class="visit-popup-label">{popupCopy.nameLabel} *</span>
                                <input type="text" name="name" required autocomplete="name" class="visit-popup-input" />
                            </label>
                            <label class="visit-popup-field">
                                <span class="visit-popup-label">{popupCopy.phoneLabel} *</span>
                                <input type="tel" name="phone" required autocomplete="tel" class="visit-popup-input" />
                            </label>
                            <label class="visit-popup-field visit-popup-field--full">
                                <span class="visit-popup-label">{popupCopy.emailLabel} *</span>
                                <input type="email" name="email" required autocomplete="email" class="visit-popup-input" />
                            </label>
                            <label class="visit-popup-field">
                                <span class="visit-popup-label">{popupCopy.levelLabel} *</span>
                                <select name="level" required class="visit-popup-input visit-popup-select">
                                    <option value="" disabled selected>
                                        {popupCopy.levelPlaceholder}
                                    </option>
                                    {popupLevelOptions.map((opt) => (
                                        <option value={opt.value}>{opt.label}</option>
                                    ))}
                                </select>
                            </label>
                            <label class="visit-popup-field">
                                <span class="visit-popup-label">{popupCopy.cityLabel} *</span>
                                <input type="text" name="city" required autocomplete="address-level2" class="visit-popup-input" placeholder={popupCopy.cityPlaceholder} />
                            </label>
                            <label class="visit-popup-field visit-popup-field--full">
                                <span class="visit-popup-label">{popupCopy.visitLabel} *</span>
                                <input type="text" name="start-date" required class="visit-popup-input" placeholder={popupCopy.visitPlaceholder} />
                            </label>
                            <div class="visit-popup-actions visit-popup-actions--form visit-popup-field--full">
                                <button type="submit" class="visit-popup-btn visit-popup-btn-primary" id="visit-popup-submit">
                                    {popupCopy.submitLabel}
                                </button>
                                <button type="button" class="visit-popup-btn visit-popup-btn-outline visit-popup-close-secondary">
                                    {popupCopy.secondaryLabel}
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

