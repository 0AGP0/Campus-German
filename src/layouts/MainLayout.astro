---
// Ana Layout - Tüm sayfalar için kullanılacak
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SuccessModal from '../components/SuccessModal.astro';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/global.css';
import '../styles/header.css';
import '../styles/footer.css';
import '../styles/sticky-sidebar.css';

const {
  title = 'Campus German - Almanca Dil Kursu',
  lang = 'tr',
  includeHizmetCSS = false,
  hideHeader = false,
  hideFooter = false,
  robots = '',
} = Astro.props;

const popupLang = (lang as 'tr' | 'de' | 'en' | 'es') || 'tr';

const visitPopupWhatsappHref = 'https://wa.me/4915203823792';

const visitPopupCopyMap: Record<'tr' | 'de' | 'en' | 'es', { closeAria: string; dialogLabel: string; imageAlt: string }> = {
  tr: {
    closeAria: 'Kapat',
    dialogLabel: 'Kampanya — WhatsApp ile iletişim',
    imageAlt: 'Campus German kampanya duyurusu — WhatsApp ile yazın',
  },
  de: {
    closeAria: 'Schließen',
    dialogLabel: 'Aktion — Kontakt per WhatsApp',
    imageAlt: 'Campus German Aktion — Schreiben Sie uns per WhatsApp',
  },
  en: {
    closeAria: 'Close',
    dialogLabel: 'Promo — Contact on WhatsApp',
    imageAlt: 'Campus German offer — message us on WhatsApp',
  },
  es: {
    closeAria: 'Cerrar',
    dialogLabel: 'Oferta — Contacto por WhatsApp',
    imageAlt: 'Oferta Campus German — escríbanos por WhatsApp',
  },
};

const visitPopupCopy = visitPopupCopyMap[popupLang] || visitPopupCopyMap.tr;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta property="og:title" content={title}>
    {robots ? <meta name="robots" content={robots} /> : null}
    
    <!-- Favicon / Google site icon (Campus German logo) – mutlak URL Google aramada simge için gerekli -->
    <link rel="icon" href="https://campusgerman.com/favicon.ico" sizes="48x48">
    <link rel="icon" type="image/png" href="https://campusgerman.com/Campusgerman.png" sizes="48x48">
    <link rel="shortcut icon" href="https://campusgerman.com/favicon.ico">
    <link rel="apple-touch-icon" href="https://campusgerman.com/Campusgerman.png">
    <meta property="og:image" content="https://campusgerman.com/Campusgerman.png">
    
    <!-- CSS: hizmet.css (koşullu) - global.css ve header.css import ediliyor -->
    {includeHizmetCSS ? (
        <link rel="stylesheet" href="/hizmet.css" />
    ) : ''}
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <!-- Google Fonts: Outfit (Europa benzeri geometrik sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Header height: promo açıkken ~156px; gömülü / tam ekran sayfalarda 0 -->
    <script is:inline define:vars={{ hideHeader }}>
      document.documentElement.style.setProperty('--header-height', hideHeader ? '0px' : '156px');
    </script>
    <!-- Script early so header dropdown works as soon as DOM is ready (defer = after parse, before paint) -->
    <script src="/script.js?v=6" defer></script>
</head>
<body>
    {hideHeader ? null : <Header lang={lang} />}
    {hideHeader ? null : <div class="header-spacer" aria-hidden="true"></div>}

    <main>
        <slot />
    </main>

    {!hideFooter ? <Footer lang={lang} /> : null}
    
    <!-- Success Modal -->
    <SuccessModal lang={lang} />

    <!-- GDPR Cookie Consent Banner (first visit) -->
    <CookieConsent lang={lang} />

    <!-- Kampanya görseli — ~5 sn sonra veya openVisitPopup(); tıklanınca WhatsApp (+49 1520 382 3792) -->
    <div id="visit-popup" class="visit-popup" aria-hidden="true" role="dialog" aria-modal="true" aria-label={visitPopupCopy.dialogLabel}>
        <div class="visit-popup-backdrop"></div>
        <div class="visit-popup-card visit-popup-card--whatsapp">
            <button class="visit-popup-close" type="button" aria-label={visitPopupCopy.closeAria}>
                <i class="fas fa-times"></i>
            </button>
            <a
                id="visit-popup-whatsapp"
                class="visit-popup-whatsapp-link"
                href={visitPopupWhatsappHref}
                target="_blank"
                rel="noopener noreferrer"
            >
                <img
                    src="/PopUp_Whatsapp.jpeg"
                    alt={visitPopupCopy.imageAlt}
                    class="visit-popup-whatsapp-img"
                    width="1200"
                    height="800"
                    loading="eager"
                    decoding="async"
                />
            </a>
        </div>
    </div>
</body>
</html>

